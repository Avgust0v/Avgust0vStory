    { "structure": "cataclysm:abandoned_temple", "factor": 1.6 },
    { "structure": "cataclysm:abandoned_spire", "factor": 1.6 },
    { "structure": "cataclysm:desert_temple", "factor": 1.8 },
    { "structure": "cataclysm:desert_site", "factor": 1.6 },
    { "structure": "cataclysm:amethyst_nest", "factor": 1.4 },
    { "structure": "minecraft:desert_pyramid", "factor": 2 },
    { "structure": "betterdeserttemples:desert_temple", "factor": 2 },
    { "structure": "explorify:badlands_pyramid", "factor": 2 },
    { "structure": "betterarcheology:desert_obelisk", "factor": 1.6 },
    { "structure": "betterarcheology:catacombs", "factor": 1.6 },
    { "structure": "betterarcheology:light_temple", "factor": 1.6 },
    { "structure": "betterarcheology:temple_jungle", "factor": 1.6 },
    { "structure": "philipsruins:ancient_dungeon", "factor": 2.5 },
    { "structure": "philipsruins:lost_soul_city", "factor": 2.5 },
    { "structure": "philipsruins:lost_soul_dungeon", "factor": 2 },
    { "structure": "philipsruins:ocean_fortress", "factor": 2 },
    { "structure": "philipsruins:ancient_crypt", "factor": 2 },
    { "structure": "philipsruins:ancient_towers", "factor": 2 },
    { "structure": "philipsruins:underground_structures", "factor": 2 },
    { "structure": "philipsruins:level_three_ruins", "factor": 2 },
    { "structure": "philipsruins:rare_ruin", "factor": 1.8 },
    { "structure": "terralith:fortified_desert_village", "factor": 1.5 },
