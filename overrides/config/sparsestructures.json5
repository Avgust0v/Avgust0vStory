// ### THE MOD REQUIRES A RESTART OF THE GAME TO APPLY CHANGES ###
// AvgustovStory: "living world" tuning. factor < 1 = more common, > 1 = rarer (spacing and separation are multiplied).
// Rule: small roadside/Create-style structures more often, big dungeons and boss lairs less often.
// Moog's structures (mvs/mns/mes) are tuned in moogs_structures.json, not here.
{
  "spreadFactor": 1,
  "idBasedSalt": true,
  "customSpreadFactors": [
    { "structure": "minecraft:mansion", "factor": 2 },
    // villages (vanilla + CTOV share the minecraft:villages set): 1.25x rarer, about one per 2 km2 (dev.10, user; 1.5 gave 35 villages on the 10x10 km dev.8 map, one per 2.9 km2; 1.8 left one per 9.7 km2).
    // outposts (vanilla + CTOV share minecraft:pillager_outposts): 1.6x rarer; with few villages the outposts had room everywhere (12 per 9.7 km2).
    { "structure": "minecraft:village_plains", "factor": 1.25 },
    { "structure": "villagesandpillages:village_witch", "factor": 1.25 },
    { "structure": "minecraft:pillager_outpost", "factor": 1.6 },
    { "structure": "terralith:desert_outpost", "factor": 1.6 },

    // ---- small Create-style structures: more common; they make the world feel alive, overlaps are stopped by Structure Essentials minimumStructureDistance. dev.9: CES camps 0.5 -> 0.75 (332 camps on 100 km2) ----
    { "structure": "create_rustic_structures:rustic_barn", "factor": 0.6 },
    { "structure": "create_rustic_structures:rustic_smithy", "factor": 0.6 },
    { "structure": "create_rustic_structures:rustic_well", "factor": 0.75 },
    { "structure": "create_rustic_structures:rustic_windmill", "factor": 0.6 },
    { "structure": "create_easy_structures:camp_1", "factor": 0.75 },
    { "structure": "create_easy_structures:camp_2", "factor": 0.75 },
    { "structure": "create_easy_structures:camp_3", "factor": 0.75 },
    { "structure": "create_easy_structures:camp_4", "factor": 0.75 },
    { "structure": "create_easy_structures:camp_5", "factor": 0.75 },
    { "structure": "create_easy_structures:house_2", "factor": 0.6 },
    { "structure": "create_easy_structures:house_3", "factor": 0.6 },
    { "structure": "create_easy_structures:house_4", "factor": 0.6 },
    { "structure": "create_easy_structures:windmill", "factor": 0.5 },
    { "structure": "create_easy_structures:foresttracks", "factor": 0.6 },
    { "structure": "create_structures_arise:create_copper_statue", "factor": 0.5 },
    { "structure": "create_structures_arise:createpickaxestatue", "factor": 0.5 },
    { "structure": "create_structures_arise:createlittleman", "factor": 0.45 },
    { "structure": "create_structures_arise:createdesertwell", "factor": 0.45 },
    { "structure": "create_structures_arise:windmill", "factor": 0.5 },
    { "structure": "create_structures_arise:createfluidtank", "factor": 0.5 },
    { "structure": "create_structures_arise:createcontainer", "factor": 0.45 },
    { "structure": "create_structures_arise:createairdrop", "factor": 0.5 },
    { "structure": "create_structures_arise:createoldruine", "factor": 0.5 },
    { "structure": "create_structures_arise:createcushercrane", "factor": 0.5 },
    { "structure": "create_structures_arise:createlosttrainstation", "factor": 0.6 },
    { "structure": "create_structures_arise:createhouse", "factor": 0.6 },
    { "structure": "create_structures_arise:createmonsterroom", "factor": 0.6 },
    { "structure": "create_structures_arise:createwitchhut", "factor": 0.6 },
    { "structure": "create_structures_arise:deadlordshouse", "factor": 0.8 },

    // ---- dev.9 ocean: 10x10 km map had 3477 ocean structures (35 per km2); these sets are about half as common now ----
    { "structure": "aquamirae:surface", "factor": 1.5 },
    { "structure": "underwater_village:temple_ruins", "factor": 1.5 },
    { "structure": "underwater_village:temple_broken", "factor": 1.5 },
    { "structure": "underwater_village:temple", "factor": 1.5 },
    { "structure": "underwater_village:small_gate", "factor": 1.5 },
    { "structure": "underwater_village:tower", "factor": 1.5 },
