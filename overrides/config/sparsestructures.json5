    { "structure": "underwater_village:warm_gate", "factor": 1.5 },
    { "structure": "underwater_village:warm_broken_house", "factor": 1.5 },
    { "structure": "underwater_village:cold_gate", "factor": 1.5 },
    { "structure": "underwater_village:cold_fountain", "factor": 1.5 },
    { "structure": "underwater_village:shrine", "factor": 1.5 },
    { "structure": "underwater_village:cold_big_gate", "factor": 1.5 },
    { "structure": "underwater_village:warm_big_gate", "factor": 1.5 },
    { "structure": "underwater_village:cold_broken_house", "factor": 1.5 },
    { "structure": "underwater_village:warm_fountain", "factor": 1.5 },
    { "structure": "betterarcheology:underwater_ruins", "factor": 1.4 },
    { "structure": "spawn:octopolis", "factor": 1.4 },

    // ---- small vanilla+ details: more common ----
    { "structure": "explorify:campsites", "factor": 0.7 },
    { "structure": "explorify:guide_posts", "factor": 0.6 },
    { "structure": "explorify:supply_caches", "factor": 0.7 },
    { "structure": "explorify:watchtowers", "factor": 0.8 },
    { "structure": "explorify:ruins", "factor": 0.75 },
    { "structure": "explorify:farmsteads", "factor": 0.8 },
    { "structure": "explorify:taverns", "factor": 0.8 },
    { "structure": "structory:ruin", "factor": 0.75 },
    { "structure": "structory:ruin_quiet", "factor": 0.75 },
    { "structure": "structory:mid_rare_ruin", "factor": 0.8 },
    { "structure": "farmers_structures:shepherd_farms_with_all", "factor": 0.5 },
    { "structure": "farmers_structures:undergardens_with_all", "factor": 0.7 },

    // ---- big dungeons: rarer, so each one is an event ----
    { "structure": "dungeons_arise:major_structures", "factor": 1.5 },
    { "structure": "create_structures_arise:darkcastle", "factor": 1.2 },
    { "structure": "create_structures_arise:towerofochrum", "factor": 1.2 },

    // ---- boss lairs: they were every 15-30 chunks, far too dense for a boss; dev.11j (user, 2026-11-18): after the 1.1 thinning they were
    //      almost absent on the map, so the main lairs are back near mod defaults (1-1.5); biome-locked cold lairs at 1-1.2 ----
    { "structure": "mowziesmobs:wrought_chambers", "factor": 1.5 },
    { "structure": "mowziesmobs:frostmaw_spawns", "factor": 1.2 },
    { "structure": "mowziesmobs:monasteries", "factor": 1.2 },
    { "structure": "mowziesmobs:umvuthana_groves", "factor": 1 },
    { "structure": "block_factorys_bosses:yeti_hideout", "factor": 1.2 },
    { "structure": "block_factorys_bosses:sandworm_nest", "factor": 1 },
    { "structure": "block_factorys_bosses:kraken_ship", "factor": 1 },
    { "structure": "block_factorys_bosses:underworld_arena", "factor": 1 },
    { "structure": "cataclysm:soul_black_smith", "factor": 1 },
    { "structure": "cataclysm:ruined_citadel", "factor": 1 },

    // ---- giants: much rarer (2026-11-13 test world had a Cataclysm pyramid and a YUNG desert temple in one desert) ----
    { "structure": "cataclysm:cursed_pyramid", "factor": 1 },
    { "structure": "cataclysm:ancient_factory", "factor": 1.1 },
    { "structure": "cataclysm:burning_arena", "factor": 1 },
    { "structure": "cataclysm:sunken_city", "factor": 1.1 },
    { "structure": "cataclysm:frosted_prison", "factor": 1 },
