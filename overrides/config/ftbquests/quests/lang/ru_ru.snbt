	quest.4F12538AE9AA53A5.title: "Заказ недели: Вино к празднику"
	quest.4F12538AE9AA53A5.quest_desc: [
		"Служебный квест доски заказов: открывает заказ этой недели.",
	]
	quest.1E4B3D65D330D314.title: "§6Инженер:§r Вино к празднику"
	quest.1E4B3D65D330D314.quest_subtitle: "Заказ недели · Инженер"
	quest.1E4B3D65D330D314.quest_desc: [
		"Годовщина первой артели. Без вина Мирон бы не одобрил — он был человек основательный.",
