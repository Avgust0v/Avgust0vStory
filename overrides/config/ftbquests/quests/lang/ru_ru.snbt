	]
	quest.58C10040443352A2.title: "§6Великий заказ:§r Ракетный двигатель"
	quest.58C10040443352A2.quest_subtitle: "Заказ недели · Великий заказ"
	quest.58C10040443352A2.quest_desc: [
		"Один двигатель. Запасной. Ракеты, говорят, любят ломаться в самый интересный момент.",
		" ",
		"",
		" ",
		"§7Сдать до понедельника, 00:00 по Москве.§r",
