		" ",
		"",
		" ",
		"Морская владычица бурь.",
	]
	quest.5668AD0EA39A2CC0.title: "Block Factory's Bosses"
	quest.5668AD0EA39A2CC0.quest_desc: [
		"Боссы со своими аренами по всему миру. Некоторые арены открываются ключом — смотрите JEI.",
	]
	quest.6356E223E486C0C9.title: "Йети"
	quest.6356E223E486C0C9.quest_desc: [
