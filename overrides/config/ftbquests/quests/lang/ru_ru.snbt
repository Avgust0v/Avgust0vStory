{
	file.0000000000000001.title: "AvgustovStory"
	reward_table.7B015A218852F65B.title: "Дар деревни"
	reward_table.344791A38284FBF1.title: "Торговое оборудование"
	reward_table.75F4E52411B13725.title: "Снаряжение путешественника"
	reward_table.592561C799B6FAF1.title: "Трофей охотника"
	reward_table.779E14AEABE8BA1B.title: "Награда легенды"
	reward_table.320FA7967966249B.title: "Набор механика"
	reward_table.284F1CA75065455B.title: "Латунный набор"
	reward_table.16B23A642123199E.title: "Набор электрика"
	reward_table.6833E15DE88C38A2.title: "Набор путейца"
	reward_table.5E4FEC26A655A552.title: "Набор металлурга"
	reward_table.4AC23E38FC006FEB.title: "Набор пилота"
	reward_table.37D5FFE4BE2B9876.title: "Набор артиллериста"
	reward_table.01314A45F21BE799.title: "Оборона базы"
	chapter_group.0C5877243EA452C8.title: "&#F4A261&lПуть инженера&r"
	chapter_group.79CFB7D5EF5A4EA6.title: "&#90BE6D&lРемёсла и жизнь&r"
	chapter_group.6F40D0E1399F3965.title: "&#2A9D8F&lПоселения и жители&r"
	chapter_group.0B22509E29683950.title: "&#E63946&lПриключения и боссы&r"
	chapter.318ED96E5B909505.title: "&#E9C46AСправочник&r"
	chapter.318ED96E5B909505.subtitle: "Всё, чем эта сборка отличается от обычного Майнкрафта. Прочитайте в первый вечер."
	quest.277DE12840B5758E.title: "Как читать книгу"
	quest.277DE12840B5758E.quest_desc: [
		"Главы «Пути инженера» идут по эпохам: каждая эпоха открывает новую энергию, транспорт и логистику.",
		" ",
		"",
		" ",
		"Форма ячейки — тип квеста: большой шестиугольник — начало главы, шестерёнка — веха, восьмиугольник — босс или охота, пятиугольник — место (постройка, измерение), скруглённый квадрат — заметка или страница истории, ромб — по желанию, круг — обычный квест. Чем больше ячейка, тем важнее квест. Побочные главы (кухня, звери, арсенал, подземелья) открываются вместе с основной линией.",
		" ",
		"",
		" ",
		"Клик по предмету в задаче открывает рецепт в JEI.",
	]
	quest.6C64A75635356346.title: "Гильдия"
	quest.6C64A75635356346.quest_desc: [
		"На сервере играют гильдиями: 2–4 гильдии, до 4 игроков в каждой. Создайте свою: /ftbteams party create <название>, затем /ftbteams party invite <ник>. Прогресс квестов, приват чанков и командные награды общие внутри гильдии. Когда гильдия открывает письмо мастера Августа, весь сервер видит это в чате, а первая гильдия попадает в историю.",
		" ",
		"",
		" ",
		"Командные награды (вехи эпох) выдаются один раз на команду, а обычные — каждому.",
	]
	quest.4970C0D736D8E8EF.title: "Ponder: живые инструкции"
	quest.4970C0D736D8E8EF.quest_desc: [
		"Наведите курсор на любой блок Create в инвентаре или JEI и удерживайте W — откроется анимированная сцена, показывающая, как он работает. Это лучший учебник по Create.",
		" ",
		"",
		" ",
		"R в JEI — рецепт, U — где используется.",
		" ",
		"",
		" ",
		"§6Как работает:§r Удерживайте W над любым предметом Create (в инвентаре или JEI) — откроется Ponder; Shift над предметом — краткая справка. В JEI: R — рецепт, U — где используется; U на машине (Жёрнов, Вентилятор в корпусе, Механический пресс) покажет всё, что она делает. Инженерные очки на голове показывают обороты, нагрузку и содержимое машин.",
		" ",
		"§6Зачем:§r девять из десяти «сломанных» машин чинятся за минуту: Ponder покажет правильную сборку, очки — чего не хватает.",
	]
	quest.511F2A5EA7E27314.title: "Клавиши сборки"
	quest.511F2A5EA7E27314.quest_desc: [
		"Z — приближение, X — перекат, B — рюкзак, M — карта, N — магнит, J — джетпак (H — зависание), Y — пульт корабля, ` — поворот при сборке Simulated, R / V — заклинания, Alt — меню инструментов Create, U — история смертей.",
		" ",
		"",
		" ",
		"Голос: Caps Lock — говорить, ; — меню голосового чата, Alt+; — группы, Alt+M — выключить микрофон.",
		" ",
		"",
		" ",
		"Все клавиши меняются в Настройках → Управление.",
	]
	quest.1312B8235E100152.title: "Голосовой чат"
	quest.1312B8235E100152.quest_desc: [
		"Simple Voice Chat: голос слышно в радиусе 48 блоков, тише с расстоянием. Нажмите ; — там проверка микрофона, громкость игроков и группы: в группе слышно друг друга на любом расстоянии, удобно для экспедиций.",
	]
	quest.0BBC1EA872492C7B.title: "Жажда, климат и раны"
	quest.0BBC1EA872492C7B.quest_desc: [
		"Legendary Survival Overhaul: рядом с голодом — шкалы жажды и температуры. Сырую воду лучше очищать: переплавьте бутылку или флягу в печи. Жара и холод сбивают здоровье до одного сердца — одевайтесь по погоде (швейный стол), грейтесь у огня, в зной ищите тень и воду. Урон получают части тела: раны лечат бинты и аптечки. Сами раны заживают медленно, сон лечит их только отчасти, а тяжёлые раны дают дебаффы: голова — головная боль и тошнота, руки — усталость и слабость, грудь — уязвимость, ноги и ступни — медлительность. Подробно — в главе «Кухня, вода и климат».",
	]
	quest.3AA1042BCCBF3AFA.title: "Смерть и надгробие"
	quest.3AA1042BCCBF3AFA.quest_desc: [
		"После смерти вещи остаются в надгробии на месте гибели — вернитесь и откройте его. Чужие могилы не открываются. История смертей с координатами — клавиша U.",
	]
	quest.4A9317BF669DD041.title: "Метки для друзей"
	quest.4A9317BF669DD041.quest_desc: [
		"Ping Wheel: удерживайте колесо мыши — на блоке появится метка, видная всей команде. Удобно в подземельях и при стройке.",
	]
	quest.5C05E25AE1149DB2.title: "Сервер без лагов"
	quest.5C05E25AE1149DB2.quest_desc: [
		"Сервер общий, поэтому:",
		" ",
		"• не оставляйте предметы на земле и ремнях без конца — ставьте хранилища;",
		" ",
		"• выключайте ненужные линии рычагом;",
		" ",
		"• один статичный загрузчик чанков Power Loader на человека; гильдия держит прогруженными не больше 50 чанков, а у того, кто не заходил 7 дней, прогрузка снимается;",
		" ",
		"• не больше ~3 поездов на игрока, без генераторов булыжника на столкновении;",
		" ",
		"• корабль или машина — не больше 16 000 блоков; огромное собирайте на открытом месте, а не впритык к чужой базе.",
		" ",
		"",
		" ",
		"Мир сохраняется в копию каждые 2 часа, 12 последних копий хранятся.",
	]
	quest.5FB14D3A23A5E73F.title: "Свой скин"
	quest.5FB14D3A23A5E73F.quest_desc: [
		"Сервер работает с любым лаунчером. Свой скин ставится командой /skin set <ник с лицензией или ссылка на картинку>.",
	]
	quest.78DE637970AE59FD.title: "Табло славы"
	quest.78DE637970AE59FD.quest_desc: [
		"Сервер ведёт четыре таблицы: §eav_dishes§r — сколько разных блюд попробовал каждый, §eav_bosses§r — сколько стражей пало рядом с ним, §eav_hours§r — часы в игре, §eav_deaths§r — смерти.",
		" ",
		"",
		" ",
		"Поставьте на вокзале табло Create (Display Board), подключите к нему Display Link, в источнике выберите «Scoreboard» и впишите имя таблицы. Пусть все видят, кто лучший повар и охотник сервера.",
	]
	quest.018B0FD1CBC37B44.title: "Ступени снаряжения"
	quest.018B0FD1CBC37B44.quest_desc: [
		"Броня делится на ступени, в подсказке у каждой вещи написано «Ступень Tn · эпоха».",
		" ",
		"§7T0§r кожа, дерево, стёганка · §fT1§r железо, кольчуга, дешёвые латы Epic Knights · §6T2§r латунь, паропанк, броня XIV века · §bT3§r алмаз (теперь с механизмом точности), бездна, резонарий, нептуний · §9T4§r стальные рыцарские латы, тяжёлая броня · §5T5§r незерит и Fantasy Armor · §cT6§r трофейная броня боссов (игнитиум, курсиум, аннигилятор, варден).",
		" ",
		"С T2 каждая часть даёт ещё и здоровье: полный комплект T5 — +6, трофейный — до +10.",
		" ",
		"",
		" ",
		"Боссы тоже идут ступенями B1–B6. При первой встрече в чате видно ступень, нужную броню и здоровье. За каждого игрока рядом босс получает +35% здоровья, а доля оставшегося здоровья сохраняется. Огнестрел и стрелы наносят боссу не больше определённого урона в секунду на каждого стрелка, взрывы — не больше потолка за удар.",
		" ",
		"",
		" ",
		"Незерит плавится только в смесителе с перегревом: 4 обломка + 2 золота + 2 стали. Готические латы и кастенбруст Epic Knights улучшаются до незерита на кузнечном столе с сохранением чар, рыцарские — до Максимилиана.",
	]
	quest.18A4027B6BFF9CC3.title: "Вращение и нагрузка"
	quest.18A4027B6BFF9CC3.quest_desc: [
		"Каждый источник даёт мощность в ен (единицах нагрузки): Водяное колесо — 256, Большое водяное колесо — 512, Рукоятка — 256, ветряк — 512 на каждый свой об/мин, паровой двигатель — до 16 384.",
		" ",
		"Каждая машина берёт свои ен на каждый об/мин: Жёрнов, Механический смешиватель, пила, бур, Автономный активатор, помпа, поршни — по 4; Механический пресс и Дробильное колесо — по 8; Вентилятор, Механическая рука, Механический сборщик — по 2; валы, шестерни и ремни — 0. Пример: пресс на 32 об/мин = 256 ен — ровно одно водяное колесо.",
		" ",
		"Если сумма нагрузок больше мощности — «Перегрузка», и встаёт вся сеть. Смотрите Стрессометр или Инженерные очки; добавьте источник, снизьте обороты тяжёлых машин или отделите их Сцеплением.",
	]
	quest.1D58BCDA6C192C44.title: "Скорость и шестерни"
	quest.1D58BCDA6C192C44.quest_desc: [
		"Скорость сети задаёт источник: Водяное колесо — 8 об/мин, Большое — 4, Рукоятка — 32, ветряк — 1–16, паровой двигатель — до 64. Большая шестерня, ведущая малую, удваивает скорость, малая, ведущая большую, — делит пополам; Валы и Угловая передача скорость не меняют. Предел — 256 об/мин. Регулятор скорости вращения выдаёт любую заданную скорость на Большую шестерню над собой.",
		" ",
		"Скорость ускоряет работу (Жёрнов до 16 об/мин одинаково медленный, на 32 — вдвое быстрее, на 256 — в 16 раз), но во столько же раз растёт нагрузка. Механическому смешивателю нужно не меньше 30 об/мин. Вентилятору обороты прибавляют только дальность потока, а не скорость обработки. Две ветки с разной скоростью на одном валу ломают блок на стыке.",
	]
	quest.1256061A7CA0E382.title: "Подача и выдача предметов"
	quest.1256061A7CA0E382.quest_desc: [
		"Брошенное сверху (Q) принимают: Механический ремень, Депо, Жёрнов, Дробильные колёса, Механическая пила (вверх), Чаша, Жёлоб, Осушитель предметов и шлюз, поставленный «внутрь». НЕ принимают: Хранилище предметов и Жидкостный бак (их и руками не открыть), Автономный активатор и Механический сборщик (им — ПКМ по лицевой стороне), Дозатор (только трубой).",
		" ",
		"ПКМ с предметом в руке кладёт его на Депо, в сборщик и активатор, но НЕ в Жёрнов. ПКМ пустой рукой забирает готовое из Жернова, с Депо и Ремня.",
		" ",
		"Автоматика: шлюз (в игре «Андезитовый шлюз» — не путайте с обычной воронкой; берёт по 1 предмету, Латунный — стопкой и с фильтром), Жёлоб (вниз сам, вверх — с Вентилятором), Ремень, Механическая рука (до 5 блоков). Из сундука в сундук шлюзами напрямую нельзя — нужен Ремень или Жёлоб.",
		" ",
		"Выход: Жёрнов держит готовое внутри (полные ячейки останавливают помол), Дробильные колёса сыплют вниз, Чаша выливает через носик на Ремень, Депо или сундук сбоку и на блок ниже.",
	]
	quest.0DBFC5019405734D.title: "Обработка вентилятором"
	quest.0DBFC5019405734D.quest_desc: [
		"Вентилятор в корпусе дует сквозь блок-катализатор, и всё, что лежит за ним в потоке — на земле, Ремне или Депо, — обрабатывается:",
		" ",
		"• вода — промывка (дроблёная руда в самородки, гравий в кремень, мука в тесто);",
		" ",
		"• лава или Горелка всполоха с топливом — плавка;",
		" ",
		"• огонь, костёр или горелка без топлива — копчение (еду готовят только так: в плавке она сгорает);",
		" ",
		"• огонь душ или костёр душ — навевание.",
		" ",
		"Время от оборотов не зависит: 7,5 с на каждые 16 предметов в стопке; обороты меняют только дальность (3–20 блоков). Частые ошибки: катализатор стоит не в потоке; целая стопка на земле обрабатывается долго — пускайте предметы Ремнём. Что получится — JEI, U по Вентилятору в корпусе.",
	]
	quest.304AA2CFA6EAB288.title: "Руда: дробление, промывка, плавка"
	quest.304AA2CFA6EAB288.quest_desc: [
		"Жёрнов руду не мелет — нужны Дробильные колёса (эпоха 2).",
		" ",
		"Путь: сырая руда → Дробильные колёса → дроблёная руда и Кусочки опыта (75 %) → промывка вентилятором через воду → 9 самородков и побочный продукт (железо — редстоун 75 %, медь — глина 50 %, золото — кварц 50 %, цинк — порох 25 %) → Механический пресс над Чашей уплотняет 9 самородков в слиток. Или просто переплавьте дроблёную руду: 1 слиток.",
		" ",
		"Выгода: блок руды (с шёлковым касанием) даёт 1,75 дроблёной руды вместо 1, блок сырой руды — 9; плюс опыт и побочные металлы. Пока колёс нет, промывайте гравий (кремень, железные самородки) и красный песок (золотые самородки).",
	]
	chapter.1C61CCEE8DC655F6.title: "&#C9A227Хроника Предтеч&r"
	chapter.1C61CCEE8DC655F6.subtitle: "Кто строил машины на этой земле до нас — и куда они ушли. Страницы летописи спрятаны в постройках и у стражей мира."
	quest.64F9716A95B4C4F9.title: "Хроника Предтеч"
	quest.64F9716A95B4C4F9.quest_subtitle: "Как искать страницы"
	quest.64F9716A95B4C4F9.quest_desc: [
		"Каждая страница летописи Ратибора лежит там, где жила Первая артель: в руинах, на станциях, в литейных, на дне моря и у стражей. Страница засчитывается, когда вы доберётесь до этого места.",
		" ",
		"",
		" ",
		"Каждая страница даёт карту с красным крестом к месту следующей (кроме незерской), а компас исследователя в награду найдёт любую постройку по названию. В сундуках этих руин лежат и обрывки записей тех, кто жил рядом с Ратибором. Страницы открываются вместе с письмами мастера Августа — по мере того, как растёт сама артель.",
	]
	quest.4C9138ED290F5D61.title: "Страница 1. Мы пришли первыми"
	quest.4C9138ED290F5D61.quest_subtitle: "Летопись мастера Ратибора"
	quest.4C9138ED290F5D61.quest_desc: [
		"Мы пришли сюда, когда здесь не было ничего, кроме леса и ветра. Первую шестерню выточил мой отец — из камня, потому что металла ещё не знали. Мы назвали себя артелью: каждый умел своё, а вместе — всё.",
		" ",
		"",
		" ",
		"Если ты читаешь это, значит, нас уже нет. Не горюй. Читай дальше.",
		" ",
		"",
		" ",
		"— Ратибор, летописец Первой артели",
	]
	quest.136D243046ECF770.title: "Страница 2. Ветер и вода"
	quest.136D243046ECF770.quest_subtitle: "Летопись мастера Ратибора"
	quest.136D243046ECF770.quest_desc: [
		"Ветряки стояли на каждом холме, колёса — на каждом ручье. Мы мололи муку, пилили лес и пели за работой. Это было лучшее время. Машины служили людям, а не люди машинам.",
		" ",
		"",
		" ",
		"Запомни это время, наследник. Потом его не вернуть.",
		" ",
		"",
		" ",
		"— Ратибор, летописец Первой артели",
	]
	quest.1208C18957072236.title: "Страница 3. Укрощение огня"
	quest.1208C18957072236.quest_subtitle: "Летопись мастера Ратибора"
	quest.1208C18957072236.quest_desc: [
		"В крепостях Незера мы нашли ифритов и научились запирать их в котлы. Латунь потекла рекой. Мы строили всё быстрее, всё больше.",
		" ",
		"",
		" ",
		"Кузнец Игнат захотел огня сильнее всех — и вырастил Игниса, рыцаря из пламени, стеречь нашу кузню. Рыцарь сторожит её до сих пор. Даже от нас.",
		" ",
		"",
		" ",
		"— Ратибор, летописец Первой артели",
		" ",
		"",
		" ",
		"§cНе ищите кузню Игниса, пока не сварите сталь: это страж ступени B6.§r",
	]
	quest.6D0EBADDF753515D.title: "Страница 4. Город под волнами"
	quest.6D0EBADDF753515D.quest_subtitle: "Летопись мастера Ратибора"
	quest.6D0EBADDF753515D.quest_desc: [
		"У южного берега стоял наш порт — купола, ворота, маяк. Мы осушали заливы, чтобы строить ещё. А однажды море пришло обратно и забрало город за одну ночь.",
		" ",
		"",
		" ",
		"Мы сказали себе: случайность. Это была первая ложь.",
		" ",
		"",
		" ",
		"— Ратибор, летописец Первой артели",
		" ",
		"",
		" ",
		"§6Компас исследователя:§r Temple (underwater_village).",
	]
	quest.6C2B55B818AC4F67.title: "Страница 5. Украденное небо"
	quest.6C2B55B818AC4F67.quest_subtitle: "Летопись мастера Ратибора"
	quest.6C2B55B818AC4F67.quest_desc: [
		"Наш флот был гордостью артели: паровые дирижабли ходили до самых гор. Когда машины стали работать сами, ученики остались без дела и угнали их. Теперь они грабят деревни и зовут себя иначе.",
		" ",
		"",
		" ",
		"Если встретишь их — не вини слишком сильно. Это мы оставили их без работы.",
		" ",
		"",
		" ",
		"— Ратибор, летописец Первой артели",
	]
	task.23E8D5103BF7FEBC.title: "Найти литейную или фабрику"
	quest.5080490B94FDC787.title: "Страница 6. Литейная"
	quest.5080490B94FDC787.quest_subtitle: "Летопись мастера Ратибора"
	quest.5080490B94FDC787.quest_desc: [
		"Литейные работали день и ночь. Склады считали сами, посылки летали по цепям. Дым закрыл солнце, и никто уже не помнил, какого цвета небо.",
		" ",
		"",
		" ",
		"Старый мельник сказал на совете: «Земля устала». Его подняли на смех. Мне до сих пор стыдно, что я промолчал.",
		" ",
		"",
		" ",
		"— Ратибор, летописец Первой артели",
		" ",
		"",
		" ",
		"§6Компас исследователя (подойдёт любая):§r When Dungeons Arise: Foundry, Mechanical Nest; Create: Easy Structures: Factory 1, Factory 2.",
	]
	quest.07049344D99E519F.title: "Страница 7. Последний поезд"
	quest.07049344D99E519F.quest_subtitle: "Летопись мастера Ратибора"
	quest.07049344D99E519F.quest_desc: [
		"Великая выработка пришла тихо: иссякли жилы, почернели реки, звери ушли в горы. Совет решил: раз эта земля кончилась, найдём другую. Не здесь — выше неба.",
		" ",
		"",
		" ",
		"Последний поезд увёз мастеров к фабрике в горах, где строили ракету. Я остался записать всё, что было. Кто-то должен.",
		" ",
		"",
		" ",
		"— Ратибор, летописец Первой артели",
	]
	quest.4CE27C1BF38E94F4.title: "Страница 8. Ракетная фабрика"
	quest.4CE27C1BF38E94F4.quest_subtitle: "Летопись мастера Ратибора"
	quest.4CE27C1BF38E94F4.quest_desc: [
		"Фабрику в горах охраняет Предвестник — железный страж, которого мы собрали из лучших механизмов. Он не пустит никого, пока не убедится, что пришедшие достойны.",
		" ",
		"",
		" ",
		"В его ядро я вложил карту неба — путь туда, куда улетели мои братья. Если ты одолел его, значит, ты достоин.",
		" ",
		"",
		" ",
		"— Ратибор, летописец Первой артели",
	]
	quest.672FF7EFC7AFD2A5.title: "Страница 9. Ядро стража"
	quest.672FF7EFC7AFD2A5.quest_subtitle: "Летопись мастера Ратибора"
	quest.672FF7EFC7AFD2A5.quest_desc: [
		"§6Ступень B6§r · рекомендуется броня T5+ (незерит и трофейная)",
		" ",
		"",
		" ",
		"Ты держишь в руках ядро Предвестника. На его медной пластине — звёздная карта: Земля, орбита, Луна, а дальше — Марс и Венера с пометкой «если Луны не хватит».",
		" ",
		"",
		" ",
		"Они не знали, хватит ли. Мы так и не узнали.",
		" ",
		"",
		" ",
		"— Ратибор, летописец Первой артели",
		" ",
		"",
		" ",
		"§6Компас исследователя:§r Ancient Factory (L_Ender's Cataclysm 1.21.1).",
	]
	quest.16BD5124B9B1A7B0.title: "Страница 10. Клятва огня"
	quest.16BD5124B9B1A7B0.quest_subtitle: "Летопись мастера Ратибора"
	quest.16BD5124B9B1A7B0.quest_desc: [
		"§6Ступень B6§r · рекомендуется броня T5+ (незерит и трофейная)",
		" ",
		"§cЖара:§r охлаждающая подкладка на броню и вода",
		" ",
		"",
		" ",
		"Игнис пал — значит, кузня Игната свободна. На наковальне выбита клятва Первой артели: «Строить, пока земля даёт. Брать, сколько земля простит».",
		" ",
		"",
		" ",
		"Вторую половину клятвы мы забыли первой.",
		" ",
		"",
		" ",
		"— Ратибор, летописец Первой артели",
		" ",
		"",
		" ",
		"§6Компас исследователя:§r Burning Arena (L_Ender's Cataclysm 1.21.1).",
	]
	quest.69D2D4983CD65590.title: "Страница 11. Выше неба"
	quest.69D2D4983CD65590.quest_subtitle: "Летопись мастера Ратибора"
	quest.69D2D4983CD65590.quest_desc: [
		"С орбиты земля кажется маленькой и хрупкой — синей, зелёной и бурой там, где мы её выжгли. Мои братья смотрели на неё отсюда в последний раз.",
		" ",
		"",
		" ",
		"Наследник, посмотри на свою землю. Она ещё зелёная? Тогда ты уже сделал больше, чем мы.",
		" ",
		"",
		" ",
		"— Ратибор, летописец Первой артели",
	]
	quest.69D9D637AED315AB.title: "Страница 12. Лунная мастерская"
	quest.69D9D637AED315AB.quest_subtitle: "Летопись мастера Ратибора"
	quest.69D9D637AED315AB.quest_desc: [
		"Это последняя страница. Лунная мастерская пуста: братья полетели дальше, к Марсу. Я остался — кто-то должен дождаться наследников и передать им летопись.",
		" ",
		"",
		" ",
		"Если ты здесь, ты прошёл наш путь. Не повторяй наших ошибок. Строй мудрее нас.",
		" ",
		"",
		" ",
		"Летопись Первой артели закончена. Начни свою.",
		" ",
		"",
		" ",
		"— Ратибор, летописец Первой артели",
	]
	quest.283EB5A9AD5C1061.title: "Кованый рыцарь"
	quest.283EB5A9AD5C1061.quest_subtitle: "Страж Предтеч"
	quest.283EB5A9AD5C1061.quest_desc: [
		"§6Ступень B2§r · рекомендуется броня T1+ (железо)",
		" ",
		"",
		" ",
		"Наш первый автомат: доспех, в который вместо человека поставили шестерни и пружины. Он умел только одно — рубить. Мы гордились им неделю, а потом не смогли остановить и замуровали в подземелье.",
		" ",
		"",
		" ",
		"Урок, который мы не выучили: механизм без цели опаснее пустого цеха. Ставь машину, только когда знаешь, зачем она.",
		" ",
		"",
		" ",
		"— Ратибор, летописец Первой артели",
		" ",
		"",
		" ",
		"§6Компас исследователя:§r Wrought Chamber (Mowzie's Mobs).",
	]
	quest.789ADDE7463B48C8.title: "Незеритовое чудовище"
	quest.789ADDE7463B48C8.quest_subtitle: "Страж Предтеч"
	quest.789ADDE7463B48C8.quest_desc: [
		"§6Ступень B5§r · рекомендуется броня T4+ (стальные латы)",
		" ",
		"§cЖара:§r охлаждающая подкладка на броню и вода",
		" ",
		"",
		" ",
		"Кузнец Игнат собрал его, чтобы кормить печи Незера: огромный незеритовый голем, который сам носил руду к горелкам всполоха. Когда руда кончилась, голем стал искать её где придётся — в стенах, в мостах, в людях.",
		" ",
		"",
		" ",
		"Огонь котла — великий помощник. Но корми его ты, а не машина без хозяина.",
		" ",
		"",
		" ",
		"— Ратибор, летописец Первой артели",
		" ",
		"",
		" ",
		"§6Компас исследователя:§r Soul Black Smith (L_Ender's Cataclysm 1.21.1).",
	]
	quest.337D7CB8797BD211.title: "Левиафан"
	quest.337D7CB8797BD211.quest_subtitle: "Страж Предтеч"
	quest.337D7CB8797BD211.quest_desc: [
		"§6Ступень B4§r · рекомендуется броня T3+ (алмаз и подобная)",
		" ",
		"",
		" ",
		"Когда мы осушали заливы под порт, из глубины поднялся Левиафан. Мы решили, что он охраняет море от нас, — и были правы. Он и сейчас стережёт затонувший город и наши подлодки.",
		" ",
		"",
		" ",
		"Балласт, прочное стекло, кислород — мы умели спускаться на дно. Мы не умели вовремя остановиться.",
		" ",
		"",
		" ",
		"— Ратибор, летописец Первой артели",
		" ",
		"",
		" ",
		"§6Компас исследователя:§r Sunken City (L_Ender's Cataclysm 1.21.1).",
	]
	quest.35534A134624A5B2.title: "Сцилла"
	quest.35534A134624A5B2.quest_subtitle: "Страж Предтеч"
	quest.35534A134624A5B2.quest_desc: [
		"§6Ступень B4§r · рекомендуется броня T3+ (алмаз и подобная)",
		" ",
		"",
		" ",
		"Сцилла — дитя бури над затонувшим портом. Говорят, она родилась из молний, что били в наш маяк, пока море забирало город.",
		" ",
		"",
		" ",
		"— Ратибор, летописец Первой артели",
		" ",
		"",
		" ",
		"§6Компас исследователя:§r Acropolis (L_Ender's Cataclysm 1.21.1).",
	]
	quest.2E6AC0A4D2018FAC.title: "Маледиктус"
	quest.2E6AC0A4D2018FAC.quest_subtitle: "Страж Предтеч"
	quest.2E6AC0A4D2018FAC.quest_desc: [
		"§6Ступень B6§r · рекомендуется броня T5+ (незерит и трофейная)",
		" ",
		"§bХолод:§r тёплая подкладка на броню и горячая еда",
		" ",
		"",
		" ",
		"В ледяную тюрьму на севере мы отправили учеников, угнавших дирижабли. Маледиктус был их надзирателем. Теперь узники давно сбежали и стали иллагерами, а надзиратель всё сторожит пустые камеры.",
		" ",
		"",
		" ",
		"Мы наказали голодных вместо того, чтобы их накормить.",
		" ",
		"",
		" ",
		"— Ратибор, летописец Первой артели",
		" ",
		"",
		" ",
		"§6Компас исследователя:§r Frosted Prison (L_Ender's Cataclysm 1.21.1).",
	]
	quest.1DBA801D2FF722F8.title: "Заклинатель"
	quest.1DBA801D2FF722F8.quest_subtitle: "Страж Предтеч"
	quest.1DBA801D2FF722F8.quest_desc: [
		"§6Ступень B2§r · рекомендуется броня T1+ (железо)",
		" ",
		"",
		" ",
		"Лучший ученик моего брата. Он первым понял, что машины можно водить не руками, а волей, — и первым увёл учеников в леса. Теперь он вождь иллагеров и зовёт нас «старыми хозяевами».",
		" ",
		"",
		" ",
		"Если победишь его, скажи ему: мы сожалеем.",
		" ",
		"",
		" ",
		"— Ратибор, летописец Первой артели",
		" ",
		"",
		" ",
		"§6Компас исследователя:§r Labyrinth (Illager Invasion).",
	]
	quest.582020A541AB5D80.title: "Древний остаток"
	quest.582020A541AB5D80.quest_subtitle: "Страж Предтеч"
	quest.582020A541AB5D80.quest_desc: [
		"§6Ступень B4§r · рекомендуется броня T3+ (алмаз и подобная)",
		" ",
		"§cЖара:§r охлаждающая подкладка на броню и вода",
		" ",
		"",
		" ",
		"В пустыне стояла наша обсерватория. Там считали путь ракеты: углы, скорости, топливо — всё, что сегодня делает штурманский стол. Остаток сторожит расчёты от песка и воров.",
		" ",
		"",
		" ",
		"Карта, которую он охраняет, — лишь черновик. Чистовик — в ядре Предвестника.",
		" ",
		"",
		" ",
		"— Ратибор, летописец Первой артели",
		" ",
		"",
		" ",
		"§6Компас исследователя:§r Cursed Pyramid (L_Ender's Cataclysm 1.21.1).",
	]
	quest.3AD3A6725655B6D0.title: "Эндер-страж"
	quest.3AD3A6725655B6D0.quest_subtitle: "Страж Предтеч"
	quest.3AD3A6725655B6D0.quest_desc: [
		"§6Ступень B6§r · рекомендуется броня T5+ (незерит и трофейная)",
		" ",
		"",
		" ",
		"В Крае мы нашли левитит — камень, который не хочет лежать на земле. Из него строили летающие города и днища кораблей. Эндер-страж охраняет последние жилы левитита.",
		" ",
		"",
		" ",
		"Без левитита ракета не оторвалась бы от земли. Береги каждый кристалл.",
		" ",
		"",
		" ",
		"— Ратибор, летописец Первой артели",
		" ",
		"",
		" ",
		"§6Компас исследователя:§r Ruined Citadel (L_Ender's Cataclysm 1.21.1).",
	]
	quest.329AE237179B6018.title: "Стражи свободны"
	quest.329AE237179B6018.quest_subtitle: "Все стражи Предтеч"
	quest.329AE237179B6018.quest_desc: [
		"Все стражи Первой артели повержены. Их долг кончился: хозяева не вернутся, а наследники доказали, что достойны.",
		" ",
		"",
		" ",
		"Теперь технологии Предтеч — ваши. Распорядитесь ими мудрее.",
	]
	quest.4FCBD34DB6C6BC3B.title: "Библиотека артели"
	quest.4FCBD34DB6C6BC3B.quest_desc: [
		"Каждое письмо мастера Августа приходит настоящей книгой. Соберите все десять — от «Пролога» до «К звёздам» — и поставьте их на кафедры в ратуше, по порядку глав. Пусть те, кто придёт после нас, прочтут, как мы начинали.",
	]
	task.13CE0FBE3AFC8C28.title: "Обрывок 1/13: Первая шестерня"
	task.1FA8A4CE1BD3A13F.title: "Обрывок 2/13: Мельница у ручья"
	task.7B988186FA72DE99.title: "Обрывок 3/13: Ведомость кузни"
	task.681395525C350C34.title: "Обрывок 4/13: Портовый журнал"
	task.0FF3BD94023689C6.title: "Обрывок 5/13: Записка в кубрике"
	task.0E56E271033749A8.title: "Обрывок 6/13: Сменный лист литейной"
	task.7F5F6B161D427115.title: "Обрывок 7/13: Расписание, которое не сбылось"
	task.489C0D343A3A0BA7.title: "Обрывок 8/13: Записка в вагонетке"
	task.4467E086AAB3ECCB.title: "Обрывок 9/13: Протокол совета"
	task.289CB1696E82E153.title: "Обрывок 10/13: Надпись на могиле"
	task.2FEACA2CC1A88049.title: "Обрывок 11/13: Клятва Первой артели"
	task.0A1BCD2B301CA720.title: "Обрывок 12/13: Вахтенный журнал маяка"
	task.33474C0DB7688232.title: "Обрывок 13/13: Нижний горизонт"
	quest.2EDB267AE42E9650.title: "Собиратель обрывков"
	quest.2EDB267AE42E9650.quest_desc: [
		"Летопись Ратибора — не единственное, что осталось от Первой артели. В сундуках руин лежат потрёпанные записки тех, кто жил рядом с ним: мельника, кузнеца, смотрителя вокзала, учеников. С Lootr у каждого свой сундук, так что ищите все.",
		" ",
		"",
		" ",
		"Где искать:",
		" ",
		"• 1. Первая шестерня — в старых руинах",
		" ",
		"• 2. Мельница у ручья — на ветряных мельницах",
		" ",
		"• 3. Ведомость кузни — в крепостях Незера",
		" ",
		"• 4. Портовый журнал — в затонувшем городе",
		" ",
		"• 5. Записка в кубрике — на кораблях и дирижаблях разбойников",
		" ",
		"• 6. Сменный лист литейной — в литейной",
		" ",
		"• 7. Расписание, которое не сбылось — на заброшенных вокзалах",
		" ",
		"• 8. Записка в вагонетке — в шахтах и шахтных поездах",
		" ",
		"• 9. Протокол совета — в разрушенном замке",
		" ",
		"• 10. Надпись на могиле — на старых кладбищах",
		" ",
		"• 11. Клятва Первой артели — в заброшенных библиотеках",
		" ",
		"• 12. Вахтенный журнал маяка — на маяках",
		" ",
		"• 13. Нижний горизонт — в сланцевых хранилищах Древней крепости",
		" ",
		"",
		" ",
		"Собранные записки не забираются: держите их у себя или поставьте на полку в ратуше.",
	]
	quest.2DF99D88266E4FD7.title: "Камни предшественников"
	quest.2DF99D88266E4FD7.quest_desc: [
		"Ancient Remnants: по миру стоят монолиты и монументы цивилизации, которую не помнит даже летопись Ратибора. Их ядра до сих пор гудят. Найдите любой — у каждого своё благословение.",
		" ",
		"",
		" ",
		"§6Компас исследователя (подойдёт любая):§r Ancient Remnants: Cherry Monument, Coniferous Monument, Oakwood Monument, Hunter Monolith, Sentinel Monolith и ещё 1.",
	]
	quest.4BFF5193874F0949.title: "Кодекс монолита"
	quest.4BFF5193874F0949.quest_desc: [
		"Обрывки исследований не крафтятся — их находят в сундуках, чаще всего на аванпостах разбойников. Найдите обрывок и вклейте его в Кодекс монолита (книга, аметист и глубинный сланец на верстаке): кодекс расскажет, что даёт каждый камень и где искать остальные.",
		" ",
		"",
		" ",
		"На полях кодекса кто-то нарисовал углём шестерню, выточенную из камня, и подписал: «М.». Мирон, отец Ратибора, видел эти камни раньше всех — свою первую шестерню он выточил по их резьбе. Первая артель начинала не с пустого места. И мы тоже.",
	]
	task.68F92A6F2B18EC3B.title: "Обрывок 10/13: Надпись на могиле"
	quest.0B3E8C1A9FDC0C43.title: "Мельник был прав"
	quest.0B3E8C1A9FDC0C43.quest_desc: [
		"На старых кладбищах лежит мельник Добрыня — тот, кто первым сказал совету «Земля устала», и кого за это выгнали. Найдите записку с его могилы.",
	]
	quest.382EC0DD56E92FE4.title: "Мельница снова мелет"
	quest.382EC0DD56E92FE4.quest_desc: [
		"Поставьте на холме ветряную мельницу с жерновами — такую, как у Добрыни: ветер вместо угля, мука вместо дыма. Отметьте задачу, когда она закрутится.",
	]
	quest.77B8FB998CA1C226.title: "Роща для Добрыни"
	quest.77B8FB998CA1C226.quest_desc: [
		"«Посадите рядом дерево. Он хотел бы дерево, а не камень». Посадите у мельницы рощу — не меньше шестнадцати деревьев — и отметьте задачу. Ратибор промолчал на совете; вы — нет.",
	]
	quest.054F9E2CE961B8D8.title: "Стражи иных земель"
	quest.054F9E2CE961B8D8.quest_subtitle: "Летопись мастера Ратибора"
	quest.054F9E2CE961B8D8.quest_desc: [
		"Мы назвали эту землю своей, потому что пришли первыми. Но за рекой, за горами и за морем у каждой земли был свой хозяин: в саванне — солнечный вождь, на горе — Скульптор, в джунглях — мшистый колосс, в песках — страж дюн, в глубоком море — Кракен. Их не строил никто из нас. Они выросли вместе со своей землёй и спали, пока её не трогали.",
		" ",
		"",
		" ",
		"Наши стражи стерегут то, что мы сделали. Эти стерегут то, что мы хотели взять. Для них я завёл в летописи отдельный лист и записываю туда каждого, кого мы разбудили.",
		" ",
		"",
		" ",
		"— Ратибор, летописец Первой артели",
		" ",
		"",
		" ",
		"§7Лист открывается после победы над любым стражем иных земель (главы «Подземелья и мини-боссы» и «Боссы»). Строки летописи о каждом — в описаниях их квестов.§r",
	]
	quest.71C731CFE2F902A0.title: "Ничьей земли нет"
	quest.71C731CFE2F902A0.quest_subtitle: "Летопись мастера Ратибора"
	quest.71C731CFE2F902A0.quest_desc: [
		"Когда наши жилы иссякли, мы пошли за рудой в чужие земли: в Незер, в Край, на дно моря, в снега и пески. И везде нас уже ждали — у каждой жилы, у каждого лавового озера был свой страж. Ничьей земли нет, наследник. Есть только земля, чьего хозяина ещё не разбудили.",
		" ",
		"",
		" ",
		"На совете о ракете я снова промолчал. Совет решил искать ничью землю выше неба. Я до сих пор не знаю, нашли ли её мои братья — или и там кто-то спит.",
		" ",
		"",
		" ",
		"— Ратибор, летописец Первой артели",
	]
	chapter.768E07399E2C5D87.title: "&#A7C957Эпоха 0. Первые шаги&r"
	chapter.768E07399E2C5D87.subtitle: "Обжиться, найти деревню, сделать первый андезитовый сплав."
	quest.577642ADDF95E032.title: "Пролог. Новая земля"
	quest.577642ADDF95E032.quest_subtitle: "Письмо мастера Августа"
	quest.577642ADDF95E032.quest_desc: [
		"Друзья мои!",
		" ",
		"",
		" ",
		"Корабль ушёл, а мы остались. Земля здесь богатая, но дикая: ни дорог, ни мельниц, ни одной нашей шестерни.",
		" ",
		"",
		" ",
		"Но я скажу вам то, о чём молчал всю дорогу. Мой дед рассказывал о Первой артели — мастерах, которые строили машины задолго до нас и однажды исчезли. Говорил, что они жили за морем, на этой самой земле. Если увидите заросшую мельницу или ржавую шестерню в траве — это их след. Записи, которые найдёте, несите мне. Я начинаю «Хронику Предтеч».",
		" ",
		"",
		" ",
		"А пока — нож, верстак и крыша над головой. Найдите деревню. И держитесь вместе: артель сильна, пока она артель.",
		" ",
		"",
		" ",
		"— Мастер Август",
	]
	quest.4C63655423EE0349.title: "Добро пожаловать в AvgustovStory"
	quest.4C63655423EE0349.quest_subtitle: "Сборка вокруг Create"
	quest.4C63655423EE0349.quest_desc: [
		"Развитие идёт по эпохам: каждая новая машина требует продукт прошлой эпохи. Главы «Путь инженера» ведут по этому пути по порядку.",
		" ",
		"Рецепты смотрите в JEI: R — рецепт, U — где используется. Клавиша Ponder (W при наведении) показывает анимированную инструкцию к любому блоку Create.",
	]
	quest.477711A9460E18F2.title: "Верстак"
	quest.4CC5DAA24F887D91.title: "Первая ночь"
	quest.4CC5DAA24F887D91.quest_desc: [
		"Сделайте кровать и переночуйте. На сервере достаточно, чтобы спала половина игроков.",
	]
	quest.3A3959929D0FE561.title: "Кремнёвый нож"
	quest.3A3959929D0FE561.quest_desc: [
		"Нож Farmer's Delight режет еду на доске и даёт солому с травы.",
	]
	quest.35A5856EC8806193.title: "Разделочная доска"
	quest.0881EAAFC76089B5.title: "Котелок"
	quest.0881EAAFC76089B5.quest_desc: [
		"Сытные супы и рагу восстанавливают больше и дают эффект «Питание». Котелок нужно ставить на огонь.",
	]
	quest.0F0C4C3DD4217887.title: "Горячий обед"
	quest.2EC18C6208F09BD2.title: "Рюкзак"
	quest.2EC18C6208F09BD2.quest_desc: [
		"Открывается клавишей B. Улучшения (магнит, автоплавка, фильтры) вставляются прямо в рюкзак.",
	]
	quest.58EB00CC2026161D.title: "Железо"
	quest.34312F0ACEAA9988.title: "Медь"
	quest.34312F0ACEAA9988.quest_desc: [
		"Медь понадобится тоннами: трубы, баки, корпуса, провода.",
	]
	quest.44A2090750D5E53E.title: "Цинк"
	quest.44A2090750D5E53E.quest_desc: [
		"Руда цинка — серо-зелёные крапинки, чаще всего на высоте 0–70. Из цинка и меди позже получится латунь.",
	]
	quest.7F31BD8C5EC8CCB6.title: "Найти деревню"
	quest.7F31BD8C5EC8CCB6.quest_desc: [
		"Деревни — первые союзники: торговля, кровати, сундуки. В каждой деревне стоит путевой камень Waystones.",
		" ",
		"",
		" ",
		"§6Компас исследователя (подойдёт любая):§r ChoiceTheorem's Overhauled Village: Large/village Beach, Large/village Christmas, Large/village Desert, Large/village Desert Oasis, Large/village Dark Forest; Minecraft: Равнинная деревня, Пустынная деревня, Саванная деревня, Заснеженная деревня, Таёжная деревня и ещё 61.",
	]
	quest.294D6C6083CE2ECE.title: "Путевой камень"
	quest.294D6C6083CE2ECE.quest_desc: [
		"Активируйте путевой камень правым кликом — к нему можно будет телепортироваться с любого другого камня.",
	]
	quest.0F0542C5A3CC33D1.title: "Карта и приват"
	quest.0F0542C5A3CC33D1.quest_desc: [
		"M — карта FTB Chunks. На ней можно приватить чанки команды (защита от взрывов и чужих) и ставить метки.",
	]
	quest.4BBD41D376ABCC53.title: "Следы путников"
	quest.4BBD41D376ABCC53.quest_desc: [
		"Мелкие постройки встречаются часто: лагеря, указатели, тайники снабжения, ветряки и водонапорки в стиле Create. В их сундуках бывают первые шестерни и валы.",
	]
	quest.1CC9DB28526AFC92.title: "Лошадиная сила"
	quest.1CC9DB28526AFC92.quest_desc: [
		"Привяжите лошадь поводком к лошадиному вороту — она будет ходить по кругу и крутить вал. Первая энергия без воды и ветра.",
		" ",
		"",
		" ",
		"§6Как работает:§r Конный ворот ставят на дорожку из подходящих блоков (какие лучше — покажет Ponder, клавиша W), лошадь привязывают к нему поводком, и она ходит по кругу. Вращение снимают шестернёй сбоку или валом снизу, сверху — нельзя. Мощность зависит от животного и дорожки: смотрите в Инженерных очках.",
		" ",
		"§6Зачем:§r вращение там, где нет реки и ветра, — например, для первого Жернова с мукой.",
	]
	quest.3C85E444B7B97A9C.title: "Андезитовый сплав"
	quest.3C85E444B7B97A9C.quest_desc: [
		"Андезит + железные (или цинковые) самородки. Это сердце эпохи 1: валы, шестерни, корпуса.",
		" ",
		"",
		" ",
		"§6Как работает:§r На верстаке — 2 андезита и 2 железных (или цинковых) самородка квадратом 2×2, каждый вид по диагонали: 1 сплав. Механический смешиватель над Чашей (без нагрева) тратит вдвое меньше: 1 андезит + 1 самородок = 1 сплав.",
		" ",
		"§6Зачем:§r Валы, Шестерни, Андезитовый корпус, Механический ремень — почти всё в эпохе 1. Андезит копайте впрок: его нужно много.",
	]
	quest.2BA45C1ABD28F58C.title: "Очки инженера"
	quest.2BA45C1ABD28F58C.quest_desc: [
		"Показывают скорость, нагрузку и содержимое машин при взгляде на них.",
		" ",
		"",
		" ",
		"§6Как работает:§r Наденьте на голову и смотрите на блок: у источников видна выдаваемая мощность, у машин — их нагрузка, у Стрессометра — состояние всей сети, у баков, Чаш и Жерновов — содержимое.",
		" ",
		"§6Зачем:§r главный инструмент отладки. Машина стоит — посмотрите в очках: нет вращения, мала скорость или сеть перегружена.",
	]
	quest.2CEE645358B21744.title: "Гаечный ключ"
	quest.2CEE645358B21744.quest_desc: [
		"Поворачивает блоки Create, а с Shift — быстро снимает их.",
		" ",
		"",
		" ",
		"§6Как работает:§r ПКМ по блоку Create поворачивает его вокруг грани, по которой кликнули; Shift + ПКМ мгновенно снимает блок в инвентарь. Ключом разворачивают стрелку Механической помпы и шлюз, убирают лишние валы с ремня и переносят собранные вагонетки и поезда.",
		" ",
		"§6Зачем:§r неверно поставленный блок не нужно ломать — машину правят за секунды.",
	]
	chapter.4FD73A25E2DD2973.title: "&#B5B5B5Эпоха 1. Андезит&r"
	chapter.4FD73A25E2DD2973.subtitle: "Кинетика: колёса, жернова, прессы, ремни и первые подвижные машины."
	quest.66ED7F7448F796FE.title: "Глава I. Первая шестерня"
	quest.66ED7F7448F796FE.quest_subtitle: "Письмо мастера Августа"
	quest.66ED7F7448F796FE.quest_desc: [
		"Андезитовый сплав — серый, неказистый, но из него родится всё остальное.",
		" ",
		"",
		" ",
		"Вчера я нашёл у ручья старое водяное колесо. Дерево сгнило, а ступица цела — и выточена так, как точим мы. Предтечи начинали так же, как мы. От этой мысли мне и радостно, и тревожно: где же они теперь?",
		" ",
		"",
		" ",
		"Постройте своё колесо. Пусть ручей работает на вас, а руки останутся для дела поважнее.",
		" ",
		"",
		" ",
		"— Мастер Август",
	]
	quest.6ECC7C838BBEE14E.title: "Валы и шестерни"
	quest.6ECC7C838BBEE14E.quest_desc: [
		"Вращение передаётся валами и шестернями: шестерни, стоящие рядом, крутятся в разные стороны. Наденьте очки инженера, чтобы видеть скорость.",
		" ",
		"",
		" ",
		"§6Как работает:§r Вал передаёт вращение по прямой, Шестерня — соседней шестерне сбоку, Угловая передача — за угол. Соседние шестерни крутятся в разные стороны; по валу скорость не теряется. Предел Create — 256 об/мин. Если две ветки сети крутят один вал с разной скоростью или в разные стороны, блок на стыке ломается.",
		" ",
		"§6Зачем:§r это «провода» Create: машина работает, только пока к ней подведено вращение от колеса, ветряка или Рукоятки.",
	]
	quest.4F2B32D0E388BA97.title: "Ручной привод"
	quest.4F2B32D0E388BA97.quest_desc: [
		"Первая энергия — ваши руки. Хватит, чтобы поднять ворота или провернуть пресс пару раз.",
		" ",
		"",
		" ",
		"§6Как работает:§r Удерживайте ПКМ — Рукоятка крутится (с Shift — в обратную сторону) со скоростью 32 об/мин и даёт 256 ен, пока вы держите кнопку. Крутить её — тратить голод.",
		" ",
		"§6Зачем:§r проверить новую машину до того, как построено колесо, и привод для редких действий — поднять ворота, провернуть поршень.",
	]
	quest.4F48098BE4C15E3B.title: "Водяное колесо"
	quest.4F48098BE4C15E3B.quest_desc: [
		"Поставьте колесо так, чтобы на него падала или текла вода. Несколько колёс на одном валу дают больше мощности (нагрузки), а не скорости.",
		" ",
		"",
		" ",
		"Летопись Ратибора: «Первое колесо Предтеч стояло на этом же ручье. Вода крутила его сто лет и ни разу не попросила угля».",
		" ",
		"",
		" ",
		"§6Как работает:§r Колесо крутит текущая вода рядом (падающая или бегущая): 8 об/мин и 256 ен на колесо. Больше сторон в воде мощности не прибавляют, а встречные потоки гасят друг друга; направление вращения зависит от того, куда течёт вода.",
		" ",
		"§6Зачем:§r дешёвая вечная энергия первой мастерской. 8 об/мин мало — поднимайте скорость Большой шестернёй на малую (×2 за ступень).",
	]
	quest.25BDB93253FA4E31.title: "Большое колесо"
	quest.25BDB93253FA4E31.quest_desc: [
		"Медленнее, но держит в разы больше нагрузки. Хороший центр первой мастерской.",
		" ",
		"",
		" ",
		"§6Как работает:§r 4 об/мин и 512 ен — вдвое медленнее обычного колеса, но вдвое мощнее. Достаточно воды вдоль одной стороны; больше — не прибавит.",
		" ",
		"§6Зачем:§r опорный источник для нескольких машин; скорость затем поднимают передачами.",
	]
	quest.0D33890A1ECCEE87.title: "Ветряк"
	quest.0D33890A1ECCEE87.quest_desc: [
		"Паруса крепятся к подшипнику ветряка и собираются правым кликом. Чем больше парусов, тем больше мощность — ветер есть везде.",
		" ",
		"",
		" ",
		"§6Как работает:§r Приклейте Суперклеем к Подшипнику ветряной мельницы конструкцию минимум из 8 парусных блоков (Парус, Рама паруса или любая шерсть) и нажмите ПКМ по подшипнику. Каждые 8 парусов дают 1 об/мин (не больше 16 об/мин), и каждый об/мин — 512 ен. Повторный ПКМ останавливает мельницу для правки.",
		" ",
		"§6Зачем:§r мощный источник без воды: 32 паруса — 4 об/мин и 2048 ен. Медленный вал поднимают шестернями.",
	]
	quest.4E2F08A493893CD4.title: "Передачи"
	quest.4E2F08A493893CD4.quest_desc: [
		"Соедините большую шестерню с малой — скорость изменится вдвое. Это главный способ ускорить медленное колесо.",
		" ",
		"",
		" ",
		"§6Как работает:§r Большая шестерня цепляется к малой по диагонали. Ведущая большая → ведомая малая: скорость ×2; наоборот — пополам. Две большие шестерни соединяются под прямым углом. Удвоили скорость — удвоили и нагрузку всех машин дальше по цепи.",
		" ",
		"§6Зачем:§r поднять 8 об/мин колеса до 32–64 об/мин для Механического смешивателя и быстрой обработки или замедлить тяжёлые машины.",
	]
	quest.4EFDEBDB7A6D75CA.title: "Андезитовый корпус"
	quest.4EFDEBDB7A6D75CA.quest_desc: [
		"Андезитовый сплав по обтёсанному бревну. Почти все машины эпохи строятся на корпусах.",
		" ",
		"",
		" ",
		"§6Как работает:§r ПКМ Андезитовым сплавом по обтёсанному бревну или древесине. Корпусом можно щёлкнуть по Валу или Шестерне — они окажутся в корпусе (аккуратно и безопасно).",
		" ",
		"§6Зачем:§r из корпуса делают Угловую передачу, Механический бур, Механический пресс, Вентилятор в корпусе, Депо и другие машины эпохи.",
	]
	quest.1F3C2E85AC605CB9.title: "Измерения"
	quest.1F3C2E85AC605CB9.quest_desc: [
		"Измеритель нагрузки в очках показывает, сколько мощности сети уже занято. Перегрузка останавливает всю сеть сразу.",
		" ",
		"",
		" ",
		"§6Как работает:§r Стрессометр ставят в линию вала: он показывает, какая доля мощности сети занята, а в Инженерных очках — точные ен. Мощность источников складывается; машина берёт свои ен × об/мин (Жёрнов — 4 ен на 1 об/мин, Пресс — 8). Если нагрузка превысит мощность, встаёт вся сеть («Перегрузка»), а не одна последняя машина.",
		" ",
		"§6Зачем:§r прежде чем добавить машину, посмотрите остаток мощности. При перегрузке добавьте источник, снизьте обороты тяжёлых машин или отделите их Сцеплением.",
	]
	quest.15B86A6E44F88225.title: "Жернов"
	quest.15B86A6E44F88225.quest_desc: [
		"Мелет зерно в муку, гравий в кремень, булыжник в гравий, цветы в красители. Руду жёрнов не берёт — её дробят Дробильные колёса (эпоха 2).",
		" ",
		"",
		" ",
		"§6Как работает:§r Вращение — шестернёй сбоку или валом снизу. Предметы бросьте сверху (Q) или подайте Жёлобом или шлюзом: ПКМ с пшеницей в руке их внутрь НЕ кладёт. Внутри помещается одна стопка одного вида, и мелется она по одной штуке: пшеница — 150 тиков (7,5 с) на 16 об/мин и ниже, стопка ≈ 8 минут; на 32 об/мин вдвое быстрее, на 256 — в 16 раз. Готовое остаётся внутри: ПКМ пустой рукой или шлюз сбоку / Жёлоб снизу. Когда выходные ячейки заполнены, жёрнов встаёт.",
		" ",
		"§6Зачем:§r Пшеничная мука (тесто, хлеб), кремень из гравия, гравий из булыжника, красители из цветов, сахар из тростника. Руду — только в Дробильные колёса.",
	]
	quest.54F4C46D1A02AFDB.title: "Вентилятор"
	quest.54F4C46D1A02AFDB.quest_desc: [
		"Поток воздуха толкает предметы и сущности. Сквозь воду — промывает, сквозь лаву — плавит, сквозь огонь — коптит, сквозь душевный огонь — навевает.",
		" ",
		"",
		" ",
		"§6Как работает:§r Вентилятор дует или тянет в зависимости от направления вращения; дальность растёт с оборотами — от 3 до 20 блоков (на 256 об/мин). Поставьте блок-катализатор прямо в поток: всё, что лежит за ним на земле, Ремне или Депо, обрабатывается. Скорость обработки от оборотов НЕ зависит: стопка до 16 штук — 7,5 с, 64 штуки — в четыре раза дольше.",
		" ",
		"§6Зачем:§r обработка партиями без печей: промывка, плавка, копчение, навевание. Вентилятор под или над Жёлобом поднимает предметы вверх.",
	]
	quest.389C3435AF290359.title: "Обработка потоком"
	quest.389C3435AF290359.quest_desc: [
		"Пропустите измельчённую руду через поток сквозь воду: самородки и редкие побочные металлы. Из гравия так добывают кремень и железные самородки, из красного песка — золотые.",
		" ",
		"",
		" ",
		"§6Как работает:§r Промывка — вода (источник или течение) в потоке вентилятора. Дроблёное рудное железо → 9 железных самородков и с шансом 75 % редстоун, цинк → 9 кусочков цинка; гравий → кремень (25 %) и железный самородок (12,5 %). Пока нет Дробильных колёс (эпоха 2), промывайте гравий. Частые ошибки: вода стоит не в потоке; большая стопка на земле — раскладывайте по 16 или везите Ремнём.",
		" ",
		"§6Зачем:§r самородки и побочные продукты из дроблёной руды (редстоун, кварц, глина), тесто из муки, а дальше — вся рудная фабрика.",
	]
	quest.12A6FC78202DB4C7.title: "Механический пресс"
	quest.12A6FC78202DB4C7.quest_desc: [
		"Пресс над депо или ремнём превращает слитки в листы. Листы — основа большинства рецептов Create.",
		" ",
		"",
		" ",
		"§6Как работает:§r Между прессом и Депо, Ремнём или Чашей должен быть ровно один пустой блок; вращение — валом сбоку. На Депо кладите ПКМ, предмет на Ремне пресс остановит сам. Пресс тяжёлый: 8 ен на 1 об/мин, на 64 об/мин это 512 ен — следите за Стрессометром.",
		" ",
		"§6Зачем:§r Железный, Медный, Золотой и Латунный листы для пропеллеров, Электронных ламп и Механизма точности; над Чашей — уплотнение (см. «Уплотнение»).",
	]
	quest.4384678F160BB3BD.title: "Миксер"
	quest.4384678F160BB3BD.quest_desc: [
		"Миксер над чашей смешивает ингредиенты. Рецепты с нагревом ждут горелки всполоха.",
		" ",
		"",
		" ",
		"§6Как работает:§r Чаша на полу (на Горелке всполоха, если рецепту нужен нагрев), над ней один пустой блок и смешиватель. Нужно не меньше 30 об/мин — на 8 или 16 об/мин колеса смешиватель стоит! Ингредиенты бросьте в Чашу или подайте шлюзом, жидкости — трубой. Результат выльется в Ремень, Депо или сундук, поставленный сбоку от Чаши на блок ниже, иначе останется в Чаше.",
		" ",
		"§6Зачем:§r Андезитовый сплав вдвое дешевле, тесто, шоколад, а с нагревом — Латунь и другие сплавы эпохи 2.",
	]
	quest.7BEBD608D80FB369.title: "Уплотнение"
	quest.7BEBD608D80FB369.quest_desc: [
		"Пресс над чашей уплотняет много предметов в меньшее число — например, самородки в слитки.",
		" ",
		"",
		" ",
		"§6Как работает:§r Тот же Механический пресс, но над Чашей (через один пустой блок). Он выполняет заполненные рецепты 2×2 и 3×3: 9 самородков → слиток, 4 предмета → блок. Если подходит несколько рецептов, задайте нужный фильтром на прессе. Выход — как у смешивателя: на Ремень, Депо или сундук сбоку и на блок ниже Чаши.",
		" ",
		"§6Зачем:§r самородки после промывки — в слитки, ресурсы — в блоки для склада, Основа торта всполоха, позже чугун TFMG.",
	]
	quest.4416282B085423CF.title: "Ремни"
	quest.4416282B085423CF.quest_desc: [
		"Ремень соединяет два вала и везёт предметы. Машины над ремнём обрабатывают всё, что проезжает.",
		" ",
		"",
		" ",
		"§6Как работает:§r Возьмите Механический ремень и ПКМ по двум валам на одной линии: длина 2–20 блоков, горизонтально, по диагонали или вертикально. Вращение подаётся в любой вал ремня, предметы едут быстрее на высоких оборотах; сам ремень нагрузки не создаёт. Брошенное на ремень едет; снять — ПКМ пустой рукой или шлюзом в конце.",
		" ",
		"§6Зачем:§r конвейер под Механическим прессом, Вентилятором, Дозатором и Автономным активатором — так строят линии, где предмет обрабатывается на ходу.",
	]
	quest.1098B5E64A0D1721.title: "Воронки"
	quest.1098B5E64A0D1721.quest_desc: [
		"Воронки достают предметы из сундуков и кладут их обратно. Туннели делят поток на ремне.",
		" ",
		"",
		" ",
		"§6Как работает:§r В игре воронка Create называется «Андезитовый шлюз» (не путайте с обычной воронкой). Поставленный на сундук простым кликом, он вытаскивает из него, с Shift — складывает в него; Гаечный ключ переворачивает. Андезитовый шлюз берёт по одному предмету, Латунный — до целой стопки и с фильтром. Из сундука в сундук шлюз на шлюз не работает — между ними нужен Ремень или Жёлоб.",
		" ",
		"§6Зачем:§r связь машин с сундуками: выгрузка с конца ремня, загрузка Жернова, забор готового из Депо. Андезитовый туннель делит поток на ремне.",
	]
	quest.5F94C8099C765EB1.title: "Желоба"
	quest.5F94C8099C765EB1.quest_desc: [
		"Жёлоб везёт предметы вниз сам, без вращения. Под сундуком он вытягивает из него, над сундуком или машиной — складывает в неё; брошенное сверху тоже падает внутрь. Вверх предметы поднимает Вентилятор в корпусе над или под Жёлобом. Жёлоб, приставленный к боку другого, становится наклонным.",
		" ",
		"§6Зачем:§r подача сверху в Жёрнов, Дробильные колёса и Чашу, вертикальные склады и подъёмники.",
	]
	quest.01265E4D3384E645.title: "Пила"
	quest.01265E4D3384E645.quest_desc: [
		"Пила, смотрящая вверх, режет предметы на ремне: брёвна в доски, камень в ступени.",
		" ",
		"",
		" ",
		"§6Как работает:§r Пила, повёрнутая вверх, обрабатывает предметы на себе: бросьте их сверху или пустите Ремень прямо в пилу — она работает как кусок конвейера, выход идёт против направления её вращения. Если у предмета несколько вариантов (камень → ступени, плиты), задайте нужный фильтром, иначе пила будет их чередовать. Пила, смотрящая вбок, срубает всё дерево, если срежет нижний блок ствола.",
		" ",
		"§6Зачем:§r брёвна в обтёсанные брёвна и доски, рецепты камнереза потоком; позже — ферма деревьев с Автономным активатором.",
	]
	quest.38351AA20081E7AE.title: "Насос"
	quest.38351AA20081E7AE.quest_desc: [
		"Насос гонит жидкость по трубам в сторону стрелки. Бесконечный источник воды — два ведра в яме 3×1.",
		" ",
		"",
		" ",
		"§6Как работает:§r Помпа стоит в линии Жидкостных труб и гонит жидкость по стрелке; направление вращения не важно, стрелку разворачивает Гаечный ключ. Открытый конец трубы в воде или лаве качает её; к бакам, Чашам и Дозаторам трубы подключаются сами. Дальность — до 16 блоков трубы в каждую сторону, больше оборотов — быстрее поток.",
		" ",
		"§6Зачем:§r вода для промывки, смешивателя и паровых котлов, лава для торта всполоха и Прочного листа, заливка Дозатора.",
	]
	quest.3A38D7ABE34F76A9.title: "Дозатор"
	quest.3A38D7ABE34F76A9.quest_desc: [
		"Наполняет вёдра, бутылки и наливает жидкость на предметы — пригодится в сборке по шагам и на кухне.",
		" ",
		"",
		" ",
		"§6Как работает:§r Дозатор ставят над Депо или Ремнём с одним пустым блоком между ними и заливают только трубой — вручную его не наполнить. Предмет на Депо или на Ремне сам остановится и наполнится: бутылки, вёдра и «наливные» рецепты (JEI: U по жидкости).",
		" ",
		"§6Зачем:§r сборка по шагам (Прочный лист поливают лавой), торт всполоха, еда с шоколадом и мёдом, Чай строителя.",
	]
	quest.3A9BEC7A42E89747.title: "Слив"
	quest.3A9BEC7A42E89747.quest_desc: [
		"Осушитель предметов — обратный Дозатору: ПКМ ведром или бутылкой выливает жидкость в него, а предметы, заехавшие сбоку с Ремня или шлюза (или брошенные сверху), прокатываются по нему и опустошаются. Жидкость из него забирают трубой с Механической помпой.",
		" ",
		"§6Зачем:§r перелить вёдра воды, лавы, молока в трубы и баки (в выживании бак ведром не заполнить) и вернуть пустую тару на линию.",
	]
	quest.3FFA51A73031CEC3.title: "Розовый кварц"
	quest.3FFA51A73031CEC3.quest_desc: [
		"Кварц Незера с редстоуном, затем шлифовка наждачкой. Кварц дают жители-каменщики и сундуки, а редстоун моют из гравия.",
		" ",
		"",
		" ",
		"§6Как работает:§r Розовый кварц — кварц Незера и 8 редстоуна на верстаке. Полируют Наждачной бумагой: держите кварц во второй руке и зажмите ПКМ с бумагой (или смотрите на кварц, лежащий на земле); позже это делает Автономный активатор с бумагой над Депо.",
		" ",
		"§6Зачем:§r Полированный розовый кварц + Железный лист = Электронная лампа.",
	]
	quest.7DEF708B73A8F70F.title: "Электронная лампа"
	quest.7DEF708B73A8F70F.quest_desc: [
		"Нужна для умных блоков: автономных активаторов, сборщиков, связи по редстоуну.",
		" ",
		"",
		" ",
		"§6Как работает:§r Полированный розовый кварц над Железным листом на верстаке — одна лампа. Заготовьте с десяток.",
		" ",
		"§6Зачем:§r Редстоуновый передатчик сигнала, Автономный активатор, Механический сборщик, Умная жидкостная труба и прочие «умные» блоки.",
	]
	quest.0D46A4828275B515.title: "Беспроводной редстоун"
	quest.0D46A4828275B515.quest_desc: [
		"Пара связей с одинаковыми предметами-частотами передаёт сигнал без проводов.",
		" ",
		"",
		" ",
		"§6Как работает:§r Поставьте два передатчика и вставьте в оба одинаковую пару предметов-частот (ПКМ предметом по двум слотам на блоке). Shift + ПКМ (или Гаечный ключ) переключает блок в режим приёмника. Сигнал идёт без проводов на 256 блоков.",
		" ",
		"§6Зачем:§r включать дальние линии рычагом у входа, связать Пороговый переключатель с машиной на другом конце базы, управлять с Контроллера частот.",
	]
	quest.4150C56EE4F70F6C.title: "Медный корпус"
	quest.4150C56EE4F70F6C.quest_desc: [
		"Медный слиток ПКМ по обтёсанному бревну или древесине.",
		" ",
		"§6Зачем:§r Дозатор, Осушитель предметов, Шланговая катушка и Портативный жидкостный интерфейс — вся жидкостная часть эпохи.",
	]
	quest.5ABB19465B46C3BE.title: "Водолаз"
	quest.5ABB19465B46C3BE.quest_desc: [
		"Медный баллон на спину, шлем на голову — и можно долго ходить под водой. Баллон заряжается воздухом от вращения.",
		" ",
		"",
		" ",
		"§6Как работает:§r Поставьте Медный баллон на землю и подайте вращение — он накачивается воздухом, тем быстрее, чем выше обороты. Надетый на спину, он питает Медный водолазный шлем; Медные водолазные ботинки дают ходить по дну.",
		" ",
		"§6Зачем:§r подводные шахты и стройки; тот же баллон потом питает Картофельную пушку и джетпак.",
	]
	quest.3A8C625128897260.title: "Пустая горелка всполоха"
	quest.3A8C625128897260.quest_desc: [
		"Котёл даёт нагрев чаше, без него не сделать латунь. Гореть он будет, только если поймать в него ифрита — путь лежит в Незер. Незерак для горелки ищите у разрушенных порталов: их в мире много.",
		" ",
		"",
		" ",
		"Летопись: «С пустого котла и пойманного ифрита начался наш взлёт. И наш долг огню, который мы так и не вернули».",
		" ",
		"",
		" ",
		"§6Как работает:§r ПКМ Пустой горелкой всполоха по живому всполоху (ифриту) или прямо по его спавнеру — он окажется внутри. Пустую горелку можно поджечь огнивом, но это только украшение: Чашу она не греет. Готовую горелку ставят под Чашу или под бак парового котла.",
		" ",
		"§6Зачем:§r нагрев для Латуни и других «горячих» рецептов, плавка и копчение потоком вентилятора, паровой двигатель эпохи 4.",
	]
	quest.58E29D718355BF98.title: "Жидкий опыт"
	quest.58E29D718355BF98.quest_desc: [
		"Create Enchantment Industry: механический точильный камень перемалывает самородки опыта в жидкий опыт и снимает чары с предметов. Опыт хранится в баках, как любая жидкость.",
	]
	quest.083BA56F55976BB3.title: "Силос и сосуд"
	quest.083BA56F55976BB3.quest_desc: [
		"Create Connected: дешёвые многоблочные хранилища предметов и жидкостей ещё до латуни.",
	]
	quest.4C68D34BFEDA95A1.title: "Шестисторонний редуктор"
	quest.14511258DD4ADD81.title: "Защитная муфта"
	quest.14511258DD4ADD81.quest_desc: [
		"Отключает участок сети при перегрузке, чтобы вся фабрика не вставала из-за одной машины.",
	]
	quest.0B9E71E9A52F3881.title: "Экструдер"
	quest.0B9E71E9A52F3881.quest_desc: [
		"Генератор камня без контрапций: из воды, лавы и блока-катализатора под ним делает булыжник, а с нужным катализатором — охрум, кримсит, азурит и другие камни Create.",
	]
	quest.1AFD1969F4ABE98A.title: "Гидравлический пресс"
	quest.1AFD1969F4ABE98A.quest_desc: [
		"Dreams & Desires: прессует жидкости в камень — кальцит, охрум, кримсит из лавы и «молочных коктейлей».",
	]
	quest.5962BBC27879708E.title: "Промышленный вентилятор"
	quest.5962BBC27879708E.quest_desc: [
		"Мощный вентилятор с паруса-катализаторами: шлифовка песком, заморозка и другие новые способы обработки потоком.",
	]
	quest.0CAC05FCD0F52EA0.title: "Фланцевые шестерни и цепи"
	quest.0CAC05FCD0F52EA0.quest_desc: [
		"Bits 'n' Bobs: шестерни можно соединить цепью на расстоянии — как велосипедная передача.",
	]
	quest.4287F5C47D4C3B98.title: "Первое ружьё"
	quest.4287F5C47D4C3B98.quest_desc: [
		"Create Gunsmithing: кремнёвое ружьё делается из андезита и железных листов. Подробнее — глава «Арсенал».",
	]
	quest.4079F25838407C2F.title: "Управление вращением"
	quest.4079F25838407C2F.quest_desc: [
		"Сигнал редстоуна на муфте останавливает вал, на реверсе — разворачивает его. Спидометр показывает скорость. Так любой станок включается рычагом или датчиком, а не ломанием шестерни.",
		" ",
		"",
		" ",
		"§6Как работает:§r Сцепление и Реверсивная передача ставятся в линию вала. Сигнал редстоуна на Сцеплении разрывает вал (всё после него стоит), на Реверсивной передаче — меняет направление вращения. Спидометр показывает обороты, а компаратор рядом с ним выдаёт сигнал по скорости.",
		" ",
		"§6Зачем:§r выключить цех рычагом, гонять поршень и лебёдку туда-обратно, остановить линию по датчику.",
	]
	quest.6CC52BB40B145712.title: "Цепной привод Create"
	quest.6CC52BB40B145712.quest_desc: [
		"Цепной корпус передаёт вращение вбок по линии корпусов, а регулируемый удваивает скорость по сигналу.",
		" ",
		"",
		" ",
		"§6Как работает:§r Цепные приводы в корпусе передают вращение друг другу по ряду, и все валы ряда крутятся в одну сторону; ряд можно поворачивать на 90°. Регулируемая цепная коробка передач без сигнала работает как обычный привод, а с сигналом удваивает скорость остальных приводов ряда (аналоговым сигналом — от ×1 до ×2).",
		" ",
		"§6Зачем:§r передать вращение вбок на несколько машин без шестерён и переключать скорость линии сигналом.",
	]
	quest.52EDB7614DA3BAB2.title: "Хитрые муфты"
	quest.52EDB7614DA3BAB2.quest_desc: [
		"Create Connected: центробежная муфта включается только на нужной скорости, муфта свободного хода крутит в одну сторону, тормоз останавливает сеть мгновенно.",
	]
	quest.632AEE7F419978EA.title: "Депо и катапульта"
	quest.632AEE7F419978EA.quest_desc: [
		"Депо — одиночная клетка конвейера: на нём жмёт пресс и работает автономный активатор. Катапульта бросает предметы (и игроков!) в выбранную точку — простой способ связать два цеха без ремня.",
		" ",
		"",
		" ",
		"§6Как работает:§r Депо держит одну стопку: кладите ПКМ, бросайте сверху или подавайте шлюзом и ремнём; над ним (через пустой блок) работают Пресс, Дозатор и Автономный активатор. Весовую катапульту нацеливают до установки: Shift + ПКМ ею по точке приземления (по прямой, до 32 блоков), затем ставят и дают вращение. Всё, что легло на катапульту, улетает в цель; сигнал редстоуна её блокирует.",
		" ",
		"§6Зачем:§r Депо — одиночный станок без ремня (листы по одному); катапульта перекидывает предметы между цехами и через реку — и людей тоже.",
	]
	quest.023FF6B1DA70A3B3.title: "Прыжок веры"
	quest.023FF6B1DA70A3B3.quest_desc: [
		"Пусть катапульта забросит вас дальше 30 блоков. Совет: шлем и вода в точке приземления.",
	]
	quest.2C799B52B79B667C.title: "Тоннели и фильтры"
	quest.2C799B52B79B667C.quest_desc: [
		"Тоннель над ремнём делит поток по боковым ремням поровну. Фильтр в воронке или руке пропускает только нужное.",
		" ",
		"",
		" ",
		"§6Как работает:§r Андезитовый туннель кладут на Ремень: если по бокам есть другие ремни или шлюзы, он отщепляет туда по одному предмету от каждой проходящей стопки, остальное едет дальше. Фильтр предметов: ПКМ в руке — задать список, затем ПКМ фильтром по слоту фильтра на шлюзе, туннеле, пиле или активаторе.",
		" ",
		"§6Зачем:§r раздать руду по печам, отсортировать добычу по сундукам, отделить готовое от сырья.",
	]
	quest.7F825C603FF381F6.title: "Редстоун Create"
	quest.7F825C603FF381F6.quest_desc: [
		"Контакты срабатывают при встрече двух машин, аналоговый рычаг даёт силу 0–15, защёлка и импульсы заменяют громоздкие схемы.",
		" ",
		"",
		" ",
		"§6Как работает:§r Два Редстоуновых контакта лицом к лицу дают сигнал — даже если один из них едет на подвижной машине. Аналоговый рычаг: ПКМ прибавляет силу сигнала, Shift + ПКМ убавляет (0–15). Редстоуновый повторитель импульса выдаёт короткий импульс с задержкой до часа (колесо мыши по панели). Редстоуновый триггер включается сигналом сзади и выключается сигналом сбоку.",
		" ",
		"§6Зачем:§r остановить поршень или каретку в крайней точке, точная сила сигнала, таймеры и защёлки без громоздких схем.",
	]
	quest.331A908A7569EB7C.title: "Сильный ветер"
	quest.331A908A7569EB7C.quest_desc: [
		"Соберите ветряк максимальной мощности — нужно много парусов. Сравните выдачу на стрессометре с водяными колёсами.",
		" ",
		"",
		" ",
		"§6Как работает:§r Предел — 16 об/мин, для этого нужно 128 парусных блоков (шерсть тоже считается). Такая мельница даёт 16 × 512 = 8192 ен.",
		" ",
		"§6Зачем:§r один ветряк тянет целый ряд прессов и смешивателей; сравните на Стрессометре с водяными колёсами.",
	]
	quest.38FA369CC3B7EB77.title: "Шланговый шкив"
	quest.38FA369CC3B7EB77.quest_desc: [
		"Опускает шланг в озеро и выкачивает или заливает его целиком. Бесконечным считается водоём (вода или лава) от 10 000 блоков.",
		" ",
		"",
		" ",
		"§6Как работает:§r Шланг опускается, пока катушка вращается, и сматывается при обратном вращении. С другой стороны подключите трубу с Механической помпой: помпа, тянущая от катушки, осушает водоём, толкающая к ней — заливает. Скорость зависит только от помпы и труб.",
		" ",
		"§6Зачем:§r осушить озеро под стройку, бесконечная вода для котлов и промывки, лава для торта всполоха и Прочного листа.",
	]
	quest.42B904A00EDF1DDD.title: "Насос мантии"
	quest.42B904A00EDF1DDD.quest_desc: [
		"Большое лавовое озеро (10 000 блоков и больше) считается бесконечным. Это топливо для котлов и экструдеров навсегда.",
	]
	quest.1B0289C7F9F33F57.title: "Призрачный колокол"
	quest.1B0289C7F9F33F57.quest_desc: [
		"Обработайте колокол потоком сквозь огонь душ. Его звон подсвечивает места, где ночью появятся мобы, — проверка освещения базы.",
		" ",
		"",
		" ",
		"§6Как работает:§r Нужен Особенный колокол (рецепт — в JEI) и поток вентилятора сквозь огонь душ: огонь на песке душ, костёр душ или подожжённая пустая горелка с «душевным» пламенем. Колокол, лежащий в потоке, станет Призрачным.",
		" ",
		"§6Зачем:§r ПКМ колоколом подсвечивает места, где могут появиться мобы, — проверка освещения базы. Другие рецепты навевания — в JEI.",
	]
	quest.12D3D6A2419141C8.title: "Сменные катализаторы"
	quest.12D3D6A2419141C8.quest_desc: [
		"Create Connected: катализатор встаёт перед вентилятором вместо воды или огня. Обработка без луж и костров, а режим меняется заменой одного блока.",
	]
	quest.7CEC8A7AB17E666B.title: "Угловая передача"
	quest.7CEC8A7AB17E666B.quest_desc: [
		"Угловая передача раздаёт вращение на все четыре стороны вокруг своей оси: прямой выход крутится в обратную сторону, боковые — зеркально. Скорость она не меняет. Вертикальная угловая передача — та же, только повёрнута; одна превращается в другую на верстаке.",
		" ",
		"§6Зачем:§r повернуть вал за угол или раздать вращение на 3–4 машины из одной точки без лишних шестерён.",
	]
	quest.0C01697C66F250F2.title: "Механический бур"
	quest.0C01697C66F250F2.quest_desc: [
		"Бур ломает блок прямо перед собой, пока вращается, быстрее — на высоких оборотах (4 ен на 1 об/мин). Добытое выпадает на землю: подставьте шлюз или Ремень. Классика: бур перед местом, где вода встречается с лавой, — бесконечный булыжник.",
		" ",
		"§6Зачем:§r булыжник для Жернова (гравий, затем кремень) и стройки; на подвижной машине — туннели и карьеры.",
	]
	quest.5991EF0C713904DB.title: "Трубы и вентиль"
	quest.5991EF0C713904DB.quest_desc: [
		"Жидкостные трубы соединяются сами; Гаечный ключ делает из прямого участка трубу с окошком (она перестаёт цепляться к соседним трубам), а Медный корпус прячет трубу и фиксирует её соединения. Жидкостный вентиль ставят в линию трубы: вращение в одну сторону его открывает, в обратную — закрывает. Сам по себе поток идёт только от Механической помпы.",
		" ",
		"§6Зачем:§r подвести воду к смешивателю и котлам, лаву — к Дозатору; перекрыть линию вентилем без разборки.",
	]
	quest.7A6C07F193B2B8EB.title: "Жидкостный бак"
	quest.7A6C07F193B2B8EB.quest_desc: [
		"Баки, поставленные рядом или друг на друга, сливаются в один (до 3×3 в ширину и до 32 в высоту), каждый блок держит 8 вёдер. В выживании ведро в бак не выльешь и не наберёшь — только трубы, Осушитель предметов, Дозатор или Чаша. Компаратор у бака показывает заполнение.",
		" ",
		"§6Зачем:§r запас воды и лавы для линии, а в эпохе 4 — котёл парового двигателя.",
	]
	quest.4B2AE3C4FD574B4C.title: "Мука и тесто"
	quest.4B2AE3C4FD574B4C.quest_desc: [
		"Пшеница в Жернове — Пшеничная мука (1 и с шансом ещё 2, в среднем 1,5). Тесто: мука и ведро воды на верстаке, мука в потоке вентилятора сквозь воду или Механический смешиватель с водой. Тесто в печи, коптильне или на костре становится хлебом.",
		" ",
		"§6Зачем:§r хлеб автоматом для всей гильдии и тесто для кухни и сладостей.",
	]
	quest.5C2D893952034C06.title: "Ферма деревьев"
	quest.5C2D893952034C06.quest_desc: [
		"Удобрение для деревьев (цветы, коралл и костная мука) сразу выращивает дерево из саженца, даже в тесноте. Механическая пила, смотрящая вбок на ствол, срубает всё дерево, если срежет нижний блок.",
		" ",
		"§6Зачем:§r брёвна для корпусов и досок без топора; с Автономным активатором эпохи 2, который сажает саженцы, ферма станет полностью автоматической.",
	]
	quest.51165BC26A85E13E.title: "Планшет"
	quest.51165BC26A85E13E.quest_desc: [
		"ПКМ открывает список дел с галочками, Shift + ПКМ вешает планшет на стену. Главное: ПКМ планшетом по машине копирует её настройки (фильтры, режимы), ЛКМ по другой — вставляет их. Исписанный планшет выводит текст на Табло и Газоразрядные индикаторы.",
		" ",
		"§6Зачем:§r настроить десяток одинаковых шлюзов за секунды, оставить друзьям записку у машины, подписать склад.",
	]
	quest.15B7943139D7496B.title: "Чертёж рецепта"
	quest.15B7943139D7496B.quest_desc: [
		"Чертёж (картина + верстак) вешают на стену; ПКМ по пустой клетке открывает меню, где задают рецепт. ПКМ по настроенной клетке собирает предмет из ингредиентов в вашем инвентаре, с Shift — до целой стопки.",
		" ",
		"§6Зачем:§r быстро крафтить сотни валов, шестерён и ремней для стройки цеха.",
	]
	quest.26A422EF2B054EE6.title: "Ящик для инструментов"
	quest.26A422EF2B054EE6.quest_desc: [
		"Ящик держит много предметов 8 разных видов и, если его сломать, сохраняет содержимое. Поставьте его в мастерской: игроки рядом достают из него вещи, удерживая клавишу ящика (по умолчанию Alt), не подходя к нему.",
		" ",
		"§6Зачем:§r Гаечный ключ, Инженерные очки, клей и фильтры всегда под рукой на стройке, а инвентарь свободен.",
	]
	chapter.54375765B865CB39.title: "&#B5B5B5Эпоха 1. Машины в движении&r"
	chapter.54375765B865CB39.subtitle: "Поршни, подшипники, шкивы, вагонеточные машины и строительная пушка — всё, что движется и строит само."
	quest.7EB3C3C4A1DFF233.title: "Суперклей"
	quest.7EB3C3C4A1DFF233.quest_desc: [
		"Склеенные блоки двигаются вместе, когда их тянет поршень или крутит подшипник. Это основа всех подвижных машин.",
		" ",
		"",
		" ",
		"§6Как работает:§r Суперклей: ПКМ по двум углам — получится склеенная область (рамка), всё внутри неё двигается вместе. Удалить область — ударить по ней (ЛКМ) с клеем в руке. Блоки, которые держатся на других (факелы, рычаги), клея обычно не требуют.",
		" ",
		"§6Зачем:§r собрать конструкцию для поршня, Механического вращателя, лебёдки, вагона поезда или корабля.",
	]
	quest.01C986BA577293FD.title: "Подвижная машина"
	quest.01C986BA577293FD.quest_desc: [
		"Соберите контрапцию с дрелями, пилами или жатками: механический поршень или подшипник двигает её, а инструменты работают на ходу. Так делаются шахтные буры и фермы деревьев.",
		" ",
		"",
		" ",
		"§6Как работает:§r Склейте Механический бур, Механическую пилу или Механический комбайн с конструкцией и двигайте её поршнем, Механическим вращателем, Верёвочной лебёдкой или Кареткой линейного привода — инструменты работают на ходу. Добыча складывается в сундуки и бочки на самой машине, а если их нет — выпадает на землю. Одна машина двигает до 2048 блоков.",
		" ",
		"§6Зачем:§r проходческий бур, карьер, ферма деревьев и полей без ручной работы.",
	]
	quest.0FE63BEC8FE0FB9E.title: "Механическая ферма"
	quest.0FE63BEC8FE0FB9E.quest_desc: [
		"Жатка на подвижной машине собирает урожай и оставляет корни. Плуг рыхлит землю.",
		" ",
		"",
		" ",
		"§6Как работает:§r Механический комбайн работает только на движущейся машине: срезает спелый урожай и сам пересаживает его, незрелое не трогает. Механический плуг на ходу ломает траву и прочие «мягкие» блоки и вспахивает землю в грядки. Гоняйте их поршнем или вагонеткой над полем; урожай — в сундук на машине.",
		" ",
		"§6Зачем:§r автоматическая ферма пшеницы (мука и хлеб), картофеля и тростника без жителей.",
	]
	quest.534FF1B5D6814DCC.title: "Поршни и подшипники"
	quest.534FF1B5D6814DCC.quest_desc: [
		"Механический поршень двигает приклеенную конструкцию по прямой, подшипник — вращает. Это основа ворот, лифтов, ветряков и буров.",
		" ",
		"",
		" ",
		"§6Как работает:§r Поршень двигает приклеенную к нему конструкцию; без Удлинителей поршня, поставленных за ним в линию, он вообще не сдвинется — их число и есть длина хода (до 64). Направление хода задаёт направление вращения (меняйте Реверсивной передачей). Липкий поршень тянет конструкцию и назад. Механический вращатель крутит конструкцию перед собой, пока на него идёт вращение.",
		" ",
		"§6Зачем:§r ворота, лифты, разводные мосты, буры-тоннелепроходчики, карусели.",
	]
	quest.57355E960A7D739C.title: "Верёвочный шкив"
	quest.57355E960A7D739C.quest_desc: [
		"Опускает и поднимает конструкцию по вертикали: шахтный лифт или бур, который сам уходит вниз.",
		" ",
		"",
		" ",
		"§6Как работает:§r Лебёдка опускает приклеенную под ней конструкцию, пока крутится в одну сторону, и поднимает при обратном вращении; канат до 384 блоков. Скорость хода растёт с оборотами; остановить на нужной высоте помогают Сцепление и Редстоуновый контакт.",
		" ",
		"§6Зачем:§r шахтный лифт, бур, уходящий вниз слой за слоем, грузовой подъёмник.",
	]
	quest.1C371232E7002E70.title: "Верёвка в бездну"
	quest.1C371232E7002E70.quest_desc: [
		"Опустите шкив глубже 200 блоков. С новыми высотами мира это шахта от неба до бездны.",
	]
	quest.599D8A0525C64B63.title: "Козловой кран"
	quest.599D8A0525C64B63.quest_desc: [
		"Каретка ездит по вращающемуся валу, а на ней — бур, автономный активатор или ещё одна каретка. Так строят «принтеры» блоков и карьеры.",
		" ",
		"",
		" ",
		"§6Как работает:§r Вал линейного привода крутят как обычный вал, а Каретка, поставленная на него, едет вдоль вала; направление меняют направлением вращения. Приклейте к каретке бур или Автономный активатор; каретка на каретке даёт движение по второй оси.",
		" ",
		"§6Зачем:§r «принтеры» блоков, карьеры с проходом по рядам, точные манипуляторы.",
	]
	quest.7FD89700AC38E9C4.title: "Шасси и липучка"
	quest.7FD89700AC38E9C4.quest_desc: [
		"Шасси захватывает блоки вокруг себя без клея, липучка цепляет и отпускает конструкцию по сигналу — для стыкуемых машин.",
		" ",
		"",
		" ",
		"§6Как работает:§r Шасси цепляет блоки без клея: ПКМ шаром слизи делает его сторону липкой. Радиальное шасси захватывает все блоки своего слоя в радиусе (Гаечный ключ задаёт радиус, до 16), Линейное — ряд блоков перед липким торцом. Блок-липучка по сигналу редстоуна прилипает к блоку перед собой или отпускает его.",
		" ",
		"§6Зачем:§r большие буры и стыкуемые машины, которые оставляют или подхватывают часть себя по сигналу.",
	]
	quest.0C96E1CE909DE153.title: "Вагонеточные машины"
	quest.0C96E1CE909DE153.quest_desc: [
		"Сборщик на рельсах превращает конструкцию в вагонетку: комбайн, бур или передвижной склад ещё до поездов. Сцепка соединяет две вагонетки.",
		" ",
		"",
		" ",
		"§6Как работает:§r Вагонеточный сборщик ставят в линию рельсов: вагонетка, проезжающая по нему при сигнале редстоуна, увозит приклеенную к нему конструкцию, а без сигнала — разбирает её обратно в блоки. Гаечным ключом по вагонетке-машине её можно взять и перенести. Вагонеточная сцепка (ПКМ по двум вагонеткам) соединяет вагонетки.",
		" ",
		"§6Зачем:§r передвижные буры, комбайны и склады по обычным рельсам — ещё до поездов.",
	]
	quest.32065E63E920021A.title: "Обмен на ходу"
	quest.32065E63E920021A.quest_desc: [
		"Два интерфейса — на машине и на станции — перегружают предметы, когда машина проезжает мимо. Так комбайн сам разгружается.",
		" ",
		"",
		" ",
		"§6Как работает:§r Один интерфейс — на машине, второй — неподвижный, лицом к нему через 1–2 пустых блока. Когда машина проезжает мимо, они соединяются, и неподвижный интерфейс видит все сундуки машины: шлюз или Жёлоб на нём выгружает или загружает их. Машина стоит, пока идёт обмен, и уезжает, когда он закончился.",
		" ",
		"§6Зачем:§r комбайн сам сдаёт урожай на склад, поезд сам грузит руду.",
	]
	quest.5BF049DE782F4C66.title: "Пульт инструментов"
	quest.5BF049DE782F4C66.quest_desc: [
		"Включает и выключает свёрла, плуги и пилы на ходу машины, не разбирая её.",
		" ",
		"",
		" ",
		"§6Как работает:§r Поставьте Контроллер штуковины на машину: ПКМ по нему на ходу включает или выключает её инструменты. Фильтр в нём выбирает, какие именно (буры, пилы, плуги); если при сборке на контроллер подан сигнал, они стартуют выключенными.",
		" ",
		"§6Зачем:§r проехать по базе с буром и ничего не сломать, включать путеукладчик только на нужном участке.",
	]
	quest.51C301CBCAABE24C.title: "Жидкости в пути"
	quest.51C301CBCAABE24C.quest_desc: [
		"Как интерфейс для предметов, только для баков: заправка цистерн и машин на ходу.",
		" ",
		"",
		" ",
		"§6Как работает:§r Работает как Портативный складской интерфейс, только с баками машины: пара интерфейсов через 1–2 блока, у неподвижного — труба с Механической помпой.",
		" ",
		"§6Зачем:§r заправка поездов и кораблей топливом, вывоз жидкостей с нефтекачалок.",
	]
	quest.313D0A817054FF8A.title: "Схемы и строительная пушка"
	quest.313D0A817054FF8A.quest_desc: [
		"Пустая схема и Схема-и-Перо сохраняют постройку, стол записывает её, а строительная пушка строит сама — из сундука рядом. Делитесь заводами с друзьями: файл схемы лежит в папке schematics.",
		" ",
		"",
		" ",
		"§6Как работает:§r Схематикой и пером выделите два угла постройки и сохраните её (файл ляжет в папку schematics). На Схематичном столе файл записывается на Пустую схематику; её вставляют в Строительную пушку и ставят голограмму на место. Пушке нужен порох как топливо и блоки в сундуке рядом; Складской тикер позже сам закажет недостающие.",
		" ",
		"§6Зачем:§r копировать удачные цеха, строить большие проекты без ручной кладки, делиться заводами с гильдией.",
	]
	quest.4631C44D350E97EE.title: "Узорные схемы"
	quest.4631C44D350E97EE.quest_desc: [
		"Сохраняет кусок постройки как повторяющийся узор — строительная пушка потом проложит его хоть на километр (дороги, насыпи под рельсы).",
	]
	quest.11963E3650F1D205.title: "Копикаты"
	quest.11963E3650F1D205.quest_desc: [
		"Copycats+: блоки из цинка, которые принимают вид любого блока — склоны, ступени, даже работающие шестерни и трубы.",
	]
	quest.451B49335CEE6F97.title: "Эскалатор"
	quest.6A32F8546E8A7A10.title: "Линейное шасси"
	quest.6A32F8546E8A7A10.quest_desc: [
		"Линейные шасси одной ориентации, стоящие рядом, двигаются вместе. Открытый торец делают липким шаром слизи — он захватывает линию блоков перед собой; длину задают Гаечным ключом (с Ctrl — сразу всем). К боковым сторонам блоки цепляют Суперклеем.",
		" ",
		"§6Зачем:§r широкий бур или комбайн без горы клея: ряд шасси с бурами — проходческий щит.",
	]
	chapter.7CA4022CCA953A46.title: "&#E9C46AЭпоха 2. Незер и латунь&r"
	chapter.7CA4022CCA953A46.subtitle: "Горелка всполоха, латунь, сборка по шагам и умная автоматизация."
	quest.21255BCC44ED797D.title: "Глава II. Огонь из-под земли"
	quest.21255BCC44ED797D.quest_subtitle: "Письмо мастера Августа"
	quest.21255BCC44ED797D.quest_desc: [
		"Латунь не возьмёшь из руды: медь и цинк надо смешать в жару, какой не даст ни одна печь. Нужен живой огонь — ифриты Незера.",
		" ",
		"",
		" ",
		"Страницы летописи говорят, что Предтечи первыми научились держать ифритов в котлах, и с этого началось их величие. И их беда: самого сильного огненного стража, Игниса, они так и не смогли укротить.",
		" ",
		"",
		" ",
		"Идите в Незер с бронёй, зельями огнестойкости и другом. Поймайте ифрита — и мастерская станет заводом.",
		" ",
		"",
		" ",
		"— Мастер Август",
	]
	quest.0212EF427C731405.title: "В Незер"
	quest.0212EF427C731405.quest_desc: [
		"Возьмите огнестойкость и поставьте путевой камень у портала — возвращаться придётся часто.",
	]
	quest.38C48BE48BF9EED8.title: "Крепость и ифриты"
	quest.38C48BE48BF9EED8.quest_desc: [
		"Ифриты живут в крепостях Незера. YUNG's сделал крепости больше и опаснее — идите группой.",
	]
	quest.6E0A417E075574BC.title: "Пойманный ифрит"
	quest.6E0A417E075574BC.quest_desc: [
		"Пустой котёл правым кликом по ифриту — и он внутри. Кормите котёл углём или брёвнами, а лучше подавайте топливо механической рукой.",
		" ",
		"",
		" ",
		"§6Как работает:§r Горелка греет только Чашу прямо над собой (и бак парового котла). Кормите её ПКМ любым топливом — углём, брёвнами, досками: пламя станет «нагретым»; Торт всполоха даёт на время сверхнагрев. Без топлива всполох лишь тлеет, и «горячие» рецепты не идут. В потоке вентилятора голодная горелка коптит, сытая — плавит.",
		" ",
		"§6Зачем:§r Латунь и все рецепты с нагревом, плавка потоком без лавы, паровой двигатель эпохи 4.",
	]
	quest.09D2A077FB7FD8DA.title: "Кварц"
	quest.2C8F1AF81F0DCA24.title: "Латунь"
	quest.2C8F1AF81F0DCA24.quest_desc: [
		"Медь + цинк в миксере над чашей с горящим котлом. Латунь открывает «умную» часть Create и первые корабли.",
		" ",
		"",
		" ",
		"Летопись: «Латунь дала нам руки быстрее человеческих. Через год мы забыли, как работать своими».",
		" ",
		"",
		" ",
		"§6Как работает:§r Медный и цинковый слитки в Чашу на горящей Горелке всполоха, сверху через блок — Механический смешиватель на 30+ об/мин: выходит 2 Латунных слитка. Частые ошибки: горелка без топлива, смешиватель медленнее 30 об/мин, нет носика — поставьте Ремень или Депо сбоку от Чаши на блок ниже.",
		" ",
		"§6Зачем:§r Латунный корпус, Механический сборщик, Латунный шлюз и туннель, Механизм точности — вся «умная» часть Create.",
	]
	quest.2741FB41F86956F1.title: "Латунный корпус"
	quest.2741FB41F86956F1.quest_desc: [
		"Латунный слиток ПКМ по обтёсанному бревну или древесине.",
		" ",
		"§6Зачем:§r Механический сборщик, Механическая рука, Железнодорожный корпус и другие латунные машины.",
	]
	quest.09F002BF6428A02A.title: "Механический сборщик"
	quest.09F002BF6428A02A.quest_desc: [
		"Сборщики ставятся сеткой, стрелки направляют предметы к последнему. Делают рецепты больше 3×3 — генераторы, буры, джетпаки.",
		" ",
		"",
		" ",
		"§6Как работает:§r Поставьте сборщики сеткой по форме рецепта (как в JEI) и Гаечным ключом поверните стрелки так, чтобы все пути сходились к одному выходу; результат ляжет в сундук, Депо или Ремень у выхода. Предметы кладут ПКМ по лицевой стороне или шлюзами; пустые клетки рецепта закрывают Заглушкой слота сборщика. Если рецепт заполняет не всю сетку, запустите сборку импульсом редстоуна.",
		" ",
		"§6Зачем:§r рецепты больше 3×3: Дробильные колёса, Генератор переменного тока, джетпаки, большие детали аддонов.",
	]
	quest.017C54E1DE685462.title: "Автономный активатор"
	quest.017C54E1DE685462.quest_desc: [
		"Делает то же, что игрок с предметом в руке: ставит, использует, бьёт, режет. Основа сборочных линий.",
		" ",
		"",
		" ",
		"§6Как работает:§r Активатор действует на клетку в двух блоках перед собой (ближняя ему не мешает). Дайте ему предмет ПКМ по лицевой стороне или подайте шлюзом; Гаечный ключ переключает режим ПКМ / ЛКМ. Повёрнутый вниз над Депо или Ремнём (через пустой блок), он применяет предмет к лежащему там: ставит шестерню на заготовку, полирует наждачкой.",
		" ",
		"§6Зачем:§r сборка по шагам (Механизм точности, рельсы), посадка саженцев на ферме деревьев, кормление Горелки всполоха, автоматический бой и сбор.",
	]
	quest.22DEBD5AC32E1906.title: "Сборка по шагам"
	quest.22DEBD5AC32E1906.quest_desc: [
		"Предмет едет по ремню под автономными активаторами, прессом и дозатором и после нужного числа кругов становится готовой деталью. JEI показывает порядок шагов. Начните собирать механизм точности — он понадобится в эпохе 4.",
		" ",
		"",
		" ",
		"Летопись: «Сборку по шагам придумал мой брат: машина повторяет движения мастера. Мастера потом стали не нужны — и это была наша вина, не машины».",
		" ",
		"",
		" ",
		"§6Как работает:§r Заготовка едет по Ремню под машинами в порядке шагов из JEI и возвращается к началу, пока не пройдёт все круги. Механизм точности: Золотой лист, 5 кругов по три Автономных активатора (Шестерня, Большая шестерня, железный самородок); выходит около 80 %, остальное — запчасти (лист, шестерни, сплав). Замкните ремень в петлю или возвращайте заготовку Механической рукой.",
		" ",
		"§6Зачем:§r Механизм точности (руки, поезда, корабли эпохи 4), Прочный лист, рельсы — всё сложное в Create делается так.",
	]
	quest.4DD982119AD237B9.title: "Умная логистика"
	quest.4DD982119AD237B9.quest_desc: [
		"Латунные воронки и туннели умеют фильтровать и делить поток поровну — сортировка без сундуков.",
		" ",
		"",
		" ",
		"§6Как работает:§r Латунный шлюз берёт до целой стопки за раз (количество — колесом мыши по панели) и пропускает только то, что в его фильтре. Латунный туннель имеет фильтр на каждой стороне и режимы раздачи (поровну, по кругу, ближайший); туннели на соседних ремнях работают как одна группа. Умный жёлоб — Жёлоб с фильтром и размером порции; сигнал редстоуна его останавливает.",
		" ",
		"§6Зачем:§r сортировка руды и добычи по сундукам, ровная раздача по печам и сборщикам, точная подача ингредиентов.",
	]
	quest.7EB137A15A34CA8A.title: "Дробильные колёса"
	quest.7EB137A15A34CA8A.quest_desc: [
		"Быстрее жернова и дают больше побочных продуктов — сердце рудной фабрики.",
		" ",
		"",
		" ",
		"§6Как работает:§r Два колеса ставят через один пустой блок на параллельных осях и крутят навстречу друг другу, чтобы сверху затягивало. Бросьте предметы сверху или подайте Жёлобом: колёса берут сразу всю стопку, готовое сыплется вниз — подставьте Ремень, Жёлоб или сундук. Каждое колесо — 8 ен на 1 об/мин: пара на 128 об/мин съедает 2048 ен. Рецепты Жернова колёса тоже делают.",
		" ",
		"§6Зачем:§r дробление руды (блок руды → 1,75 дроблёной, блок сырой руды → 9) с опытом и побочными металлами, Незераковая мука, Обсидиановый порошок, песок из гравия.",
	]
	quest.3AADC189D9D3C63C.title: "Огненный торт"
	quest.3AADC189D9D3C63C.quest_desc: [
		"Разогревает котёл до сверхнагрева — нужен для лучших сплавов и алмазов из графита.",
		" ",
		"",
		" ",
		"§6Как работает:§r Незерак в Дробильных колёсах → Незераковая мука; яйцо + сахар + мука под Механическим прессом над Чашей → Основа торта всполоха; Дозатор поливает её 250 мВ лавы → Торт всполоха. ПКМ тортом по горелке даёт сверхнагрев на время.",
		" ",
		"§6Зачем:§r рецепты со «сверхнагревом» в JEI и вдвое больше тепла для парового котла (2 уровня нагрева вместо 1).",
	]
	quest.02B2AF48CD21AAC5.title: "Кочегар"
	quest.02B2AF48CD21AAC5.quest_desc: [
		"Механическая рука сама подкладывает топливо в котёл (рука появится вместе с механизмом точности).",
	]
	quest.0BCBB280684C68BA.title: "Сборщик физики"
	quest.0BCBB280684C68BA.quest_desc: [
		"Превращает постройку в физический объект: машину, лодку, воздушный шар или корабль. Дальше — глава «Небо».",
	]
	quest.3C50FBC27A835777.title: "Штурвал"
	quest.40503799A0A423E9.title: "Воздушный шар"
	quest.40503799A0A423E9.quest_desc: [
		"Горелка нагревает воздух в оболочке — простой летательный аппарат без пропеллеров.",
		" ",
		"",
		" ",
		"Награда за воздушный шар — в главе «Небо: корабли и джетпаки» (квест «Воздушный шар»).",
	]
	quest.76D4E2534E658833.title: "Гиперпетли"
	quest.76D4E2534E658833.quest_desc: [
		"Пневмотрубы для игроков: заходите во вход и летите по трубе до выхода. Быстрый транспорт внутри базы.",
	]
	quest.3E5DB1CBC2E87723.title: "Расплавленный металл"
	quest.3E5DB1CBC2E87723.quest_desc: [
		"Create: Metalwork: миксер с нагревом плавит руду и слитки, пресс над чашей отливает их обратно. Расплав возят по трубам и разливают в формы.",
	]
	quest.53BE8C9A41875B8F.title: "Огненный зачарователь"
	quest.53BE8C9A41875B8F.quest_desc: [
		"Горелка всполоха, кормленный жидким опытом, зачаровывает предметы на ремне — выбранные чары, без случайностей.",
	]
	quest.5373F9D80574BB87.title: "Огненная кузня"
	quest.5373F9D80574BB87.quest_desc: [
		"Автоматическая наковальня: соединяет чары, снимает и переносит их через шаблоны.",
	]
	quest.4BA257241455E208.title: "Печатный станок"
	quest.4BA257241455E208.quest_desc: [
		"Копирует книги и зачарованные книги за опыт, переименовывает предметы. Позже — перепечатывает адреса на посылках.",
	]
	quest.2E77D291260458A8.title: "Зачарованные машины"
	quest.2E77D291260458A8.quest_desc: [
		"Create Enchantable Machinery: дрели, пилы, жатки и дробилки принимают чары — «Удача» на дрели даёт больше руды, «Шёлковое касание» — блоки целиком.",
	]
	quest.63072E52E756743B.title: "Латунный редуктор"
	quest.630644A731842D3C.title: "Катализатор плавки"
	quest.630644A731842D3C.quest_desc: [
		"Вентилятор плавит предметы без открытой лавы рядом с базой.",
	]
	quest.4F4340E840565303.title: "Кипение"
	quest.4F4340E840565303.quest_desc: [
		"Dreams & Desires: поток сквозь перегретую горелку всполоха — новый способ обработки, например уголь в алмазные осколки.",
	]
	quest.31FA8CAD5BBCABD7.title: "Умная воронка"
	quest.56DCFE856A54DE1B.title: "Очищенное сияние"
	quest.56DCFE856A54DE1B.quest_desc: [
		"Create More Features: светящийся материал из светокамня и порошка обсидиана — для лучших инструментов и корпусов.",
	]
	quest.767F7D02C450CD1F.title: "Загрузчик чанков"
	quest.767F7D02C450CD1F.quest_desc: [
		"Create Power Loader: пустой загрузчик ловит гаста, после этого он держит чанк загруженным, пока вращается. Фабрики работают, даже когда вас нет рядом.",
		" ",
		"",
		" ",
		"§6Как работает:§r ПКМ пустым андезитовым загрузчиком по гасту — гаст окажется внутри. Поставьте загрузчик и подайте вращение: пока он крутится, чанк загружен; встало вращение — чанк выгружается.",
		" ",
		"§6Зачем:§r фабрика работает, пока вас нет рядом. Правило сервера: один статичный загрузчик на человека (см. «Сервер без лагов»).",
	]
	quest.424855176498ACCE.title: "Шлем с очками"
	quest.424855176498ACCE.quest_desc: [
		"Create Goggles: очки инженера встраиваются в любой шлем, баллон — в нагрудник. Больше не нужно выбирать между бронёй и очками.",
	]
	quest.4B5250A8B6E15D61.title: "Карты доступа"
	quest.4B5250A8B6E15D61.quest_desc: [
		"Create: Things and Misc — пресс карт и считыватель: двери базы, которые открываются только своей картой.",
	]
	quest.03A88E9E1A38677A.title: "Органы"
	quest.03A88E9E1A38677A.quest_desc: [
		"Sound of Steam: настоящий духовой орган на воздухе из паровых систем. Играется клавиатурой или перфолентой.",
	]
	quest.4EE3BBA648021077.title: "Табло и экраны"
	quest.4EE3BBA648021077.quest_desc: [
		"Передатчик информации читает данные с машины, склада или станции и выводит их на никси-лампы, табло или таблички. Показывайте запасы склада у входа.",
		" ",
		"",
		" ",
		"§6Как работает:§r Сначала ПКМ Передатчиком информации по табло или индикатору, затем поставьте его на блок-источник (склад, станцию, Стрессометр) и в меню выберите, что выводить. Табло работает только при вращении; Газоразрядный индикатор без передатчика просто показывает силу редстоуна, а с исписанным Планшетом — текст.",
		" ",
		"§6Зачем:§r запасы склада у входа, расписание поездов на станции, нагрузка сети на пульте инженера.",
	]
	quest.78693900B9C38AD7.title: "Датчики склада"
	quest.78693900B9C38AD7.quest_desc: [
		"Умный наблюдатель видит, что едет по ремню или лежит в сундуке. Пороговый переключатель включает линию, когда склад пустеет, и выключает, когда полон.",
		" ",
		"",
		" ",
		"§6Как работает:§r Умный наблюдатель с фильтром даёт сигнал, когда перед ним проезжает или лежит в сундуке нужный предмет. Пороговый переключатель ставят на сундук или хранилище и задают два порога: сигнал включается при одном заполнении и гаснет при другом.",
		" ",
		"§6Зачем:§r остановить линию, когда склад полон, и запустить, когда пустеет; считать продукцию; сортировать по сигналу.",
	]
	quest.7A09D27E6554F0C5.title: "Программируемый редуктор"
	quest.7A09D27E6554F0C5.quest_desc: [
		"Выполняет программу: повернуть на 90°, подождать, вернуться. Для дверей, ворот и механизмов с точным ходом.",
		" ",
		"",
		" ",
		"§6Как работает:§r ПКМ открывает список команд: повернуть на угол, сдвинуть поршень на N блоков, подождать. По сигналу редстоуна коробка прогоняет программу один раз и ждёт следующего сигнала; компаратор читает, на каком она шаге.",
		" ",
		"§6Зачем:§r ворота и мосты, которые открываются на точное расстояние, поворотные платформы, станки с циклом.",
	]
	quest.0977AF04472AFBA2.title: "Лифт"
	quest.0977AF04472AFBA2.quest_desc: [
		"Лифтовый шкив с контактами на этажах: кабина сама останавливается на нужном этаже, а этажи подписываются на табло.",
		" ",
		"",
		" ",
		"§6Как работает:§r Соберите кабину под Лифтовой лебёдкой и приклейте к ней Редстоуновый контакт; на каждом этаже поставьте в той же вертикали неподвижный Редстоуновый контакт лицом к кабине. При сборке (вращение подано, ПКМ по лебёдке) все контакты этого столба сами станут Лифтовыми контактами — отдельно их не крафтят. ПКМ по контакту — имя этажа; импульс на контакт вызывает кабину, а в кабине этаж выбирают Контроллером штуковины (колесо мыши и клик).",
		" ",
		"§6Зачем:§r лифт в шахту и по этажам цеха; контакт даёт сигнал, пока кабина на его этаже, — откройте им двери.",
	]
	quest.56F14CBA45AC0668.title: "Часовая башня"
	quest.56F14CBA45AC0668.quest_desc: [
		"Часовой подшипник показывает игровое время стрелками из любых блоков. Поставьте часы на ратушу.",
		" ",
		"",
		" ",
		"§6Как работает:§r Приклейте стрелку к Часовому механизму и подайте вращение — она покажет час. Вторая конструкция перед часовой стрелкой (не склеенная с ней) станет минутной. ПКМ по механизму запускает и останавливает его.",
		" ",
		"§6Зачем:§r часы на ратуше и вокзале, конструкции, которые поворачиваются по времени суток.",
	]
	quest.5767BA611E3D30F3.title: "Дробилка на максимум"
	quest.5767BA611E3D30F3.quest_desc: [
		"Разгоните пару дробильных колёс до максимальной скорости — для этого нужна серьёзная энергия.",
		" ",
		"",
		" ",
		"§6Как работает:§r Предел — 256 об/мин: пара колёс тогда съедает 2 × 8 × 256 = 4096 ен. Поднимите скорость шестернями или Регулятором скорости вращения и проверьте запас на Стрессометре.",
		" ",
		"§6Зачем:§r чем выше обороты, тем быстрее перемалывается стопка — рудная фабрика успевает за бурами.",
	]
	quest.31BB2F85D7AB43B9.title: "Пульт управления"
	quest.31BB2F85D7AB43B9.quest_desc: [
		"Пульт с кнопками, привязанными к частотам беспроводного редстоуна: ворота, лифты и машины управляются из рук.",
	]
	quest.1391112CEE65751D.title: "Программа на редстоуне"
	quest.1391112CEE65751D.quest_desc: [
		"Create Connected: генератор импульсов по программе с чипа управления — таймеры и циклы без километров редстоуна.",
	]
	quest.109072BD9CF9DE42.title: "Кинетический мост"
	quest.109072BD9CF9DE42.quest_desc: [
		"Передаёт вращение на расстояние без вала между точками, разделяя нагрузку.",
	]
	quest.00A078CC1DBAECFC.title: "Путеукладчик"
	quest.00A078CC1DBAECFC.quest_desc: [
		"Вагонеточная машина с автономным активатором, который кладёт рельсы перед собой. Прокладывает дорогу к дальнему руднику сама.",
	]
	quest.6A049651F814E691.title: "Сверхопыт"
	quest.6A049651F814E691.quest_desc: [
		"Молния в опытный блок даёт сверхопыт — топливо для чар выше обычного предела.",
	]
	quest.3B059234A12FE49D.title: "Свет вместо проводов"
	quest.3B059234A12FE49D.quest_desc: [
		"Create Optical: оптический источник светит лучом, датчик ловит его и выдаёт сигнал, а зеркала и линзы поворачивают луч. Так сигнал передаётся через всю базу без проводов. Детали собираются сборкой по шагам.",
	]
	quest.0BA4D815EEA1E98C.title: "Фильтр атрибутов"
	quest.0BA4D815EEA1E98C.quest_desc: [
		"ПКМ открывает настройку: вместо списка предметов фильтр проверяет свойства — «можно раздробить», «можно переплавить», «еда», «из мода…» и другие. Вставьте его в слот фильтра Латунного шлюза, туннеля, Умного жёлоба или в категории Складского тикера.",
		" ",
		"§6Зачем:§r одним фильтром отправить всю руду в дробилку, а прочее — на склад; сортировать добычу бура.",
	]
	quest.63EC383E8BD2C6D7.title: "Умная жидкостная труба"
	quest.63EC383E8BD2C6D7.quest_desc: [
		"У источника она выбирает, какую жидкость качать; дальше по трубе — пропускает только её. Чтобы задать жидкость, ПКМ по её слоту фильтра ведром или бутылкой с этой жидкостью.",
		" ",
		"§6Зачем:§r брать из общего бака только воду, разделить лаву и воду в одной сети, не путать молоко и мёд на кухне.",
	]
	quest.61DF4C272AEE3043.title: "Чай строителя"
	quest.61DF4C272AEE3043.quest_desc: [
		"Механический смешиватель с нагревом: листва + 250 мВ воды + 250 мВ молока → 500 мВ чая. Молоко — вёдрами в Осушитель предметов и по трубе в Чашу. Дозатор наливает по 250 мВ чая в стеклянные бутылки.",
		" ",
		"§6Зачем:§r жидкости Create на практике (Осушитель → труба → Чаша → Дозатор), а сам чай бодрит и сытно кормит на стройке и в шахте.",
	]
	quest.4BE048499EDE2483.title: "Таймеры Create"
	quest.4BE048499EDE2483.quest_desc: [
		"Редстоуновый генератор импульса сам выдаёт короткие импульсы с заданным интервалом (колесо мыши по панели), сигнал на входе ставит его на паузу. Редстоуновый удлинитель импульса растягивает короткий сигнал до заданного времени (до часа). Редстоуновый триггер-защёлка — рычаг, который переключается каждым импульсом сзади.",
		" ",
		"§6Зачем:§r катапульта или пресс раз в N секунд, Механическая рука по одному циклу, свет и двери по таймеру, одна кнопка «вкл/выкл» для линии.",
	]
	quest.19AEE9552BB3EE24.title: "Лаволаз"
	quest.19AEE9552BB3EE24.quest_desc: [
		"Медные шлем, ботинки и баллон улучшаются незеритовым слитком на кузнечном столе (нужен шаблон незеритового улучшения). Полный комплект — Незеритовый лаволазный шлем, Незеритовый баллон, незеритовые поножи и Незеритовые лаволазные ботинки — защищает от огня и лавы, пока в баллоне есть воздух; в лаве лучше видно.",
		" ",
		"§6Зачем:§r ходить по лавовым озёрам Незера, добывать древние обломки, чинить лавовые насосы и котлы.",
	]
	quest.2C45B3F8E422CA06.title: "Латунный век"
	quest.2C45B3F8E422CA06.quest_desc: [
		"Сборщики, сборка по шагам и умная логистика — у вас есть всё для настоящей фабрики.",
	]
	chapter.109EA7C80E9B6026.title: "&#8AB17DСуша и море&r"
	chapter.109EA7C80E9B6026.subtitle: "Машины, лодки, подлодки и аттракционы на физике Create Aeronautics — с латуни."
	quest.78B5B9A254BDDA39.title: "Глава III. За горизонт"
	quest.78B5B9A254BDDA39.quest_subtitle: "Письмо мастера Августа"
	quest.78B5B9A254BDDA39.quest_desc: [
		"Сборщик физики — странная машина: собранное им начинает жить. Колёса едут, паруса ловят ветер, корпус держится на воде.",
		" ",
		"",
		" ",
		"Морякам артели: под водой у южных берегов видели купола и ворота. Похоже, у Предтеч был порт, и море его забрало. Постройте подлодку и спуститесь туда. Только осторожно — глубина не прощает.",
		" ",
		"",
		" ",
		"— Мастер Август",
	]
	quest.11BE6D3308CF9E83.title: "Физика"
	quest.11BE6D3308CF9E83.quest_desc: [
		"Склейте постройку суперклеем, поставьте сборщик физики и запитайте его — постройка станет физическим телом: падает, плавает, катится.",
	]
	quest.574AE09AC6303A92.title: "Колёса"
	quest.574AE09AC6303A92.quest_desc: [
		"Offroad: шина ставится на колёсное крепление с подвеской. Большие и «чудовищные» шины едут по бездорожью.",
	]
	quest.738D3A3801D55CBF.title: "Двигатель"
	quest.738D3A3801D55CBF.quest_desc: [
		"Портативный двигатель жжёт топливо прямо на машине и даёт вращение колёсам.",
	]
	quest.49DC399AE57E1357.title: "Первая машина"
	quest.49DC399AE57E1357.quest_desc: [
		"Четыре колеса, двигатель и штурвал. Командная цель: доехать на машине до соседней базы.",
	]
	quest.659D384023611DEA.title: "Шарниры и лебёдки"
	quest.659D384023611DEA.quest_desc: [
		"Поворотный шарнир — сцепка для прицепа, лебёдка — подъём грузов и буксировка.",
	]
	quest.7B8F6AEC2CF0A28F.title: "Проходческий щит"
	quest.7B8F6AEC2CF0A28F.quest_desc: [
		"Машина с режущей головой прогрызает туннели в скале на ходу.",
	]
	quest.5158C310BE2968DA.title: "Американские горки"
	quest.5158C310BE2968DA.quest_desc: [
		"Рельсы горок ставятся свободно в пространстве — петли, спирали, цепной подъём. Отличный аттракционный парк для друзей.",
	]
	quest.79891D13DD13ACE2.title: "Парусник"
	quest.79891D13DD13ACE2.quest_desc: [
		"Поплавки держат корпус на воде, паруса ловят ветер (флюгер покажет его направление), руль поворачивает.",
	]
	quest.5DDA8FB499631B8A.title: "Моторная лодка"
	quest.3F506BEC14B3ECCB.title: "Под парусом"
	quest.3F506BEC14B3ECCB.quest_desc: [
		"Командная цель: переплыть океан на собственном судне.",
	]
	quest.73AB85589161C4AC.title: "Балласт"
	quest.73AB85589161C4AC.quest_desc: [
		"Create Submarine: насос заполняет балластные цистерны водой — лодка тонет, откачивает — всплывает.",
	]
	quest.01576B7B752B1CBA.title: "Прочное стекло"
	quest.01576B7B752B1CBA.quest_desc: [
		"Обычное стекло трескается на глубине. Железное прочное стекло держит давление.",
	]
	quest.62B8CBE037206B2F.title: "Воздух"
	quest.62B8CBE037206B2F.quest_desc: [
		"Электролизёр делает кислород из воды, диффузор раздаёт его по лодке.",
	]
	quest.5BB391B6A0CC4458.title: "Подводная лодка"
	quest.5BB391B6A0CC4458.quest_desc: [
		"Бортовой компьютер управляет погружением, водомёт толкает лодку. Командная цель: опуститься ниже Y=0 и вернуться — тогда отметьте галочку.",
		" ",
		"",
		" ",
		"Летопись: «На такой же подлодке мы искали затонувший порт. Левиафан не пустил нас дальше ворот».",
	]
	quest.608B7BF241B2C981.title: "Глубоководье"
	quest.608B7BF241B2C981.quest_desc: [
		"Барометр показывает глубину, а декомпрессионная камера даёт вернуться с большой глубины без вреда. С ними подлодка уходит к самому дну океана.",
	]
	quest.4F077325BF0A09F8.title: "Сонар"
	quest.68B0159760A23598.title: "Механический проводник"
	quest.68B0159760A23598.quest_desc: [
		"Create: Aquatic Ambitions — морская обработка и механический проводник силы моря для подводной базы.",
	]
	quest.07CEDD7E5C651FCC.title: "Медовый клей"
	quest.07CEDD7E5C651FCC.quest_desc: [
		"Медовый клей выделяет группу блоков для сборки физической машины точнее, чем суперклей.",
	]
	quest.3376DF953AFA7D17.title: "Канаты"
	quest.3376DF953AFA7D17.quest_desc: [
		"Канат связывает две машины: буксир, прицеп, якорь или подвесная люлька.",
	]
	quest.45ADC5C830926264.title: "Поручень"
	quest.45ADC5C830926264.quest_desc: [
		"За поручень можно держаться на ходу — пассажиры не слетают с платформы.",
	]
	quest.75170D286D644F65.title: "Именная табличка"
	quest.75170D286D644F65.quest_desc: [
		"Назовите свою машину — имя видно в навигации и на радарах.",
	]
	quest.4B3B6E6BF88B5C0D.title: "Чертёж машины"
	quest.4B3B6E6BF88B5C0D.quest_desc: [
		"Чертёж показывает массу, центр тяжести и тягу машины до запуска.",
	]
	quest.3F3B7CD53FE312E4.title: "Редстоун-магнит"
	quest.3F3B7CD53FE312E4.quest_desc: [
		"Магнит притягивает машины друг к другу по сигналу — для стыковки и сцепки.",
	]
	quest.256ACAE55CD48615.title: "Портовые ворота"
	quest.256ACAE55CD48615.quest_desc: [
		"Командная цель: опустите подлодку на дно к воротам затонувшего порта — арки и купола Underwater Village стоят по всем океанам. Отметьте галочку, когда лодка встанет у ворот.",
		" ",
		"",
		" ",
		"Ратибор писал, что Левиафан не пустил их подлодку дальше ворот. Ворота перед вами. За ними — храм порта (страница 4 «Хроники Предтеч»), а в глубине — сам Левиафан. Пройдите дальше, чем смогли они.",
		" ",
		"",
		" ",
		"§6Компас исследователя:§r Small Gate (underwater_village).",
	]
	quest.70FFFD81AE0CCB62.title: "Капитан"
	quest.70FFFD81AE0CCB62.quest_desc: [
		"Машина, судно и подлодка — вы освоили сушу и море.",
	]
	chapter.68EF7D52A167703E.title: "&#48CAE4Небо: корабли и джетпаки&r"
	chapter.68EF7D52A167703E.subtitle: "Шары и пропеллеры с латуни, гироскопы вместе с поездами, левитит и джетпаки после Энда."
	quest.465941E135A689AB.title: "Глава IV. Небо артели"
	quest.465941E135A689AB.quest_subtitle: "Письмо мастера Августа"
	quest.465941E135A689AB.quest_desc: [
		"Мальчишкой я думал, что облака — для птиц. Я ошибался: они для тех, кто не боится пропеллеров.",
		" ",
		"",
		" ",
		"Но в небе мы не первые. Над лесами видели паровой дирижабль под чёрным флагом — с него стреляли иллагеры. Это корабль Предтеч, я узнал его по чертежу из летописи. Разбойники летают на краденом.",
		" ",
		"",
		" ",
		"Начните с воздушного шара. Потом — пропеллер, руль, штурманский стол. И пусть однажды наш флот пройдёт над их дирижаблем.",
		" ",
		"",
		" ",
		"— Мастер Август",
	]
	quest.12268CDCD669EB14.title: "Воздушный шар"
	quest.12268CDCD669EB14.quest_desc: [
		"Оболочка из ткани над горелкой: горячий воздух поднимает постройку. Самый простой летательный аппарат.",
	]
	quest.6176B327FB6967D1.title: "Выше облаков"
	quest.37775BFF17F4282E.title: "Пропеллер"
	quest.37775BFF17F4282E.quest_desc: [
		"Подшипник пропеллера с лопастями даёт тягу. Ставится на корабль вместе со сборщиком физики и штурвалом.",
	]
	quest.6FD4BA8DC7693A80.title: "Первый корабль"
	quest.6FD4BA8DC7693A80.quest_desc: [
		"Командная цель: долететь на пропеллерном корабле до соседней базы. Без гироскопа корабль раскачивается — держите его небольшим.",
		" ",
		"",
		" ",
		"Летопись: «Наш первый корабль поднялся над этой же долиной. Через полвека на таких летали разбойники-иллагеры».",
	]
	quest.7AFB83E96F18CBFF.title: "Твердотопливный двигатель"
	quest.7AFB83E96F18CBFF.quest_desc: [
		"Create Propulsion: простейшая реактивная тяга и крылья (закалённые крылья — из печи).",
	]
	quest.3EA463AB4D805A63.title: "Кабина"
	quest.3EA463AB4D805A63.quest_desc: [
		"Aeroworks: штурвал-ярмо, сектор газа и педали передают сигналы на рули и двигатели.",
	]
	quest.074BFA88F1A824A2.title: "Гироскоп"
	quest.18BA14FB6E0B6508.title: "Гироскопический пропеллер"
	quest.18BA14FB6E0B6508.quest_desc: [
		"Держит корабль ровно. Требует механизм точности — открывается вместе с поездами.",
	]
	quest.40890E25CD724252.title: "Умные пропеллеры"
	quest.6DA4847976A3E673.title: "Жидкостный двигатель"
	quest.6DA4847976A3E673.quest_desc: [
		"Работает на скипидаре: дроблёная ель + вода в миксере.",
	]
	quest.7A094033F3F0C72C.title: "Штурманский стол"
	quest.2746FB3D256D6FBA.title: "Стыковка"
	quest.2746FB3D256D6FBA.quest_desc: [
		"Стыковочные соединители скрепляют два корабля в полёте — пересадка и перегрузка без посадки.",
	]
	quest.7ADE11575F89DF99.title: "Воздушный флот"
	quest.7ADE11575F89DF99.quest_desc: [
		"Командная цель: стабилизированный корабль со штурманским столом, который сам держит курс и высоту.",
	]
	quest.7C493CEC1B4BA1D0.title: "Грузовой маршрут"
	quest.7C493CEC1B4BA1D0.quest_desc: [
		"Транспондер записывает маршрут между воздушными станциями — корабль сам возит грузы, как поезд по расписанию.",
	]
	quest.2A5102659915C685.title: "Приват корабля"
	quest.2A5102659915C685.quest_desc: [
		"Защищает корабль как приват FTB Chunks — никто чужой не разберёт его в полёте.",
	]
	quest.4EF6A4D7C599283F.title: "Гарпун"
	quest.13C84087EA17B3D2.title: "Летающие острова"
	quest.13C84087EA17B3D2.quest_desc: [
		"Над облаками висят острова — с домами, башнями, прудами и даже вулканом. Летопись Ратибора помнит, что Первая артель поднимала в небо целые улицы на левитите. Найдите хотя бы один остров: корабль долетит туда, куда ноги не дойдут.",
		" ",
		"",
		" ",
		"§6Компас исследователя (подойдёт любая):§r mss: Arena, Birch River, Calcite House, Castle Ruin, Castle Tower и ещё 30.",
	]
	quest.0AF94DACD04C9CCB.title: "Небесная арена"
	quest.0AF94DACD04C9CCB.quest_desc: [
		"Самый большой остров — арена с испытательными спавнерами и хранилищем. Командная цель: пройти её всей гильдией и открыть хранилище, потом отметьте галочку.",
		" ",
		"",
		" ",
		"§6Компас исследователя:§r Arena (mss).",
	]
	quest.5D5AA5F7B0B988AA.title: "Радар"
	quest.5D5AA5F7B0B988AA.quest_desc: [
		"Create Radars видит корабли, мобов и игроков вокруг. Монитор появится вместе с механизмом точности.",
	]
	quest.24A454126BA127C2.title: "Паровой ранец"
	quest.24A454126BA127C2.quest_desc: [
		"Create Stuff 'n Additions: личный полёт на паровом двигателе ещё до Края.",
	]
	quest.1FA6327560BA8AB0.title: "Край"
	quest.1FA6327560BA8AB0.quest_desc: [
		"Крепость с порталом ищется по Оку Края. YUNG's переделал и крепости, и остров дракона.",
	]
	quest.767D6B425028B816.title: "Левитит"
	quest.767D6B425028B816.quest_desc: [
		"Порошок эндерняка + цинк + вода, затем нагрев — кристаллы, которые парят без энергии. Летающие острова и базы.",
		" ",
		"",
		" ",
		"Летопись: «Левитит держал наши летающие города. Его жилы стережёт Эндер-страж».",
	]
	quest.513AF4CC98998836.title: "Элитры"
	quest.2716D5A640A1855F.title: "Джетпак"
	quest.2716D5A640A1855F.quest_desc: [
		"Летает на воздухе из баллона. J — включить, H — зависание.",
	]
	quest.1E75DB116875FB8F.title: "Ионный двигатель"
	quest.1E75DB116875FB8F.quest_desc: [
		"Электрическая тяга без топлива. Требует стальной механизм TFMG.",
	]
	quest.3525A19D86C1269B.title: "Край атмосферы"
	quest.5C0879E16AFDC9DC.title: "Лётные очки"
	quest.2AAC4A5B00DAC48F.title: "Высотомер"
	quest.2AAC4A5B00DAC48F.quest_desc: [
		"Даёт сигнал по высоте: автопилот держит эшелон, балласт сбрасывается сам.",
	]
	quest.34F6AE5BB042C238.title: "Датчик скорости"
	quest.1D820AD45C5AE9F4.title: "Кардан"
	quest.1D820AD45C5AE9F4.quest_desc: [
		"Сигнал по крену и тангажу — основа самодельного автопилота, который выравнивает корабль.",
	]
	quest.03F033F779418501.title: "Лазер"
	quest.03F033F779418501.quest_desc: [
		"Лазерная указка и датчик: дальномер для посадки и «сигнализация» для ангара.",
	]
	quest.7AB8168AADB10F5D.title: "Дальний курс"
	quest.7AB8168AADB10F5D.quest_desc: [
		"Задайте штурманскому столу цель дальше 5000 блоков — первая дальняя экспедиция.",
	]
	quest.2AF434B686B16FF1.title: "Бортовая пушка"
	quest.2AF434B686B16FF1.quest_desc: [
		"Картофельная пушка на борту — первая защита корабля.",
	]
	quest.6D0D143877C63ECF.title: "Охотник за фантомами"
	quest.6D0D143877C63ECF.quest_desc: [
		"Собьте фантома из бортовой пушки.",
	]
	quest.7A59ABAE862C8C01.title: "Векторная тяга"
	quest.7A59ABAE862C8C01.quest_desc: [
		"Двигатель с поворотным соплом — корабль маневрирует без рулей.",
	]
	quest.5E0BD74945082AA2.title: "Перламутровый левитит"
	quest.53E47ED6DA088D05.title: "Хозяева неба"
	quest.53E47ED6DA088D05.quest_desc: [
		"Флот кораблей, маршруты и джетпаки. Самое сильное снаряжение потребует трофеев боссов.",
	]
	chapter.7FC2CF8BF6F9688D.title: "&#2A9D8FЭпоха 3. Фабрика и ток&r"
	chapter.7FC2CF8BF6F9688D.subtitle: "Склады Create 6, посылки и первое электричество."
	quest.37C7E988DD06B6B3.title: "Глава V. Город машин"
	quest.37C7E988DD06B6B3.quest_subtitle: "Письмо мастера Августа"
	quest.37C7E988DD06B6B3.quest_desc: [
		"Латунь освоена, и главная беда теперь — беспорядок. Сундуки ломятся, ремни путаются, каждый тащит своё.",
		" ",
		"",
		" ",
		"Предтечи прошли и это. Их литейные стояли так тесно, что дым закрывал солнце, а склады считали сами. Ратибор пишет, что тогда они впервые забыли спросить, хватит ли земле сил.",
		" ",
		"",
		" ",
		"Стройте склад, почту и провода. Но рядом сажайте сады и держите зверей. Мы не повторим их ошибку.",
		" ",
		"",
		" ",
		"— Мастер Август",
	]
	quest.5EB3BA9F3F56F287.title: "Хранилище"
	quest.5EB3BA9F3F56F287.quest_desc: [
		"Хранилища соединяются в один большой склад. К ним подключаются воронки, руки и упаковщики.",
		" ",
		"",
		" ",
		"§6Как работает:§r Хранилища, поставленные рядом, сливаются в одно (основание до 3×3, длина до трёх диаметров). Открыть его руками нельзя: предметы кладут и забирают шлюзами, Механической рукой, Складским люком или через упаковщик.",
		" ",
		"§6Зачем:§r огромный общий склад для линии и основа сети упаковщиков и Складского тикера.",
	]
	quest.47001A59A0B89240.title: "Упаковщик"
	quest.47001A59A0B89240.quest_desc: [
		"Упаковывает предметы в посылки с адресом. Посылки едут по ремням, цепям и поездам.",
		" ",
		"",
		" ",
		"§6Как работает:§r Прикрепите упаковщик к сундуку или хранилищу: по сигналу редстоуна он упакует содержимое в Картонную коробку и выдаст её наружу. Посылку, поданную обратно, он распакует в свой склад, если всё влезет.",
		" ",
		"§6Зачем:§r перевозка заказов Цепным конвейером, поездом и Квакопортом; со Складским передатчиком — склад, доступный всей сети.",
	]
	quest.7D00AA26CB9675C7.title: "Квакопорт"
	quest.7D00AA26CB9675C7.quest_desc: [
		"ПКМ Квакопортом по Цепному конвейеру, затем поставьте его рядом и задайте в его меню адрес. Чужие посылки он кладёт на цепь, а посылки со своим адресом снимает и складывает в сундук или упаковщик под собой. ПКМ Планшетом по квакопорту запоминает адрес.",
		" ",
		"§6Зачем:§r почта между цехами без ремней: заказал на складе — посылка сама приехала в нужный цех.",
	]
	quest.3F3291A1E5618CAF.title: "Цепной конвейер"
	quest.3F3291A1E5618CAF.quest_desc: [
		"Ставьте Цепные конвейеры на валы и соединяйте ПКМ цепью по двум конвейерам (до 32 блоков, до 4 связей у каждого). Они передают вращение друг другу и везут посылки; с Гаечным ключом в руке можно прокатиться по цепи самому.",
		" ",
		"§6Зачем:§r дорога для посылок между Квакопортами над всей базой.",
	]
	quest.4A376E246EDCEF5F.title: "Учёт склада"
	quest.4A376E246EDCEF5F.quest_desc: [
		"Складской тикер показывает всё содержимое сети и заказывает нужное прямо к вам.",
		" ",
		"",
		" ",
		"§6Как работает:§r Складской передатчик ставят на упаковщик — склад становится частью сети. Складской тикер перед установкой привязывают ПКМ по передатчику; заказывают через «кладовщика» — любое существо или Горелку всполоха, сидящих перед тикером (ПКМ по нему). Заказ упакуется и поедет по указанному адресу.",
		" ",
		"§6Зачем:§r одно окно ко всем складам базы; основа фабрик «под заказ» и магазина на скатерти.",
	]
	quest.2A794F41BE8008BD.title: "Фабричный контроллер"
	quest.2A794F41BE8008BD.quest_desc: [
		"Держит нужный запас: если продукта меньше заданного, сам заказывает ингредиенты и запускает производство.",
		" ",
		"",
		" ",
		"§6Как работает:§r Поставленный на упаковщик, контроллер следит за запасом в его сундуке и дозаказывает со склада до заданного числа (зажмите ПКМ, чтобы задать). Поставленный отдельно, он следит за всей сетью: подключите контроллеры ингредиентов, укажите адрес цеха — при нехватке он сам отправит туда сырьё.",
		" ",
		"§6Зачем:§r фабрика «под заказ»: склад сам поддерживает нужный запас листов, механизмов и еды.",
	]
	quest.16935440BED7C1E7.title: "Жидкие посылки"
	quest.16935440BED7C1E7.quest_desc: [
		"Factory Logistics упаковывает жидкости в банки — их можно возить как обычные посылки.",
	]
	quest.4559634BDE43CF11.title: "Первая автоматическая линия"
	quest.4559634BDE43CF11.quest_desc: [
		"Командная цель: линия, которая сама делает продукт от сырья до склада, без рук. Например, листы, шестерни или хлеб.",
		" ",
		"",
		" ",
		"Летопись: «Первая линия, которая работала без людей, стояла в литейной у реки. Мы праздновали неделю. Река почернела через год».",
	]
	quest.04395D536ED14639.title: "Прокатный стан"
	quest.04395D536ED14639.quest_desc: [
		"Начало Crafts & Additions: прокатывает слитки в стержни и проволоку.",
	]
	quest.4C51493BC599030A.title: "Провода"
	quest.3E53F78D09A3DDFA.title: "Конденсатор"
	quest.633ACAF83A600B2C.title: "Генератор"
	quest.633ACAF83A600B2C.quest_desc: [
		"Превращает вращение в энергию (FE). Нужен механический сборщик.",
		" ",
		"",
		" ",
		"§6Как работает:§r Генератор переменного тока крутят валом, он выдаёт энергию FE: чем выше обороты, тем больше энергии, но и нагрузка у него большая — ставьте на сильный источник. Энергию с него забирают Низковольтным соединителем в режиме «Вытягивание».",
		" ",
		"§6Зачем:§r электричество для Электромоторов вдали от рек, Катушки Теслы и энергайзеров New Age.",
	]
	quest.2F21427C8D01F550.title: "Электромотор"
	quest.2F21427C8D01F550.quest_desc: [
		"Обратно: энергия в вращение. Энергию можно передавать проводами на километры.",
		" ",
		"",
		" ",
		"§6Как работает:§r Электромотор получает FE через соединитель в режиме «Отдача» и сам крутит вал; скорость задают колесом мыши по нему (до 256 об/мин), расход энергии растёт со скоростью.",
		" ",
		"§6Зачем:§r энергию по проводам можно увести на километры — мотор крутит машины там, где нет своего источника.",
	]
	quest.2D4BC9494DB51701.title: "Сеть"
	quest.2D4BC9494DB51701.quest_desc: [
		"ПКМ Медной катушкой по двум соединителям протягивает между ними провод. Гаечный ключ переключает режим соединителя: у генератора — «Вытягивание», у потребителя — «Отдача», «Нет» — просто опора линии.",
		" ",
		"§6Зачем:§r электросеть между базами вместо километров валов.",
	]
	quest.559AD3DF79BDBBE3.title: "Аккумулятор"
	quest.3B4349BED16DF8C8.title: "Катушка Теслы"
	quest.3B4349BED16DF8C8.quest_desc: [
		"Заряжает предметы и бьёт током мобов рядом.",
	]
	quest.0E5275852E2AAD12.title: "Энергайзер"
	quest.0E5275852E2AAD12.quest_desc: [
		"New Age: заряжает предметы энергией. Заряженное железо даёт магнетит. В AvgustovStory энергайзер требует конденсатор C&A.",
	]
	quest.6354043329D0CFB6.title: "Магнетит"
	quest.2DACD5528C14659D.title: "Катушки генератора"
	quest.2DACD5528C14659D.quest_desc: [
		"Магниты, вращающиеся рядом с катушками, дают много энергии — генератор New Age мощнее генератора C&A.",
	]
	quest.5A9546D215D8FE04.title: "Мотор New Age"
	quest.51CED7BB65034E92.title: "Цветные хранилища"
	quest.51CED7BB65034E92.quest_desc: [
		"Create: Vibrant Vaults — вертикальные и цветные хранилища, цветные упаковщики: цвет — это адрес, логистика становится читаемой.",
	]
	quest.4FACCDC9C1AEF784.title: "Контейнеры"
	quest.29284A3CCAFA6EDD.title: "Опытный люк"
	quest.29284A3CCAFA6EDD.quest_desc: [
		"Сдавайте свой опыт в общий бак команды и забирайте, когда нужно.",
	]
	quest.563E3090B12CA398.title: "Магазин на скатерти"
	quest.563E3090B12CA398.quest_desc: [
		"Скатерть со складским тикером превращает склад в магазин: друзья выбирают товар, платят, а посылка приезжает сама. Ставьте лавки у станций.",
	]
	quest.7AD0179052D2AFA7.title: "Переупаковщик"
	quest.7AD0179052D2AFA7.quest_desc: [
		"Собирает части большого заказа в одну посылку — нужно для механических сборщиков на заказ.",
	]
	quest.129EDEAB9BEC1992.title: "Робо-пчёлы"
	quest.129EDEAB9BEC1992.quest_desc: [
		"Create Mobile Packages: пчёлы-дроны забирают посылки из порта и несут их прямо игроку, где бы он ни был.",
	]
	quest.317DA199C0120077.title: "Карманный склад"
	quest.317DA199C0120077.quest_desc: [
		"Заказ со склада из любой точки мира — пчела привезёт.",
	]
	quest.6C7148B5AEC81857.title: "Перезарядка"
	quest.6C7148B5AEC81857.quest_desc: [
		"Энергайзер заряжает металл током. Перезаряженные железо и золото — материалы следующего уровня New Age.",
	]
	quest.1ECD18322D14D8E0.title: "Усиленный энергайзер"
	quest.2833E05F1D197C34.title: "Мощный мотор"
	quest.2833E05F1D197C34.quest_desc: [
		"Мотор следующего уровня: больше скорости и момента от той же сети.",
	]
	quest.21C9E35BB4C820FD.title: "Сильные магниты"
	quest.21C9E35BB4C820FD.quest_desc: [
		"Магниты из редстоуна и слоистые магниты дают генераторам New Age больше тока.",
	]
	quest.5E3188FB1682D359.title: "Солнечный нагрев"
	quest.5E3188FB1682D359.quest_desc: [
		"Солнечные пластины греют трубы, а тепло разжигает горелку всполоха без топлива днём.",
	]
	quest.0F0FAFE8F6C8A5CD.title: "Биотопливо"
	quest.0F0FAFE8F6C8A5CD.quest_desc: [
		"Crafts & Additions: отходы ферм прессуются в пеллеты — топливо для котлов из ничего.",
	]
	quest.21EFFCEDB0160E7F.title: "Складской люк"
	quest.21EFFCEDB0160E7F.quest_desc: [
		"Люк ставят на Хранилище или сундук. ПКМ по нему кладёт внутрь предмет из руки, Shift + ПКМ — весь инвентарь, кроме хотбара.",
		" ",
		"§6Зачем:§r Хранилище руками не открыть — люк делает из него приёмное окно склада: вернулся из шахты и сдал всё одним кликом.",
	]
	quest.3CD6487F15C4CA9C.title: "Запрос по сигналу"
	quest.3CD6487F15C4CA9C.quest_desc: [
		"Перед установкой ПКМ им по Складскому передатчику — он подключится к сети. ПКМ по установленному — настройте заказ (что, сколько и на какой адрес); каждый импульс редстоуна отправляет этот заказ со склада.",
		" ",
		"§6Зачем:§r кнопка «привезти 64 угля к котлам», подача сырья по датчику — без похода к тикеру.",
	]
	quest.6BA5E146AFCD8360.title: "Фильтр отправлений"
	quest.6BA5E146AFCD8360.quest_desc: [
		"ПКМ — впишите адрес. В слоте фильтра шлюза, Латунного туннеля или Умного жёлоба он пропускает только посылки с этим адресом.",
		" ",
		"§6Зачем:§r развести посылки по цехам обычными ремнями, без Квакопортов.",
	]
	quest.7F492D888B9BF134.title: "Индустриальный город"
	quest.7F492D888B9BF134.quest_desc: [
		"Склад с учётом, электросеть и автоматика. Дальше — пар, рельсы и экономика.",
	]
	chapter.7CF6F3B9F0311268.title: "&#F4A261Эпоха 4. Пар и рельсы&r"
	chapter.7CF6F3B9F0311268.subtitle: "Механизм точности, паровые машины, поезда и деньги."
	quest.7C9CA89A3742B492.title: "Глава VI. Железная дорога"
	quest.7C9CA89A3742B492.quest_subtitle: "Письмо мастера Августа"
	quest.7C9CA89A3742B492.quest_desc: [
		"Спросите меня, какое изобретение лучшее, и я отвечу не думая: пар и рельсы.",
		" ",
		"",
		" ",
		"В лесу нашли станцию Предтеч: перрон, табло, ржавые стрелки. Пути ведут в одну сторону — к старой фабрике в горах. Ратибор пишет о «последнем поезде». Кто на нём уехал и куда?",
		" ",
		"",
		" ",
		"Механизм точности, котёл на полную мощь, первая станция. Потом — магистраль через весь континент. Пусть каждая наша база будет связана с каждой.",
		" ",
		"",
		" ",
		"— Мастер Август",
	]
	quest.49C8E1C2CB9DF78F.title: "Механизм точности"
	quest.49C8E1C2CB9DF78F.quest_desc: [
		"Сборка по шагам: золотой лист проходит через автономные активаторы с шестернями, большими шестернями и железными самородками. Ключ ко всей эпохе.",
		" ",
		"",
		" ",
		"Летопись: «Механизм точности — сердце стражей. Из таких же механизмов собран Предвестник».",
		" ",
		"",
		" ",
		"§6Как работает:§r Линия: Пресс делает Золотой лист, Ремень-петля ведёт его под тремя Автономными активаторами (Шестерня, Большая шестерня, железный самородок), 5 кругов. Выход около 80 %, остальное распадается на запчасти (лист, шестерни, сплав) — их можно пустить обратно в дело.",
		" ",
		"§6Зачем:§r Механическая рука, Контроллер поезда, рука-удлинитель и жезл симметрии, стабилизированные корабли.",
	]
	quest.322E48A162593536.title: "Механическая рука"
	quest.322E48A162593536.quest_desc: [
		"Механическая рука берёт предметы из одних блоков и кладёт в другие: ремни, депо, котлы, печи, крафтеры. Собирается из механизма точности, латунного корпуса и латунного листа.",
		" ",
		"",
		" ",
		"§6Как работает:§r Пока рука у вас в руке (до установки!), ПКМ по блокам-целям: первый клик — вход (синий), второй — выход (жёлтый), ЛКМ снимает выбор. Затем поставьте её не дальше 5 блоков от целей и подайте вращение. При нескольких выходах режим (по кругу, по приоритету) выбирают колесом мыши; сигнал редстоуна её останавливает, а короткий спад сигнала даёт ровно один цикл.",
		" ",
		"§6Зачем:§r компактные линии без ремней, возврат заготовок в сборке по шагам, кормление горелок, загрузка механических сборщиков.",
	]
	quest.64D1E811B244D8F0.title: "Паровой двигатель"
	quest.64D1E811B244D8F0.quest_desc: [
		"Бак с водой над горелкой всполоха. Чем больше бак и горелок под ним, тем выше уровень котла и мощность.",
		" ",
		"",
		" ",
		"§6Как работает:§r Котёл — это Жидкостные баки (минимум 4) с Горелками всполоха под ними и водой от Механической помпы. Паровой двигатель ставят на стенку бака, а ПКМ Валом по двигателю создаёт выходной вал. Уровень котла — наименьшее из трёх: нагрев (горящая горелка — 1, с тортом — 2), объём (4 блока бака на уровень) и вода (10 мВ в тик на уровень). На каждый уровень один двигатель работает в полную силу: 64 об/мин и 16 384 ен.",
		" ",
		"§6Зачем:§r первая по-настоящему большая энергия: котёл тянет всю фабрику, дробилки на максимуме и рельсовый завод.",
	]
	quest.50DBEB12E4862F54.title: "Большой котёл"
	quest.50DBEB12E4862F54.quest_desc: [
		"Паровой двигатель тянет ровно столько, сколько даёт котёл. Котёл — это жидкостные баки с водой над горелками всполоха: чем больше баков и горелок, тем больше двигателей он тянет. Очки инженера показывают его уровень.",
		" ",
		"",
		" ",
		"§6Как работает:§r Посмотрите на бак в Инженерных очках: три шкалы — Объём, Вода, Нагрев; уровень котла — по самой короткой. Мало воды — добавьте помпу или поднимите ей обороты; мало нагрева — ещё горелки под баком. Горелка без топлива (или огонь, магма) даёт лишь слабый «пассивный» режим.",
		" ",
		"§6Зачем:§r подобрать котёл под нужное число двигателей; лишние двигатели сверх уровня работают слабее.",
	]
	quest.037B455A917C82D8.title: "Прочный лист"
	quest.037B455A917C82D8.quest_desc: [
		"Прочный лист — последовательная сборка: порошок обсидиана с дробильных колёс прессуют в заготовку, поливают лавой и прессуют снова. Из него делают железнодорожный корпус.",
		" ",
		"",
		" ",
		"§6Как работает:§r Обсидиан в Дробильных колёсах → Обсидиановый порошок (и с шансом 75 % обсидиан обратно). Дальше линия сборки по шагам из JEI: Дозатор с лавой и Механический пресс над Ремнём.",
		" ",
		"§6Зачем:§r Железнодорожный корпус → станции, Контроллер поезда, тележки вагонов.",
	]
	quest.5F22BB0D8AF2D897.title: "Железнодорожный корпус"
	quest.5F22BB0D8AF2D897.quest_desc: [
		"Железнодорожный корпус — латунный корпус, к которому приложили прочный лист. Из него делают станции, пульты машиниста, двери и сцепки.",
		" ",
		"",
		" ",
		"§6Как работает:§r ПКМ Прочным листом по Латунному корпусу (или Автономным активатором). ПКМ Железнодорожным корпусом по пути ставит тележку вагона; повторный клик меняет её вид.",
		" ",
		"§6Зачем:§r тележки, Железнодорожная станция, Контроллер поезда, двери вагонов.",
	]
	quest.358D0659205DAC79.title: "Пути"
	quest.358D0659205DAC79.quest_desc: [
		"Рельсы собираются последовательной сборкой из шпал, железных и цинковых самородков. Магистраль съест их сотнями — автоматизируйте сборку.",
		" ",
		"",
		" ",
		"§6Как работает:§r ПКМ рельсом по существующему пути, затем по точке назначения — путь проложится сам, с поворотами и уклонами; с зажатым бегом получится самая длинная дуга. Блоки во второй руке автоматически ложатся под путь.",
		" ",
		"§6Зачем:§r магистрали между базами, шахтами и складами.",
	]
	quest.380479E50B4CB991.title: "Станция"
	quest.380479E50B4CB991.quest_desc: [
		"Станция (железнодорожный корпус и компас) ставится прямо на путь. На ней собирают и разбирают поезд, а в расписании она служит остановкой.",
		" ",
		"",
		" ",
		"§6Как работает:§r ПКМ Станцией по пути, затем поставьте её рядом. В её меню включите режим сборки: на пути поставьте тележки (ПКМ Железнодорожным корпусом по рельсу), постройте вагоны, склейте Суперклеем, поставьте Контроллер поезда и нажмите «Собрать». Разобрать поезд можно только на станции.",
		" ",
		"§6Зачем:§r остановки маршрутов, сборка и ремонт составов; ПКМ картой по станции ставит её на карту.",
	]
	quest.69DC4856CBFC0A90.title: "Пульт машиниста"
	quest.69DC4856CBFC0A90.quest_desc: [
		"Пульт машиниста превращает склеенную конструкцию на тележках в поезд: без него состав не тронется. Рецепт — рычаг, железнодорожный корпус и механизм точности.",
		" ",
		"",
		" ",
		"§6Как работает:§r Без Контроллера поезда состав не соберётся; второй контроллер, смотрящий назад, позволит ехать в обе стороны. ПКМ по контроллеру — и поезд слушается клавиш движения. Топливо (уголь, брёвна) в сундуке или бочке на поезде ускоряет его; топливо в Хранилище не тратится.",
		" ",
		"§6Зачем:§r ручное вождение и место для машиниста расписания.",
	]
	quest.7C036BD110CE6DC8.title: "Суперклей"
	quest.7C036BD110CE6DC8.quest_desc: [
		"Суперклеем выделяют область — все блоки внутри едут вместе как один вагон.",
		" ",
		"",
		" ",
		"§6Как работает:§r Каждый вагон — своя склеенная область над своими тележками (одна или две на вагон); вагоны между собой не склеивают.",
		" ",
		"§6Зачем:§r собрать многовагонный состав, который входит в повороты.",
	]
	quest.411E9AB77390070D.title: "Расписание"
	quest.411E9AB77390070D.quest_desc: [
		"Расписание вкладывается в машиниста (жителя или ифрита) — и поезд ездит сам.",
		" ",
		"",
		" ",
		"§6Как работает:§r ПКМ Расписанием поезда в руке откроет редактор: добавьте станции и условия (ждать N секунд, до загрузки или выгрузки). Затем ПКМ им по машинисту — любому существу или Горелке всполоха, сидящим перед Контроллером поезда. Забрать расписание можно в любой момент.",
		" ",
		"§6Зачем:§r поезд ездит сам: руда с шахты, грузы между базами, пассажирская линия.",
	]
	quest.6CEC049A0BB60DFF.title: "Первый поезд"
	quest.6CEC049A0BB60DFF.quest_desc: [
		"Командная цель: поезд по расписанию между двумя базами или шахтой и складом.",
		" ",
		"",
		" ",
		"Летопись: «Наши поезда связали все города Предтеч. Последний из них увёз мастеров к ракетной фабрике — и рельсы опустели навсегда».",
	]
	quest.135D2D76A1165B42.title: "Двери вагонов"
	quest.135D2D76A1165B42.quest_desc: [
		"Двери для вагонов: обычная деревянная дверь и железнодорожный корпус.",
	]
	quest.43E8152C9C58FC59.title: "Навигатор"
	quest.43E8152C9C58FC59.quest_desc: [
		"Railways Navigator строит маршрут с пересадками по всей сети и показывает табло прибытия.",
	]
	quest.5F026A4053487696.title: "Табло"
	quest.5F026A4053487696.quest_desc: [
		"Расширенное табло Create Railways Navigator ставят в вагоне как указатель направления или на перроне — оно показывает больше, чем обычное табло.",
	]
	quest.27E39C39CB646949.title: "Банк"
	quest.27E39C39CB646949.quest_desc: [
		"Numismatics: у каждого игрока свой счёт. Монеты чеканятся из металлов, торговля идёт через торговые автоматы.",
	]
	quest.33E4A92F201544B0.title: "Торговый автомат"
	quest.33E4A92F201544B0.quest_desc: [
		"Каждый в команде делает что-то лучше других — продавайте своё друзьям через автоматы на станциях.",
	]
	quest.03BA26063AFC1037.title: "Чугунная пушка"
	quest.03BA26063AFC1037.quest_desc: [
		"Create Big Cannons: пушки собираются из блоков и стреляют ядрами. Для обороны базы от рейдов.",
		" ",
		"",
		" ",
		"Пушки Create Big Cannons подробно и с наградами — в главе «Арсенал и оборона».",
	]
	quest.04F05A9D86419715.title: "Стрелка"
	quest.04F05A9D86419715.quest_desc: [
		"Steam 'n' Rails: стрелка переключается рычагом или редстоуном — развилки, депо и разъезды.",
	]
	quest.24CEEA04CD08EC2B.title: "Сигналы"
	quest.24CEEA04CD08EC2B.quest_desc: [
		"Сигналы делят пути на блоки: в одном блоке может быть только один поезд. Без них два поезда на одной линии рано или поздно столкнутся.",
		" ",
		"",
		" ",
		"§6Как работает:§r ПКМ светофором по пути, затем поставьте его рядом. Светофор делит путь на участки: поезд по расписанию не въедет в занятый участок и никогда не проедет светофор против его направления — для двустороннего движения ставьте второй, смотрящий навстречу.",
		" ",
		"§6Зачем:§r несколько поездов на одной линии без аварий, разъезды и депо.",
	]
	quest.1B9143F82446A079.title: "Табло прибытия"
	quest.1B9143F82446A079.quest_desc: [
		"Связь дисплея показывает на табло время до прибытия поезда.",
	]
	quest.45877A48C15C0BA6.title: "Сцепка"
	quest.45877A48C15C0BA6.quest_desc: [
		"Сцепка Steam 'n' Rails ставится на путь и сцепляет или расцепляет составы прямо на маршруте.",
	]
	quest.2185C3F1F0490CC1.title: "Робот-кондуктор"
	quest.2185C3F1F0490CC1.quest_desc: [
		"Фуражка на андезитовом корпусе превращается в робота-кондуктора: он водит поезд и дёргает рычаги по расписанию.",
	]
	quest.3225AC4F65A3B8E5.title: "Узкая и широкая колея"
	quest.3225AC4F65A3B8E5.quest_desc: [
		"Steam 'n' Rails: широкая колея для тяжёлых составов и монорельс на балках — для тесных мест и красоты.",
	]
	quest.0C7817597691E087.title: "Топливный бак"
	quest.0C7817597691E087.quest_desc: [
		"Поезда на жидком топливе — дизель позже станет главным топливом магистралей.",
	]
	quest.05CF54651EECE600.title: "Длинный состав"
	quest.05CF54651EECE600.quest_desc: [
		"Соберите поезд хотя бы из шести вагонов.",
	]
	quest.1D7583A7568D88A9.title: "Магистраль"
	quest.1D7583A7568D88A9.quest_desc: [
		"Проедьте больше 5000 блоков за одну поездку — магистраль между всеми базами команды.",
	]
	quest.7C79A52036532CCA.title: "Портальная линия"
	quest.7C79A52036532CCA.quest_desc: [
		"Поезда проходят через порталы Незера: 1 блок в Незере = 8 в мире — самый быстрый путь на дальние базы.",
	]
	quest.64B723F464DF7138.title: "Раздвижные двери"
	quest.64B723F464DF7138.quest_desc: [
		"Train Utilities: раздвижные двери в стиле реальных поездов и платформенные блоки.",
	]
	quest.790CA574E95D369F.title: "Кинетический аккумулятор"
	quest.790CA574E95D369F.quest_desc: [
		"Запасает вращение и отдаёт его позже — для машин, которые работают рывками.",
	]
	quest.43262ED3EBEB1E23.title: "Латунный загрузчик"
	quest.43262ED3EBEB1E23.quest_desc: [
		"Держит до 5×5 чанков и работает на поездах и кораблях — вагоны не застрянут на границе прогруженной зоны.",
	]
	quest.78E467044E1863CF.title: "Геймпад"
	quest.78E467044E1863CF.quest_desc: [
		"Управление связями редстоуна с геймпада или клавиатуры с плавными аналоговыми сигналами — для кранов, кораблей, поездов.",
	]
	quest.2979DE43D31AA237.title: "Золотой миксер"
	quest.2979DE43D31AA237.quest_desc: [
		"Золотой миксер Dreams & Desires — миксер с золотым венчиком; что он умеет сверх обычного, покажет JEI.",
	]
	quest.53C4296266FA3507.title: "Полный пар"
	quest.53C4296266FA3507.quest_desc: [
		"Котёл максимального уровня: большой бак, много горелок всполоха, вода с запасом. Это энергия целой фабрики.",
		" ",
		"",
		" ",
		"Летопись: «На полном пару наши котлы ели лес быстрее, чем он рос. Ставьте ветряки и колёса — пар пусть будет подмогой, а не хозяином».",
		" ",
		"",
		" ",
		"§6Как работает:§r Уровень 18 требует нагрева 18 (например, 9 горелок с тортом всполоха), 72 блока бака и 180 мВ воды в тик; тогда 18 двигателей дают 18 × 16 384 ен.",
		" ",
		"§6Зачем:§r энергия целого промышленного района с одного котла.",
	]
	quest.012D55AC890E4EE2.title: "Регулятор скорости"
	quest.012D55AC890E4EE2.quest_desc: [
		"Задаёт точную скорость сети независимо от источника. Без него большие заводы перегружаются или тратят мощность впустую.",
		" ",
		"",
		" ",
		"§6Как работает:§r Регулятор ставят на входной вал, а Большую шестерню — прямо над ним: на неё он выдаёт заданную колесом мыши скорость (до 256 об/мин, можно и обратную). Мощности он не добавляет: больше оборотов — больше нагрузка.",
		" ",
		"§6Зачем:§r точная скорость для смешивателей и линий; быстро сбавить обороты при перегрузке, не перестраивая передачи.",
	]
	quest.57DB21C390DE2EE5.title: "Инструменты инженера"
	quest.57DB21C390DE2EE5.quest_desc: [
		"Жезл симметрии зеркалит стройку, механическая рука-удлинитель достаёт дальше — для высоких построек и мостов.",
	]
	quest.4AEBFB0A1E381054.title: "Картофельная пушка"
	quest.4AEBFB0A1E381054.quest_desc: [
		"Стреляет любой едой из баллона. Победите ею моба — разные овощи действуют по-разному.",
	]
	quest.0A629A3336C4AD75.title: "Паровой гудок"
	quest.0A629A3336C4AD75.quest_desc: [
		"Гудок на котле: сигнал смены на заводе. Несколько гудков разной высоты — орган.",
	]
	quest.0F468DB664E7F4B6.title: "Ту-ту!"
	quest.0F468DB664E7F4B6.quest_desc: [
		"Поставьте на поезд паровой гудок и дайте сигнал на ходу.",
	]
	quest.777E5AC12A2FA1E1.title: "Путейцы"
	quest.777E5AC12A2FA1E1.quest_desc: [
		"Механический каток на поезде мостит насыпь под путём, путевой наблюдатель видит проходящий состав — стрелки и шлагбаумы по поезду.",
	]
	quest.54ACDA619631C266.title: "Тупик"
	quest.54ACDA619631C266.quest_desc: [
		"Упор Misc and Things ставится в конце тупика, чтобы поезд не уехал за край пути.",
	]
	quest.0D1630844C98F34A.title: "Рельсовый завод"
	quest.0D1630844C98F34A.quest_desc: [
		"Сделайте больше 1000 рельсов на одном прессе. Магистраль между базами требует тысячи рельсов, так что завод окупится.",
	]
	quest.1028EC86159CF8AD.title: "Уютный вагон"
	quest.1028EC86159CF8AD.quest_desc: [
		"Create: Interiors — кресла и диваны, на которых можно сидеть в движущемся поезде или корабле.",
	]
	quest.40C6269F041F6C55.title: "Почтовый ящик"
	quest.40C6269F041F6C55.quest_desc: [
		"ПКМ Почтовым ящиком по Железнодорожной станции, поставьте его рядом и задайте в нём адрес. Чужие посылки, положенные в ящик, заберёт любой поезд, остановившийся на станции, а посылки с этим адресом поезд выгрузит в ящик; работает и в незагруженных чанках.",
		" ",
		"§6Зачем:§r почта по железной дороге: заказ со склада сам доезжает до дальней базы.",
	]
	quest.27205B9F3903CFBA.title: "Век пара"
	quest.27205B9F3903CFBA.quest_desc: [
		"Пар, рельсы и деньги. Следующий шаг — сталь, а её делает только доменная печь TFMG.",
	]
	chapter.2D70F24899807E05.title: "&#6C757DЭпоха 5. Сталь и нефть&r"
	chapter.2D70F24899807E05.subtitle: "Доменная печь, нефтепромысел, пластик и бесконечные жилы."
	quest.5927541A6852BA3D.title: "Глава VII. Сталь"
	quest.5927541A6852BA3D.quest_subtitle: "Письмо мастера Августа"
	quest.5927541A6852BA3D.quest_desc: [
		"Чугун хрупок, а нам нужно крепкое. Сталь варится только в доменной печи — огромной, жаркой, ненасытной. А под землёй ждёт нефть: топливо, пластик, платы.",
		" ",
		"",
		" ",
		"Именно здесь Предтечи сломались. Летопись говорит о «Великой выработке»: они выкачали из земли всё, реки почернели, звери ушли, а ученики, лишившись работы, взяли старые инструменты и стали разбойниками-иллагерами.",
		" ",
		"",
		" ",
		"Варите сталь и качайте нефть — но считайте каждую бочку. Земля у нас одна.",
		" ",
		"",
		" ",
		"— Мастер Август",
	]
	quest.6596D173AF641EF6.title: "Чугун"
	quest.6596D173AF641EF6.quest_desc: [
		"Железо с углём под прессом над чашей. Чугун — каркас всей тяжёлой промышленности TFMG.",
	]
	quest.1149957716CF42A8.title: "Огнеупорный кирпич"
	quest.1149957716CF42A8.quest_desc: [
		"Огнеупорный кирпич обжигают в печи из шариков огнеупорной глины (откуда глина — покажет JEI). Из этих кирпичей складывают стены доменной печи.",
	]
	quest.51D890EF63FFA68A.title: "Коксовая печь"
	quest.51D890EF63FFA68A.quest_desc: [
		"Коксовая печь (чугун и промышленное железо) выжигает из угля кокс. Как собрать её из нескольких блоков, покажет Ponder.",
	]
	quest.2518FD5E3D0F8C76.title: "Кокс"
	quest.2518FD5E3D0F8C76.quest_desc: [
		"Кокс горит жарче угля — это топливо доменной печи. Запаситесь: печь ненасытная.",
	]
	quest.551BD18276D7EA22.title: "Доменная печь"
	quest.551BD18276D7EA22.quest_desc: [
		"Стены из огнеупорного кирпича, сверху железная руда с коксом. Размеры и схема — в Ponder и JEI.",
	]
	quest.5DAF564C963FD05E.title: "Сталь"
	quest.5DAF564C963FD05E.quest_desc: [
		"Единственный способ получить сталь с нуля в AvgustovStory. Стали Big Cannons и Gunsmithing меняются на неё 1:1 в верстаке.",
		" ",
		"",
		" ",
		"Летопись: «Сталь — наша гордость и наша беда. Ради неё мы срыли горы, которые держали реки».",
		" ",
		"",
		" ",
		"§6Сталь открывает поздние ступени:§r незерит (смеситель с перегревом, квест «Незерит»), рыцарские латы Epic Knights и тяжёлую броню T4, стальное оружие.",
	]
	quest.60975C4024C61525.title: "Тяжёлая плита"
	quest.60975C4024C61525.quest_desc: [
		"Тяжёлая плита — сталь, прокатанная последовательной сборкой. Нужна для стального механизма, дистилляции и тяжёлых машин.",
	]
	quest.5C442A1AADB0D00A.title: "Стальной механизм"
	quest.5C442A1AADB0D00A.quest_desc: [
		"Стальной механизм — ключ эпохи: тяжёлая плита, стальные шестерни, никелевая и свинцовая пластины, винты и отвёртка в последовательной сборке. Без него не будет нефтекачалки, буровой установки и ионного двигателя.",
	]
	quest.65AB2D5985F2AF66.title: "Стальной корпус"
	quest.65AB2D5985F2AF66.quest_desc: [
		"Стальной корпус — сталь на закалённых досках. Основа машин TFMG.",
	]
	quest.0517763710403F2C.title: "Поиск нефти"
	quest.0517763710403F2C.quest_desc: [
		"Нефть лежит в отдельных чанках. Сканер показывает, насколько богат чанк.",
	]
	quest.6301E49FA9901CE0.title: "Нефтекачалка"
	quest.6301E49FA9901CE0.quest_desc: [
		"Летопись: «Нефть лилась, пока не кончилась. Считай бочки, наследник, — мы не считали».",
	]
	quest.6C7F36997FFC58F0.title: "Качалка Diesel Generators"
	quest.6C7F36997FFC58F0.quest_desc: [
		"Вторая система нефти. В AvgustovStory её подшипник тоже требует стальной механизм.",
	]
	quest.079ADB71CC3BAE2D.title: "Перегонка"
	quest.079ADB71CC3BAE2D.quest_desc: [
		"Контроллер перегонки собирает колонну, которая делит сырую нефть на фракции: бензин, дизель, керосин, нафту и другие. Сборку колонны покажет Ponder.",
	]
	quest.7B3B79C13DB227E1.title: "Топливо"
	quest.7B3B79C13DB227E1.quest_desc: [
		"Бензин и дизель идут с колонны перегонки. Ими заправляют двигатели Diesel Generators и машины TFMG.",
	]
	quest.1F6F566757C93AE5.title: "Дизельный двигатель"
	quest.1F6F566757C93AE5.quest_desc: [
		"Поршни теперь стальные, зато двигатель даёт много вращения в компактном корпусе.",
	]
	quest.7D3924CA3CBB831F.title: "Пластик"
	quest.7D3924CA3CBB831F.quest_desc: [
		"Пластик отливают из расплавленного пластика; его цепочку от продуктов перегонки покажет JEI. Пластик нужен для печатных плат.",
	]
	quest.4664BA7269053B79.title: "Печатная плата"
	quest.4664BA7269053B79.quest_desc: [
		"Понадобится для двигателей TFMG и для пульта ракеты.",
	]
	quest.485F971FBE660B5F.title: "Алюминий"
	quest.485F971FBE660B5F.quest_desc: [
		"Алюминий получают в химическом чане из бокситовой пыли. Алюминиевые листы понадобятся для ракеты в последней эпохе.",
	]
	quest.754A2BEB65158F3D.title: "Электросеть TFMG"
	quest.754A2BEB65158F3D.quest_desc: [
		"Генератор TFMG превращает вращение в электричество, аккумулятор его запасает (свинец, серная кислота, алюминиевый корпус).",
	]
	quest.2271B5353B3A159A.title: "Буровая установка"
	quest.2271B5353B3A159A.quest_desc: [
		"Бесконечная руда из жилы под землёй. Жилы ищутся искателем жил, у каждой свой состав.",
	]
	quest.3F375ABC97FD6C91.title: "Искатель жил"
	quest.3F375ABC97FD6C91.quest_desc: [
		"Искатель жил показывает, есть ли в чанке бесконечная жила для буровой установки. Рецепт — аметист, око Края и редстоуновая руда.",
	]
	quest.03C72A5485CBDF0D.title: "Стальной ствол"
	quest.03C72A5485CBDF0D.quest_desc: [
		"Сборный стальной ствол Create Big Cannons. Подробно и с наградой — в главе «Арсенал и оборона» (квест «Стальной ствол»).",
	]
	quest.079D6921AC491BEF.title: "Факельная труба"
	quest.079D6921AC491BEF.quest_desc: [
		"Сжигает лишние газы перегонки, чтобы колонна не вставала из-за полного бака.",
	]
	quest.565B2C898DE979ED.title: "Промышленный миксер"
	quest.565B2C898DE979ED.quest_desc: [
		"Промышленный миксер TFMG — большой смеситель для химических рецептов. Какие рецепты он берёт, покажет JEI.",
	]
	quest.6F33439F4138ACC0.title: "Химический чан"
	quest.6F33439F4138ACC0.quest_desc: [
		"Чан с электродами проводит электролиз и химические реакции TFMG.",
	]
	quest.423783841511FDFC.title: "Асфальт"
	quest.423783841511FDFC.quest_desc: [
		"Битум из перегонки — асфальт для дорог: по нему быстрее бегать и ездить.",
	]
	quest.009032BD517A601E.title: "Большой дизель"
	quest.009032BD517A601E.quest_desc: [
		"Большие дизели ставятся цепочкой на общий вал, турбина добавляет мощности.",
	]
	quest.6F572FD85FEEC494.title: "Огромный дизель"
	quest.6F572FD85FEEC494.quest_desc: [
		"Огромный дизель — самый мощный двигатель Diesel Generators. Кормите его топливом с колонны перегонки.",
	]
	quest.2CFB6682A875F57E.title: "Этанол"
	quest.2CFB6682A875F57E.quest_desc: [
		"Брожение урожая в чаше под крышкой даёт этанол — возобновляемое топливо без нефти.",
	]
	quest.2730B1177D89E2AC.title: "Канистра"
	quest.2730B1177D89E2AC.quest_desc: [
		"Канистра хранит топливо и заправляет технику в пути.",
	]
	quest.320B4FF55989C1C1.title: "Индустриальная эпоха"
	quest.320B4FF55989C1C1.quest_desc: [
		"Сталь, нефть и бесконечная руда. Дальше — небо и Край.",
	]
	chapter.5F6BD320417E29B3.title: "&#E63946Эпоха 6. Трофеи боссов&r"
	chapter.5F6BD320417E29B3.subtitle: "Трофеи Cataclysm и незеритовое снаряжение. Пушки — в главе «Арсенал»."
	quest.066C0076956AAE88.title: "Глава VIII. Стражи Предтеч"
	quest.066C0076956AAE88.quest_subtitle: "Письмо мастера Августа"
	quest.066C0076956AAE88.quest_desc: [
		"Перед уходом Предтечи поставили стражей у самого ценного: огненного рыцаря Игниса — у кузни в Незере, железного Предвестника — у ракетной фабрики в горах. Стражи до сих пор служат хозяевам, которых больше нет, и не пускают никого.",
		" ",
		"",
		" ",
		"В их сердцах — металлы, которых не выплавить ни в одной печи. А в ядре Предвестника, по словам Ратибора, хранится карта неба.",
		" ",
		"",
		" ",
		"Не ходите поодиночке. Это работа для всей артели.",
		" ",
		"",
		" ",
		"— Мастер Август",
	]
	quest.130148D3B8439F46.title: "На охоту"
	quest.130148D3B8439F46.quest_desc: [
		"Подробные квесты по боссам — в главе «Боссы». Здесь только трофеи, которые нужны технике.",
		" ",
		"",
		" ",
		"Подготовка как в рейдовых сборках: броня T5 (незерит, Максимилиан, Fantasy) с «Защитой» IV, зелья огнестойкости и лечения, тотем, еда с насыщением и вся команда рядом. Логова ищите компасом исследователя.",
	]
	quest.09B61BBAF2CBA24F.title: "Игнис"
	quest.09B61BBAF2CBA24F.quest_desc: [
		"§6Ступень B6§r · рекомендуется броня T5+ (незерит и трофейная)",
		" ",
		"§cЖара:§r охлаждающая подкладка на броню и вода",
		" ",
		"",
		" ",
		"Огненный рыцарь Горящей арены в Незере. Бьёт огнём и щитом; огнестойкость обязательна, лаву вокруг арены лучше заранее перекрыть. Рекомендуется команда из 2–4 человек.",
		" ",
		"",
		" ",
		"Это страж кузни Предтеч — подробнее в «Хронике Предтеч», страница 10.",
		" ",
		"",
		" ",
		"§6Компас исследователя:§r Burning Arena (L_Ender's Cataclysm 1.21.1).",
	]
	quest.55CA5B20172A1007.title: "Игнитиум"
	quest.55CA5B20172A1007.quest_desc: [
		"Нужен для незеритового джетпака.",
	]
	quest.1F31CC93666C13D9.title: "Предвестник"
	quest.1F31CC93666C13D9.quest_desc: [
		"§6Ступень B6§r · рекомендуется броня T5+ (незерит и трофейная)",
		" ",
		"",
		" ",
		"Механический страж Древней фабрики — очень в духе Create. Стреляет лазерами и ракетами: держите укрытия и не стойте на месте. Рекомендуется команда из 2–4 человек.",
		" ",
		"",
		" ",
		"Это страж ракетной фабрики Предтеч, в его ядре — звёздная карта. Подробнее в «Хронике Предтеч», страница 9.",
		" ",
		"",
		" ",
		"§6Компас исследователя:§r Ancient Factory (L_Ender's Cataclysm 1.21.1).",
	]
	quest.7D8C648876D1BE98.title: "Ведьмит"
	quest.7D8C648876D1BE98.quest_desc: [
		"Нужен для незеритового бура Ore Excavation.",
	]
	quest.4233AE2347FB1210.title: "Незеритовый джетпак"
	quest.4233AE2347FB1210.quest_desc: [
		"Незеритовый джетпак собирают на механическом крафтере: элитры, незеритовый баллон, игнитиум и латунь. В этой сборке игнитиум заменил механизм точности — без победы над Игнисом его не собрать.",
	]
	quest.55D9A380247187A0.title: "Незеритовый бур"
	quest.55D9A380247187A0.quest_desc: [
		"Незеритовый бур для буровой установки: алмазный бур, шаблон незеритового улучшения и ведьмит на кузнечном столе. В этой сборке ведьмит Предвестника заменил незеритовый слиток.",
	]
	quest.30CB301B541829CE.title: "Ветераны"
	quest.30CB301B541829CE.quest_desc: [
		"Лучшее снаряжение добыто. Осталась последняя граница — космос.",
	]
	chapter.6F1204A5E9394F2D.title: "&#9D4EDDЭпоха 7. Космос&r"
	chapter.6F1204A5E9394F2D.subtitle: "Ракета, скафандры, Луна и Марс. Финал сборки."
	quest.141E0EDDF78B547B.title: "Глава IX. К звёздам"
	quest.141E0EDDF78B547B.quest_subtitle: "Письмо мастера Августа"
	quest.141E0EDDF78B547B.quest_desc: [
		"Это моё последнее письмо, друзья.",
		" ",
		"",
		" ",
		"Теперь я знаю, куда ушёл последний поезд. Предтечи построили ракету и улетели — искать землю, которую ещё не успели исчерпать. Карта из ядра Предвестника ведёт на Луну: там их последняя мастерская.",
		" ",
		"",
		" ",
		"Когда-то здесь не было ни одной шестерни. Теперь у нас поезда, корабли, заводы и сталь — и живая земля вокруг. Мы прошли их путь и не сломались. Ракете нужно всё, что мы умеем. Соберите всю артель и долетите туда, где кончается их летопись.",
		" ",
		"",
		" ",
		"— Мастер Август",
	]
	quest.1C133A562A6AA6C2.title: "Стол ракетостроителя"
	quest.1C133A562A6AA6C2.quest_desc: [
		"Creating Space: двигатели проектируются на чертежах, ракета собирается из блоков как контрапция.",
	]
	quest.031BAEFE8C990837.title: "Космические металлы"
	quest.031BAEFE8C990837.quest_desc: [
		"Никель даёт руда TFMG в обычном мире, алюминий даёт боксит TFMG. Кобальта на Земле нет — он только на Луне.",
	]
	quest.02CF9D42370FBB20.title: "Лунный кобальт"
	quest.02CF9D42370FBB20.quest_desc: [
		"Кобальт из лунной руды и алюминиевые листы дают настоящий корпус ракеты — для следующих полётов, к Марсу и Венере.",
	]
	quest.395D9CBF7783687A.title: "Чертёж двигателя"
	quest.395D9CBF7783687A.quest_desc: [
		"На столе ракетостроителя задайте нужные параметры двигателя — стол выдаст чертёж. По чертежу собирают двигатель и его детали.",
	]
	quest.52623177A13DE13C.title: "Ракетный двигатель"
	quest.52623177A13DE13C.quest_desc: [
		"Малый ракетный двигатель собирают по чертежу со стола ракетостроителя; детали и рецепт покажет JEI. Чем тяжелее ракета, тем больше тяги ей нужно.",
	]
	quest.76C9E9D3439B1365.title: "Торий"
	quest.76C9E9D3439B1365.quest_desc: [
		"Торий New Age: ториевая руда встречается в мире, а миксер умеет получать его из камня, глины и воды.",
	]
	quest.180F23FB6EF5DD37.title: "Сверхзаряженный алмаз"
	quest.180F23FB6EF5DD37.quest_desc: [
		"Алмаз в продвинутом энергайзере. Нужен для пульта ракеты.",
	]
	quest.3D2BAE855354FD05.title: "Пульт ракеты"
	quest.3D2BAE855354FD05.quest_desc: [
		"Требует сверхзаряженный алмаз New Age и плату TFMG — понадобятся все ветки сразу.",
		" ",
		"",
		" ",
		"Летопись: «Пульт нашей ракеты собирали год. Мастера по очереди ставили в него по детали — на память о доме».",
	]
	quest.41A045F9CA841BBB.title: "Ядерное топливо"
	quest.41A045F9CA841BBB.quest_desc: [
		"Ядерное топливо — последовательная сборка: радиоактивный торий (торий после дробильных колёс) на железной пластине.",
	]
	quest.3E323B4F45F1A01B.title: "Реактор"
	quest.3E323B4F45F1A01B.quest_desc: [
		"Реактор New Age: корпус, стекло, приёмник топлива, вентиляция и стержни на тяжёлой плите TFMG. Перегрев превращает активную зону в кориум — расплав, который прожигает пол. Держите охлаждение с запасом и стройте реактор подальше от базы.",
	]
	quest.129EFC7C2F4F85A2.title: "Ожижитель воздуха"
	quest.129EFC7C2F4F85A2.quest_desc: [
		"Ожижитель воздуха Creating Space вытягивает газы из воздуха и сжижает их. Так получают жидкий кислород для скафандра и ракеты.",
	]
	quest.3E87A2803D715CDC.title: "Жидкий кислород"
	quest.3E87A2803D715CDC.quest_desc: [
		"Ожижитель превращает воздух в жидкий кислород, а хранят его в криогенном баке — оттуда заправляют ракету и баллоны скафандра.",
	]
	quest.318692E388708E7C.title: "Скафандр"
	quest.318692E388708E7C.quest_desc: [
		"Скафандр шьют из космической ткани (медный лист, золото и красная шерсть в последовательной сборке). Кислородный баллон заправляют жидким кислородом через трубу снизу.",
	]
	quest.09E687E6EA4026B2.title: "Орбита"
	quest.09E687E6EA4026B2.quest_desc: [
		"Поднимите ракету на орбиту Земли. Награду за первый выход на орбиту даёт страница 11 «Хроники Предтеч».",
	]
	quest.575ACA00F378EEF2.title: "Луна"
	quest.575ACA00F378EEF2.quest_desc: [
		"Командная цель: высадка всей команды и образцы для артели — шестнадцать блоков лунного реголита (его даёт верхний слой Луны). Возьмите герметизатор, чтобы поставить базу с воздухом. Саму высадку отмечает страница 12 «Хроники Предтеч».",
	]
	quest.79E7A700C61E5553.title: "Лунная база"
	quest.79E7A700C61E5553.quest_desc: [
		"Герметизатор наполняет закрытую комнату кислородом — на лунной базе можно дышать без баллона. Стены должны быть без щелей.",
	]
	quest.0A39EA459E6367D7.title: "Марс"
	quest.0A39EA459E6367D7.quest_desc: [
		"Ратибор писал, что его братья улетели с Луны дальше, к Марсу. Чтобы пойти по их следу, нужен двигатель мощнее и больше топлива.",
	]
	quest.227A42268CAD3B97.title: "Венера"
	quest.227A42268CAD3B97.quest_desc: [
		"На звёздной карте из ядра Предвестника Венера отмечена словами «если Луны не хватит». Горячая и ядовитая — готовьтесь как к Незеру.",
	]
	quest.460A44F163F7847C.title: "Эпилог. История артели"
	quest.460A44F163F7847C.quest_subtitle: "Конец одной истории — начало другой"
	quest.460A44F163F7847C.quest_desc: [
		"Вы стоите в лунной мастерской Предтеч. На верстаке — последняя страница летописи и пустая книга. Ратибор ждал тех, кто придёт следом.",
		" ",
		"",
		" ",
		"Внизу — ваша земля: дороги, рельсы, дым заводов, огни городов и зелёные поля. Вы построили больше, чем Предтечи, и не разрушили то, что вас кормит.",
		" ",
		"",
		" ",
		"Впишите в пустую книгу имена всех, кто был в артели, и поставьте её у вокзала. Это ваша история — AvgustovStory. А Марс и Венера ждут следующую главу.",
	]
	chapter.151B1C8AD1616459.title: "&#E76F51Кухня, вода и климат&r"
	chapter.151B1C8AD1616459.subtitle: "Чистая вода, сытная еда, одежда по погоде, своё пиво и вино — и всё это на машинах Create."
	quest.1D6532AEE86B0746.title: "Чистая вода"
	quest.1D6532AEE86B0746.quest_desc: [
		"Legendary Survival Overhaul: рядом с голодом — шкала жажды. Сырая вода из реки утоляет хуже и может вызвать жажду-отравление. Переплавьте бутылку воды в печи — получится чистая. Вентилятор Create над лавой делает то же самое целыми партиями.",
		" ",
		"",
		" ",
		"Летопись: «Когда литейные встали у каждой реки, вода почернела. Мы научились кипятить её и пить с горечью. Пейте чистую — и не давайте рекам чернеть снова».",
	]
	quest.738192A57BF3792F.title: "Фляга"
	quest.738192A57BF3792F.quest_desc: [
		"Фляга вмещает несколько глотков. Наберите воду и прокалите флягу в печи — вода в ней станет чистой. Для долгих походов есть большая фляга.",
		" ",
		"",
		" ",
		"Летопись: «В последние годы фляга была у каждого: родникам мы больше не верили».",
	]
	quest.1D44838FBC181F8B.title: "Очиститель воды"
	quest.1D44838FBC181F8B.quest_desc: [
		"Очиститель воды — амулет на голову (слот Curios): пока он надет, жажда не тратится. Собирается из медных и латунных листов, угля-фильтра, механизма точности и фляги, так что это цель эпохи точности. До него — фляга и прокалка воды.",
		" ",
		"",
		" ",
		"Летопись: «Очистители мы ставили у каждой кухни, а надо было — у каждой литейной. Сберечь воду дешевле, чем потом её чистить».",
	]
	quest.20D884662DD3CD9D.title: "Жара и холод"
	quest.20D884662DD3CD9D.quest_desc: [
		"Температура тела зависит от биома, высоты, погоды, времени суток и того, что рядом: огонь и лава греют, вода, лёд и снег холодят. Термометр покажет, насколько вам жарко или холодно. Без защиты жара и холод сбивают здоровье до одного сердца.",
	]
	quest.42AC7B82D3FA8BD8.title: "Швейный стол"
	quest.42AC7B82D3FA8BD8.quest_desc: [
		"На швейном столе к броне пришивают подкладку: тёплую — для снегов, охлаждающую — для пустынь и Незера. Любая броня становится одеждой по погоде.",
	]
	quest.3B17E29D075C8592.title: "Тёплая подкладка"
	quest.7295133678F66227.title: "Охлаждающая подкладка"
	quest.67F084DF55A23737.title: "Обогреватель"
	quest.67F084DF55A23737.quest_desc: [
		"Греет воздух вокруг себя: база в снегах станет жилой.",
	]
	quest.60DF1F21EF685F68.title: "Охладитель"
	quest.60DF1F21EF685F68.quest_desc: [
		"Охлаждает воздух вокруг себя — для баз в пустыне и в Незере.",
	]
	quest.707A59E3AFA43B90.title: "Перевязка"
	quest.707A59E3AFA43B90.quest_desc: [
		"Урон получают части тела. Раненая голова мутит взгляд, руки хуже бьют и копают, ноги замедляют. Бинт и пластырь лечат одну часть тела, аптечка — сильнее, а морфий на время глушит боль.",
	]
	quest.119DFDC1CB78E80E.title: "Аптечка"
	quest.3823B45A254AEA58.title: "Нож и доска"
	quest.3823B45A254AEA58.quest_desc: [
		"Нож и доску уже оплатила «Эпоха 0» («Кремнёвый нож», «Разделочная доска»). Здесь они открывают кухню.",
	]
	quest.5ACE0163F6203D78.title: "Плита и котелок"
	quest.5ACE0163F6203D78.quest_desc: [
		"Farmer's Delight: блюда из котелка сытнее и дают «Питание». Супы ещё и утоляют жажду.",
	]
	quest.04CC9CD124C29EB8.title: "Суп на всю артель"
	quest.04CC9CD124C29EB8.quest_desc: [
		"Овощной и куриный суп варятся в котелке на плите. Каждое новое блюдо идёт в зачёт «Гурмана»: чем больше разных блюд, тем больше сердец.",
	]
	quest.4B1EB9D3DD6BBD10.title: "Пир"
	quest.4B1EB9D3DD6BBD10.quest_desc: [
		"Блюдо-блок на всю команду: поставьте на стол, каждый берёт порцию.",
	]
	quest.5A97D002957E6FFF.title: "Богатая почва"
	quest.2743BFBEE92E78B2.title: "Механическая кухня"
	quest.2743BFBEE92E78B2.quest_desc: [
		"Create Central Kitchen: пила режет как разделочная доска, автономный активатор с ножом работает на доске, горелка всполоха греет котелок, механическая рука загружает его.",
	]
	quest.491D07C0F0616BB7.title: "Слайсер"
	quest.7B65D4E85B4213DC.title: "Бочонок"
	quest.7B65D4E85B4213DC.quest_desc: [
		"Brewin' and Chewin': ингредиенты бродят в бочонке, напиток разливается по кружкам. Трубы Create подают жидкость прямо в бочонок.",
	]
	quest.5CD5C6B32E16CEFE.title: "Пиво"
	quest.5CD5C6B32E16CEFE.quest_desc: [
		"Пиво утоляет жажду, но крепкие напитки дают «Навеселе» — не перед боем.",
	]
	quest.4C3E4519E263C2F1.title: "Медовуха"
	quest.7CCA1FA01EE40E72.title: "Квашения"
	quest.7CCA1FA01EE40E72.quest_desc: [
		"Вяленое мясо — лучшая еда в дорогу.",
	]
	quest.20EB8AD3B1B3707C.title: "Сыр"
	quest.20EB8AD3B1B3707C.quest_desc: [
		"Сырная головка зреет, лёжа на полу. Терпение.",
	]
	quest.43D611D20E2A63F0.title: "Пицца"
	quest.074D90F0E7FFECC4.title: "Стаут «Стальной носок»"
	quest.0A5FF3EEE9393BB3.title: "Виноград"
	quest.3C91B79D602AEF36.title: "Винный погреб"
	quest.3C91B79D602AEF36.quest_desc: [
		"Create Winery: пресс давит виноград в мезгу, сусло выдерживается в винном погребе.",
	]
	quest.2C853FA06D9AD647.title: "Вино"
	quest.236A0C858978A01B.title: "Шампанское"
	quest.462956A8435D5420.title: "Шоколадная фабрика"
	quest.462956A8435D5420.quest_desc: [
		"Create Confectionery: какао дробится, шоколад варится в миксере с нагревом. Горячий шоколад утоляет жажду.",
	]
	quest.25CB3685B95D775D.title: "Орехи"
	quest.25CB3685B95D775D.quest_desc: [
		"Garnished: орехи с ореховых деревьев колются жерновом и обсыпаются приправой из дозатора.",
	]
	quest.52CC2FF27EE6FB4E.title: "Гарнированный обед"
	quest.6960F9B7D764872A.title: "Фритюрница"
	quest.6960F9B7D764872A.quest_desc: [
		"Create: Bitterballen — подсолнечное масло и механическая фритюрница над горелкой всполоха.",
	]
	quest.63CE185815E31B92.title: "Картошка фри"
	quest.734C904D2FC6116B.title: "Автоматическая кухня"
	quest.734C904D2FC6116B.quest_desc: [
		"Командная цель: кухня, которая сама варит, режет и жарит по заказу фабричного контроллера — еда и напитки для всей команды без рук.",
	]
	quest.53E2DB669A21A45C.title: "Своя таверна"
	quest.53E2DB669A21A45C.quest_desc: [
		"Таверна с пивом, вином и пиццей, а у стойки — торговый автомат Numismatics: пусть друзья платят за ужин.",
	]
	quest.4AD2AE6CFE0EB0AC.title: "Кухня Края"
	quest.2324D73EB868E07D.title: "Карточный стол"
	quest.2324D73EB868E07D.quest_desc: [
		"Charta и Charta: Casino — карточные игры прямо в мире: блэкджек, техасский холдем, дурак, «Сумасшедшие восьмёрки». За один стол садятся до 8 игроков, каждый на свой стул.",
		" ",
		"",
		" ",
		"Фишки в партии виртуальные. Хотите играть на монеты — договоритесь о бай-ине заранее и пусть кто-то будет банкиром.",
	]
	quest.16E35FB952F43AAC.title: "Своё казино"
	quest.16E35FB952F43AAC.quest_desc: [
		"Стол дилера и игровые кресла — сделайте при таверне игровой зал. Рядом поставьте бильярд и шахматы.",
	]
	quest.5FFD08E7197D783B.title: "Бильярд и шахматы"
	quest.5FFD08E7197D783B.quest_desc: [
		"Pool and Billiards: стол и кий собираются по рецептам в книге рецептов. Снукер, «восьмёрка», «девятка», игра вдвоём или с ботом.",
		" ",
		"",
		" ",
		"MineChess: шахматная доска тоже крафтится — настоящие шахматы на двоих.",
	]
	quest.03349234A9A2020D.title: "Леденцы и пряники"
	quest.57BA29CDF42B744D.title: "Маршмеллоу у костра"
	quest.47E9A2864FBB20A9.title: "Шоколадная коллекция"
	quest.4B5298305B92257F.title: "Сбалансированное питание"
	quest.4B5298305B92257F.quest_desc: [
		"Один дозатор делает и ягоды в шоколаде, и яблоко в мёде, и сладкую булку.",
	]
	quest.07A441807671B4FA.title: "Гурман"
	quest.07A441807671B4FA.quest_desc: [
		"Каждое новое блюдо приносит очки гурмана — смотря как трудно его приготовить: ★ 1 очко — печь, костёр, 1–2 продукта; ★★ 2 — разделочная доска, 3–4 продукта; ★★★ 3 — котелок, машины Create, бочки, винодельня и пиры. Блюдом считается еда, которая восстанавливает хотя бы два окорочка сытости.",
		" ",
		"",
		" ",
		"Каждый начинает с 8 сердцами. За 10, 15, 35, 50, 75, 100, 135, 165, 210, 250, 310 и 360 очков прибавляется по сердцу, максимум 20. За этапы дают кухонные звания — от «Поварёнка» до «Легенды кухни» — и монеты. Кристальное сердце (9 осколков из сундуков шахт, кладов, храмов джунглей и бастионов) — ещё +1 сердце по ПКМ.",
		" ",
		"",
		" ",
		"Общий стол: порция, взятая с блюда-пира, засчитывается всем из вашей гильдии в 16 блоках.",
		" ",
		"",
		" ",
		"Смерть забирает одно сердце, но не ниже стартовых 8. Чтобы вернуть его, наберите столько очков разных блюд, сколько стоил последний этап (знакомые блюда тоже считаются), или используйте Кристальное сердце.",
		" ",
		"",
		" ",
		"Рацион: считаются 10 последних блюд и напитков. Групп пять — мясо, рыба и яйца; овощи и фрукты; хлеб и злаки; сладкое; напитки. 3 группы — Спешка на 10 минут, 4 — ещё Сила, все 5 — ещё Сопротивление. 10 раз подряд одна группа — «Однообразно»: Слабость. Одно и то же блюдо 8 раз подряд — «Приелось»: короткий Голод.",
		" ",
		"",
		" ",
		"§e/hearts§r — сердца и очки. §e/gourmet§r — журнал гурмана: рацион и блюда, которые вы ещё не пробовали.",
		" ",
		"",
		" ",
		"У каждого края своя кухня: в сундуках океанских построек — рыбные блюда, в холодных — горячие супы, в пустынях и джунглях — фрукты и сладости, в Незере и Крае — их блюда, в подземельях — сыры, вина и осколки Кристального сердца. Первая победа над каждым боссом даёт осколки, а над большим — целое Кристальное сердце.",
	]
	chapter.0FE0B49642FB6CD5.title: "&#90BE6DФермы и линии&r"
	chapter.0FE0B49642FB6CD5.subtitle: "Хороший инженер не рубит дерево — он строит то, что рубит за него."
	quest.57DC511E55D14451.title: "Фермы и линии"
	quest.57DC511E55D14451.quest_desc: [
		"Ратибор: «Руками мы добываем на один вечер. Машиной — на всю жизнь». В этой главе — фермы, которые снимают рутину именно в нашей сборке: вода, топливо, камень, руда, опыт, сталь и ракетное топливо. Как собрать каждую — в описании и в подсказках Ponder (зажмите W над механизмом).",
	]
	quest.0C1AB0F17EF01CD9.title: "Станция чистой воды"
	quest.0C1AB0F17EF01CD9.quest_desc: [
		"Как сделать: механическая помпа качает воду в смеситель над горелкой всполоха, деплойер или воронка подаёт стеклянные бутылки — смеситель кипятит воду прямо в бутылки (250 мБ на бутылку). Без горелки — котёл на костре и бутылка вручную.",
		" ",
		"Зачем: жажда — ежедневная забота. Чистая вода не даёт эффекта жажды, а соки из неё лечат ещё и жару.",
	]
	quest.61DCBDD899D09163.title: "Лесопилка"
	quest.61DCBDD899D09163.quest_desc: [
		"Как сделать: механическая пила спиливает дерево целиком, деплойер сажает саженец, а стволы едут по ленте в печь или вентилятор с огнём. Проще всего — ель или берёза (ровный ствол).",
		" ",
		"Зачем: древесный уголь — топливо горелок, костров для кипячения и печей; доски и палки уходят на всё подряд.",
	]
	quest.18BB7FC4F9D7A905.title: "Камень из ничего"
	quest.18BB7FC4F9D7A905.quest_desc: [
		"Как сделать: механический экструдер между водой и лавой выдавливает камень; если рядом нужный блок-образец, получается андезит, гранит или диорит. Вал вращения — и бесконечный карьер готов.",
		" ",
		"Зачем: андезитовый сплав, каменные блоки, гравий и песок для следующих ферм.",
	]
	quest.4474FCA42743231A.title: "Песок и глина"
	quest.4474FCA42743231A.quest_desc: [
		"Как сделать: дробильные колёса превращают булыжник в гравий, гравий — в песок; вентилятор через воду промывает гравий (кремень, железные самородки) и песок (глина).",
		" ",
		"Зачем: стекло, бетон, кирпичи, кремень — и железо из промывки, пока своя шахта не готова.",
	]
	quest.37C5F2BD8916DC49.title: "Поле на автопилоте"
	quest.37C5F2BD8916DC49.quest_desc: [
		"Как сделать: комбайн на поршне или на поезде проходит над полем и собирает урожай, оставляя растения расти дальше; плуг рыхлит новую землю. Тростник и бамбук собираются тем же комбайном.",
		" ",
		"Зачем: хлеб, корм для животных, сахар — и много блюд для очков гурмана.",
	]
	quest.4DDFCA5EB06FDA77.title: "Водорослевая котельная"
	quest.4DDFCA5EB06FDA77.quest_desc: [
		"Как сделать: ламинария растёт в колонне воды, комбайн или пила срезает её, вентилятор с огнём сушит, механический пресс или крафтер собирает блоки.",
		" ",
		"Зачем: блок сушёной ламинарии — дешёвое возобновляемое топливо для горелок и печей.",
	]
	quest.639523AD0B236BF2.title: "Курятник"
	quest.639523AD0B236BF2.quest_desc: [
		"Как сделать: насест Create Integrated Farming — куры несутся и линяют в блоке, яйца и перья забирает воронка или лента.",
		" ",
		"Зачем: перья для стрел, яйца и курица для кухни, без забора и толпы кур.",
	]
	quest.5681907E1EC1DAAA.title: "Руда из камня"
	quest.5681907E1EC1DAAA.quest_desc: [
		"Как сделать: экструдер (латунный работает быстрее) выдавливает асурин, веридий, охрум и кримсит, если рядом стоит блок-образец; дробильные колёса превращают их в дроблёную руду, промывка и плавка дают цинк, медь, золото и железо.",
		" ",
		"Зачем: латунь без шахт — главный ресурс эпохи.",
	]
	quest.103BE13758B916A0.title: "Опыт по трубам"
	quest.103BE13758B916A0.quest_desc: [
		"Как сделать: мобы, убитые деплойером с мечом или дробильными колёсами, роняют опыт; Create Enchantment Industry собирает его в жидкость и самородки. Ферму мобов ставьте подальше от мегафакелов.",
		" ",
		"Зачем: опыт — это зачарования и телепорты, которые у нас стоят опыта.",
	]
	quest.1CEB7ADE4A053DF7.title: "Стержни ифрита"
	quest.1CEB7ADE4A053DF7.quest_desc: [
		"Где взять: ифриты в незерских крепостях; спаунер можно огородить и бить ифритов деплойером. Порох и стержни тоже делаются в смесителе из пыли ифрита (Create Ultimate Factory, см. JEI).",
		" ",
		"Зачем: горелки всполоха, зелья, глаза Края и пороховые заряды — перед боссами ступени B3 запас нужен всегда.",
	]
	quest.5539ED7AAC4C0048.title: "Коксовая печь"
	quest.5539ED7AAC4C0048.quest_desc: [
		"Как сделать: коксовая печь TFMG спекает уголь в кокс. Уголь — из шахты, из «призрачного» обжига древесного угля вентилятором с огнём душ, или из промывки.",
		" ",
		"Зачем: кокс нужен доменной печи для стали — без него эпоха стали стоит.",
	]
	quest.584FC0929BD87BA9.title: "Бесконечная лава"
	quest.584FC0929BD87BA9.quest_desc: [
		"Как сделать: шланговый шкив в лавовом море Незера — если в водоёме больше 10 000 блоков, он считается бесконечным, и лава не кончается. Трубы и помпы доводят её до базы или до цистерны поезда.",
		" ",
		"Зачем: топливо, литьё и экструдеры камня.",
	]
	quest.7A379864171045A0.title: "Нефть и дизель"
	quest.7A379864171045A0.quest_desc: [
		"Как сделать: станок-качалка TFMG над нефтяным месторождением (в бесплодных землях их больше), дистилляционная колонна делит нефть на бензин, дизель, керосин и газ.",
		" ",
		"Зачем: двигатели, генераторы и пластик эпохи стали.",
	]
	quest.29DEC34A72369A8E.title: "Ракетное топливо"
	quest.29DEC34A72369A8E.quest_desc: [
		"Как сделать: механический электролизёр делит воду на водород и кислород, ожижитель воздуха даёт жидкий кислород, всё это копится в криогенных цистернах. Вёдрами топливо не носят — только трубы и цистерны.",
		" ",
		"Зачем: без топлива ракета остаётся памятником.",
	]
	quest.037F7593A8C97FE0.title: "Лунный карьер"
	quest.037F7593A8C97FE0.quest_desc: [
		"Как сделать: на Луне тот же экструдер или бур на подшипнике; ценные лунные руды идут через дробление и промывку, как дома.",
		" ",
		"Зачем: стройматериал для лунной базы на месте — возить камень с Земли ракетой дорого.",
	]
	quest.23F84575BE33D32D.title: "Сомнительные фермы"
	quest.23F84575BE33D32D.quest_desc: [
		"Ратибор морщится, когда слышит слова «ферма железных големов», «ферма рейдов» и «зал торговцев». Строить их можно, но тогда железо, тотемы и «Починка» перестают быть наградой, а «Лавка артели» скучает без покупателей. Летопись это запомнит.",
		" ",
		"Совет: если строите — открывайте их не раньше эпохи стали, когда игра уже про другое.",
	]
	chapter.388F77CD4F772EF4.title: "&#90BE6DЗвери, рыбалка и фермы&r"
	chapter.388F77CD4F772EF4.subtitle: "Живность мира, рыбалка Aquaculture, хранение урожая и автоматические фермы."
	quest.648CA8E4002792F8.title: "Натуралист"
	quest.648CA8E4002792F8.quest_desc: [
		"В мире десятки новых животных: олени, медведи, змеи, светлячки. Сачком ловятся бабочки и светлячки.",
		" ",
		"",
		" ",
		"Летопись: «Перед Великой выработкой звери ушли в горы, а мы заметили это последними. Запишите, кто живёт рядом с вами. Если однажды список станет короче — остановитесь».",
	]
	quest.46BB8658D89E5BEA.title: "Охота"
	quest.5E07AFF348EDFEA5.title: "Светлячки"
	quest.107929A294983AF4.title: "Питомец"
	quest.107929A294983AF4.quest_desc: [
		"Critters & Companions: приручите хорька, красную панду или паука-скакуна. Friends & Foes: блик (glare) подсвечивает тёмные места.",
	]
	quest.61F5087944156F29.title: "Кои"
	quest.372CAC49BD881CCB.title: "Шёлк и крюк"
	quest.372CAC49BD881CCB.quest_desc: [
		"Шёлк от паука-скакуна — для крюка-кошки, лучшего инструмента скалолаза.",
	]
	quest.47D53965F4099D7E.title: "Медный голем"
	quest.47D53965F4099D7E.quest_desc: [
		"Медный блок + тыква + громоотвод — маленький помощник, который нажимает медные кнопки.",
	]
	quest.6035F63716FF33C1.title: "Тотемы иллагеров"
	quest.6035F63716FF33C1.quest_desc: [
		"Ледяной и иллюзорный иллагеры прячутся в хижинах — их тотемы спасают по-новому.",
	]
	quest.170EB030A9F86563.title: "Эндермены биомов"
	quest.6A93004FFBD6C81F.title: "Кленовый сироп"
	quest.7EE2EA2995FDE8B4.title: "Рыбалка"
	quest.7EE2EA2995FDE8B4.quest_desc: [
		"Aquaculture: червяки с фермы — наживка, крючки и леска настраиваются в ящике для снастей. В каждом биоме своя рыба.",
	]
	quest.097E890E050C296D.title: "Снасти"
	quest.53427463D093ECE7.title: "Трофейная рыба"
	quest.53427463D093ECE7.quest_desc: [
		"Тунец — в океане, арапайма — в джунглях.",
	]
	quest.6D222AD1354FA4F1.title: "Сокровище со дна"
	quest.47C6BB6818338F4F.title: "Морепродукты"
	quest.061A25FE70E5C239.title: "Ящики"
	quest.061A25FE70E5C239.quest_desc: [
		"Storage Drawers: каждый ящик хранит много одного предмета, сжимающий сам переводит самородки в слитки и блоки.",
	]
	quest.1D1B7F599AF0A561.title: "Склад урожая"
	quest.1D1B7F599AF0A561.quest_desc: [
		"Контроллеры собирают ящики и бочки в одну сеть — воронка Create кладёт урожай в контроллер, а он раскладывает сам.",
	]
	quest.1F76C6E74D4BC47E.title: "Полив и удобрения"
	quest.1F76C6E74D4BC47E.quest_desc: [
		"Slice & Dice: разбрызгиватели поливают и удобряют грядки — урожай растёт быстрее.",
	]
	quest.4DF2762B75E31C53.title: "Автоферма"
	quest.4DF2762B75E31C53.quest_desc: [
		"Командная цель: поле с поливом, механическая жатка собирает урожай, ремни везут его на склад — без рук.",
	]
	quest.220CBAA0AAF68C08.title: "Зоопарк"
	quest.220CBAA0AAF68C08.quest_desc: [
		"Командная цель: вольеры минимум с пятью разными видами животных из разных модов.",
	]
	quest.43715C376C3EA5D7.title: "Пасека"
	quest.43715C376C3EA5D7.quest_desc: [
		"Насос вытягивает мёд из улья прямо в бак — для дозатора и кухни.",
	]
	quest.6761C7B4E826A261.title: "Насесты"
	quest.6761C7B4E826A261.quest_desc: [
		"Create Integrated Farming: курица в насесте несёт яйца и роняет перья в воронку — птичник без мобов на полу.",
	]
	quest.42112A28B6C69D90.title: "Рыболовная сеть"
	quest.42112A28B6C69D90.quest_desc: [
		"Сеть на движущейся машине — лодке или поезде над водой — ловит рыбу на ходу. Есть и лавовая сеть для Незера.",
	]
	quest.3A4ED3F79573E9E2.title: "Аквариум"
	quest.62A5E5D0A5F4D4F0.title: "Небо полно птиц"
	quest.62A5E5D0A5F4D4F0.quest_desc: [
		"Fowl Play: птицы теперь по-настоящему летают стаями — чайки на побережье, вороны и голуби у полей, гуси у рек, ястребы над лесом. Пугало отгоняет ворон от грядок.",
	]
	quest.2C3008D3F1456B86.title: "Породистое хозяйство"
	quest.2C3008D3F1456B86.quest_desc: [
		"Earth Mobs: нарядные куры, рогатые овцы, чайные свинки, гигантские и прыгучие кролики. Перо нарядной курицы и рог рогатой овцы — доказательство, что вы их нашли.",
	]
	quest.0E96D6C35503C980.title: "Жизнь побережья"
	quest.0E96D6C35503C980.quest_desc: [
		"Spawn: на скалистых берегах и в морских лугах живут моллюски, морские коровы, осьминоги, луна-рыбы и тюлени. Удильщик светится в глубине — поймайте его ведром.",
	]
	quest.52EF94D584C246DC.title: "Муравьиная ферма"
	quest.52EF94D584C246DC.quest_desc: [
		"Муравьи из муравейников собирают всё, что лежит вокруг. Ферма держит колонию дома.",
	]
	quest.265801186363658A.title: "Трэшер"
	quest.265801186363658A.quest_desc: [
		"Upgrade Aquatic: в холодных океанах охотятся трэшеры — они чувствуют вибрацию и бьют током. Щука водится в реках.",
	]
	quest.017A9AC58435BBB1.title: "Рыбалка в лаве"
	quest.017A9AC58435BBB1.quest_desc: [
		"Nether Depths Upgrade: в лавовых озёрах Незера плавают обсидиановые рыбы, лавовые иглобрюхи и огненные треска. Обычная удочка там сгорит.",
	]
	quest.57F76869F4929731.title: "Совиное гнездо"
	quest.57F76869F4929731.quest_desc: [
		"Ender Zoology: совы охотятся на пауков и несут яйца. Лютые волки бродят по снежным лесам — не ходите туда в одиночку.",
	]
	quest.2A49C2B7547DB685.title: "Лягушачий базар"
	quest.2A49C2B7547DB685.quest_desc: [
		"Ribbits: в болотах стоят деревни лягушек-торговцев — рыбаки, садовники, колдуны. Торгуются они за янтарь.",
		" ",
		"",
		" ",
		"§6Компас исследователя:§r Ribbit Village (Ribbits).",
	]
	quest.2686668689286D25.title: "Пленник поместья"
	quest.2686668689286D25.quest_desc: [
		"Eternal Nether: в поместье пиглинов держат пленного пиглина. Освободите его — охотники-пиглины этого не простят.",
		" ",
		"",
		" ",
		"§6Компас исследователя:§r Piglin Manor (Eternal Nether).",
	]
	chapter.5C651509E771767F.title: "&#2A9D8FЖители и торговля&r"
	chapter.5C651509E771767F.subtitle: "Торговля, монеты, стража и жители за станками Create."
	quest.2658DC25D6B3DA7D.title: "Деревня"
	quest.2658DC25D6B3DA7D.quest_desc: [
		"Деревни — источник торговли, еды и жителей. В сборке они переработаны (ChoiceTheorem's Overhauled Village) и заметно крупнее обычных.",
		" ",
		"",
		" ",
		"Летопись: «Деревни стояли здесь задолго до нас. Мы торговали с ними, пока были щедры, а потом стали брать. Наши ученики, оставшись без работы, ушли в иллагеры и грабили эти же деревни. Торгуйте честно и берегите их».",
		" ",
		"",
		" ",
		"Награда за первую деревню — в «Эпохе 0» («Найти деревню»). Здесь деревня открывает главу.",
		" ",
		"",
		" ",
		"§6Компас исследователя (подойдёт любая):§r ChoiceTheorem's Overhauled Village: Large/village Beach, Large/village Christmas, Large/village Desert, Large/village Desert Oasis, Large/village Dark Forest; Minecraft: Равнинная деревня, Пустынная деревня, Саванная деревня, Заснеженная деревня, Таёжная деревня и ещё 61.",
	]
	quest.689955EBFEFBEE47.title: "Изумруды"
	quest.689955EBFEFBEE47.quest_desc: [
		"Валюта жителей.",
	]
	quest.580BCAE9E6CE216C.title: "Профессии"
	quest.580BCAE9E6CE216C.quest_desc: [
		"Just Enough Professions показывает в JEI, какой рабочий блок даёт какую профессию.",
	]
	quest.11B1C884F639507E.title: "Исцеление"
	quest.11B1C884F639507E.quest_desc: [
		"Бросьте в зомби-жителя зелье слабости и дайте ему золотое яблоко. Вылеченный житель навсегда торгует со скидкой.",
	]
	quest.183F2694AA369842.title: "Торговый склад"
	quest.183F2694AA369842.quest_desc: [
		"Аддон Create: склад торгует с жителем перед ним, а товары подаются и забираются механизмами Create.",
	]
	quest.3722F79F88DAAC1E.title: "Рабочие руки"
	quest.3722F79F88DAAC1E.quest_desc: [
		"Create Villager Labor сажает жителей за станки Create. Shift + ПКМ привязкой по жителю, затем Shift + ПКМ по рабочему сиденью, и житель займёт место.",
	]
	quest.79555F0FF44A37BA.title: "Пресс с рабочим"
	quest.79555F0FF44A37BA.quest_desc: [
		"Посаженный житель сам работает на прессе.",
	]
	quest.212E828BE86D1EE0.title: "Миксер с рабочим"
	quest.212E828BE86D1EE0.quest_desc: [
		"Житель берёт на себя рецепты смешивания.",
	]
	quest.781937B74390881F.title: "Жернова с рабочим"
	quest.781937B74390881F.quest_desc: [
		"Житель мелет зерно и руду на жерновах.",
	]
	quest.05926B4D3859C7F8.title: "Пила с рабочим"
	quest.05926B4D3859C7F8.quest_desc: [
		"Житель распиливает брёвна и камень.",
	]
	quest.53E5411E4A9D48F0.title: "Рабочие перчатки"
	quest.53E5411E4A9D48F0.quest_desc: [
		"Улучшение для сиденья миксера: житель сможет готовить рецепты с нагревом.",
	]
	quest.0BD872A6E132BA98.title: "Постоянный рабочий"
	quest.0BD872A6E132BA98.quest_desc: [
		"Примените к сиденью, и на нём появится постоянный житель-рабочий. Ловить и водить жителей больше не нужно.",
	]
	quest.2859F5709F676199.title: "Латунный цех"
	quest.2859F5709F676199.quest_desc: [
		"Сиденья бывают андезитовые, медные и латунные, как и детали Create. Соберите цех из латуни.",
	]
	quest.2FB3669343F67A3E.title: "Стража"
	quest.2FB3669343F67A3E.quest_desc: [
		"В деревнях служат стражники из Guard Villagers. Они защищают жителей и игроков-союзников, их можно экипировать.",
	]
	quest.0191994FE0A2F870.title: "Герой деревни"
	quest.0191994FE0A2F870.quest_desc: [
		"Отразите набег разбойников. Разоритель — главная цель, а с Вызывателя падает Тотем бессмертия.",
	]
	quest.2ED598306999F658.title: "Гоблины-торговцы"
	quest.2ED598306999F658.quest_desc: [
		"Гоблины иногда появляются под землёй, а их жилковые собратья — в Незере. Они продают редкие товары.",
	]
	quest.2CD88606C1AE94EC.title: "Шляпа жителя"
	quest.2CD88606C1AE94EC.quest_desc: [
		"Артефакт из сундуков. Пока шляпа на вас, жители продают дешевле.",
	]
	quest.782F00D1CBFEEC77.title: "Банковский счёт"
	quest.782F00D1CBFEEC77.quest_desc: [
		"Create: Numismatics даёт серверу свои монеты: шпора (1), фаска (8), звёздочка (16), шестерёнка (64), коронка (512) и солнышко (4096). В банковском терминале их кладут на счёт и снимают. Квесты этой ветки платят монетами.",
		" ",
		"",
		" ",
		"Награда за банковский терминал — в «Эпохе 4» (квест «Банк»).",
	]
	quest.19FF6DD1272E94B3.title: "Своя лавка"
	quest.19FF6DD1272E94B3.quest_desc: [
		"Торговый автомат продаёт ваши товары другим игрокам за монеты. Shift + ПКМ открывает настройки.",
		" ",
		"",
		" ",
		"Награда за торговый автомат — в «Эпохе 4» (квест «Торговый автомат»).",
	]
	quest.22559023B528869C.title: "Платный проход"
	quest.22559023B528869C.quest_desc: [
		"Валидатор принимает оплату и выдаёт сигнал красного камня: платные двери, лифты, билеты на поезд.",
	]
	quest.0A3EA0673EEC8504.title: "Общая казна"
	quest.0A3EA0673EEC8504.quest_desc: [
		"Инструкция банкира превращает горелку всполоха во всполоха-банкира. Это счёт для нескольких игроков, например казна команды.",
	]
	quest.3D99FF00DB2F6952.title: "Рынок"
	quest.3D99FF00DB2F6952.quest_desc: [
		"Откройте торговый ряд и продавайте друзьям то, что производят ваши фабрики.",
	]
	quest.78389CE2CC3C1B88.title: "Торговая империя"
	quest.78389CE2CC3C1B88.quest_desc: [
		"Ваша экономика работает. Пора строить свою колонию!",
	]
	chapter.496D413A0F49A695.title: "&#E9C46AБиржа контрактов&r"
	chapter.496D413A0F49A695.subtitle: "Повторяемые заказы: сдайте партию товара — получите монеты. Повод автоматизировать каждую линию."
	quest.75B148B996AF893A.title: "Как работает биржа"
	quest.75B148B996AF893A.quest_desc: [
		"Каждый контракт повторяемый: нажмите «Сдать», товар заберут из инвентаря, монеты Numismatics придут сразу, а контракт откроется снова.",
		" ",
		"",
		" ",
		"Цены рассчитаны так, чтобы ручной сбор окупался слабо, а автоматическая линия — хорошо. Монеты тратьте в лавках друзей и на банковском счёте.",
	]
	quest.5E28C409D5CB0441.title: "Андезитовый сплав"
	quest.5E28C409D5CB0441.quest_desc: [
		"Бригада строит новый цех — нужен сплав.",
	]
	quest.0C8ACC1CD809AC57.title: "Хлеб для артели"
	quest.0C8ACC1CD809AC57.quest_desc: [
		"Обеды для рабочих — пекарня на мельнице окупится.",
	]
	quest.2352D22A581C715E.title: "Горячие обеды"
	quest.2352D22A581C715E.quest_desc: [
		"Сытная еда для шахтёров.",
	]
	quest.60E41E602974308C.title: "Латунь"
	quest.60E41E602974308C.quest_desc: [
		"Мастерским нужна латунь для механизмов.",
	]
	quest.0C0B9BFBA89A1184.title: "Пиво в таверну"
	quest.0C0B9BFBA89A1184.quest_desc: [
		"Таверна на станции всегда хочет пива.",
	]
	quest.1FA963E57AC10F48.title: "Вино"
	quest.1FA963E57AC10F48.quest_desc: [
		"Праздник в деревне — нужно вино.",
	]
	quest.48C4ACAF55EEBAC5.title: "Шоколад"
	quest.48C4ACAF55EEBAC5.quest_desc: [
		"Сладости к ярмарке.",
	]
	quest.44DC490CB2DFA82B.title: "Рельсы для магистрали"
	quest.44DC490CB2DFA82B.quest_desc: [
		"Каждый километр магистрали — тысяча рельсов.",
	]
	quest.4A5C26596C70E21F.title: "Механизмы точности"
	quest.4A5C26596C70E21F.quest_desc: [
		"Точная механика для штурманских столов и рук.",
	]
	quest.3D7D8396104FD3B9.title: "Сталь"
	quest.3D7D8396104FD3B9.quest_desc: [
		"Сталь для мостов и котлов.",
	]
	quest.260B652D22C3E988.title: "Пластик"
	quest.260B652D22C3E988.quest_desc: [
		"Нефтехимия кормит электронику.",
	]
	quest.5C95754429021E4C.title: "Печатные платы"
	quest.5C95754429021E4C.quest_desc: [
		"Платы для пультов и ракет.",
	]
	quest.72BF7FF0C40952A5.title: "Снаряды для обороны"
	quest.72BF7FF0C40952A5.quest_desc: [
		"Батареям у ворот нужен запас.",
	]
	chapter.6AC229FA60BF18CA.title: "&#E9C46AЗаказы Ратибора&r"
	chapter.6AC229FA60BF18CA.subtitle: "Четыре заказа в неделю: по одному на ступень. Новые — каждый понедельник."
	quest.7FFD99F0CED01858.title: "Доска заказов"
	quest.7FFD99F0CED01858.quest_desc: [
		"Каждый понедельник в полночь по Москве Ратибор вывешивает четыре заказа — по одному на каждую ступень: Подмастерье, Мастер, Инженер и Великий заказ. Заказ выполняется один раз за неделю и платит в два-четыре раза щедрее биржи.",
		" ",
		"",
		" ",
		"Заказы старших ступеней появятся, когда команда дойдёт до нужной эпохи.",
		" ",
		"",
		" ",
		"§6Сдавайте заказ целиком и забирайте награду до понедельника:§r в полночь доска обновляется, недоделанный заказ сгорает вместе со сданной частью.",
		" ",
		"",
		" ",
		"«Я не жадный. Я экономный. Разница — в монетах, которые вы получите». — Ратибор",
	]
	quest.2CF091C57E980F0D.title: "Заказ недели: Шестерни на склад"
	quest.2CF091C57E980F0D.quest_desc: [
		"Служебный квест доски заказов: открывает заказ этой недели.",
	]
	quest.106EC15D4976C65D.title: "§6Подмастерье:§r Шестерни на склад"
	quest.106EC15D4976C65D.quest_subtitle: "Заказ недели · Подмастерье"
	quest.106EC15D4976C65D.quest_desc: [
		"Шестерни опять кончились. Подозреваю, их кто-то ест. Нужно много — и маленьких, и больших.",
		" ",
		"",
		" ",
		"§7Сдать до понедельника, 00:00 по Москве.§r",
	]
	quest.3E46F342693390BA.title: "Заказ недели: Валы"
	quest.3E46F342693390BA.quest_desc: [
		"Служебный квест доски заказов: открывает заказ этой недели.",
	]
	quest.39F590193E88FBAC.title: "§6Подмастерье:§r Валы"
	quest.39F590193E88FBAC.quest_subtitle: "Заказ недели · Подмастерье"
	quest.39F590193E88FBAC.quest_desc: [
		"Вал — это шестерня, которая решила вытянуться. Нужно сто двадцать восемь таких решительных.",
		" ",
		"",
		" ",
		"§7Сдать до понедельника, 00:00 по Москве.§r",
	]
	quest.1305B323ECA7234E.title: "Заказ недели: Стекло для оранжереи"
	quest.1305B323ECA7234E.quest_desc: [
		"Служебный квест доски заказов: открывает заказ этой недели.",
	]
	quest.2869ABB1CFEAD86D.title: "§6Подмастерье:§r Стекло для оранжереи"
	quest.2869ABB1CFEAD86D.quest_subtitle: "Заказ недели · Подмастерье"
	quest.2869ABB1CFEAD86D.quest_desc: [
		"Строим оранжерею. Стекло — из песка, песок — из гравия, гравий — из булыжника. Всё это делает один дробильный цех.",
		" ",
		"",
		" ",
		"§7Сдать до понедельника, 00:00 по Москве.§r",
	]
	quest.1D3C17FEFD03BBEF.title: "Заказ недели: Андезитовые корпуса"
	quest.1D3C17FEFD03BBEF.quest_desc: [
		"Служебный квест доски заказов: открывает заказ этой недели.",
	]
	quest.562049D856052268.title: "§6Подмастерье:§r Андезитовые корпуса"
	quest.562049D856052268.quest_subtitle: "Заказ недели · Подмастерье"
	quest.562049D856052268.quest_desc: [
		"Новой мельнице нужны корпуса. Старые кто-то разобрал «посмотреть, как устроено».",
		" ",
		"",
		" ",
		"§7Сдать до понедельника, 00:00 по Москве.§r",
	]
	quest.55326995BCF86EFB.title: "Заказ недели: Топливо для котлов"
	quest.55326995BCF86EFB.quest_desc: [
		"Служебный квест доски заказов: открывает заказ этой недели.",
	]
	quest.71A646CE102DB59B.title: "§6Подмастерье:§r Топливо для котлов"
	quest.71A646CE102DB59B.quest_subtitle: "Заказ недели · Подмастерье"
	quest.71A646CE102DB59B.quest_desc: [
		"Сушёная ламинария горит не хуже угля, а растёт сама. Ферма у берега окупится за неделю.",
		" ",
		"",
		" ",
		"§7Сдать до понедельника, 00:00 по Москве.§r",
	]
	quest.716C9FDCECA3EECC.title: "Заказ недели: Хлеб для артели"
	quest.716C9FDCECA3EECC.quest_desc: [
		"Служебный квест доски заказов: открывает заказ этой недели.",
	]
	quest.5836EE4772AC8C94.title: "§6Подмастерье:§r Хлеб для артели"
	quest.5836EE4772AC8C94.quest_subtitle: "Заказ недели · Подмастерье"
	quest.5836EE4772AC8C94.quest_desc: [
		"Артель работает в три смены, и все три хотят есть. Мельница и печь — лучшие друзья бригадира.",
		" ",
		"",
		" ",
		"§7Сдать до понедельника, 00:00 по Москве.§r",
	]
	quest.3C028E127F3709C1.title: "Заказ недели: Латунные корпуса"
	quest.3C028E127F3709C1.quest_desc: [
		"Служебный квест доски заказов: открывает заказ этой недели.",
	]
	quest.6FA5E4C97518B74F.title: "§6Мастер:§r Латунные корпуса"
	quest.6FA5E4C97518B74F.quest_subtitle: "Заказ недели · Мастер"
	quest.6FA5E4C97518B74F.quest_desc: [
		"Латунь блестит, латунь звенит, латунь нужна всем. Мне — тридцать два корпуса.",
		" ",
		"",
		" ",
		"§7Сдать до понедельника, 00:00 по Москве.§r",
	]
	quest.0B5C19793885B2A9.title: "Заказ недели: Электронные лампы"
	quest.0B5C19793885B2A9.quest_desc: [
		"Служебный квест доски заказов: открывает заказ этой недели.",
	]
	quest.42361E3C4B4FEAF3.title: "§6Мастер:§r Электронные лампы"
	quest.42361E3C4B4FEAF3.quest_subtitle: "Заказ недели · Мастер"
	quest.42361E3C4B4FEAF3.quest_desc: [
		"Лампы для умной логистики. Без них склады думают медленно, а я не люблю, когда склады думают медленно.",
		" ",
		"",
		" ",
		"§7Сдать до понедельника, 00:00 по Москве.§r",
	]
	quest.3D6D1BFB84387656.title: "Заказ недели: Конвейерные ленты"
	quest.3D6D1BFB84387656.quest_desc: [
		"Служебный квест доски заказов: открывает заказ этой недели.",
	]
	quest.409442411C770D86.title: "§6Мастер:§r Конвейерные ленты"
	quest.409442411C770D86.quest_subtitle: "Заказ недели · Мастер"
	quest.409442411C770D86.quest_desc: [
		"Шестьдесят четыре ленты. Да, это много резины. Нет, ламинарию на ленты не пускаем — её ест котёл.",
		" ",
		"",
		" ",
		"§7Сдать до понедельника, 00:00 по Москве.§r",
	]
	quest.27A3C7E1EEC890D2.title: "Заказ недели: Медные листы"
	quest.27A3C7E1EEC890D2.quest_desc: [
		"Служебный квест доски заказов: открывает заказ этой недели.",
	]
	quest.4531FF093C10BD4B.title: "§6Мастер:§r Медные листы"
	quest.4531FF093C10BD4B.quest_subtitle: "Заказ недели · Мастер"
	quest.4531FF093C10BD4B.quest_desc: [
		"Трубам нужна медь, баку нужна медь, крыше вокзала нужна медь. Пресс справится.",
		" ",
		"",
		" ",
		"§7Сдать до понедельника, 00:00 по Москве.§r",
	]
	quest.64F5885A91175645.title: "Заказ недели: Шоколад к ярмарке"
	quest.64F5885A91175645.quest_desc: [
		"Служебный квест доски заказов: открывает заказ этой недели.",
	]
	quest.3FD0B204B8392FE6.title: "§6Мастер:§r Шоколад к ярмарке"
