	quest.552456BB6C4A265E.quest_desc: [
		"Мост через реку. Деревянный уже унесло течением. Ну, течение мы ослабили, но всё равно.",
		" ",
		"",
		" ",
		"§7Сдать до понедельника, 00:00 по Москве.§r",
