	image.7A2AD6EE3ACC123C.title: "Подмастерье"
	image.71E9CCF6916FF0D3.title: "Мастер"
	image.3AFC0839FB33A857.title: "Инженер"
	image.390B42136569120E.title: "Великий заказ"
	chapter.3454B04FF0C25AD0.title: "&#F4A261Лавка артели&r"
	chapter.3454B04FF0C25AD0.subtitle: "Монеты с биржи и жетоны стражей — на то, что не скрафтить. Каждую покупку можно повторять."
	quest.169ACB71D2B05BC1.title: "Как работает лавка"
	quest.169ACB71D2B05BC1.quest_desc: [
		"Нажмите «Сдать» в покупке — монеты или жетоны заберут из инвентаря, товар придёт сразу, а покупка откроется снова.",
		" ",
		"",
		" ",
		"Монеты Numismatics дают контракты на бирже, квесты и торговля между гильдиями. Жетон стража получает каждый, кто стоял рядом (64 блока), когда пал страж постройки: Игнис, Левиафан, Ночной лич, Корнелия и другие. Иссушитель, Хранитель и Эндер-дракон жетонов не дают.",
	]
	quest.480B44A735ED345E.title: "Опыт в бутылках"
	quest.480B44A735ED345E.quest_desc: [
		"Телепорты стоят опыта — его можно и купить.",
	]
	quest.60EB61AF811FC73B.title: "Свитки возвращения"
	quest.60EB61AF811FC73B.quest_desc: [
		"Домой из любой дали — к своему путевому камню.",
	]
	quest.1E39FF72DA62B8CE.title: "Компас природы"
	quest.1E39FF72DA62B8CE.quest_desc: [
		"Найдёт любой биом.",
	]
	quest.7F3D9C6F23666183.title: "Компас исследователя"
	quest.7F3D9C6F23666183.quest_desc: [
		"Найдёт любую постройку — и логово стража тоже.",
	]
	quest.2D58913773EB03D1.title: "Седло"
	quest.2D58913773EB03D1.quest_desc: [
		"Для коня, свиньи или страйдера.",
	]
	quest.370A476FA340105F.title: "Бирки"
	quest.370A476FA340105F.quest_desc: [
		"Назовите зверя — и он не исчезнет.",
	]
	quest.53FFC1739282123E.title: "Золотая морковь"
	quest.53FFC1739282123E.quest_desc: [
		"Лучшая еда в дорогу.",
	]
	quest.50E7AADD08CBF41A.title: "Яйцо нюхача"
	quest.50E7AADD08CBF41A.quest_desc: [
		"Нюхач откапывает древние семена.",
	]
	quest.40C185F50B5A122B.title: "Сердце моря"
	quest.40C185F50B5A122B.quest_desc: [
		"Для проводника — дышать и видеть под водой.",
	]
	quest.796FE00AE923E1BF.title: "Тотем бессмертия"
	quest.796FE00AE923E1BF.quest_desc: [
		"Один раз спасёт от смерти.",
	]
	quest.743AE4CFD7332EC6.title: "Книга «Починка»"
	quest.743AE4CFD7332EC6.quest_desc: [
		"Опыт чинит снаряжение.",
	]
	quest.42822013BCB2C7C9.title: "Шаблон незеритового улучшения"
	quest.42822013BCB2C7C9.quest_desc: [
		"Без похода в бастион.",
	]
	quest.0B0E7A0AF77CBD7A.title: "Зачарованное золотое яблоко"
	quest.0B0E7A0AF77CBD7A.quest_desc: [
		"Для самого трудного боя.",
	]
	quest.049CEBD0729F0D81.title: "Элитры"
	quest.049CEBD0729F0D81.quest_desc: [
		"Крылья без поиска кораблей Края — для тех, кто уже побывал в Крае.",
	]
	quest.57ED6836EF5E62DE.title: "Сдать жетон в казну"
	quest.57ED6836EF5E62DE.quest_desc: [
		"Казна артели выкупит жетон за 4 шестерни.",
	]
	chapter.54161B9819F9D227.title: "&#E76F51Исследование мира&r"
	chapter.54161B9819F9D227.subtitle: "Структуры, измерения, археология и артефакты."
	quest.05B4081B9721AB3B.title: "В путь!"
	quest.05B4081B9721AB3B.quest_desc: [
		"Мир сборки полон структур: Dungeons Arise, Structory, переработанные деревни, данжи Cataclysm, Legendary Monsters и Bosses of Mass Destruction.",
		" ",
		"Lootr: у каждого игрока свой лут в сундуках — исследуйте вместе, никто не останется без добычи.",
		" ",
		"Совет для сервера: соберитесь в гильдию (FTB Teams, до 4 игроков, кнопка в инвентаре) — прогресс квестов общий внутри гильдии.",
		" ",
		"",
		" ",
		"Летопись: «Мы прошли эту землю вдоль и поперёк, но смотрели только под ноги — где руда, где уголь. Наследник, смотри и по сторонам: в руинах лежат наши записки, а в каждой постройке — чья-то история».",
	]
	quest.4A4D6BBFDFD8D405.title: "Компас природы"
	quest.4A4D6BBFDFD8D405.quest_desc: [
		"Находит любой биом.",
	]
	quest.3584BC96C05B81A9.title: "Компас исследователя"
	quest.3584BC96C05B81A9.quest_desc: [
		"Находит любую структуру — включая логова боссов.",
	]
	quest.7CD3245C528E9F02.title: "Путевой камень"
	quest.7CD3245C528E9F02.quest_desc: [
		"Сеть телепортов. Активируйте найденные камни и ставьте свои на базах. Перемещение стоит опыта: чем дальше, тем дороже (до 27 уровней), в другое измерение — сразу 27. Глобальные камни стоят столько же, варп-плиты — вдвое дешевле. Для дальних маршрутов выгоднее поезд или корабль.",
	]
	quest.2CA71200DC80629F.title: "Свиток возвращения"
	quest.27456D2E34802369.title: "Камень перемещения"
	quest.27456D2E34802369.quest_desc: [
		"Переносной телепорт к любому активированному камню.",
	]
	quest.0C9F9F01CFF640B2.title: "Археология"
	quest.0C9F9F01CFF640B2.quest_desc: [
		"Подозрительный песок и гравий скрывают находки. Better Archeology добавляет окаменелости и древние артефакты.",
	]
	quest.1A1EC416333250E2.title: "Неопознанный артефакт"
	quest.0681202113C8FFF2.title: "Стол археолога"
	quest.0681202113C8FFF2.quest_desc: [
		"Расшифруйте находку на столе — получится древний предмет с особым свойством (тотемы, бомбы и другое).",
	]
	quest.2D1F7C5D0EA6A458.title: "Артефакты"
	quest.2D1F7C5D0EA6A458.quest_desc: [
		"В сундуках структур попадаются артефакты: бутылка с облаком, беговые кроссовки, когти и многое другое. Осторожно: некоторые сундуки — мимики!",
	]
	quest.7E1F90B300B465D7.title: "Подземелья мира"
	quest.7E1F90B300B465D7.quest_desc: [
		"Испытательные камеры, древние города, подводные крепости и особняки — плюс десятки структур из Dungeons Arise и Structory. Заглядывайте во всё, что увидите.",
	]
	quest.4C3524EDA359F682.title: "Испытательные камеры"
	quest.4C3524EDA359F682.quest_desc: [
		"§6Компас исследователя:§r Trial Chambers (Minecraft).",
	]
	quest.2A0A115E794F6C18.title: "Ключ испытаний"
	quest.6E2D5370531169F7.title: "Булава"
	quest.6E2D5370531169F7.quest_desc: [
		"Тяжёлое ядро выпадает из зловещих хранилищ. Из него и стержня вихря делается булава.",
	]
	quest.720E2A84641D95E3.title: "Незер"
	quest.720E2A84641D95E3.quest_desc: [
		"Награда за первый поход в Незер — в «Эпохе 2» («В Незер»). Здесь Незер открывает поиск крепости и бастиона.",
	]
	quest.7D9ACB82381CA35B.title: "Крепость Незера"
	quest.7D9ACB82381CA35B.quest_desc: [
		"§6Компас исследователя:§r Крепость Незера (Minecraft).",
	]
	quest.649777B977AB5A64.title: "Бастион"
	quest.649777B977AB5A64.quest_desc: [
		"§6Компас исследователя:§r Развалины бастиона (Minecraft).",
	]
	quest.1DC70211B9AE8946.title: "Незерит"
	quest.1DC70211B9AE8946.quest_desc: [
		"",
		" ",
		"§6С этой версии незерит плавится только в смесителе с перегревом: 4 обломка + 2 золота + 2 стали TFMG. Сохраните обломки до эпохи стали.§r",
	]
	quest.2689AE7493FD8B7D.title: "Крепость"
	quest.2689AE7493FD8B7D.quest_desc: [
		"Око Эндера ведёт к крепости с порталом в Край.",
		" ",
		"",
		" ",
		"§6Компас исследователя:§r Крепость в Энд (Minecraft).",
	]
	quest.0198B30433C0AD4D.title: "Край"
	quest.0198B30433C0AD4D.quest_desc: [
		"Награда за Край — в главе «Небо: корабли и джетпаки» (квест «Край»). Здесь Край открывает поиск города Края.",
	]
	quest.69BD03EE3F98CBF1.title: "Город Края"
	quest.69BD03EE3F98CBF1.quest_desc: [
		"Элитры хранятся на кораблях Края.",
		" ",
		"",
		" ",
		"§6Компас исследователя:§r Город Энда (Minecraft).",
	]
	quest.2E5781E0AB6080EC.title: "Древний город"
	quest.2E5781E0AB6080EC.quest_desc: [
		"Не шумите — здесь охотится Хранитель.",
		" ",
		"",
		" ",
		"§6Компас исследователя:§r Ancient City (Minecraft).",
	]
	quest.4ADDF55ACD6F5E6A.title: "Компас восстановления"
	quest.4ADDF55ACD6F5E6A.quest_desc: [
		"Указывает на место последней смерти.",
	]
	quest.3155C400BA0020AF.title: "Подводная крепость"
	quest.3155C400BA0020AF.quest_desc: [
		"§6Компас исследователя:§r Океанский монумент (Minecraft).",
	]
	quest.3CFC306E8DBE0E31.title: "Сокровище"
	quest.3CFC306E8DBE0E31.quest_desc: [
		"Карты сокровищ лежат на затонувших кораблях.",
	]
	quest.5DCF5F177B22169F.title: "Лесной особняк"
	quest.5DCF5F177B22169F.quest_desc: [
		"§6Компас исследователя:§r Особняк (Minecraft).",
	]
	quest.083932C79138D22E.title: "Путешественник"
	quest.083932C79138D22E.quest_desc: [
		"Побывайте везде, где стоит побывать: Город Края, Древний город, незерит, булава и подводная крепость.",
	]
	quest.1EC1218CE11C10F0.title: "Параплан"
	quest.1EC1218CE11C10F0.quest_desc: [
		"Paragliders: прыгните с высоты и держите ПКМ с парапланом в руке, чтобы лететь. Полёт тратит выносливость — её колесо видно у прицела. Над костром и огнём поднимается тёплый поток, который несёт вверх.",
	]
	quest.7ADA1661351C3BC9.title: "Духовные сферы"
	quest.7ADA1661351C3BC9.quest_desc: [
		"Сферы выпадают из сломанных спаунеров, испытательных камер, стража-старейшины и попадаются в сундуках подземелий. Отнесите 4 сферы к Статуе Богини (её можно скрафтить или найти в деревнях) и получите сосуд выносливости: летать можно дольше. Сердца здесь не продаются — они растут от новых блюд и кристальных сердец.",
	]
	quest.35046B73B8850B23.title: "Башни на горизонте"
	quest.35046B73B8850B23.quest_desc: [
		"Structory: Towers ставит башни под каждый биом: дозорные, лесные, пустынные и другие. С верхушки далеко видно, а в сундуках бывает лут сборки, как в других постройках.",
		" ",
		"",
		" ",
		"§6Компас исследователя (подойдёт любая):§r Structory: Towers: Ancient Temple, Engineer Tower, Farmer Outpost, Foraging Outpost, Great Toadstool и ещё 16.",
	]
	quest.0860A224B4B7D61B.title: "Кости в пустоте"
	quest.0860A224B4B7D61B.quest_desc: [
		"Nullscape изменил Край: висящие острова, разломы и кристальные пики, а среди них лежат скелеты древних драконов. Найдите такой скелет. Возьмите с собой элитру или много блоков.",
		" ",
		"",
		" ",
		"§6Компас исследователя:§r Dragon Skeleton (Nullscape).",
	]
	quest.56E18D619505984F.title: "Летучий корабль Края"
	quest.56E18D619505984F.quest_desc: [
		"Unusual End оживил Край: летучие корабли, гнёзда сгустков, башни и острова странников. С Nullscape здесь встречаются его биомы — коралловые рифы и земли сгустков.",
		" ",
		"",
		" ",
		"§6Компас исследователя:§r Flying End Ship (Unusual End).",
	]
	quest.4073A19A4CE19B6C.title: "Королева сгустков"
	quest.4073A19A4CE19B6C.quest_desc: [
		"§6Ступень B6§r · рекомендуется броня T5+ (незерит и трофейная)",
		" ",
		"",
		" ",
		"Хозяйка гнезда сгустков, одна из сильнейших в Крае. Её броню почти не пробить: берите оружие с пробиванием брони и друзей.",
		" ",
		"",
		" ",
		"Летопись: «Дальние острова Края, где сгустки вьют гнёзда, мы так и не обжили, сколько бы левитита там ни лежало. Их королева не терпит гостей и не ведёт с ними торга. Мы оставили ей её острова — и, может быть, это было самое мудрое наше решение».",
	]
	chapter.4407398F80F7B747.title: "&#B8C4FFПод луной&r"
	chapter.4407398F80F7B747.subtitle: "Кровавая, урожайная, голубая и суперлуние: у каждой луны свои правила и своя добыча."
	quest.6A69EC405671CD11.title: "Лунный календарь"
	quest.6A69EC405671CD11.quest_desc: [
		"Иногда ночью восходит необычная луна — об этом сообщают в чате.",
		" ",
		"",
		" ",
		"§cКровавая луна:§r нежити втрое больше, она появляется прямо рядом, спать нельзя, на деревни нападают.",
		" ",
		"§6Урожайная луна:§r посевы дают больше урожая.",
		" ",
		"§9Голубая луна:§r больше опыта, дешевле зачарование и наковальня.",
		" ",
		"§aСуперлуние:§r слизни появляются где угодно.",
		" ",
		"У кровавой, урожайной и голубой есть «супер» — то же самое, только сильнее.",
		" ",
		"",
		" ",
		"Летописец советует: кровавую луну встречать за стенами, урожайную — в поле, голубую — у стола зачарований, суперлуние — с мечом и пустыми сундуками под слизь.",
	]
	quest.593D77D1B5095AFA.title: "Охота кровавой луны"
	quest.593D77D1B5095AFA.quest_desc: [
		"Победите 20 враждебных мобов под кровавой луной (можно за несколько лун).",
		" ",
		"",
		" ",
		"Нежить в эту ночь появляется прямо рядом, так что лучше держаться вместе и у стены.",
	]
	quest.75BBA6A9DDCC783F.title: "Дожить до рассвета"
	quest.75BBA6A9DDCC783F.quest_desc: [
		"Встретьте кровавую луну в Верхнем мире и доживите до её заката, ни разу не погибнув.",
		" ",
		"",
		" ",
		"Спать в эту ночь нельзя — кровать не поможет. Помогут стены, свет и друзья.",
	]
	quest.15E80221A0486886.title: "Урожайная ночь"
	quest.15E80221A0486886.quest_desc: [
		"Соберите 32 созревших посева под урожайной луной (можно за несколько лун).",
		" ",
		"",
		" ",
		"Комбайн Create не считается: собирать надо своими руками — луна любит личное участие.",
	]
	quest.248601BE4FF21097.title: "Голубая удача"
	quest.248601BE4FF21097.quest_desc: [
		"Наберите 5 уровней опыта за одну голубую луну.",
		" ",
		"",
		" ",
		"Опыта в эту ночь больше, а зачарование и наковальня дешевле — самое время для брони мечты.",
	]
	quest.4F75796BE0847468.title: "Слизневый дождь"
	quest.4F75796BE0847468.quest_desc: [
		"Победите 8 слизней в суперлуние (можно за несколько лун).",
		" ",
		"",
		" ",
		"В эту ночь они появляются где угодно. Слизь — это поршни, ленты и липкие механизмы Create.",
	]
	quest.41327865CBDB7989.title: "Под всеми лунами"
	quest.41327865CBDB7989.quest_desc: [
		"Вы видели все луны этого мира и пережили каждую.",
		" ",
		"",
		" ",
		"Летописец заносит в хронику: «Не боялись темноты. Боялись только пропустить интересное».",
	]
	chapter.6384AA12155B113A.title: "&#E63946Арсенал и оборона&r"
	chapter.6384AA12155B113A.subtitle: "Огнестрел Create Gunsmithing и патроны, пушки Big Cannons и снаряды, оборона базы и щиты — через все эпохи. Холодное оружие и луки — в главе «Оружие», доспехи — в главе «Броня»."
	quest.10B7D2BF5BA572F7.title: "Арсенал"
	quest.10B7D2BF5BA572F7.quest_desc: [
		"Шесть независимых веток: огнестрел, патроны, пушки, снаряды, оборона базы и щиты. Каждая идёт по эпохам слева направо: латунь, механизм точности, сталь, боссы. В квесте-семействе засчитывается любой один предмет, а клик по любому покажет его рецепт.",
		" ",
		"",
		" ",
		"Как сделать: обычный щит — 6 досок и железный слиток на верстаке.",
		" ",
		"",
		" ",
		"Летопись: «Первая артель долго обходилась без оружия: мы строили, а не воевали. Когда пришлось защищать мастерские от собственных учеников, ковать мечи было уже поздно. Готовьте оборону заранее».",
	]
	quest.61F51669057A5A69.title: "Свинец"
	quest.61F51669057A5A69.quest_desc: [
		"Create Gunsmithing: ружья собираются на верстаке и механическом сборщике, патроны — сборкой по шагам. На всё нужен свинец.",
		" ",
		"",
		" ",
		"Где взять: свинцовая руда TFMG в верхнем мире (руда Gunsmithing в этой сборке не генерируется). Переплавьте руду или дроблёную руду в печи; самородки — слиток на верстаке.",
	]
	quest.5372210F85C8C1F8.title: "Кремнёвое ружьё"
	quest.5372210F85C8C1F8.quest_desc: [
		"Как сделать: андезитовый сплав, железный лист, огниво и обтёсанное бревно на верстаке. Бумажный патрон — свинцовый самородок, порох и бумага (или сборка по шагам: бумага, порох, самородок).",
		" ",
		"",
		" ",
		"Один выстрел на перезарядку. Бумажная дробь (свинцовая картечь из самородков на камнерезе, порох и бумага) бьёт веером из 12 дробин.",
	]
	task.75F78B212C180387.title: "Любой предмет из списка"
	quest.2D103EFF73F65B56.title: "Мушкет и мушкетон"
	quest.2D103EFF73F65B56.quest_desc: [
		"Обвесы кремнёвого ружья ставятся клавишей «Изменить обвесы» (настройки управления, раздел NTGL Оружие).",
		" ",
		"",
		" ",
		"Как сделать: мушкетный ствол — 2 железных листа и 2 обтёсанных бревна; ствол мушкетона и длинный ствол мушкетона — железные листы и обтёсанное бревно; барабан кремнёвки — 8 железных листов вокруг шестерни.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	task.76928AFC347B7EF1.title: "Любой предмет из списка"
	quest.55E240F4678C38C1.title: "Приклад, прицел и штык"
	quest.55E240F4678C38C1.quest_desc: [
		"Общие обвесы. Приклад ставится на кремнёвку, револьвер, дробовик и гвоздомёт, прицел — на кремнёвку, револьвер и ракетницу, штык — на кремнёвку, большой штык — на ракетницу.",
		" ",
		"",
		" ",
		"Как сделать: приклад — латунный лист и обтёсанные брёвна; прицел — подзорная труба, латунный лист и чёрный краситель; штык — 2 железных листа и латунный лист, большой штык — 4 железных листа и латунный лист.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	quest.77780F3504F257AB.title: "Револьвер"
	quest.77780F3504F257AB.quest_desc: [
		"Как сделать: механический сборщик — андезитовый сплав, стальные листы и слиток, шестерня, латунный лист и обтёсанные брёвна. Сталь только из доменной печи TFMG.",
		" ",
		"",
		" ",
		"Шесть патронов в барабане: обычные и бронебойные револьверные (ветка патронов).",
	]
	task.03971271BBA6D833.title: "Любой предмет из списка"
	quest.73652F36B4E055A0.title: "Обвесы револьвера"
	quest.73652F36B4E055A0.quest_desc: [
		"Как сделать: длинный ствол — железные и латунный листы, обтёсанные брёвна; патронная лента (камора) — латунные самородки и стальные листы на механическом сборщике; автоматический огонь (рама) — андезитовый сплав, шестерня, латунный лист, механизм точности и валы на механическом сборщике.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	task.0E80BD6C4BC97CCB.title: "Любой предмет из списка"
	quest.6E3070B895BB4A7F.title: "Дробовик"
	quest.6E3070B895BB4A7F.quest_desc: [
		"Два ствола, патроны: дробовые, флешетты (гвозди), стальные флешетты и зажигательные.",
		" ",
		"",
		" ",
		"Как сделать: дробовик — механический сборщик: андезитовый сплав, стальные и латунные листы, обтёсанные брёвна. Длинные стволы — стальные и латунные листы с брёвнами, стволы-раструбы — стальные и железный листы, барабаны — шестерни, латунные и стальные листы, автозарядник — латунные листы, механизмы точности и андезитовый сплав (сборщик).",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	task.6010172D1037E0EA.title: "Любой предмет из списка"
	quest.1405461DC7088898.title: "Гатлинг"
	quest.1405461DC7088898.quest_desc: [
		"Сто патронов в коробе. Паровой двигатель — обвес «двигатель» для гатлинга, гвоздомёта и огнемёта.",
		" ",
		"",
		" ",
		"Как сделать: гатлинг — механический сборщик: стальные листы и слиток, латунные листы, шестерни, механизм точности, андезитовый сплав. Барабанный магазин — большая шестерня, андезитовый сплав и латунные листы. Паровой двигатель — доменная печь, паровой двигатель и маховик Create, латунные листы, механизм точности, труба и бак.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	task.00AC4331E845E807.title: "Любой предмет из списка"
	quest.0C4BB363D1D1CF68.title: "Гвоздомёт"
	quest.0C4BB363D1D1CF68.quest_desc: [
		"Пневматическое оружие: стреляет гвоздями, 40 гвоздей в магазине. Стальные гвозди — в ветке патронов.",
		" ",
		"",
		" ",
		"Как сделать: механический сборщик — андезитовый сплав, ящик для инструментов, вентиль, железные и латунные листы, механизм точности, трубы, медный баллон и обтёсанные брёвна. Гвозди — 3 железных самородка столбиком (или резка и прессовка самородка). Раструб — железные листы, жёлоб, механизм точности и трубы.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	quest.6437978C77D7DE73.title: "Огнемёт"
	quest.6437978C77D7DE73.quest_desc: [
		"Как сделать: механический сборщик — горелка всполоха, жёлоб, латунные листы, трубы, бак, андезитовый сплав и обтёсанные брёвна.",
		" ",
		"",
		" ",
		"Заправка: ПКМ по огнемёту топливом (уголь и другое горючее) или пирогом всполоха.",
	]
	task.6DD7B64DE465D41F.title: "Любой предмет из списка"
	quest.5671B097B9F914F7.title: "Ракетница"
	quest.5671B097B9F914F7.quest_desc: [
		"Четыре ракеты в стволе. Автозарядник — обвес-магазин ракетницы.",
		" ",
		"",
		" ",
		"Как сделать: ракетница — механический сборщик: андезитовый сплав, жёлоба, стальные и латунные листы, трубы, обтёсанные брёвна. Ракета — сборка по шагам: труба, динамит, латунный лист; малая ракета — из железного листа с латунью и динамитом. Автозарядник — ящик для инструментов, медные и латунные листы, трубы, медный баллон, шестерни и механизм точности.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	task.4A2267156ADD91EA.title: "Любой предмет из списка"
	quest.759440345AB6D06E.title: "Баллистазука"
	quest.759440345AB6D06E.quest_desc: [
		"Обвес-магазин ракетницы: вместо ракет она мечет копья.",
		" ",
		"",
		" ",
		"Как сделать: баллистазука — механический сборщик: маховики, железные и латунные листы, нитки, обтёсанные брёвна. Копьё — железные листы и обтёсанные брёвна на верстаке.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	quest.72FDF6FBA89E2F82.title: "Осколочная граната"
	quest.72FDF6FBA89E2F82.quest_desc: [
		"Как сделать: латунный и железный листы, медный самородок, порох и шестерня на верстаке.",
	]
	task.6E1FA2250BA20B03.title: "Любой предмет из списка"
	quest.4CA873468808C681.title: "Пневмомолот"
	quest.4CA873468808C681.quest_desc: [
		"Пневматическое оружие ближнего боя. Насадка-молот или насадка-топор ставится обвесом; с патронником молот стреляет холостыми дробовыми патронами.",
		" ",
		"",
		" ",
		"Как сделать: молот — механический сборщик: андезитовый сплав, латунный блок, механический поршень, медный баллон, обтёсанные брёвна. Насадки: каменная — из камня, железная и алмазная — блок и слитки, незеритовая — алмазная насадка на кузнечном столе. Патронник — стальной, медный и латунный листы с андезитовым сплавом.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	task.2D61F593DA723A85.title: "Любой предмет из списка"
	quest.7918413E6BB6F54F.title: "Оружие Вестника"
	quest.7918413E6BB6F54F.quest_desc: [
		"Где взять: блок ведьмита выпадает из Вестника (на верстаке он даёт слитки), ядро пустоты — из Эндер-голема.",
		" ",
		"",
		" ",
		"Как сделать: лазерный гатлинг — ведьмитовые слитки, железо, редстоун и блок редстоуна; наплечная пушка иссушения — ведьмит, порох и блок редстоуна; пушка пустоты — пушка иссушения и ядро пустоты на механической наковальне слияния (ведьмит, блоки редстоуна и наковальня).",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	task.66C8F501DF035764.title: "Любой предмет из списка"
	quest.4D7B9F923518F36F.title: "Свой порох"
	quest.4D7B9F923518F36F.quest_desc: [
		"Порох уходит на каждый патрон и заряд, крипер его не напасёт.",
		" ",
		"",
		" ",
		"Как сделать: порох — древесноугольная пыль, сера и селитра на верстаке (или в смесителе TFMG). Пыль — дробление древесного угля, сера — дробление блока магмы, селитра — смеситель с нагревом: гнилая плоть или гуано и 250 мБ воды.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	task.50D001798CCC8056.title: "Любой предмет из списка"
	quest.1E0C3D38B3FD973A.title: "Гильзы"
	quest.1E0C3D38B3FD973A.quest_desc: [
		"Как сделать: пресс-формы — железный слиток на камнерезе. Холостой патрон — сборка по шагам из латунного листа: развёртыватель кладёт пресс-форму (она остаётся), затем порох; у дробового ещё бумага. С одного листа — 8 гильз.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	task.69E4EAA50CA7EFB2.title: "Любой предмет из списка"
	quest.4E8C02DAE9D35040.title: "Боевые патроны"
	quest.4E8C02DAE9D35040.quest_desc: [
		"Как сделать: сборка по шагам из холостого патрона. Револьверный — свинцовый самородок; гатлинга — свинцовый и медный самородки; дробовой — свинцовая картечь, флешетта — гвоздь, зажигательный — огненный порошок.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	task.412E9FFB02C43DB5.title: "Любой предмет из списка"
	quest.2915627E580B0467.title: "Бронебойные патроны"
	quest.2915627E580B0467.quest_desc: [
		"Как сделать: стальной самородок вместо свинца — в револьверный (со свинцом) и в патрон гатлинга (с медью); стальная флешетта — стальной гвоздь; стальные гвозди — 3 стальных самородка столбиком или резка и прессовка. Стальные самородки — из стального слитка на верстаке.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	quest.11FCCB9AB188671C.title: "Первая пушка"
	quest.11FCCB9AB188671C.quest_desc: [
		"Create Big Cannons: пушка собирается из блоков — камора, ствол, казённая часть — на лафете или станке. Деревянная пушка слабая, но стреляет.",
		" ",
		"",
		" ",
		"Как сделать: камора — 4 бревна вокруг пороха; казённик — 3 бревна, кнопка и порох; лафет — доски, вал и пара колёс (бревно в железных листах).",
	]
	quest.3BFC9638790CFB7F.title: "Лафет и заряды"
	quest.3BFC9638790CFB7F.quest_desc: [
		"Пороховые заряды и ядро забиваются в ствол банником; число зарядов задаёт дальность. Станок поворачивается вращением.",
		" ",
		"",
		" ",
		"Как сделать: станок — андезитовый корпус, валы, железные листы и порох; банник — головка (доски и шток поршня) на двух палках; заряд — мешок (нить и шерсть) и спрессованный порох (порох в прессовщике); ядро — железные слитки, самородки и плита.",
	]
	task.74C3A384A11950CB.title: "Любой предмет из списка"
	quest.3A56ABA5279C1D80.title: "Кованая пушка и миномёт"
	quest.3A56ABA5279C1D80.quest_desc: [
		"Крепче деревянной и, как она, сама соединяется при установке. Миномётный казённик стреляет минами, которые опускают в ствол.",
		" ",
		"",
		" ",
		"Как сделать: камора — 4 железных листа вокруг пороха; казённик — железные слитки, лист и порох; миномётный казённик — кованый казённик и железная решётка.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	quest.37E52492C6443C01.title: "Пушечный цех"
	quest.37E52492C6443C01.quest_desc: [
		"Бур рассверливает отлитые стволы (скорость бура и токарного станка должна совпадать), сборщик насаживает слои стальных стволов, заряжатель с головкой банника подаёт боеприпасы.",
		" ",
		"",
		" ",
		"Как сделать: всё на андезитовом корпусе со штоком поршня: бур — с железом и трубой, сборщик — с железными листами и самородками, заряжатель — с порохом.",
	]
	quest.7EA7A3F925D95AE8.title: "Литьё"
	quest.7EA7A3F925D95AE8.quest_desc: [
		"Металл плавится в чаше под литейной крышкой над горелкой всполоха и заливается в форму, обложенную литейным песком. Залитая форма остывает (чем больше, тем дольше), после этого её ломают и получают нерассверленный блок.",
		" ",
		"",
		" ",
		"Как сделать: крышка — 4 андезитовых сплава; песок — песок, земля и глина; формы — бревно на механической пиле.",
	]
	quest.7BE14415BC16599B.title: "Чугунная пушка"
	quest.7BE14415BC16599B.quest_desc: [
		"Чугун TFMG — железо и уголь в прессовщике с нагревом; в литейной чаше он плавится. Отлитые ствол и камору рассверлите буром, недостающие детали затвора вставьте рукой или развёртывателем (их список на блоке).",
		" ",
		"",
		" ",
		"Чугунные блоки не соединяются при установке: собирайте пушку целиком или свяжите сваркой. Без шёлкового касания сломанная пушка рассыпается в лом.",
	]
	quest.529A00BF0C8D298D.title: "Сварка"
	quest.529A00BF0C8D298D.quest_desc: [
		"ПКМ по двум соседним блокам пушки одного материала и типа сваривает их. Сварка ослабляет некоторые стволы — лучше отливать и переносить пушку целиком.",
		" ",
		"",
		" ",
		"Как сделать: горелка всполоха, латунные и железный листы, вентиль на верстаке.",
	]
	task.5A73EC0830F83462.title: "Любой предмет из списка"
	quest.75326C0F476326EC.title: "Бронзовая пушка"
	quest.75326C0F476326EC.quest_desc: [
		"Бронза держит больше пороха, чем чугун, и отливается так же.",
		" ",
		"",
		" ",
		"Как сделать: бронзовые слитки — смеситель с нагревом: 2 латунных слитка и золистая мука или медь, цинк и золистая мука (2 слитка). Золистая мука — дробление незерака.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	task.35BAA68F6448DB02.title: "Любой предмет из списка"
	quest.2CD0481462C678A7.title: "Автопушка"
	quest.2CD0481462C678A7.quest_desc: [
		"Скорострельная пушка с магазином — защита от воздушных пиратов и оружие кораблей. Ствол, затвор и пружина отливаются в своих формах (бревно на пиле).",
		" ",
		"",
		" ",
		"Как сделать: короб — латунный слиток и железные листы; зенитный снаряд — железный лист, порох и шрапнель (железный слиток в самородках); бронебойный — чугунный и железный слитки; пулемётный патрон — гильза (резка листа), порох и медный самородок.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	quest.327C192415E8CC66.title: "Стальной ствол"
	quest.327C192415E8CC66.quest_desc: [
		"Сталь держит гораздо больше зарядов, чем чугун и бронза. Ствол собирается из слоёв: каждый слой отливается и рассверливается, сборщик насаживает их друг на друга, а горячий поток вентилятора через лаву превращает слои в готовый ствол.",
	]
	quest.3216571E90BBE848.title: "Незерсталь"
	quest.3216571E90BBE848.quest_desc: [
		"Как сделать: незерсталь — смеситель с перегревом: незеритовый лом и стальной (или чугунный) слиток. Ствол собирается из слоёв, как стальной.",
	]
	task.37E2AB9E11E22E71.title: "Любой предмет из списка"
	quest.02EA33D7875AE63A.title: "Ядра и картечь"
	quest.02EA33D7875AE63A.quest_desc: [
		"Ядро пробивает стены, картечь бьёт по толпе, мортирный камень летит дальше всех и взрывается при ударе.",
		" ",
		"",
		" ",
		"Как сделать: шрапнель — железный слиток в 8 самородках; картечь — шрапнель, шерсть, нить и плита; мортирный камень — камень и плита.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	quest.4DC5ECBC76FBF9CD.title: "Снаряды"
	quest.4DC5ECBC76FBF9CD.quest_desc: [
		"Фугас с взрывателем рушит постройки, шрапнель бьёт по толпе. Взрыватели вставляются в снаряд.",
		" ",
		"",
		" ",
		"Как сделать: пироксилин — бумага, порох, редстоун и 200 мБ воды в смесителе, затем прессовщик; фугас — железо, плита и прессованный пироксилин на механическом сборщике; ударный взрыватель — кнопка и редстоун.",
	]
	task.2A5DCDCA90C03369.title: "Любой предмет из списка"
	quest.717DAE49E9909408.title: "Взрыватели"
	quest.717DAE49E9909408.quest_desc: [
		"Как сделать: дистанционный — часы, железо и редстоун; неконтактный — железная решётка, кварц, железо и редстоун; с замедлением — дистанционный и ударный; инерционный — кнопка, пружина (лист, разрезанный пилой и спрессованный) и редстоун; проводной — медь и редстоун.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	task.0048F8C71D073B67.title: "Любой предмет из списка"
	quest.1159F550A1F3E589.title: "Особые снаряды"
	quest.1159F550A1F3E589.quest_desc: [
		"Как сделать: бронебойное ядро и снаряд — чугун (TFMG), железо и плита, у снаряда ещё пироксилин; дымовой — сено и железо; жидкостный — железо и трубы (наполняется жидкостью); мина миномёта — заряд, железный лист, вал и пироксилин.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	task.08292A2AF8CF4186.title: "Любой предмет из списка"
	quest.0B55CEA58AB85331.title: "Гильзы и нитропорох"
	quest.0B55CEA58AB85331.quest_desc: [
		"Большая гильза — компактный заряд, её набивают более сильным порохом; после выстрела её можно наполнить снова.",
		" ",
		"",
		" ",
		"Как сделать: лист гильзы — 4 латунных листа, затем 5 прессовок сборкой по шагам. Студень — огненный порошок, сгусток магмы и порох в смесителе (или пироксилин, слизь, редстоун и вода); в печи он твердеет, жернова мелют его в нитропорох.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	quest.20FC3401E61EA89B.title: "Мега-факел"
	quest.20FC3401E61EA89B.quest_desc: [
		"Не даёт враждебным мобам появляться в радиусе 64 блоков.",
		" ",
		"",
		" ",
		"Как сделать: механический смеситель без нагрева — 3 факела, 2 алмаза, 2 золотых блока, 2 бревна и 250 мБ лавы.",
	]
	quest.69711FBF08F72FB9.title: "Ночной дозор"
	quest.69711FBF08F72FB9.quest_desc: [
		"Guard Villagers: Shift + правый клик по жителю с мечом или арбалетом делает его стражником. Жрецы лечат стражу.",
	]
	quest.703292B04762F4AB.title: "Лампа страха"
	quest.703292B04762F4AB.quest_desc: [
		"Наоборот, запрещает спавн мирных мобов в радиусе 64 блоков — для чистых ферм и складов.",
		" ",
		"",
		" ",
		"Как сделать: обсидиан, стеклянные панели, светокамень и чёрный краситель.",
	]
	quest.75D83EE5912EE169.title: "Дикий огонь"
	quest.75D83EE5912EE169.quest_desc: [
		"Сам расставляет невидимые источники света в радиусе 16 блоков: шахты и подвалы без факелов.",
		" ",
		"",
		" ",
		"Как сделать: золотые слитки, светокаменная пыль и стекло.",
	]
	quest.1594ED87597CB23C.title: "Книга опыта"
	quest.1594ED87597CB23C.quest_desc: [
		"Хранит опыт — не потеряете уровни при смерти и сможете отдать их другу.",
		" ",
		"",
		" ",
		"Как сделать: книга и 4 жемчужины Края.",
	]
	task.1CCB580E9874FEB9.title: "Любой предмет из списка"
	quest.131C69AF71A5EF6E.title: "Турель с радаром"
	quest.131C69AF71A5EF6E.quest_desc: [
		"Create Radar наводит пушку сам: автоповорот ставится под станок, автонаклон — рядом, контроллер огня подаёт сигнал редстоуна, когда станок навёлся. Всё связывается с монитором радара через передатчики данных, цель выбирается на мониторе.",
		" ",
		"",
		" ",
		"Как сделать: автоповорот и автонаклон — механизм точности и коробка передач; контроллер огня — латунный корпус, компараторы, механизм точности и редстоун; мониторы — электронные лампы, латунный корпус и механизм точности; фильтр целей — бумага, механизм точности и редстоун.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	task.45520D2E38C635B9.title: "Любой предмет из списка"
	quest.64BE3391B428A886.title: "Щиты из камня и металла"
	quest.64BE3391B428A886.quest_desc: [
		"New Shield Variants: прочнее обычного щита.",
		" ",
		"",
		" ",
		"Как сделать: форма как у обычного щита — железный щит из железных слитков, каменный — булыжник и железный слиток, золотой — золото и железный слиток.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	task.54407A8A5CFE18C7.title: "Любой предмет из списка"
	quest.0E970AF69A9D5397.title: "Рыцарские щиты"
	quest.0E970AF69A9D5397.quest_desc: [
		"Epic Knights: четыре формы щита из разных материалов.",
		" ",
		"",
		" ",
		"Как сделать: деревянный щит (экю, каплевидный, круглый, овальный) — доски и железный слиток; металлический — деревянный щит той же формы и 4 слитка или камня вокруг.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	task.56565184CD6DA66F.title: "Любой предмет из списка"
	quest.246BE58B314DF1CA.title: "Алмазные щиты"
	quest.246BE58B314DF1CA.quest_desc: [
		"Как сделать: алмазный щит New Shield Variants — алмазы и железный слиток; щиты Epic Knights — деревянный щит и 4 алмаза.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	task.7ED558D33B6C3A8C.title: "Любой предмет из списка"
	quest.4A3024A8A0A20293.title: "Стальные щиты"
	quest.4A3024A8A0A20293.quest_desc: [
		"Как сделать: деревянный щит Epic Knights и 4 стальных слитка TFMG.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	task.74B78FF637A7AC95.title: "Любой предмет из списка"
	quest.4D2876ED23A162FE.title: "Незеритовые щиты"
	quest.4D2876ED23A162FE.quest_desc: [
		"Как сделать: незеритовый щит New Shield Variants — незеритовые и железный слитки на верстаке; щиты Epic Knights — алмазный щит, незеритовый слиток и шаблон улучшения на кузнечном столе.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	task.50832667D166B864.title: "Любой предмет из списка"
	quest.2D10A077B461842B.title: "Особые щиты"
	quest.2D10A077B461842B.quest_desc: [
		"Огненный и динамитный щиты метают огненный шар и динамит.",
		" ",
		"",
		" ",
		"Как сделать: незеритовый слиток и особая часть — огненный заряд, динамит, блок редстоуна, стержень ифрита, жемчужина Края, панцирь шалкера (города Края) или голова дракона (корабли Края).",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	task.3DD96756E438F82B.title: "Любой предмет из списка"
	quest.193C7623D7FF43C6.title: "Щиты стражей"
	quest.193C7623D7FF43C6.quest_desc: [
		"Как сделать: оплот пламени — игнитиум (с Игниса), стержни ифрита, незерский кирпич и щит; лазурный щит — слёзы моря (со Сциллы, морских тварей Cataclysm и из сокровищницы Акрополя), золото; искажённый щит — зубы эндерменов Края (Enderman Overhaul), доски и железо.",
		" ",
		"",
		" ",
		"Где взять: усиленный щит и щит драконьей стражи Block Factory's Bosses не крафтятся — они лежат в сундуках драконьей башни, усиленный ещё в хранилище арены подземного мира.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	quest.3472B863BF92E3C0.title: "Оборона базы"
	quest.3472B863BF92E3C0.quest_desc: [
		"Командная цель: база под мега-факелом, со стражей и хотя бы одной чугунной пушкой на стене.",
	]
	image.33B7BCC1BD1C8DBB.title: "Огнестрел"
	image.01CEB0D673A6B78F.title: "Пушки"
	image.66051C4D60E02FDA.title: "Оборона базы"
	image.3680975E2E88F189.title: "Щиты"
	chapter.0C8BC331080BBBB1.title: "&#C9A227Доспехи&r"
	chapter.0C8BC331080BBBB1.subtitle: "Комплекты брони сборки по веткам: где взять каждую часть и что даёт комплект. Все квесты, кроме первого, необязательные."
	quest.27A9A632D062727C.title: "Гардероб"
	quest.27A9A632D062727C.quest_desc: [
		"Эта глава — справочник по комплектам брони. В квесте перечислены все части комплекта: клик по части открывает её рецепт в JEI, а квест засчитывается, когда каждая часть побывает у вас в инвентаре.",
		" ",
		"",
		" ",
		"Ветки не зависят друг от друга: §6металл§r — от меди через латунь и алмаз к незериту и трофейной броне на нём · §6Immersive Armors§r — дерево, кости, слизь, мантия, паропанк, тяжёлая броня · §6Epic Knights§r — от стёганки и кольчуги до стальных лат · §6Ледяной лабиринт§r — броня Aquamirae · §6трофеи чудовищ§r — броня из добычи мини-боссов. Внутри ветки комплект открывается после того, из которого он делается, или после ступени перед ним, поздние — ещё и после своей эпохи.",
		" ",
		"",
		" ",
		"В подсказке у каждой вещи написано «Ступень Tn · эпоха». Полный комплект по ступеням: §7T0§r 7–10 брони · §fT1§r 12–15 · §6T2§r 16–18 брони и 4 прочности · §bT3§r 20 и 8 · §9T4§r 20 и 10 · §5T5§r 20 и 12 · §cT6§r 26–28 и 16. С T2 каждая часть ещё добавляет здоровье: от +2 за комплект T2–T3 до +10 за T6.",
		" ",
		"",
		" ",
		"Снаряжение водолаза, ранцы и скафандры — в главах эпох.",
	]
	task.333AE41AF344EE02.title: "Любая часть комплекта"
	quest.446771FA574107D5.title: "Медные доспехи"
	quest.446771FA574107D5.quest_desc: [
		"Как сделать: медные слитки, по форме железной брони (нагрудник — 8 слитков).",
		" ",
		"Ступень T0: 10 брони за комплект. С неё начинается металлическая ветка: цинк, латунь, алмаз, незерит.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	task.1F107C9521CC02F6.title: "Любая часть комплекта"
	quest.4CA3A49EEC85DBB3.title: "Цинковые доспехи"
	quest.4CA3A49EEC85DBB3.quest_desc: [
		"Как сделать: те же формы из цинковых слитков.",
		" ",
		"Ступень T1: 12 брони, как кольчуга.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	task.07548928043A7CBA.title: "Любая часть комплекта"
	quest.5EA91EDFFD55CF09.title: "Латунные доспехи"
	quest.5EA91EDFFD55CF09.quest_desc: [
		"Как сделать: латунные слитки, по форме железной брони.",
		" ",
		"Где взять: латунь смешивается в смесителе над горелкой всполоха (эпоха латуни).",
		" ",
		"Ступень T2: 18 брони, 4 прочности, +2 здоровья.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	task.08517D7651D6DAFC.title: "Любая часть комплекта"
	quest.55449D6F4EB48018.title: "Алмаз и точность"
	quest.55449D6F4EB48018.quest_desc: [
		"Как сделать: алмазы и механизм точности в каждой части (вместо одного алмаза).",
		" ",
		"Где взять: механизм точности собирается по шагам (квест «Сборка по шагам» в эпохе латуни).",
		" ",
		"Ступень T3: 20 брони, 8 прочности, +2 здоровья. На алмазных частях куются резонариевая, пучинная и незеритовая броня.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	task.78C88ECD30E15641.title: "Любая часть комплекта"
	quest.26F132859F0F0742.title: "Нептуний"
	quest.26F132859F0F0742.quest_desc: [
		"Как сделать: слитки нептуния и механизм точности в каждой части, как у алмазной.",
		" ",
		"Где взять: слитки лежат в «Подарке Нептуна» — редком ящике, который вылавливается удочкой.",
		" ",
		"Ступень T3: 20 брони, 8 прочности, +2 здоровья. Под водой шлем даёт зрение, нагрудник — дыхание, поножи — невесомость, сапоги — скорость.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	task.3EDBCA004ADE93DA.title: "Любая часть комплекта"
	quest.500EC8607B466E1D.title: "Резонарий"
	quest.500EC8607B466E1D.quest_desc: [
		"Как сделать: кузнечный стол — шаблон резонария, алмазная часть и резонариевая пластина (4 резонария и 4 щитка черепахи или броненосца).",
		" ",
		"Где взять: резонарий падает со шламов в Ином; шаблон лежит в сундуках на вершине древнего храма Иного, иногда в сундуках древних городов, Крепостей и испытательных камер.",
		" ",
		"Ступень T3: 20 брони, 8 прочности, +2 здоровья.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	task.0D080CFDE2A51A20.title: "Любая часть комплекта"
	quest.50B4906E206B9171.title: "Незеритовые доспехи"
	quest.50B4906E206B9171.quest_desc: [
		"Как сделать: кузнечный стол — шаблон незеритового улучшения, алмазная часть и незеритовый слиток. Слиток — 4 обломка, 2 золота и 2 стали TFMG в смесителе с перегревом.",
		" ",
		"Где взять: обломки — из древних обломков глубоко в Незере, шаблон — в сундуках бастионов.",
		" ",
		"Ступень T5: 20 брони, 12 прочности, 0,4 сопротивления отбрасыванию, +6 здоровья.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	quest.05E666F85CC7AF48.title: "Лунный кристалл"
	quest.05E666F85CC7AF48.quest_desc: [
		"Как сделать: 8 светящихся чернильных мешков вокруг осколка аметиста (мешки роняют светящиеся спруты).",
		" ",
		"На кузнечном столе кристалл превращает незеритовую часть в доспех героя, третий предмет выбирает какой: железный слиток — Герой, перо — Леди Мария, снежок — Серебряный рыцарь, кость — Тёмный лорд. Все 30 комплектов — в JEI.",
	]
	quest.4278CC7FD36D973A.title: "Доспех героя"
	quest.4278CC7FD36D973A.quest_desc: [
		"Как сделать: кузнечный стол — незеритовая часть, лунный кристалл и предмет героя (рецепты всех 30 комплектов Fantasy Armor — в JEI). Подойдёт любой нагрудник.",
		" ",
		"Ступень T5, как незерит: 20 брони, 12 прочности, +6 здоровья; комплекты различаются эффектами.",
	]
	task.5654D1DEEEF7D3E4.title: "Любая часть комплекта"
	quest.55024B3BC4964CE7.title: "Доспех из игнитиума"
	quest.55024B3BC4964CE7.quest_desc: [
		"Как сделать: кузнечный стол — шаблон игнитиума, незеритовая часть и слиток игнитиума. Шаблон: шаблон незеритового улучшения, 4 огненных порошка и 4 блока незерского кирпича.",
		" ",
		"Где взять: игнитиум роняет Игнис на Пылающей арене в Незере (компас: Burning Arena).",
		" ",
		"Ступень T6, высшая: 28 брони, 16 прочности, 0,8 сопротивления отбрасыванию, +10 здоровья.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	task.0BE13FCB1FB32690.title: "Любая часть комплекта"
	quest.08694E65871B3DFD.title: "Доспех из курсиума"
	quest.08694E65871B3DFD.quest_desc: [
		"Как сделать: кузнечный стол — шаблон курсиума, незеритовая часть и слиток курсиума. Шаблон: шаблон незеритового улучшения, 2 слитка чёрной стали и 6 золотых слитков.",
		" ",
		"Где взять: курсиум роняет Маледиктус в Ледяной тюрьме (компас: Frosted Prison); чёрная сталь падает с драугров и лежит в сундуках тюрьмы.",
		" ",
		"Ступень T6: 26 брони, 16 прочности, +8 здоровья. Нагрудник однажды спасает от смерти, потом долго перезаряжается.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	task.7932BBD0FD2479CD.title: "Любая часть комплекта"
	quest.1EBD71F19CF7CA63.title: "Доспех хранителя"
	quest.1EBD71F19CF7CA63.quest_desc: [
		"Как сделать: кузнечный стол — шаблон хранителя, незеритовая часть и укреплённый осколок эха (осколок эха, 4 панциря хранителя и 4 мембраны фантома).",
		" ",
		"Где взять: шаблон и панцири лежат в сундуках древних городов и древнего храма Иного, панцирь роняет и сам Хранитель.",
		" ",
		"Ступень T6: 26 брони, 16 прочности, +8 здоровья. Шлем защищает от слепоты и тьмы, поножи ускоряют.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	task.42D39A8659D370C5.title: "Любая часть комплекта"
	quest.76ABD4D0C9421375.title: "Доспехи аннигилятора"
	quest.76ABD4D0C9421375.quest_desc: [
		"Как сделать: кузнечный стол — шаблон аннигилятора, незеритовая часть и осколок портала. Шаблон: 4 слитка эндерития, 4 камня Края и бутыль аннигиляции.",
		" ",
		"Где взять: осколки портала роняет Облитератор на космической станции в Крае; эндерит — из руды в Крае (9 самоцветов — слиток) и из сундуков станции, бутыли — в сундуках станции.",
		" ",
		"Ступень T6, высшая: 28 брони, 16 прочности, +10 здоровья, отбрасывание почти не действует.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	task.3759F30698D790A1.title: "Любая часть комплекта"
	quest.3380C4BC0F0287C6.title: "Деревянные доспехи"
	quest.3380C4BC0F0287C6.quest_desc: [
		"Как сделать: брёвна, по форме железной брони.",
		" ",
		"Ступень T0: 7 брони, как кожа. Каждая часть даёт шанс отразить стрелу и немного гасит взрывы.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	task.532DFE38A786D6C4.title: "Любая часть комплекта"
	quest.365BB99134E4CBDF.title: "Костяные доспехи"
	quest.365BB99134E4CBDF.quest_desc: [
		"Как сделать: кости, по форме железной брони.",
		" ",
		"Ступень T0: 7 брони, зато каждая часть немного ускоряет шаг. Костяные части — основа иссушённых доспехов.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	task.11B87C24DBE83F85.title: "Любая часть комплекта"
	quest.478CCBD01C5969A2.title: "Иссушённые доспехи"
	quest.478CCBD01C5969A2.quest_desc: [
		"Как сделать: костяная часть, обложенная незерскими кирпичами.",
		" ",
		"Ступень T2: 16 брони, 4 прочности, +2 здоровья, шаг чуть быстрее. Кто вас ударит, получает иссушение.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	task.301F3991E9176A2A.title: "Любая часть комплекта"
	quest.68D6835BB68D55C9.title: "Слизневые доспехи"
	quest.68D6835BB68D55C9.quest_desc: [
		"Как сделать: сгустки слизи, по форме железной брони.",
		" ",
		"Где взять: сгустки роняют слизни на болотах и в слизневых чанках.",
		" ",
		"Ступень T0: 10 брони. Каждая часть отбрасывает обидчика, гасит взрывы и уменьшает отбрасывание.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	task.1D07E6049C969400.title: "Любая часть комплекта"
	quest.61FA51811135FCBD.title: "Доспехи воина"
	quest.61FA51811135FCBD.quest_desc: [
		"Как сделать: кожаная часть того же вида и железные слитки, к шлему ещё кость, к нагруднику кожа.",
		" ",
		"Ступень T1: 15 брони. Ярость: чем меньше здоровья, тем сильнее удар; части добавляют урон топорам.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	task.0F7EF5AE46216678.title: "Любая часть комплекта"
	quest.167B967639030738.title: "Паропанк"
	quest.167B967639030738.quest_desc: [
		"Как сделать: латунные слитки и поршни, в нагрудник ещё часы и компас, в шлем — стекло и красный факел.",
		" ",
		"Ступень T2: 16 брони, 4 прочности, +2 здоровья.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	task.4323FFD9BAAAE51A.title: "Любая часть комплекта"
	quest.3533D9A9B549A644.title: "Тяжёлая броня"
	quest.3533D9A9B549A644.quest_desc: [
		"Как сделать: стальные блоки и слитки TFMG.",
		" ",
		"Где взять: сталь варится в эпохе стали (квест «Сталь»).",
		" ",
		"Ступень T4: 20 брони, 12 прочности, +4 здоровья; полный комплект совсем не отбрасывает, но в нём медленнее.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	task.544110E5628F9718.title: "Любая часть комплекта"
	quest.7724668EE148A963.title: "Мантия"
	quest.7724668EE148A963.quest_desc: [
		"Как сделать: шерсть и огненный порошок в каждой части.",
		" ",
		"Где взять: огненные стержни роняют ифриты в крепостях Незера.",
		" ",
		"8 брони за комплект, зато стойкость к огню и магии, а обидчик загорается. Мантия — основа божественных доспехов.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	task.707302D084E1F63C.title: "Любая часть комплекта"
	quest.537BFD3C81045911.title: "Божественные доспехи"
	quest.537BFD3C81045911.quest_desc: [
		"Как сделать: часть мантии и золотые слитки, в нагрудник ещё тотем бессмертия, в шлем — изумруд.",
		" ",
		"Где взять: тотемы роняют заклинатели в лесных особняках и во время набегов.",
		" ",
		"Ступень T2: 18 брони, 4 прочности, +2 здоровья. Каждая часть раз в минуту полностью отражает удар.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	task.1FFEB160AF95B474.title: "Любая часть комплекта"
	quest.2145966031DE22C0.title: "Призмариновые доспехи"
	quest.2145966031DE22C0.quest_desc: [
		"Как сделать: осколки и кристаллы призмарина, в нагрудник — сердце моря.",
		" ",
		"Где взять: призмарин роняют стражи у подводных крепостей, сердце моря лежит в закопанных сокровищах (карты — в кораблекрушениях).",
		" ",
		"Ступень T1: 15 брони. Шипы ранят ближних врагов, в воде вы плывёте быстрее.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	task.6B26E8A92871BE96.title: "Любая часть комплекта"
	quest.51ADF598BC7BF7BB.title: "Стёганка"
	quest.51ADF598BC7BF7BB.quest_desc: [
		"Как сделать: шерстяная ткань (3 белой шерсти дают 4 ткани, 6 нитей — 2), к сапогам кожа и ремешки (2 кожи — 6 ремешков).",
		" ",
		"Ступень T0: 10 брони. С неё начинается рыцарская ветка.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	task.247BE6E5C2198E06.title: "Любая часть комплекта"
	quest.26870972FB8692A0.title: "Кольчуга"
	quest.26870972FB8692A0.quest_desc: [
		"Как сделать: шлем, кольчуга и поножи — из железных цепей (5, 8 и 7), сапоги — кожа и ремешки.",
		" ",
		"Ступень T1: 12 брони. Бригантина — нагрудник из кожи и листов железа Create, ступень T0.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	task.75282B03011074D5.title: "Любая часть комплекта"
	quest.4E7D9ACBC56C484A.title: "Латы с кольчугой"
	quest.4E7D9ACBC56C484A.quest_desc: [
		"Как сделать: нагрудник — 2 железных слитка и 6 цепей, поножи — 2 слитка и 5 цепей, сапоги — слитки, кожа и ремешки, шапель — слитки, листы железа Create и цепи.",
		" ",
		"Ступень T1: 15 брони, как железо.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	task.1EDDD68493898FEA.title: "Любая часть комплекта"
	quest.41EC71E2A20510B4.title: "Крестоносец"
	quest.41EC71E2A20510B4.quest_desc: [
		"Как сделать: нагрудник — латы с кольчугой и 7 шерстяных тканей, топфхельм — 7 железных слитков и цепь, поножи — слитки и цепи, сапоги — кожа и цепи.",
		" ",
		"Ступень T1: 15 брони.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	task.0BF0DF7116DA28C4.title: "Любая часть комплекта"
	quest.50CA65F161269273.title: "Кирасир"
	quest.50CA65F161269273.quest_desc: [
		"Как сделать: шлем и кираса — листы железа Create и слитки, поножи — кожа и шерстяная ткань, сапоги — кожа и ремешки.",
		" ",
		"Ступень T1: 15 брони.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	task.3F287CD139941517.title: "Любая часть комплекта"
	quest.0D77D52DE41CE293.title: "Ламеллярный доспех"
	quest.0D77D52DE41CE293.quest_desc: [
		"Как сделать: нагрудник — 8 рядов пластин, сапоги — 2 ряда, кожа и ремешки; ряд — 6 железных самородков и 3 ремешка. Шлем с личиной — шишак и 5 железных самородков. Поножей нет.",
		" ",
		"Ступень T1: 8 брони за три части.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	task.125A20E314088D6D.title: "Любая часть комплекта"
	quest.60C2A51D9D5B3449.title: "Латы XIV века"
	quest.60C2A51D9D5B3449.quest_desc: [
		"Как сделать: латунные листы Create и железные цепи, сапоги — листы и кожа, бацинет — норманнский шлем и 2 латунных листа.",
		" ",
		"Где взять: готовые части иногда лежат в сундуках незерских замков, крепостей и бастионов.",
		" ",
		"Ступень T2: 16 брони, 4 прочности, +2 здоровья.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	task.5070218A727656D2.title: "Любая часть комплекта"
	quest.31A17ED3B19C63AA.title: "Кираса и барбют"
	quest.31A17ED3B19C63AA.quest_desc: [
		"Как сделать: кираса — 6 железных слитков и 2 листа железа Create, барбют — 3 слитка и 2 листа, гусарский нагрудник — кираса, 6 перьев, кроличья шкура и палка.",
		" ",
		"Кираса и барбют — основа стальных лат. Ступень T1: 8 брони за шлем и кирасу.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	task.364187F101631D7F.title: "Любая часть комплекта"
	quest.657ED9E1A9327981.title: "Рыцарские латы"
	quest.657ED9E1A9327981.quest_desc: [
		"Как сделать: рыцарский нагрудник — кираса и 5 стальных пластин, армет — барбют и 3 пластины, поножи — 7 пластин, сапоги — 4. 2 слитка стали TFMG дают 2 пластины.",
		" ",
		"Ступень T4: 20 брони, 10 прочности, 0,4 сопротивления отбрасыванию, +4 здоровья, шаг не медленнее.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	task.40A846C5E4A441E0.title: "Любая часть комплекта"
	quest.3438447756AD852E.title: "Турнир"
	quest.3438447756AD852E.quest_desc: [
		"Как сделать: каждая часть — часть рыцарских лат и ещё стальные пластины, штеххельм — барбют и 8 пластин.",
		" ",
		"Защита 22, прочность 10, +4 здоровья, отбрасывание не действует, но каждая часть даёт Замедление II: это латы для конного боя с рыцарским копьём.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	task.38A138395836D47B.title: "Любая часть комплекта"
	quest.625291F2050E0432.title: "Максимилиановский доспех"
	quest.625291F2050E0432.quest_desc: [
		"Как сделать: кузнечный стол — шаблон незеритового улучшения, часть рыцарских лат и незеритовый слиток.",
		" ",
		"Где взять: шаблон — в сундуках бастионов Незера.",
		" ",
		"Ступень T5, как незерит: 20 брони, 12 прочности, 0,4 сопротивления отбрасыванию, +6 здоровья, без замедления.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	task.25D69997310AFC35.title: "Любая часть комплекта"
	quest.5B793200B6CCE2ED.title: "Готические латы"
	quest.5B793200B6CCE2ED.quest_desc: [
		"Как сделать: салад — барбют и 3 стальные пластины, нагрудник — кираса, 5 пластин и 2 стальных самородка, поножи и сапоги — пластины и самородки.",
		" ",
		"Ступень T4: 20 брони, 10 прочности, +4 здоровья. На кузнечном столе улучшается до незерита с сохранением чар.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	task.02B64E9B9E4E16EA.title: "Любая часть комплекта"
	quest.00F576F383A93517.title: "Кастенбруст"
	quest.00F576F383A93517.quest_desc: [
		"Как сделать: большой бацинет — норманнский шлем и 5 стальных пластин, нагрудник — кираса, 5 пластин и 2 малые стальные пластинки (6 стальных самородков дают 8), поножи и сапоги — пластины и пластинки.",
		" ",
		"Ступень T4, как рыцарские латы. Улучшается до незерита с сохранением чар.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	task.53CDAD1EAA433E71.title: "Любая часть комплекта"
	quest.57207835097E4913.title: "Ржавая кольчуга"
	quest.57207835097E4913.quest_desc: [
		"Как сделать: не куётся, только находка.",
		" ",
		"Где взять: в сундуках замков, цитаделей, оружейных и Крепостей, там же ржавый топфхельм и нагрудник крестоносца.",
		" ",
		"Ступень T1: 12 брони, как новая кольчуга. Квест ничего не открывает.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	task.5CFD3D6AA54DBA9A.title: "Любая часть комплекта"
	quest.33DAE07EA6AF67A4.title: "Водолаз-мародёр"
	quest.33DAE07EA6AF67A4.quest_desc: [
		"Как сделать: костюм, штаны и сапоги — кожа, железные слитки и эхо кладбища кораблей.",
		" ",
		"Где взять: эхо роняют твари Ледяного лабиринта — удильщики, пасти, ползуны, хребеточники и пучинные медузы; шлем не куётся, его роняет капитан Корнелия с пиратского корабля в лабиринте.",
		" ",
		"Ступень T1: 15 брони за полный комплект; под водой быстрее плавание и добыча, стойкость глубин бережёт от тварей лабиринта.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	task.238D19158E00A89B.title: "Любая часть комплекта"
	quest.3BC4DBD7C46A9301.title: "Ужасающие доспехи"
	quest.3BC4DBD7C46A9301.quest_desc: [
		"Как сделать: кузнечный стол — ужасающий шаблон, железная часть и плавник. Шаблон размножается: шаблон, 4 клыка удильщика и 4 плавника дают два.",
		" ",
		"Где взять: всё в Ледяном лабиринте — плавники роняют угри, удильщики и пасти; шаблон лежит в пиратских мешочках и мешочках сокровищ, их роняют мародёры, угри и пасти лабиринта, они есть в его бочках и ледяных сундуках.",
		" ",
		"Ступень T2: 16 брони, 4 прочности, +2 здоровья.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	task.74F80249F6DD7D0C.title: "Любая часть комплекта"
	quest.3839C02C25DF9125.title: "Пучинные доспехи"
	quest.3839C02C25DF9125.quest_desc: [
		"Как сделать: кузнечный стол — пучинный шаблон, алмазная часть и пучинный аметист. Шаблон: ужасающий шаблон, 4 пучинных аметиста и 4 эха кладбища кораблей.",
		" ",
		"Где взять: аметист (2–6 за раз) роняет мать лабиринта в Ледяном лабиринте, изредка он лежит в мешочках сокровищ.",
		" ",
		"Ступень T3: 20 брони, 8 прочности, +2 здоровья, самая высокая стойкость глубин. Пучинная тиара (тотем и аметист) заменяет шлем.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	quest.6870F8D32D22A6B4.title: "Трофеи чудовищ"
	quest.6870F8D32D22A6B4.quest_desc: [
		"Эти доспехи делаются из добычи мини-боссов и редких мобов или выпадают из них готовыми. Квесты с готовой добычей ничего не открывают, это просто отметка о собранном комплекте. Трофейная броня T6 (игнитиум, курсиум, хранитель, аннигилятор) куётся на незеритовых частях — она в металлической ветке, после незерита.",
	]
	task.4603924CFE8432B0.title: "Любая часть комплекта"
	quest.671570D4F48FA9CC.title: "Кости мутанта"
	quest.671570D4F48FA9CC.quest_desc: [
		"Как сделать: мутант-скелет рассыпается на кости. 6 рёбер — грудная клетка, 2 наплечника и 4 конечности — руки, руки над клеткой — нагрудник; поножи — таз и конечности, сапоги — конечности.",
		" ",
		"Где взять: мутант-скелет — очень редкий гигант, появляется там же, где обычные скелеты.",
		" ",
		"Ступень T2: вместе 15 брони и 3 прочности.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	task.7967AD3521F044EB.title: "Любая часть комплекта"
	quest.4DB0B29951E80979.title: "Костяная рептилия"
	quest.4DB0B29951E80979.quest_desc: [
		"Как сделать: нагрудник — 4 слитка древнего металла и 4 кости коболетона, шлем — ещё и череп коболедиатора.",
		" ",
		"Где взять: коболетоны и коболедиатор живут в пустынных постройках Cataclysm (компас: Desert Site, Desert Temple); древний металл падает с них и с Ваджета и лежит в пустынных сокровищах.",
		" ",
		"Ступень T2: вместе 10 брони и 2 прочности, держат отбрасывание.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	quest.1158D7A0B717A7D0.title: "Мшистый нагрудник"
	quest.1158D7A0B717A7D0.quest_desc: [
		"Как сделать: кристалл природы, 2 блока мха, 4 резных каменных кирпича и железный блок.",
		" ",
		"Где взять: кристалл природы роняет Заросший колосс в мшистом храме (компас: Mossy Temple).",
		" ",
		"Ступень T3: 8 брони, 2 прочности, держит отбрасывание. Клавиша R выпускает ядовитые облака: мобов ранят, вас лечат.",
	]
	task.2DD4B3C696E30741.title: "Любая часть комплекта"
	quest.39E14246D31E4509.title: "Кости дракона"
	quest.39E14246D31E4509.quest_desc: [
		"Как сделать: кости дракона — нагрудник из 8, поножи и сапоги тоже из костей.",
		" ",
		"Где взять: кости роняет Инфернальный дракон в Башне дракона (компас: Dragon Tower).",
		" ",
		"Ступень T3: вместе 17 брони и 6 прочности. Каждая часть даёт лишний кувырок-уклонение (клавиша — в управлении) и сокращает горение.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	task.402BBDAC70E0E66A.title: "Любая часть комплекта"
	quest.0AC4EE60A85F7F5F.title: "Искажённые доспехи"
	quest.0AC4EE60A85F7F5F.quest_desc: [
		"Как сделать: нагрудник — 4 чешуи болока и 4 шипа спанклера, сапоги — чешуя и плавник болока.",
		" ",
		"Где взять: болоки и спанклеры живут в искажённых рифах Края; чешуя, плавники и шипы лежат и в сундуках искажённых кораблей.",
		" ",
		"Ступень T4: вместе 11 брони, 5 прочности, +2 здоровья, шаг чуть медленнее. В сапогах можно стоять на искажённых пузырях.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	quest.312598F9B29FBDA5.title: "Солнечная маска"
	quest.312598F9B29FBDA5.quest_desc: [
		"Как сделать: не куётся, только трофей.",
		" ",
		"Где взять: маску роняет Умвути, вождь рощи умвутана в саванне (компас: Umvuthana Grove).",
		" ",
		"Ступень T3: по защите как алмазный шлем.",
	]
	task.1B9669AC21E96607.title: "Любая часть комплекта"
	quest.7A05AF0987081E2B.title: "Одеяние геоманта"
	quest.7A05AF0987081E2B.quest_desc: [
		"Как сделать: не куётся, только трофей.",
		" ",
		"Где взять: Скульптор после испытания в горном монастыре (компас: Monastery) оставляет посох или одну из частей; части лежат и в сундуках монастыря.",
		" ",
		"Ступень T3: 20 брони, 8 прочности, +2 здоровья.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	quest.13663CEA9C4B4A51.title: "Шлем Кованого рыцаря"
	quest.13663CEA9C4B4A51.quest_desc: [
		"Как сделать: не куётся, только трофей.",
		" ",
		"Где взять: шлем роняет Кованый рыцарь в подземных залах (компас: Wrought Chamber), если его убил игрок.",
		" ",
		"Ступень T3: как алмазный шлем, держит отбрасывание.",
	]
	task.3F3ABABEF22A4330.title: "Любая часть комплекта"
	quest.5C4E2E06B8F02EA7.title: "Латы из башни дракона"
	quest.5C4E2E06B8F02EA7.quest_desc: [
		"Как сделать: не куётся, только находка.",
		" ",
		"Где взять: части лежат в сундуках Башни дракона (компас: Dragon Tower) и в редких сундуках арены Рыцаря подземного мира (компас: Underworld Arena).",
		" ",
		"Ступень T3: 20 брони, 8 прочности, +2 здоровья.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одной любой части комплекта, остальные — по желанию (клик по части покажет рецепт).§r",
	]
	quest.7C5BFE658385002B.title: "Древний шлем"
	quest.7C5BFE658385002B.quest_desc: [
		"Как сделать: не куётся, только трофей.",
		" ",
		"Где взять: шлем роняет древний ифрит, огненный босс Living Things. Его призывают ритуалом: светильник Джека на двух блоках светокамня. Умирая, он вызывает 4 обычных ифрита.",
		" ",
		"Ступень T3: как алмазный шлем, даёт стойкость к огню.",
	]
	image.712139F6C8DE77E0.title: "Металл"
	image.3093F92EAF2FC5C6.title: "Immersive Armors"
	image.3C8A5ADC4839D0FB.title: "Epic Knights"
	image.46B204EFCEA61D4F.title: "Ледяной лабиринт"
	image.53B1B8C748B84192.title: "Трофеи чудовищ"
	chapter.35A43AB9AA47B8F6.title: "&#D96C3BОружие&r"
	chapter.35A43AB9AA47B8F6.subtitle: "Холодное оружие и луки по веткам и ступеням: как сделать и где взять. Все квесты, кроме первого, необязательные."
	quest.79A5EFDD69A29C72.title: "Оружейная"
	quest.79A5EFDD69A29C72.quest_desc: [
		"Эта глава — справочник по оружию. Квест показывает целое семейство: клик по любому предмету открывает его рецепт в JEI.",
		" ",
		"",
		" ",
		"Ветки не зависят друг от друга и идут по ступеням слева направо: §6мечи§r · §6булавы, молоты и топорики§r · §6древковое§r — копья, пики, алебарды · §6кинжалы и стилеты§r · §6луки и арбалеты§r · §6море§r — оружие Ледяного лабиринта и нептуний. Поздние квесты ждут свою эпоху (латунь, сталь, незерит), трофеи T6 — своего босса.",
		" ",
		"",
		" ",
		"В подсказке у оружия урон и скорость атаки (ударов в секунду), их произведение — примерная сила в ближнем бою. Ориентиры: §7T0§r 6–8 · §fT1§r 9–10 · §6T2§r 11–12 · §bT3§r 11–13 · §9T4§r 15–16 · §5T5§r 17–18 · §cT6§r 19–23. Быстрое оружие слабее за удар, тяжёлое бьёт редко, древковое достаёт дальше, двуручное Epic Knights слабеет, если вторая рука занята.",
		" ",
		"",
		" ",
		"Огнестрел и пушки — в главе «Арсенал и оборона», оружие Mowzie's — в «Подземельях и мини-боссах».",
	]
	task.60FE4BDDA94FEBC4.title: "Любой предмет из списка"
	quest.7D83B82221448BE7.title: "Медные мечи"
	quest.7D83B82221448BE7.quest_desc: [
		"Как сделать: медный меч Create Stuff & Additions — 2 медных слитка и палка. Мечи Epic Knights собираются на рукояти: 2 кожи дают 6 кожаных ремешков, палка и ремешок — рукоять. Короткий меч и кацбальгер — 2 слитка и рукоять, полуторный — короткий меч и ещё слиток.",
		" ",
		"",
		" ",
		"Ступень T0: урон 3,5–5,3, скорость 1,4–1,7.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	task.0CD7F6ED311B8302.title: "Любой предмет из списка"
	quest.7258126D7955C827.title: "Железные мечи"
	quest.7258126D7955C827.quest_desc: [
		"Как сделать: цинковый меч — 2 цинковых слитка и палка. Epic Knights: короткий меч и кацбальгер — 2 железных слитка и рукоять, полуторный меч и клеймор — короткий меч и слиток (разный рисунок), цвайхендер — короткий меч, 3 слитка и рукоять, мессер — короткий меч, слиток и самородок. Клеймор и цвайхендер двуручные: бьют сильнее, но медленнее.",
		" ",
		"",
		" ",
		"Ступень T1: урон 5–9,9, скорость 1,0–1,8.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	task.7EF1AAED4A7CEC7D.title: "Любой предмет из списка"
	quest.0DA7C1628996CF9D.title: "Мечи Create"
	quest.0DA7C1628996CF9D.quest_desc: [
		"Как сделать: латунный меч — 2 латунных слитка и палка. Меч из розового кварца собирается механическим крафтером: 2 полированных розовых кварца, 2 листа железа, золотой слиток и цинковая рукоять. Огненный тесак — золотой меч и измельчённый обсидиан в смесителе с нагревом.",
		" ",
		"",
		" ",
		"Ступень T2: урон 6–7,5, скорость 1,6–1,8.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	task.6E47FD8D25832EA3.title: "Любой предмет из списка"
	quest.717E9AA13689F64E.title: "Алмазные мечи"
	quest.717E9AA13689F64E.quest_desc: [
		"Как сделать: мечи Epic Knights из алмазов собираются как железные. Пламенеющий меч — на кузнечном столе: шаблон незеритового улучшения, алмазный цвайхендер и огненный порошок (шаблон тратится). Алмазные мечи потом улучшаются до незеритовых.",
		" ",
		"",
		" ",
		"Ступень T3: урон 6,3–11,3, скорость 0,9–1,7.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	quest.6A5FE136D8C03DD2.title: "Резонариевый меч"
	quest.6A5FE136D8C03DD2.quest_desc: [
		"Как сделать: кузнечный стол — шаблон резонариевого улучшения, алмазный меч и резонариевая пластина (4 резонария и 4 щитка черепахи или броненосца).",
		" ",
		"Где взять: резонарий падает со шламов в Ином, шаблон лежит в сундуках на вершине древнего храма Иного.",
		" ",
		"",
		" ",
		"Ступень T3: урон 7, скорость 1,6.",
	]
	task.2CDAE06A448ACBA5.title: "Любой предмет из списка"
	quest.5801D4A152775691.title: "Стальные мечи"
	quest.5801D4A152775691.quest_desc: [
		"Как сделать: TFMG — 2 стальных или алюминиевых слитка и палка. Литиевый клинок: стальной меч, тяжёлая пластина, плата, свеча зажигания, 2 алюминиевые пластины и медный провод. Меч очищенного сияния — сборка по шагам на палке: розовый кварц, палка, очищенное сияние, лава, вода, ещё сияние и пресс (сияние: 2 светокаменной пыли, 2 измельчённого обсидиана и розовый кварц в смесителе). Мечи Epic Knights — как железные, из стали TFMG.",
		" ",
		"",
		" ",
		"Ступень T4: урон 6,5–15,7, скорость 1,0–2,0. Стальной меч TFMG — 9,5 и 1,6.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	task.671AB88F8EDBC446.title: "Любой предмет из списка"
	quest.51DA7801A67108D4.title: "Незеритовые мечи"
	quest.51DA7801A67108D4.quest_desc: [
		"Как сделать: кузнечный стол — шаблон незеритового улучшения, алмазный меч того же вида и незеритовый слиток. Незерит плавится только в смесителе с перегревом: 4 обломка, 2 золота и 2 стали TFMG. Незеритовый меч — основа Fantasy Weapons, шестерёночного меча, Испепелителя и меча хранителя.",
		" ",
		"",
		" ",
		"Ступень T5: урон 10,5–20,3, скорость 0,7–1,7. Незеритовый меч — 10,5 и 1,6.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	quest.7250BC396A7E5C1A.title: "Пылающий камень"
	quest.7250BC396A7E5C1A.quest_desc: [
		"Fantasy Weapons: 76 видов легендарного оружия — клейморы, катаны, алебарды, рапиры, молоты.",
		" ",
		"Как сделать: пылающий камень — 4 огненного порошка, 4 светокаменной пыли и камень. Кузнечный стол: в слот шаблона — третий предмет, он задаёт вид оружия (железный слиток — Клеймор Героя, необработанная медь — Цареубийца), затем незеритовый меч и пылающий камень. Все рецепты — в JEI.",
	]
	quest.5D2B6635742EA1A0.title: "Оружие легенд"
	quest.5D2B6635742EA1A0.quest_desc: [
		"Подойдёт любое оружие Fantasy Weapons.",
		" ",
		"",
		" ",
		"Ступень T5, чуть сильнее незеритового меча, а по виду разное: кинжалы — урон 8,8, скорость 2; мечи, катаны и рапиры — 11 и 1,6; копья, алебарды и глефы — 13 и 1,35; двуручные мечи, молоты и секиры — 16 и 1,1.",
	]
	task.33584954CDA1402B.title: "Любой предмет из списка"
	quest.40184F99961A1B00.title: "Шестерёночный арсенал"
	quest.40184F99961A1B00.quest_desc: [
		"Create Tools n Weapons.",
		" ",
		"Как сделать: механический крафтер — незеритовый меч (или топор), механизм точности, 3 латунных листа, промышленное железо, вал портального крана и шестерни. Есть ещё кирка, лопата и мотыга.",
		" ",
		"",
		" ",
		"Ступень T5: меч — урон 9,5, скорость 1,8; топор — 12 и 1,2.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	task.7C17047740CEDF82.title: "Любой предмет из списка"
	quest.40AEFB360E37CCDB.title: "Меч хранителя"
	quest.40AEFB360E37CCDB.quest_desc: [
		"Deeper and Darker.",
		" ",
		"Как сделать: кузнечный стол — шаблон хранителя, незеритовый меч (или незеритовый топорик Garnished) и укреплённый осколок эха: осколок эха, 4 панциря хранителя и 4 мембраны фантома.",
		" ",
		"Где взять: шаблон лежит в тайной комнате древнего храма Иного, панцири — в древних вазах и сундуках того же храма.",
		" ",
		"",
		" ",
		"Ступень T6: меч — урон 13, скорость 1,6; топорик — 10 и 1,3.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	quest.1D3A3C518F2002BA.title: "Испепелитель"
	quest.1D3A3C518F2002BA.quest_desc: [
		"Cataclysm.",
		" ",
		"Как сделать: верстак — незеритовый меч, 2 слитка игнитиума и 4 огненных стержня.",
		" ",
		"Где взять: игнитиум падает с Игниса — Пылающая арена в Незере.",
		" ",
		"",
		" ",
		"Ступень T6: урон 16, скорость 1,4, достаёт на 2 блока дальше.",
	]
	task.0D2AFC90364D47CB.title: "Любой предмет из списка"
	quest.5696EB92584A1EAF.title: "Дубины и топорики"
	quest.5696EB92584A1EAF.quest_desc: [
		"Как сделать: Basic Weapons — дубина из 2 досок или камней и палки, молот из 5 камней и 2 палок. Топорик Garnished — 2 камня или медных слитка, 2 палки и нить. Булава и моргенштерн Epic Knights — 3 медных слитка, палка и рукоять (палка и кожаный ремешок).",
		" ",
		"",
		" ",
		"Ступень T0: урон 5,7–8, скорость 0,8–1,5.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	task.4F2C79816518EE6B.title: "Любой предмет из списка"
	quest.61C0C9AAA2E4FF1F.title: "Боевые молоты"
	quest.61C0C9AAA2E4FF1F.quest_desc: [
		"Как сделать: молот Basic Weapons — 5 железных слитков и 2 палки, тяжёлый боевой молот Epic Knights — 4 слитка, палка и рукоять. Самый тяжёлый удар среди железного оружия, но медленный, а молоты Epic Knights пробивают броню.",
		" ",
		"",
		" ",
		"Ступень T1: урон 9, скорость 0,7–0,95.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	quest.499A79BFFE0C453F.title: "Мшистый молот"
	quest.499A79BFFE0C453F.quest_desc: [
		"Legendary Monsters.",
		" ",
		"Как сделать: кристалл природы, блок мха, 4 резных каменных кирпича и палка.",
		" ",
		"Где взять: кристалл природы падает с Заросшего колосса — мшистый храм.",
		" ",
		"",
		" ",
		"Ступень T1: урон 9, скорость 0,8. ПКМ по блоку бьёт всех в 4 блоках на 10 урона и отравляет. Копает как кирка.",
	]
	task.6AFD4A9675A94A0F.title: "Любой предмет из списка"
	quest.1F26DCA3814FEE3A.title: "Дубины и булавы"
	quest.1F26DCA3814FEE3A.quest_desc: [
		"Как сделать: дубина Basic Weapons — 2 железных слитка и палка. Epic Knights: булава и моргенштерн — 3 слитка, палка и рукоять, кистень — ещё и цепь (в сборке хватает обычной). Почти как железный топор, а топор останется целым для рубки.",
		" ",
		"",
		" ",
		"Ступень T1: урон 8–10,4, скорость 0,9–1,15.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	task.1049EB5B536C39C7.title: "Любой предмет из списка"
	quest.1F068CE1876D1439.title: "Топорики"
	quest.1F068CE1876D1439.quest_desc: [
		"Garnished.",
		" ",
		"Как сделать: 2 железных или цинковых слитка, 2 палки и нить. Быстрее обычного топора (урон 9, скорость 0,9).",
		" ",
		"",
		" ",
		"Ступень T1: урон 8–8,5, скорость 1,2–1,3.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	task.4CE53108043DC0F2.title: "Любой предмет из списка"
	quest.39E575E70A002F44.title: "Топорики эпохи латуни"
	quest.39E575E70A002F44.quest_desc: [
		"Как сделать: латунный — 2 латунных слитка, 2 палки и нить, кварцевый — 2 кварца Незера, 2 палки и нить. Из розового кварца — механический крафтер: 2 полированных розовых кварца, лист железа, золотой слиток, цинковая рукоять и нить. Огненный — золотой топорик и измельчённый обсидиан в смесителе с нагревом.",
		" ",
		"",
		" ",
		"Ступень T2: урон 7,5–9, скорость 1,2–1,5.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	task.15E46185F367D1C7.title: "Любой предмет из списка"
	quest.2EA0389E830F65D4.title: "Алмазные булавы и молоты"
	quest.2EA0389E830F65D4.quest_desc: [
		"Как сделать: как железные, из алмазов. Кистень Epic Knights — с обычной цепью. Алмазные потом улучшаются до незеритовых.",
		" ",
		"",
		" ",
		"Ступень T3: урон 8–12, скорость 0,7–1,4.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	task.43D1CEAFD99590FF.title: "Любой предмет из списка"
	quest.3036DC6F030ECF28.title: "Стальные булавы и молоты"
	quest.3036DC6F030ECF28.quest_desc: [
		"Epic Knights из стали TFMG.",
		" ",
		"Как сделать: булава и моргенштерн — 3 стальных слитка, палка и рукоять, молот — 4, кистень — ещё и стальная цепь. Шипастая дубина — 2 стальных слитка, 4 стальных самородка и палка, кузнечный молот — 5 слитков, палка и рукоять.",
		" ",
		"",
		" ",
		"Ступень T4: урон 9,4–17,9, скорость 0,9–1,15. Булавы, молоты и кистень — 15–16 силы удара.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	task.2ABCADD6A4B75327.title: "Любой предмет из списка"
	quest.320D44AED8AAB828.title: "Незеритовые булавы и молоты"
	quest.320D44AED8AAB828.quest_desc: [
		"Как сделать: кузнечный стол — шаблон незеритового улучшения, алмазная вещь того же вида и незеритовый слиток (незерит — в смесителе с перегревом из обломков, золота и стали).",
		" ",
		"",
		" ",
		"Ступень T5: урон 9–21,8, скорость 0,7–1,4. Булавы и молоты Epic Knights — 15–17 силы удара.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	task.31FECD95E0DCCEAC.title: "Любой предмет из списка"
	quest.64B09BC2DB7A3AC1.title: "Незеритовый горн"
	quest.64B09BC2DB7A3AC1.quest_desc: [
		"Cataclysm.",
		" ",
		"Где взять: горн падает с Незеритового чудовища — кузница душ в Незере.",
		" ",
		"Как сделать: на механической наковальне слияния горн с ядром пустоты (падает с Эндер-голема, Разрушенная цитадель в Крае) становится пустотным горном, с Астрапой — Бронтом.",
		" ",
		"",
		" ",
		"Ступень T6: горн — урон 14, скорость 1, это и молот, и кирка, ПКМ по блоку бьёт по площади. Пустотный горн вызывает руны пустоты веером, Бронт (16 и 1,2) можно метать.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	quest.1A154ACAF9B5E524.title: "Молот 3×3"
	quest.1A154ACAF9B5E524.quest_desc: [
		"Just Hammers: это инструмент, а не оружие (урон 4) — молот копает сразу область 3×3.",
		" ",
		"Как сделать: 3 слитка и 3 палки, рисунок — в JEI. Бывают каменные, железные, золотые, алмазные и незеритовые, размер области написан в подсказке.",
	]
	quest.3AEF941AF2BE4490.title: "Ударный молот"
	quest.3AEF941AF2BE4490.quest_desc: [
		"Как сделать: ударное ядро — незеритовый молот, железный и золотой блоки и 6 редстоуна. Ударный молот — ядро, 3 железных блока и 2 палки. Ударный копает 3×3×3, усиленный — 5×5×1, усиленный ударный — 5×5×3, разрушитель — 5×5×5. Каждое следующее ядро делается из предыдущего, рецепты в JEI.",
	]
	task.73DBA6F59BA68F16.title: "Любой предмет из списка"
	quest.39BE750ACA6D65B7.title: "Посохи, глефы и копья"
	quest.39BE750ACA6D65B7.quest_desc: [
		"Как сделать: Basic Weapons — боевой посох из доски или камня между двумя палками, глефа из 3 досок или камней и 2 палок. Копьё Backported Spears — материал и 2 палки. Посох и глефа достают на 1,25 блока дальше меча.",
		" ",
		"",
		" ",
		"Ступень T0: урон 1–7, скорость 0,8–1,7.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	quest.424149ED2563BBA7.title: "Копьё с разбега"
	quest.424149ED2563BBA7.quest_desc: [
		"Backported Spears.",
		" ",
		"Как сделать: железный слиток и 2 палки.",
		" ",
		"Обычный удар слабый (урон 3), сила копья — в атаке с разбега: зажмите ПКМ, и урон растёт со скоростью, особенно верхом. Ступень T1.",
	]
	quest.4306488DEE155889.title: "Древнее копьё"
	quest.4306488DEE155889.quest_desc: [
		"Cataclysm.",
		" ",
		"Как сделать: 4 слитка древнего металла.",
		" ",
		"Где взять: древний металл падает с коболетонов, Коболедиатора и Ваджета у пустынных построек Cataclysm и лежит в пустынных сокровищах.",
		" ",
		"",
		" ",
		"Ступень T2: урон 9,5, скорость 1,4, достаёт на 2 блока дальше, ЛКМ выпускает песчаную бурю.",
	]
	task.44F8463DD5B9691B.title: "Любой предмет из списка"
	quest.442C055B325E7F80.title: "Пики и алебарды"
	quest.442C055B325E7F80.quest_desc: [
		"Epic Knights.",
		" ",
		"Как сделать: рукоять — палка и кожаный ремешок, древко — 2 рукояти. Пика — слиток, палка и древко, ранкур — короткий меч и древко, гизарма — ещё и слиток, ахлшпис — 4 слитка и древко, алебарда — 4 слитка, палка и древко, лохаберская секира — 3 слитка и древко, люцернский молот — 3 слитка, палка и рукоять, рыцарское копьё — 3 слитка, древко и рукоять.",
		" ",
		"",
		" ",
		"Ступень T1: урон 6,3–11,9, скорость 0,8–1,25, достают на 0,7–3 блока дальше меча. Рыцарское копьё бьёт тем сильнее, чем быстрее несёт конь.",
		" ",
		"",
		" ",
		"§7Для зачёта хватит одного любого предмета из списка, остальные — по желанию (клик покажет рецепт).§r",
	]
	task.0A329B97A27A7599.title: "Любой предмет из списка"
	quest.3935E99F9974F1EE.title: "Железные посох и глефа"
	quest.3935E99F9974F1EE.quest_desc: [
