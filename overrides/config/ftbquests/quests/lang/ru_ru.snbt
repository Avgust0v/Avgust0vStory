	quest.49EB1B96A03D4497.title: "§6Великий заказ:§r Печатные платы"
	quest.49EB1B96A03D4497.quest_subtitle: "Заказ недели · Великий заказ"
	quest.49EB1B96A03D4497.quest_desc: [
		"Платы для пультов, ракет и, говорят, одного очень умного тостера. Не спрашивайте.",
		" ",
		"",
		" ",
		"§7Сдать до понедельника, 00:00 по Москве.§r",
	]
	quest.0D8AE9498936170D.title: "Заказ недели: Незерит"
	quest.0D8AE9498936170D.quest_desc: [
		"Служебный квест доски заказов: открывает заказ этой недели.",
	]
	quest.0CA1365B9E5A05C7.title: "§6Великий заказ:§r Незерит"
	quest.0CA1365B9E5A05C7.quest_subtitle: "Заказ недели · Великий заказ"
	quest.0CA1365B9E5A05C7.quest_desc: [
		"Четыре слитка незерита. Пиглины опять соберут совещание. Пусть собирают.",
		" ",
		"",
		" ",
		"§7Сдать до понедельника, 00:00 по Москве.§r",
	]
	quest.75DEFBA09E84CA73.title: "Заказ недели: Лунный камень"
	quest.75DEFBA09E84CA73.quest_desc: [
		"Служебный квест доски заказов: открывает заказ этой недели.",
	]
	quest.1F968B8169E5D631.title: "§6Великий заказ:§r Лунный камень"
	quest.1F968B8169E5D631.quest_subtitle: "Заказ недели · Великий заказ"
	quest.1F968B8169E5D631.quest_desc: [
		"Хочу лунную плитку в мастерской. Да, это каприз. Да, я плачу короной.",
		" ",
		"",
		" ",
		"§7Сдать до понедельника, 00:00 по Москве.§r",
