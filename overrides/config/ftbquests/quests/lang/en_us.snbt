	chapter.6AC229FA60BF18CA.title: "&#E9C46ARatibor's Orders&r"
	chapter.6AC229FA60BF18CA.subtitle: "Four orders a week, one per tier. New ones every Monday."
	quest.7FFD99F0CED01858.title: "The Order Board"
	quest.7FFD99F0CED01858.quest_desc: [
		"Every Monday at midnight (Moscow time) Ratibor posts four orders, one per tier: Apprentice, Master, Engineer and Grand Order. Each order can be done once a week and pays two to four times what the exchange does.",
		" ",
		"",
		" ",
		"Higher tiers appear once the team reaches their era.",
		" ",
		"",
		" ",
		"§6Hand in the whole order and claim the reward before Monday:§r at midnight the board resets and an unfinished order burns together with what was handed in.",
		" ",
		"",
		" ",
		"\"I am not greedy. I am thrifty. The difference is in the coins you get.\" — Ratibor",
	]
	quest.2CF091C57E980F0D.title: "Order of the week: Cogs for the Store"
	quest.2CF091C57E980F0D.quest_desc: [
		"Order board helper quest: unlocks this week's order.",
