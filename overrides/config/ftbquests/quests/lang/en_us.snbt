	quest.3E787A93CB370F86.quest_desc: [
		"Epic Knights in TFMG steel.",
		" ",
		"How to make: like the iron ones, from steel ingots. The pitchfork is 2 steel ingots and 3 sticks and reaches 2 blocks further.",
		" ",
		"",
		" ",
		"Tier T4: damage 6.7-20, speed 0.8-1.25. The halberd and the axe have 16 strength, the pike 14 and the longest reach.",
