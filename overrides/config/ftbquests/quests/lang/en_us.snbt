	quest.32881EA946AFEDC9.title: "Soul Render"
	quest.32881EA946AFEDC9.quest_desc: [
		"Cataclysm.",
		" ",
		"How to make: 3 cursium ingots and 2 black steel ingots.",
		" ",
		"Where to get: cursium drops from Maledictus in the Frosted Prison. Draugrs and aptrgangrs drop black steel, and it lies in Frosted Prison chests too.",
		" ",
		"",
		" ",
		"Tier T6: damage 20, speed 1.05, reaches 2 blocks further. Right-click dashes, with Shift it summons phantom halberds in a spiral.",
	]
	task.373DCB6A1314ADE5.title: "Any item from the list"
	quest.75692FFCF4F6DD18.title: "Storm Weapons"
	quest.75692FFCF4F6DD18.quest_desc: [
		"Cataclysm.",
		" ",
		"How to make: Astrape and Ceraunus each take 2 essences of the storm and 3 lacrima, in different shapes.",
		" ",
		"Where to get: the essence of the storm drops from Scylla in the Acropolis. Lacrima drops from her and the Acropolis creatures and lies in its treasure.",
		" ",
		"",
		" ",
		"Tier T6: Astrape damage 12, speed 1.4, right-click throws a lightning spear. Ceraunus is an anchor, 20 and 0.8, it can be thrown, and with Shift it sends waves in a fan.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	quest.0E61C4D3F95C100D.title: "The Tesseract"
	quest.0E61C4D3F95C100D.quest_desc: [
		"Legendary Monsters.",
		" ",
		"How to make: a bottle of annihilation (an eye of ender and a glass bottle), 2 portal shards and 2 enderitium ingots (an ingot is 9 enderitium gems).",
		" ",
		"Where to get: portal shards drop from the Obliterator on its space station. Enderitium ore lies in the End, and the station chests hold gems too.",
		" ",
		"",
		" ",
		"Tier T6: damage 18, speed 1.25. Hold right-click for 1.5 seconds and annihilation portals open around you in a star and pull enemies in.",
	]
	task.49CDE8DEB11476B2.title: "Any item from the list"
	quest.6E7F7AFB349B01D9.title: "Daggers and Stilettos"
	quest.6E7F7AFB349B01D9.quest_desc: [
		"How to make: the Basic Weapons dagger is stone or an iron ingot over a stick. Epic Knights: the stiletto is an ingot and a hilt (a stick and a leather strip), the estoc a short sword and an ingot. The dagger is the fastest weapon: many light hits instead of one heavy one. Stilettos pierce armour, the estoc reaches half a block further.",
		" ",
		"",
		" ",
		"Tier T1: damage 3-7.4, speed 1.35-2.4.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	task.02E3C86669CAEA41.title: "Any item from the list"
	quest.2EEF81AD8CE1DEEC.title: "Diamond Daggers"
	quest.2EEF81AD8CE1DEEC.quest_desc: [
		"How to make: like the iron ones, from diamonds. They later upgrade to netherite.",
		" ",
		"",
		" ",
		"Tier T3: damage 5-8.5, speed 1.35-2.4.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	task.6EA5B97A7C011E09.title: "Any item from the list"
	quest.7CF20A8350EA86C5.title: "Steel Stiletto and Estoc"
	quest.7CF20A8350EA86C5.quest_desc: [
		"Epic Knights.",
		" ",
		"How to make: the stiletto is a TFMG steel ingot and a hilt, the estoc a steel short sword and an ingot.",
		" ",
		"",
		" ",
		"Tier T4: the stiletto damage 8.8, speed 1.6; the estoc 11.8 and 1.36.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	task.0980A8D4F77CB204.title: "Any item from the list"
	quest.5184725707E30D36.title: "Netherite Daggers"
	quest.5184725707E30D36.quest_desc: [
		"How to make: smithing table: a netherite upgrade template, a diamond dagger of the same kind and a netherite ingot.",
		" ",
		"",
		" ",
		"Tier T5: damage 6-13.8, speed 1.3-2.4. The Epic Knights stiletto and estoc have about 18 strength.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	task.73D11B28FDE8F316.title: "Any item from the list"
	quest.6BEB77F8F97DA85E.title: "Cataclysm Gauntlets"
	quest.6BEB77F8F97DA85E.quest_desc: [
		"Cataclysm.",
		" ",
		"Where to get: the Gauntlet of Guard drops from the Ender Guardian in the Ruined Citadel in the End.",
		" ",
		"How to make: on the mechanical fusion anvil, the gauntlet with the Bulwark of the Flame (a shield, 2 ignitium ingots from Ignis, 2 blaze rods and 4 nether bricks) becomes the Gauntlet of Bulwark, with a Sandstorm in a Bottle (dropped by the Ancient Remnant, the Cursed Pyramid) the Gauntlet of Maelstrom.",
		" ",
		"",
		" ",
		"Tier T6: damage 11, speed 1.6, right-click pulls enemies to you.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	quest.31352F29D5CC7FD1.title: "Tidal Claws"
	quest.31352F29D5CC7FD1.quest_desc: [
		"Cataclysm.",
		" ",
		"Where to get: dropped by the Leviathan in the Sunken City.",
		" ",
		"",
		" ",
		"Tier T6: damage 8, speed 1.6. Right-click fires a grappling hook, left-click a tentacle that hurts from afar.",
	]
	task.7B84C80AE893496A.title: "Any item from the list"
	quest.17D92094E21B3E64.title: "Wooden Bows"
	quest.17D92094E21B3E64.quest_desc: [
		"More Bows and Arrows.",
		" ",
		"How to make: a plain bow and 2 logs of the wood (the bamboo one takes 2 bamboo blocks). The bonus damage is in the bow's tooltip.",
		" ",
		"",
		" ",
		"Tier T0: wooden bows give +2 damage.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	task.2CF9879823B03381.title: "Any item from the list"
	quest.23A813F10114D44E.title: "Bows, Longbow and Crossbow"
	quest.23A813F10114D44E.quest_desc: [
		"How to make: More Bows and Arrows bows are a plain bow and 2 of a material: iron, copper or gold ingots, bones, coal, lapis, amethyst. The Epic Knights longbow is 4 sticks, 3 string and a hilt: it hits harder than a bow but takes almost twice as long to draw.",
		" ",
		"",
		" ",
		"Tier T1: metal and stone bows give +2 damage, the golden one +1.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	task.201EA41B671F5E70.title: "Any item from the list"
	quest.1251F92219FE7C10.title: "Blaze and Emerald Bows"
	quest.1251F92219FE7C10.quest_desc: [
		"How to make: a plain bow and 2 blaze rods or 2 emeralds.",
		" ",
		"Where to get: blazes in Nether fortresses drop the rods, villagers trade emeralds.",
		" ",
		"",
		" ",
		"Tier T2: +3 damage.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	task.0F38897136ED63F2.title: "Any item from the list"
	quest.7A93B012288663BC.title: "Diamond and Obsidian Bows"
	quest.7A93B012288663BC.quest_desc: [
		"How to make: a plain bow and 2 diamonds or 2 obsidian. The diamond one later upgrades to netherite.",
		" ",
		"",
		" ",
		"Tier T3: the diamond bow gives +5 damage, the obsidian one +4.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	quest.78FB0938EE581859.title: "Heavy Crossbow"
	quest.78FB0938EE581859.quest_desc: [
		"Epic Knights.",
		" ",
		"How to make: 3 TFMG steel ingots, 2 string, a tripwire hook and a pole (2 hilts). Tier T4.",
	]
	task.2AB9D0172ECF3851.title: "Any item from the list"
	quest.68FFE8E733634134.title: "Netherite Bows"
	quest.68FFE8E733634134.quest_desc: [
		"How to make: smithing table: a netherite upgrade template, a diamond bow and a netherite ingot. The nocturnal bow is made the same way from a netherite bow and one more ingot.",
		" ",
		"",
		" ",
		"Tier T5: the netherite bow gives +6 damage, the nocturnal one +4 but makes you faster.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	task.5E77C8AAB8AA362E.title: "Any item from the list"
	quest.271915FF5579D3BE.title: "Cursed Bow"
	quest.271915FF5579D3BE.quest_desc: [
		"Cataclysm.",
		" ",
		"How to make: the cursed bow is 2 cursium ingots, a black steel ingot and 3 string. On the mechanical fusion anvil the bow with a Sandstorm in a Bottle becomes the Wrath of the Desert.",
		" ",
		"Where to get: cursium drops from Maledictus in the Frosted Prison, black steel from draugrs and the chests of the same prison, the Sandstorm in a Bottle from the Ancient Remnant in the Cursed Pyramid.",
		" ",
		"",
		" ",
		"Tier T6.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	task.1F3A4261FF32D837.title: "Any item from the list"
	quest.17F4FCFA632CF04A.title: "Ice Maze Weapons"
	quest.17F4FCFA632CF04A.quest_desc: [
		"Aquamirae.",
		" ",
		"How to make: the remnant saber is 2 sharp bones, string and a stick. Terrible weapons are 2 iron ingots, 2 fins, a stick and 2 trophies: angler fangs make the fang, anglerfish esca the blade, ship graveyard echoes the cleaver.",
		" ",
		"Where to get: everything comes from Ice Maze creatures. Eels, anglerfish and maws drop fins, anglerfish drop fangs and esca, scuttlers, maws, anglerfish and abyssal scyphoids drop echoes, eels, maws and the maze mother drop sharp bones. The dagger of greed cannot be crafted; it now and then lies in the maze's frozen and ship chests.",
		" ",
		"",
		" ",
		"Tier T2: the saber damage 5, speed 2; the fang 6 and 2; the blade 5 and 3; the cleaver 7 and 1; the dagger of greed 9 and 2.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	task.1A3D36D968DB6644.title: "Any item from the list"
	quest.7AEE279B4EA43B3B.title: "Abyssal Weapons"
	quest.7AEE279B4EA43B3B.quest_desc: [
		"Aquamirae.",
		" ",
		"How to make: the shatterblade is 2 diamonds, 4 abyssal amethysts, 2 ship graveyard echoes and a stick. The shatterspike is a diamond, 2 amethysts, 2 echoes and 2 sticks.",
		" ",
		"Where to get: the maze mother drops abyssal amethysts, and now and then they lie in the Ice Maze's treasure pouches.",
		" ",
		"",
		" ",
		"Tier T3: the blade damage 7, speed 1.4; the spike 14 and 0.8, reaching a third further.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	task.7E300E102FA1BB72.title: "Any item from the list"
	quest.7C1295FD212D7992.title: "Neptunium"
	quest.7C1295FD212D7992.quest_desc: [
		"Aquaculture.",
		" ",
		"How to make: the sword is 2 neptunium ingots and a stick, the bow 3 ingots and 3 string.",
		" ",
		"Where to get: the ingots lie in Neptune's Bounty, a rare chest you can fish up.",
		" ",
		"",
		" ",
		"Tier T3: the sword damage 7.5, speed 1.6.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	image.7E935AD28662F630.title: "Swords"
	image.454C0D79CA1A5D38.title: "Maces and Hammers"
	image.59F5D45A453FB115.title: "Polearms"
	image.35ECE778E9DDB852.title: "Daggers"
	image.6E688016D3E0BDFB.title: "Bows and Crossbows"
	image.1A1ADEDFCBB65510.title: "Sea Weapons"
	chapter.52004070A26F5A92.title: "&#B5838DDungeons and Mini-Bosses&r"
	chapter.52004070A26F5A92.subtitle: "Structures from easy to hard, and mini-bosses before the big bosses."
	task.7C942631C8A2DAEF.title: "Enter any Create-style structure"
	quest.73B70C9E08960368.title: "On the Road"
	quest.73B70C9E08960368.quest_desc: [
		"The world has many Create-style ruins: windmills, cranes, water towers, abandoned stations. Small ones are common, big dungeons rare.",
		" ",
		"",
		" ",
		"§6How it works:§r step inside any small Create-style structure: a windmill, crane, water tower, station, barn, smithy, well, camp, house or a mine cart on rails. You have to walk in; seeing it from afar is not enough. Explorer's Compass finds the nearest one.",
		" ",
		"§6Why:§r opens the chapter: illager camps and forts, abandoned stations and the first bosses (Umvuthi, Sculptor).",
		" ",
		"",
		" ",
		"§6Explorer's Compass (any of them):§r Create: Structures Arise: Windmill, Createcushercrane, Createfluidtank, Createlosttrainstation, Minetrain; Create: Rustic Structures: Rustic Windmill, Rustic Barn, Rustic Smithy, Rustic Well; Create: Easy Structures: Windmill, Camp 1, Camp 2, Camp 3, Camp 4 and 24 more.",
	]
	quest.4CA7D0A34DE1C9AE.title: "Local Creepers"
	quest.4CA7D0A34DE1C9AE.quest_desc: [
		"Every biome has its own creepers and zombies with special tricks.",
	]
	quest.08C43B6F1875CA10.title: "Chest With Teeth"
	quest.08C43B6F1875CA10.quest_desc: [
		"Mimics hide among dungeon chests. The reward is an artifact.",
	]
	task.4617DCA3CBDD714D.title: "Find an illager camp or outpost"
	quest.3EB6DEE93DB0986D.title: "Illager Camp"
	quest.3EB6DEE93DB0986D.quest_desc: [
		"Any illager camp or outpost counts: a campsite, an illager windmill, a watchtower, sorcerer huts, a Create pillager camp. Walk into its grounds.",
		" ",
		"§6Why:§r opens the first bosses from easy to hard: Umvuthi → Sculptor → Ferrous Wroughtnaut → Frostmaw. The Legendary Monsters bosses open after the Sculptor.",
		" ",
		"",
		" ",
		"§6Explorer's Compass (any of them):§r When Dungeons Arise: Illager Campsite, Illager Windmill; Minecraft: Pillager Outpost; Terralith: Desert Outpost; ChoiceTheorem's Overhauled Village: Pillager Outpost Badlands, Pillager Outpost Beach, Pillager Outpost Dark Forest, Pillager Outpost Desert, Pillager Outpost Jungle; Moog's Voyager Structures: Small Pillager Tower; Structory: Towers: Pillager Lookout; Create: Pillagers Arise: Createpillagercamp, Createpillageroutpost, Createpillagerhousesmall, Createpillagersmallhouse and 11 more.",
	]
	quest.6DCD9D06CBB4A147.title: "Lost Train Station"
	quest.6DCD9D06CBB4A147.quest_desc: [
		"Old stations keep train parts, ahead of the rails era.",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Createlosttrainstation (Create: Structures Arise).",
	]
	quest.19F7D886FBE8E1B8.title: "Ferrous Wroughtnaut"
	quest.19F7D886FBE8E1B8.quest_desc: [
		"§6Tier B2§r · recommended armour T1+ (iron)",
		" ",
		"",
		" ",
		"Lives in underground chambers. Hit its back while it is stuck after a swing. Drops its axe and helmet.",
		" ",
		"",
		" ",
		"The First Guild's first automaton (Chronicle of the Predecessors).",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Wrought Chamber (Mowzie's Mobs).",
	]
	quest.70316C8DA55A4226.title: "Naga"
	quest.70316C8DA55A4226.quest_desc: [
		"§6Tier B1§r · recommended armour T0+ (leather, wood)",
		" ",
		"",
		" ",
		"A flying serpent of sea cliffs. Bring ranged weapons: a bow or a flintlock.",
		" ",
		"",
		" ",
		"Chronicle: \"From the height of the sea cliffs the naga sees the whole shore. It left our fishermen alone until we began breaking its cliffs for the port's stone. Since then not a single boat goes near those rocks.\"",
	]
	task.01B3E061FB91E001.title: "Find an illager fort"
	quest.4FBE4C40EDF3B9D7.title: "Illager Fort"
	quest.4FBE4C40EDF3B9D7.quest_desc: [
		"Any illager fort counts (Dungeons Arise or Illager Invasion), a Create pillager fort gate or village, the illager cathedral, a woodland mansion. Walk inside.",
		" ",
		"§6Why:§r leads to the Invoker, the Foundry and the castles.",
		" ",
		"",
		" ",
		"§6Explorer's Compass (any of them):§r When Dungeons Arise: Illager Fort; Illager Invasion: Illager Fort; Create: Pillagers Arise: Createpillagerfortgate, Createpillagervillage, Cathedral Create; Minecraft: Mansion.",
	]
	quest.7798BC3AAAB21479.title: "Invoker"
	quest.7798BC3AAAB21479.quest_desc: [
		"§6Tier B2§r · recommended armour T1+ (iron)",
		" ",
		"",
		" ",
		"Illager Invasion: the Invoker is a mini-boss. Its primal essence makes the imbuing table that enchants beyond the caps.",
		" ",
		"",
		" ",
		"A former Predecessor apprentice, now the illagers' chief (Chronicle).",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Labyrinth (Illager Invasion).",
	]
	quest.79A40BB8311AA38D.title: "Imbuing Table"
	quest.1CE654B0FE286ED8.title: "Frostmaw"
	quest.1CE654B0FE286ED8.quest_desc: [
		"§6Tier B2§r · recommended armour T1+ (iron)",
		" ",
		"§bCold:§r a warm lining on your armour and hot food",
		" ",
		"",
		" ",
		"Sleeps in snowy biomes. Its ice crystal grants frost breath.",
		" ",
		"",
		" ",
		"Chronicle: \"In the north, where Frostmaw sleeps, the snow does not melt even in summer. The wagon trains to Maledictus' ice prison went the long way round its drift: whoever woke the beast never arrived. The ice crystal it guards is the very heart of the northern winter.\"",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Frostmaw Spawn (Mowzie's Mobs).",
	]
	task.10B3652C7F45EDFB.title: "Find a foundry or factory"
	quest.486992895F5AE103.title: "The Foundry"
	quest.486992895F5AE103.quest_desc: [
		"A huge When Dungeons Arise industrial complex, the most Create-like dungeon.",
		" ",
		"",
		" ",
		"The reward for the foundry is on page 6 of the Chronicle of the Predecessors. Here it opens the way further into the dungeons.",
		" ",
		"",
		" ",
		"§6How it works:§r a foundry, a mechanical nest or an abandoned Create factory counts. Foundryman Prokhor's shift sheet is only in the chests of the Dungeons Arise foundry.",
		" ",
		"§6Why:§r leads to the mutants, the pirate airships and the mechanical nest.",
		" ",
		"",
		" ",
		"§6Explorer's Compass (any of them):§r When Dungeons Arise: Foundry, Mechanical Nest; Create: Easy Structures: Factory 1, Factory 2.",
	]
	quest.43BCD5BEDAD97A28.title: "Mechanical Nest"
	quest.43BCD5BEDAD97A28.quest_desc: [
		"§6Explorer's Compass:§r Mechanical Nest (When Dungeons Arise).",
	]
	quest.427CBF8A4DCC4604.title: "Umvuthi"
	quest.427CBF8A4DCC4604.quest_desc: [
		"§6Tier B1§r · recommended armour T0+ (leather, wood)",
		" ",
		"",
		" ",
		"Chief of the Umvuthana grove in the savanna. The Sol Visage is a strong support weapon.",
		" ",
		"",
		" ",
		"Chronicle: \"The Umvuthana lived in their savanna grove long before we came to this land. Chief Umvuthi traded with us until we began cutting his grove for charcoal. Now the sun mask greets strangers with fire.\"",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Umvuthana Grove (Mowzie's Mobs).",
	]
	quest.3D39AC590848515D.title: "Mutants"
	quest.3D39AC590848515D.quest_desc: [
		"§6Tier B1§r · recommended armour T0+ (leather, wood)",
		" ",
		"",
		" ",
		"Rare giants. The mutant skeleton's bones make armour, the mutant zombie drops a hammer.",
		" ",
		"",
		" ",
		"Chronicle: \"When the rivers by the foundries turned black, giants began to turn up on their banks: zombies and skeletons twice the height of the old ones. We told ourselves it was a sickness. I think it was the water we let out of the foundries.\"",
	]
	quest.279A7D44272088E3.title: "Pirate Airship"
	quest.279A7D44272088E3.quest_desc: [
		"A steampunk raider airship. Best approached in your own ship with an autocannon.",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Pillagersteampunkairship (Create: Structures Arise).",
	]
	quest.17D3428EAAF76613.title: "Sea Fortress"
	quest.17D3428EAAF76613.quest_desc: [
		"§6Explorer's Compass:§r Typhon (When Dungeons Arise).",
	]
	quest.48BCF78DE9988978.title: "Sculptor"
	quest.48BCF78DE9988978.quest_desc: [
		"§6Tier B1§r · recommended armour T0+ (leather, wood)",
		" ",
		"",
		" ",
		"A mountaintop monastery trial: climb the pillars. The reward is a gauntlet that raises the earth.",
		" ",
		"",
		" ",
		"Chronicle: \"The Sculptor is the master of stone: he raises rocks with a wave of his hand. Into his mountaintop monastery he admits only those who climb his pillars themselves, without machines. He threw our lifts off the mountain the very first night.\"",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Monastery (Mowzie's Mobs).",
	]
	quest.3D7D3C0F8D30BBEC.title: "Heavenly Isles"
	quest.3D7D3C0F8D30BBEC.quest_desc: [
		"The hardest When Dungeons Arise dungeon: floating islands. Only with a ship or a jetpack.",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Heavenly Challenger (When Dungeons Arise).",
	]
	quest.7FF8E2A4E5AA959C.title: "The Hunter"
	quest.7FF8E2A4E5AA959C.quest_desc: [
		"The illager hunter kills animals for hides and lives in a forest hut. His boomerang comes back to the hand.",
	]
	quest.7FB7F3F4AC6AB52C.title: "Undead of the Lands"
	quest.7FB7F3F4AC6AB52C.quest_desc: [
		"Rotten Creatures: mummies in deserts, frostbitten in the snow, swampies in bogs, undead miners in caves. Each has its own trick.",
	]
	quest.4456230050210D7E.title: "Dead Beard"
	quest.4456230050210D7E.quest_desc: [
		"§6Tier B1§r · recommended armour T0+ (leather, wood)",
		" ",
		"",
		" ",
		"The undead captain arrives with a skeleton crew. His chest is the best prize on the coast.",
		" ",
		"",
		" ",
		"Chronicle: \"While he was still alive, Dead Beard sailed along our shores and smuggled our brass across the sea. A storm took him and his crew but never let them go: on foggy nights he still sails in for a cargo that no longer exists.\"",
	]
	quest.18C073B0C5E8D751.title: "The Fallen Knight"
	quest.18C073B0C5E8D751.quest_desc: [
		"Ender Zoology: the fallen knight rides a dead horse at night. Unhorse him first.",
		" ",
		"",
		" ",
		"Chronicle: \"Mounted watchmen guarded the roads between our towns. When the guild left, one of them was never relieved from his post, and he did not leave it even after death. He still rides the old road and cuts down anyone who walks it without a pass.\"",
	]
	quest.3EE25C32D1CB359C.title: "The Overgrown Colossus"
	quest.3EE25C32D1CB359C.quest_desc: [
		"§6Tier B2§r · recommended armour T1+ (iron)",
		" ",
		"",
		" ",
		"Legendary Monsters: a colossus of stone and roots sleeps in the mossy temple.",
		" ",
		"",
		" ",
		"Chronicle: \"The colossus is older than the mossy temple: it seems the temple was simply built around it while it slept. We cut the jungle around it for plantations until the colossus rose, and the forest came back in a single summer. Since then I have believed that the land can defend itself.\"",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Mossy Temple (Legendary Monsters).",
	]
	quest.686148F36ABC3617.title: "The Frostbitten Golem"
	quest.686148F36ABC3617.quest_desc: [
		"§6Tier B2§r · recommended armour T1+ (iron)",
		" ",
		"§bCold:§r a warm lining on your armour and hot food",
		" ",
		"",
		" ",
		"An ice temple in the snow is guarded by a golem that freezes everything around it.",
		" ",
		"",
		" ",
		"Chronicle: \"No man built the ice temple: its walls grow like frost on glass. We tried to cut ice there for our cellars, but the golem stopped our steam drill at full speed. The drill is still in the ice.\"",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Frostbitten Temple (Legendary Monsters).",
	]
	quest.2C8FF03B385BDEF7.title: "The Dune Sentinel"
	quest.2C8FF03B385BDEF7.quest_desc: [
		"§6Tier B2§r · recommended armour T1+ (iron)",
		" ",
		"§cHeat:§r a cooling lining on your armour and water",
		" ",
		"",
		" ",
		"The ruined desert pyramid is not a tomb but a sentinel post. He wakes at the sound of footsteps.",
		" ",
		"",
		" ",
		"Chronicle: \"The ruined pyramid was raised by those who lived in the sands before us, and they left a sentinel in it: a machine without a single cog that walks all the same. We never understood how it was built. When we began digging wells nearby for the observatory, the sentinel came out to meet us.\"",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Ruined Pyramid (Legendary Monsters).",
	]
	quest.2A65CFE61AEB1003.title: "The Void Blossom"
	quest.2A65CFE61AEB1003.quest_desc: [
		"§6Tier B3§r · recommended armour T2+ (brass)",
		" ",
		"",
		" ",
		"A flower that drinks light and life grows in lush caves. Cut it before it takes root.",
		" ",
		"",
		" ",
		"Chronicle: \"This flower grew slowly while it was quiet underground. We went down into the lush caves for clay and water, and our mines brought it air and noise: it woke and reached for our lanterns. Where it blooms, every living thing fades.\"",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Void Blossom (Bosses of Mass Destruction).",
	]
	quest.0429C3D8CE8E46FD.title: "The Night Lich"
	quest.0429C3D8CE8E46FD.quest_desc: [
		"§6Tier B3§r · recommended armour T2+ (brass)",
		" ",
		"§bCold:§r a warm lining on your armour and hot food",
		" ",
		"",
		" ",
		"Bosses of Mass Destruction: a lich tower stands in the snowy mountains. He summons spirits and throws frost bolts.",
		" ",
		"",
		" ",
		"Chronicle: \"The lich's tower is older than our ice prison. Its master, they say, also looked for a way to live longer than he was given, and found it, to his sorrow. Runaway apprentices asked him for shelter; at night their voices can still be heard from the tower.\"",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Lich Tower (Bosses of Mass Destruction).",
	]
	quest.04DC3BDA0C03A032.title: "The Nether Gauntlet"
	quest.04DC3BDA0C03A032.quest_desc: [
		"§6Tier B3§r · recommended armour T2+ (brass)",
		" ",
		"§cHeat:§r a cooling lining on your armour and water",
		" ",
		"",
		" ",
		"A huge stone gauntlet lies in a Nether arena. It fires lasers and hurls fireballs.",
		" ",
		"",
		" ",
		"Chronicle: \"Whose hand it is we never learned: none of us ever saw the giant it belonged to whole. Ignat wanted to break it up for fireproof stone for the forge, but the hand clenched into a fist and struck with fire. Since then we have kept away from that Nether arena.\"",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Gauntlet Arena (Bosses of Mass Destruction).",
	]
	quest.1B7BA27E6BE00990.title: "The Obsidilith"
	quest.1B7BA27E6BE00990.quest_desc: [
		"§6Tier B5§r · recommended armour T4+ (steel plate)",
		" ",
		"",
		" ",
		"A living obsidian monolith stands in the End. Whoever defeats it gets the obsidian heart.",
		" ",
		"",
		" ",
		"Chronicle: \"The monolith in the End is like the stones whose carvings my father followed for his first cog, only it is alive. It guards the obsidian heart and lets no one near it. We thought the monoliths were silent; this one answered.\"",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Obsidilith Arena (Bosses of Mass Destruction).",
	]
	quest.0EB4F8AFE6A5B3D1.title: "The Ice Maze"
	quest.0EB4F8AFE6A5B3D1.quest_desc: [
		"Aquamirae: in frozen oceans the ice rises in walls and forms a maze. Inside lie a ship graveyard, salvager camps and creatures from the deep: eels, maws, the maze mother. Without a warm lining (Kitchen, Water and Climate chapter) the cold drains your health to one heart; bring food and stay together.",
		" ",
		"",
		" ",
		"Chronicle: \"The apprentices fled Maledictus' ice prison towards the sea. A stranger's ship waited for them at the edge of the ice: the captain took her fee in advance and promised warm water. In spring we found only masts sticking out of the pack ice.\"",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Shipwreck (Aquamirae).",
	]
	quest.4F8C62BD832D48F0.title: "Captain Cornelia"
	quest.4F8C62BD832D48F0.quest_desc: [
		"§6Tier B2§r · recommended armour T1+ (iron)",
		" ",
		"§bCold:§r a warm lining on your armour and hot food",
		" ",
		"",
		" ",
		"Somewhere in the maze a pirate ship is frozen into the ice. Its captain never left the bridge, not even after death. The logbook tells what happened here, if you reach the cabin.",
		" ",
		"",
		" ",
		"Chronicle: \"Cornelia swore to carry the runaways to warm water. She still holds her course, in the ice. We punished the hungry, and the cold punished both them and her.\"",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Pirate Ship (Aquamirae).",
	]
	quest.3D4A10682B7DC98E.title: "The Otherside"
	quest.3D4A10682B7DC98E.quest_desc: [
		"§6Tier B5§r · recommended armour T4+ (steel plate)",
		" ",
		"",
		" ",
		"Deeper and Darker: ancient cities in the Deep Dark hold a portal frame. Beyond it lies the Otherside, a world of sculk and silence. Keep quiet.",
	]
	quest.65E465CE6ED0558B.title: "The Ancient Keep"
	quest.65E465CE6ED0558B.quest_desc: [
		"Archaion: deep in the deepslate layer stands the Ancient Keep, with a library, guard barracks, a tram station and an arena. Deepslate sentinels guard it, and wights and haunters roam its halls. Look for its map in Ancient City chests. An echo key from a deepslate spawner opens the deepslate vaults; one of them may hold the last note of Efim the mine master.",
		" ",
		"",
		" ",
		"Chronicle: \"When the mountain veins ran dry, the council ordered us down. We ran a tram to the deepslate and cut halls, stores and barracks for the shifts there. It was our last and deepest mine.\"",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Ancient Keep (Archaion).",
	]
	quest.04A01F6009A3DC4F.title: "The Last of Deepslate"
	quest.04A01F6009A3DC4F.quest_desc: [
		"§6Tier B5§r · recommended armour T4+ (steel plate)",
		" ",
		"",
		" ",
		"In the keep's arena waits the Last of Deepslate, a stone giant that brings down the ceiling and strikes with shockwaves. Go as a group and bring food.",
		" ",
		"",
		" ",
		"Chronicle: \"Efim told us to wall up the far face, and we laughed. The last thing we found down there found us first. The tram went up empty.\"",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Ancient Keep (Archaion).",
	]
	quest.46682DFD209254EF.title: "Raider Settlement"
	quest.46682DFD209254EF.quest_desc: [
		"Create: Pillager Arise: raiders have settled among Create machinery: traps, towers, their own camps and forts. Settlements are rare, usually 1-3 thousand blocks away. Go in pairs.",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Createpillagervillage (Create: Pillagers Arise).",
	]
	quest.36A56701B93E88B5.title: "Raider Blimp"
	quest.36A56701B93E88B5.quest_desc: [
		"A raider blimp hangs in the sky. Get up there with your own ship, a jetpack, or by gliding from a nearby mountain.",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Createpillagerblimp (Create: Pillagers Arise).",
	]
	quest.1629CA747584D1D0.title: "Keep Kayra"
	quest.1629CA747584D1D0.quest_desc: [
		"Castle, citadel and armoury chests hold Epic Knights weapons and shields, strips and hilts, heraldry and plumes, and now and then chainmail horse armour and a war barding: these cannot be crafted, only found. The farther from spawn, the more often steel plate turns up.",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Keep Kayra (When Dungeons Arise).",
	]
	quest.6DDB148C9AF494AF.title: "The Forbidden Castle"
	quest.6DDB148C9AF494AF.quest_desc: [
		"Incendium rebuilt the Nether: new biomes, dwellers and fortresses. The Forbidden Castle is the most dangerous of them: traps, piglin guards and a vault with Incendium weapons. Do not go alone.",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Forbidden Castle (Incendium).",
	]
	quest.704E905ADFCB78A3.title: "Castles of the Realm"
	quest.704E905ADFCB78A3.quest_desc: [
		"The dark castle, castle ruins, forts and the Collapsed Kingdom. Their chests hold Epic Knights weapons and shields, heraldry, horse armour and now and then steel plate.",
		" ",
		"",
		" ",
		"§6Explorer's Compass (any of them):§r Create: Structures Arise: Create Ruined Castle, Darkcastle; Moog's Voyager Structures: Castle Ruins; mss: Castle Ruin; Medieval Buildings: Fort; When Dungeons Arise: Keep Kayra; Legendary Monsters: Collapsed Kingdom.",
	]
	quest.0AC2981AA27F29AA.title: "The Lava Eater"
	quest.0AC2981AA27F29AA.quest_desc: [
		"§6Tier B3§r · recommended armour T2+ (brass)",
		" ",
		"§cHeat:§r a cooling lining on your armour and water",
		" ",
		"",
		" ",
		"It lives in the Nether's lava lakes. Its hide makes fiery boots that let you walk on lava like stone.",
		" ",
		"",
		" ",
		"Chronicle: \"For this beast lava is what water is to us. We pumped lava from its Nether lakes for the foundries, and with every barrel it swam closer. The last time it dragged the barrel down, pump and all.\"",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Lava Eater Spawn (Legendary Monsters).",
	]
	quest.7539F6D15BEECA36.title: "The Possessed Paladin"
	quest.7539F6D15BEECA36.quest_desc: [
		"§6Tier B4§r · recommended armour T3+ (diamond-level)",
		" ",
		"",
		" ",
		"An ancient fortress in the dark forest holds a paladin his oath never released. He hits hard and takes hits well, and is nearly untouchable at range.",
		" ",
		"",
		" ",
		"Chronicle: \"The Collapsed Kingdom was already old when we came here: the king had long since turned to dust and the walls had fallen, yet the paladin still stands guard. He serves his king the way our guardians serve us, who are gone. Only the one who defeats him can set him free.\"",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Collapsed Kingdom (Legendary Monsters).",
	]
	quest.296028D6BC6BA78D.title: "The Obliterator"
	quest.296028D6BC6BA78D.quest_desc: [
		"§6Tier B6§r · recommended armour T5+ (netherite and trophy sets)",
		" ",
		"",
		" ",
		"The Legendary Monsters space station and its master. Its shards make annihilator armour, trophy tier T6.",
		" ",
		"",
		" ",
		"Chronicle: \"On the islands of the End stands a foreign station, made of metal like our rocket but built long before us. So someone before us also tried to leave their land for the sky. The Obliterator guards it still, though there has long been no one left to fly away in it.\"",
	]
	quest.7B292058E97E10D1.title: "The Cataclysm Retinue"
	quest.7B292058E97E10D1.quest_desc: [
		"§6Tier B2§r · recommended armour T1+ (iron)",
		" ",
		"",
		" ",
		"Tier B2 mini-bosses near the Cataclysm guardians' lairs: the Kobolediator in desert camps, the Prowler in the Ancient Factory, the Clawdian in the Acropolis. Practice before the guardians themselves.",
		" ",
		"",
		" ",
		"Chronicle: \"The great guardians have servants: the kobolds of the desert camps, the beasts of the Acropolis, and our own mechanical Prowler, which still walks the workshops of the Ancient Factory as on the day we wound it up. The servants are strong, but nowhere near their masters. Whoever cannot handle the servants should not go to their lords.\"",
		" ",
		"",
		" ",
		"§6Explorer's Compass (any of them):§r L_Ender's Cataclysm 1.21.1: Ancient Factory, Acropolis.",
	]
	quest.03BA46A98823FEDC.title: "Monster Hunter"
	quest.03BA46A98823FEDC.quest_desc: [
		"All Mowzie's mini-bosses are down. Now for the big Cataclysm bosses in the Bosses chapter.",
	]
	chapter.788AD6ADA5EE8939.title: "&#D00000Bosses&r"
	chapter.788AD6ADA5EE8939.subtitle: "Vanilla, Cataclysm, Block Factory, Legendary Monsters - by tiers B1-B6."
	quest.038270643AC48CD2.title: "Boss Hunting"
	quest.038270643AC48CD2.quest_desc: [
		"The pack's toughest bosses: vanilla, L_Ender's Cataclysm, Block Factory's Bosses, and the new 1.1 guardians.",
		" ",
		"A victory counts for everyone nearby (64 blocks), even from different guilds and even if someone else landed the final blow. The quest completes for each participant's guild, the chronicle page too; everyone claims their own reward.",
		" ",
		"Different groups can fight bosses at different times. Cataclysm guardians can be summoned again: the Harbinger, Ender Guardian, Scylla, Ancient Remnant and Netherite Monstrosity at the Boss Respawner where they fell (with the Mech, Void, Storm, Desert or Monstrous Eye), Ignis at the Altar of Fire with Burning Ashes, the Leviathan at the Altar of Abyss with an Abyssal Sacrifice, Maledictus at the Cursed Tombstone. Other bosses live in other structures of the same kind; there are many in the world.",
		" ",
		"Find lairs with the Explorer's Compass. Many bosses are built for groups — bring armor, food and potions.",
		" ",
		"",
		" ",
		"§6Bosses come in tiers B1-B6.§r The tier, the armour to bring and the health show in the first line of each quest and in chat on the first meeting. Details in the handbook page \"Gear Tiers\".",
	]
	quest.2A6A00998296C0B8.title: "Vanilla Bosses"
	quest.2A6A00998296C0B8.quest_desc: [
		"Minecraft classics: the Elder Guardian, the Wither, the Ender Dragon and, optionally, the Warden.",
	]
	quest.189164932188DE72.title: "Elder Guardian"
	quest.189164932188DE72.quest_desc: [
		"§6Tier B1§r · recommended armour T0+ (leather, wood)",
		" ",
		"",
		" ",
		"Chronicle: \"The ocean monument stood in the sea long before our port. Its Elder Guardian laid such a weariness on our divers that the pick fell from their hands. We left the monument alone: the first and last time we ever listened to the sea.\"",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Monument (Minecraft).",
	]
	quest.326318105CFEBFA0.title: "The Wither"
	quest.326318105CFEBFA0.quest_desc: [
		"§6Tier B3§r · recommended armour T2+ (brass)",
		" ",
		"",
		" ",
		"Chronicle: \"No land and no master sets the Wither: you put it together with your own hands, from soul sand and skulls taken in the Nether fortresses, for the star in its chest. We built one once to light a beacon. The beacon burns to this day, and grass still does not grow on that spot.\"",
	]
	quest.643E6D152A424A54.title: "Ender Dragon"
	quest.643E6D152A424A54.quest_desc: [
		"§6Tier B5§r · recommended armour T4+ (steel plate)",
		" ",
		"",
		" ",
		"Chronicle: \"A dragon circles over the main island of the End, the eldest of all the guardians we ever met. We never touched it: we flew to the far islands for levitite in our ships, in a wide circle, and still lost people. You, the heirs, can do what we never dared.\"",
	]
	quest.14E69E154C2CB3B6.title: "The Warden"
	quest.14E69E154C2CB3B6.quest_desc: [
		"§6Tier B6§r · recommended armour T5+ (netherite and trophy sets)",
		" ",
		"",
		" ",
		"Optional and very dangerous. Sometimes running is the better plan.",
		" ",
		"",
		" ",
		"Chronicle: \"Below our mines stand ancient cities older than us, and the Warden lives in them. It is blind, but it hears every step and every stroke of a pick. Efim the mine master taught his shift to walk there in silence, and still not all of them came back.\"",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Ancient City (Minecraft).",
	]
	quest.77BBF5FA460B1483.title: "L_Ender's Cataclysm"
	quest.77BBF5FA460B1483.quest_desc: [
		"Cataclysm adds huge dungeons with their own bosses. Its eyes work like Eyes of Ender and point to the lairs. Boss drops forge unique weapons and armor — check JEI.",
	]
	quest.178004D6CDBA6E92.title: "Ender Golem"
	quest.178004D6CDBA6E92.quest_desc: [
		"§6Tier B5§r · recommended armour T4+ (steel plate)",
		" ",
		"",
		" ",
		"Chronicle: \"In the Ruined Citadel of the End the stone walks on its own: golems of the void guard its gates and halls. They were made not by us but by those who lived in the End before us. The masters left long ago, and the golems still serve the Ender Guardian.\"",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Ruined Citadel (L_Ender's Cataclysm 1.21.1).",
	]
	quest.5EA8C91B92D8229F.title: "Ender Guardian"
	quest.5EA8C91B92D8229F.quest_desc: [
		"§6Tier B6§r · recommended armour T5+ (netherite and trophy sets)",
		" ",
		"",
		" ",
		"Dwells in the Ruined Citadel in the End.",
		" ",
		"",
		" ",
		"Guardian of the last levitite veins (Chronicle of the Predecessors).",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Ruined Citadel (L_Ender's Cataclysm 1.21.1).",
	]
	quest.4E57459B78B47811.title: "Netherite Monstrosity"
	quest.4E57459B78B47811.quest_desc: [
		"§6Tier B5§r · recommended armour T4+ (steel plate)",
		" ",
		"§cHeat:§r a cooling lining on your armour and water",
		" ",
		"",
		" ",
		"Waits in the Soul Black Smith in the Nether.",
		" ",
		"",
		" ",
		"The smith Ignat's golem that fed the Nether furnaces (Chronicle of the Predecessors).",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Soul Black Smith (L_Ender's Cataclysm 1.21.1).",
	]
	quest.208FFA609A30F062.title: "Ignis"
	quest.208FFA609A30F062.quest_desc: [
		"§6Tier B6§r · recommended armour T5+ (netherite and trophy sets)",
		" ",
		"§cHeat:§r a cooling lining on your armour and water",
		" ",
		"",
		" ",
		"The lord of flame from the Burning Arena in the Nether.",
		" ",
		"",
		" ",
		"Chronicle: \"Ignat wanted a fire that knows by itself where to strike, and he grew Ignis. The knight still holds the Burning Arena by the forge and cannot tell a thief from an heir.\" More in the Chronicle of the Predecessors, page 10.",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Burning Arena (L_Ender's Cataclysm 1.21.1).",
	]
	quest.2CBA25BA0957B46C.title: "The Harbinger"
	quest.2CBA25BA0957B46C.quest_desc: [
		"§6Tier B6§r · recommended armour T5+ (netherite and trophy sets)",
		" ",
		"",
		" ",
		"A mechanical boss from the Ancient Factory.",
		" ",
		"",
		" ",
		"Chronicle: \"The whole guild built the Harbinger: every master put a mechanism of his own into it. It stands at the gates of the Ancient Factory and lets through only one who is stronger than itself.\" More in the Chronicle of the Predecessors, pages 8 and 9.",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Ancient Factory (L_Ender's Cataclysm 1.21.1).",
	]
	quest.0E8566C7CED0495F.title: "The Leviathan"
	quest.0E8566C7CED0495F.quest_desc: [
		"§6Tier B4§r · recommended armour T3+ (diamond-level)",
		" ",
		"",
		" ",
		"A deep-sea nightmare from the Sunken City. Bring water breathing.",
		" ",
		"",
		" ",
		"Guardian of the Predecessors' sunken port (Chronicle of the Predecessors).",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Sunken City (L_Ender's Cataclysm 1.21.1).",
	]
	quest.698F9A216828CADC.title: "Ancient Remnant"
	quest.698F9A216828CADC.quest_desc: [
		"§6Tier B4§r · recommended armour T3+ (diamond-level)",
		" ",
		"§cHeat:§r a cooling lining on your armour and water",
		" ",
		"",
		" ",
		"Awakens in the Cursed Pyramid in the desert.",
		" ",
		"",
		" ",
		"Guardian of the observatory where the Predecessors plotted the rocket's path (Chronicle).",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Cursed Pyramid (L_Ender's Cataclysm 1.21.1).",
	]
	quest.068D465E27A99775.title: "Maledictus"
	quest.068D465E27A99775.quest_desc: [
		"§6Tier B6§r · recommended armour T5+ (netherite and trophy sets)",
		" ",
		"§bCold:§r a warm lining on your armour and hot food",
		" ",
		"",
		" ",
		"A cursed warrior from the Frosted Prison.",
		" ",
		"",
		" ",
		"Warden of the ice prison that held the future illagers (Chronicle of the Predecessors).",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Frosted Prison (L_Ender's Cataclysm 1.21.1).",
	]
	quest.1E0164143136A3DB.title: "Scylla"
	quest.1E0164143136A3DB.quest_desc: [
		"§6Tier B4§r · recommended armour T3+ (diamond-level)",
		" ",
		"",
		" ",
		"The storm queen of the sea.",
		" ",
		"",
		" ",
		"Chronicle: \"The storm in which Scylla was born left the sunken port for the open sea and settled over the Acropolis. Our airships came up to its columns more than once, but Scylla raised the wind before we could drop anchor.\" More in the Chronicle of the Predecessors.",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Acropolis (L_Ender's Cataclysm 1.21.1).",
	]
	quest.5668AD0EA39A2CC0.title: "Block Factory's Bosses"
	quest.5668AD0EA39A2CC0.quest_desc: [
		"Bosses with their own arenas around the world. Some arenas open with a key — check JEI.",
	]
	quest.6356E223E486C0C9.title: "Yeti"
	quest.6356E223E486C0C9.quest_desc: [
		"§6Tier B2§r · recommended armour T1+ (iron)",
		" ",
		"§bCold:§r a warm lining on your armour and hot food",
		" ",
		"",
		" ",
		"Lives in snowy lands.",
		" ",
		"",
		" ",
		"Chronicle: \"On the snowy plains, in a hideout under the drifts, lives the yeti. It left our hunters alone while they took one beast a winter. When we began killing animals for hides to sell, the yeti came out onto the trail itself.\"",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Yeti Hideout (Bosses'Rise).",
	]
	quest.483EF1AFDC5F8771.title: "Sandworm"
	quest.483EF1AFDC5F8771.quest_desc: [
		"§6Tier B2§r · recommended armour T1+ (iron)",
		" ",
		"§cHeat:§r a cooling lining on your armour and water",
		" ",
		"",
		" ",
		"Hides in the desert sands.",
		" ",
		"",
		" ",
		"Chronicle: \"The desert where our observatory stood only looks empty: under the dunes, in the sandworm's nest, the ground trembles. It smelled our water caravans a mile away. We laid our road over stone, not sand, and still lost wagons.\"",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Sandworm Nest (Bosses'Rise).",
	]
	quest.5D39013E81828865.title: "Pirate Captain"
	quest.5D39013E81828865.quest_desc: [
		"§6Tier B1§r · recommended armour T0+ (leather, wood)",
		" ",
		"",
		" ",
		"Commands a pirate ship.",
		" ",
		"",
		" ",
		"Chronicle: \"Pirates came from foreign shores when our port grew rich. Their vessel is called the Kraken Ship: they say the captain feeds the beast in the deep, and it sinks whoever will not pay tribute.\"",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Kraken Ship (Bosses'Rise).",
	]
	quest.22F2F97114CE638E.title: "Kraken"
	quest.22F2F97114CE638E.quest_desc: [
		"§6Tier B4§r · recommended armour T3+ (diamond-level)",
		" ",
		"",
		" ",
		"Chronicle: \"The Kraken is the guardian of the deep sea, older than the pirates and older than us. The pirates only learned to sail their ship above its lair and pay it with other people's vessels. Our ore barges it took for nothing.\"",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Kraken Ship (Bosses'Rise).",
	]
	quest.1BA7B7B5AC438D9C.title: "Underworld Knight"
	quest.1BA7B7B5AC438D9C.quest_desc: [
		"§6Tier B3§r · recommended armour T2+ (brass)",
		" ",
		"§cHeat:§r a cooling lining on your armour and water",
		" ",
		"",
		" ",
		"Chronicle: \"In the Underworld Arena in the Nether wastes stands a knight who swore his oath to fire long before Ignat lit his first burner. We found the key to the arena but never dared to open it. Ignat envied it: if only I had such a guardian, he used to say.\"",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Underworld Arena (Bosses'Rise).",
	]
	quest.79AD95D4B5440CF7.title: "Infernal Dragon"
	quest.79AD95D4B5440CF7.quest_desc: [
		"§6Tier B3§r · recommended armour T2+ (brass)",
		" ",
		"",
		" ",
		"Chronicle: \"We did not build the Dragon Tower: it stood here when my father was still carving cogs from stone. The knights who guarded it have long since crumbled inside their armour, and the fire dragon in the tower was left without a master. We took their iron from the stairs, and the dragon woke.\"",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Dragon Tower (Bosses'Rise).",
	]
	quest.303CF052DFDAC070.title: "Boss Slayer"
	quest.303CF052DFDAC070.quest_desc: [
		"Defeat the pack's major bosses: the Ender Dragon, the Wither, Ignis, the Harbinger, the Leviathan. A server legend!",
	]
	image.14257608E6E536AF.title: "Vanilla Guardians"
	image.4A635952CE769FF5.title: "Cataclysm"
	image.2FFD88A278348B9A.title: "Block Factory"
}
