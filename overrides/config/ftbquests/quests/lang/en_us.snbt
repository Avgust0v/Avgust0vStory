	task.31FECD95E0DCCEAC.title: "Any item from the list"
	quest.64B09BC2DB7A3AC1.title: "Infernal Forge"
	quest.64B09BC2DB7A3AC1.quest_desc: [
		"Cataclysm.",
		" ",
		"Where to get: the forge drops from the Netherite Monstrosity in the Soul Blacksmith forge in the Nether.",
		" ",
		"How to make: on the mechanical fusion anvil, the forge with a void core (dropped by the Ender Golem, the Ruined Citadel in the End) becomes the Void Forge, with Astrape it becomes Brontes.",
		" ",
		"",
		" ",
		"Tier T6: the forge damage 14, speed 1, a hammer and a pickaxe in one, right-clicking a block hits an area. The Void Forge summons void runes in a fan, Brontes (16 and 1.2) can be thrown.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	quest.1A154ACAF9B5E524.title: "A 3×3 Hammer"
	quest.1A154ACAF9B5E524.quest_desc: [
		"Just Hammers: a tool rather than a weapon (damage 4), the hammer mines a 3×3 area at once.",
		" ",
		"How to make: 3 ingots and 3 sticks, JEI shows the shape. There are stone, iron, gold, diamond and netherite ones; the tooltip shows the area size.",
	]
	quest.3AEF941AF2BE4490.title: "Impact Hammer"
	quest.3AEF941AF2BE4490.quest_desc: [
		"How to make: an impact core is a netherite hammer, an iron block, a gold block and 6 redstone. The impact hammer is the core, 3 iron blocks and 2 sticks. The impact hammer mines 3×3×3, the reinforced one 5×5×1, the reinforced impact one 5×5×3 and the destructor 5×5×5. Each core is made from the previous one; JEI has the recipes.",
	]
	task.73DBA6F59BA68F16.title: "Any item from the list"
	quest.39BE750ACA6D65B7.title: "Staffs, Glaives and Spears"
	quest.39BE750ACA6D65B7.quest_desc: [
		"How to make: Basic Weapons, a quarterstaff of a plank or stone between two sticks, a glaive of 3 planks or stones and 2 sticks. A Backported Spears spear is the material and 2 sticks. The staff and the glaive reach 1.25 blocks further than a sword.",
		" ",
		"",
		" ",
		"Tier T0: damage 1-7, speed 0.8-1.7.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	quest.424149ED2563BBA7.title: "Charging Spear"
	quest.424149ED2563BBA7.quest_desc: [
		"Backported Spears.",
		" ",
		"How to make: an iron ingot and 2 sticks.",
		" ",
		"A normal jab is weak (damage 3); the spear's strength is the charge: hold right-click and the damage grows with your speed, especially on horseback. Tier T1.",
	]
	quest.4306488DEE155889.title: "Ancient Spear"
	quest.4306488DEE155889.quest_desc: [
		"Cataclysm.",
		" ",
		"How to make: 4 ancient metal ingots.",
		" ",
		"Where to get: ancient metal drops from koboletons, the Kobolediator and the Wadjet near Cataclysm desert structures and lies in desert treasure.",
		" ",
		"",
		" ",
		"Tier T2: damage 9.5, speed 1.4, reaches 2 blocks further, left-click releases a sandstorm.",
	]
	task.44F8463DD5B9691B.title: "Any item from the list"
	quest.442C055B325E7F80.title: "Pikes and Halberds"
	quest.442C055B325E7F80.quest_desc: [
		"Epic Knights.",
		" ",
		"How to make: a hilt is a stick and a leather strip, a pole 2 hilts. The pike is an ingot, a stick and a pole, the ranseur a short sword and a pole, the guisarme also an ingot, the ahlspiess 4 ingots and a pole, the halberd 4 ingots, a stick and a pole, the Lochaber axe 3 ingots and a pole, the Lucerne hammer 3 ingots, a stick and a hilt, the chivalry lance 3 ingots, a pole and a hilt.",
		" ",
		"",
		" ",
		"Tier T1: damage 6.3-11.9, speed 0.8-1.25, they reach 0.7-3 blocks further than a sword. The lance hits harder the faster your horse runs.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	task.0A329B97A27A7599.title: "Any item from the list"
	quest.3935E99F9974F1EE.title: "Iron Staff and Glaive"
	quest.3935E99F9974F1EE.quest_desc: [
		"Basic Weapons.",
		" ",
		"How to make: the quarterstaff is an iron ingot between two sticks, the glaive 3 ingots and 2 sticks. Both reach 1.25 blocks further than a sword: good for keeping enemies at a distance.",
		" ",
		"",
		" ",
		"Tier T1: the staff damage 4, speed 1.7; the glaive 8 and 0.8.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	task.47C0DF37061BD3CF.title: "Any item from the list"
	quest.7BA4D88BE8994CEA.title: "Diamond Polearms"
	quest.7BA4D88BE8994CEA.quest_desc: [
		"How to make: like the iron ones, from diamonds. Diamond ones later upgrade to netherite.",
		" ",
		"",
		" ",
		"Tier T3: damage 4-13.6, speed 0.75-1.7. The halberd and the Lochaber axe hit hardest, the pike reaches furthest.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
