	image.7A2AD6EE3ACC123C.title: "Apprentice"
	image.71E9CCF6916FF0D3.title: "Master"
	image.3AFC0839FB33A857.title: "Engineer"
	image.390B42136569120E.title: "Grand Order"
	chapter.3454B04FF0C25AD0.title: "&#F4A261The Guild Shop&r"
	chapter.3454B04FF0C25AD0.subtitle: "Exchange coins and guardian tokens for what you cannot craft. Every purchase can be repeated."
	quest.169ACB71D2B05BC1.title: "How the Shop Works"
	quest.169ACB71D2B05BC1.quest_desc: [
		"Press \"Submit\" on a purchase: the coins or tokens are taken from your inventory, the goods arrive at once and the purchase opens again.",
		" ",
		"",
		" ",
		"Numismatics coins come from exchange contracts, quests and trade between guilds. Everyone standing within 64 blocks when a structure guardian falls gets a guardian token: Ignis, the Leviathan, the Night Lich, Cornelia and others. The Wither, the Warden and the Ender Dragon give no tokens.",
	]
	quest.480B44A735ED345E.title: "Bottled Experience"
	quest.480B44A735ED345E.quest_desc: [
		"Teleports cost experience, and you can buy it.",
	]
	quest.60EB61AF811FC73B.title: "Return Scrolls"
	quest.60EB61AF811FC73B.quest_desc: [
		"Home from anywhere, back to your waystone.",
	]
	quest.1E39FF72DA62B8CE.title: "Nature's Compass"
	quest.1E39FF72DA62B8CE.quest_desc: [
		"Finds any biome.",
	]
	quest.7F3D9C6F23666183.title: "Explorer's Compass"
	quest.7F3D9C6F23666183.quest_desc: [
		"Finds any structure, a guardian lair included.",
	]
	quest.2D58913773EB03D1.title: "Saddle"
	quest.2D58913773EB03D1.quest_desc: [
		"For a horse, a pig or a strider.",
	]
	quest.370A476FA340105F.title: "Name Tags"
	quest.370A476FA340105F.quest_desc: [
		"Name an animal and it will never despawn.",
	]
	quest.53FFC1739282123E.title: "Golden Carrots"
	quest.53FFC1739282123E.quest_desc: [
		"The best food for the road.",
	]
	quest.50E7AADD08CBF41A.title: "Sniffer Egg"
	quest.50E7AADD08CBF41A.quest_desc: [
		"A sniffer digs up ancient seeds.",
	]
	quest.40C185F50B5A122B.title: "Heart of the Sea"
	quest.40C185F50B5A122B.quest_desc: [
		"For a conduit: breathe and see underwater.",
	]
	quest.796FE00AE923E1BF.title: "Totem of Undying"
	quest.796FE00AE923E1BF.quest_desc: [
		"Saves you from death once.",
	]
	quest.743AE4CFD7332EC6.title: "Mending Book"
	quest.743AE4CFD7332EC6.quest_desc: [
		"Experience repairs your gear.",
	]
	quest.42822013BCB2C7C9.title: "Netherite Upgrade Template"
	quest.42822013BCB2C7C9.quest_desc: [
		"No bastion raid needed.",
	]
	quest.0B0E7A0AF77CBD7A.title: "Enchanted Golden Apple"
	quest.0B0E7A0AF77CBD7A.quest_desc: [
		"For the hardest fight.",
	]
	quest.049CEBD0729F0D81.title: "Elytra"
	quest.049CEBD0729F0D81.quest_desc: [
		"Wings without hunting End ships, for those who have already been to the End.",
	]
	quest.57ED6836EF5E62DE.title: "Sell a Token"
	quest.57ED6836EF5E62DE.quest_desc: [
		"The guild treasury buys a token for 4 cogs.",
	]
	chapter.54161B9819F9D227.title: "&#E76F51World Exploration&r"
	chapter.54161B9819F9D227.subtitle: "Structures, dimensions, archaeology and artifacts."
	quest.05B4081B9721AB3B.title: "Adventure Awaits"
	quest.05B4081B9721AB3B.quest_desc: [
		"The pack's world is full of structures: Dungeons Arise, Structory, overhauled villages, Cataclysm, Legendary Monsters and Bosses of Mass Destruction dungeons.",
		" ",
		"Lootr gives every player their own chest loot, so explore together freely.",
		" ",
		"Server tip: form a guild (an FTB Teams party of up to 4 players, inventory button); quest progress is shared inside the guild.",
		" ",
		"",
		" ",
		"Chronicle: \"We crossed this land from end to end but looked only at our feet: for ore, for coal. Heir, look around you too: our notes lie in the ruins, and every building holds someone's story.\"",
	]
	quest.4A4D6BBFDFD8D405.title: "Nature's Compass"
	quest.4A4D6BBFDFD8D405.quest_desc: [
		"Finds any biome.",
	]
	quest.3584BC96C05B81A9.title: "Explorer's Compass"
	quest.3584BC96C05B81A9.quest_desc: [
		"Finds any structure, boss lairs included.",
	]
	quest.7CD3245C528E9F02.title: "Waystone"
	quest.7CD3245C528E9F02.quest_desc: [
		"A teleport network. Activate waystones you find and place your own at bases. Travel costs experience: the farther, the more (up to 27 levels); another dimension costs 27 at once. Global waystones cost the same, warp plates half. For long routes a train or a ship pays off.",
	]
	quest.2CA71200DC80629F.title: "Return Scroll"
	quest.27456D2E34802369.title: "Warp Stone"
	quest.27456D2E34802369.quest_desc: [
		"A portable teleport to any activated waystone.",
	]
	quest.0C9F9F01CFF640B2.title: "Archaeology"
	quest.0C9F9F01CFF640B2.quest_desc: [
		"Suspicious sand and gravel hide finds. Better Archeology adds fossils and ancient artifacts.",
	]
	quest.1A1EC416333250E2.title: "Unidentified Artifact"
	quest.0681202113C8FFF2.title: "Archeology Table"
	quest.0681202113C8FFF2.quest_desc: [
		"Identify the find at the table to get an ancient item with a special power (totems, bombs and more).",
	]
	quest.2D1F7C5D0EA6A458.title: "Artifacts"
	quest.2D1F7C5D0EA6A458.quest_desc: [
		"Structure chests may hold artifacts: cloud in a bottle, running shoes, claws and more. Careful — some chests are mimics!",
	]
	quest.7E1F90B300B465D7.title: "Overworld Dungeons"
	quest.7E1F90B300B465D7.quest_desc: [
		"Trial chambers, ancient cities, ocean monuments and mansions, plus dozens of Dungeons Arise and Structory structures. Explore everything you find.",
	]
	quest.4C3524EDA359F682.title: "Trial Chambers"
	quest.4C3524EDA359F682.quest_desc: [
		"§6Explorer's Compass:§r Trial Chambers (Minecraft).",
	]
	quest.2A0A115E794F6C18.title: "Trial Key"
	quest.6E2D5370531169F7.title: "Mace"
	quest.6E2D5370531169F7.quest_desc: [
		"The Heavy Core drops from ominous vaults. Combine it with a breeze rod to make the Mace.",
	]
	quest.720E2A84641D95E3.title: "The Nether"
	quest.720E2A84641D95E3.quest_desc: [
		"The reward for the first Nether trip is in Era 2 (Into the Nether). Here the Nether opens the search for a fortress and a bastion.",
	]
	quest.7D9ACB82381CA35B.title: "Nether Fortress"
	quest.7D9ACB82381CA35B.quest_desc: [
		"§6Explorer's Compass:§r Fortress (Minecraft).",
	]
	quest.649777B977AB5A64.title: "Bastion Remnant"
	quest.649777B977AB5A64.quest_desc: [
		"§6Explorer's Compass:§r Bastion Remnant (Minecraft).",
	]
	quest.1DC70211B9AE8946.title: "Netherite"
	quest.1DC70211B9AE8946.quest_desc: [
		"Ancient debris plus gold. Look for the upgrade template in bastions.",
		" ",
		"",
		" ",
		"§6Netherite is now made only in a superheated mixer: 4 scrap + 2 gold + 2 TFMG steel. Keep your scrap until the steel era.§r",
	]
	quest.2689AE7493FD8B7D.title: "Stronghold"
	quest.2689AE7493FD8B7D.quest_desc: [
		"Eyes of Ender lead to the stronghold with the End portal.",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Stronghold (Minecraft).",
	]
	quest.0198B30433C0AD4D.title: "The End"
	quest.0198B30433C0AD4D.quest_desc: [
		"The reward for the End is in The Sky: Ships and Jetpacks (The End quest). Here the End opens the search for an End city.",
	]
	quest.69BD03EE3F98CBF1.title: "End City"
	quest.69BD03EE3F98CBF1.quest_desc: [
		"Elytra are found on End ships.",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r End City (Minecraft).",
	]
	quest.2E5781E0AB6080EC.title: "Ancient City"
	quest.2E5781E0AB6080EC.quest_desc: [
		"Stay quiet — the Warden hunts here.",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Ancient City (Minecraft).",
	]
	quest.4ADDF55ACD6F5E6A.title: "Recovery Compass"
	quest.4ADDF55ACD6F5E6A.quest_desc: [
		"Points to where you last died.",
	]
	quest.3155C400BA0020AF.title: "Ocean Monument"
	quest.3155C400BA0020AF.quest_desc: [
		"§6Explorer's Compass:§r Monument (Minecraft).",
	]
	quest.3CFC306E8DBE0E31.title: "Buried Treasure"
	quest.3CFC306E8DBE0E31.quest_desc: [
		"Treasure maps are found on shipwrecks.",
	]
	quest.5DCF5F177B22169F.title: "Woodland Mansion"
	quest.5DCF5F177B22169F.quest_desc: [
		"§6Explorer's Compass:§r Mansion (Minecraft).",
	]
	quest.083932C79138D22E.title: "World Traveler"
	quest.083932C79138D22E.quest_desc: [
		"Go everywhere worth going: an End City, an Ancient City, netherite, the Mace and an Ocean Monument.",
	]
	quest.1EC1218CE11C10F0.title: "Paraglider"
	quest.1EC1218CE11C10F0.quest_desc: [
		"Paragliders: jump from a height and hold right-click with the paraglider to glide. Gliding uses stamina, shown as a wheel by the crosshair. Campfires and fire send up warm air that lifts you.",
	]
	quest.7ADA1661351C3BC9.title: "Spirit Orbs"
	quest.7ADA1661351C3BC9.quest_desc: [
		"Orbs drop from broken spawners, trial chambers and elder guardians, and turn up in dungeon chests. Bring 4 orbs to a Goddess Statue (craft one or find it in villages) for a stamina vessel: you glide for longer. Hearts are not sold here; they grow with new dishes and Crystal Hearts.",
	]
	quest.35046B73B8850B23.title: "Towers on the Horizon"
	quest.35046B73B8850B23.quest_desc: [
		"Structory: Towers places a tower suited to each biome: watchtowers, forest towers, desert towers and more. The top gives a long view, and the chests hold the pack loot like other buildings.",
		" ",
		"",
		" ",
		"§6Explorer's Compass (any of them):§r Structory: Towers: Ancient Temple, Engineer Tower, Farmer Outpost, Foraging Outpost, Great Toadstool and 16 more.",
	]
	quest.0860A224B4B7D61B.title: "Bones in the Void"
	quest.0860A224B4B7D61B.quest_desc: [
		"Nullscape reshaped the End: floating islands, rifts and crystal peaks, and among them lie the skeletons of ancient dragons. Find one. Bring an elytra or plenty of blocks.",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Dragon Skeleton (Nullscape).",
	]
	quest.56E18D619505984F.title: "The Flying End Ship"
	quest.56E18D619505984F.quest_desc: [
		"Unusual End brought the End to life: flying ships, blob nests, towers and wanderer islands. With Nullscape its biomes appear here: warped reefs and gloop lands.",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Flying End Ship (Unusual End).",
	]
	quest.4073A19A4CE19B6C.title: "The Enderblob Queen"
	quest.4073A19A4CE19B6C.quest_desc: [
		"§6Tier B6§r · recommended armour T5+ (netherite and trophy sets)",
		" ",
		"",
		" ",
		"Mistress of the blob nest, one of the strongest in the End. Her armour is almost impenetrable: bring armour-piercing weapons and friends.",
		" ",
		"",
		" ",
		"Chronicle: \"We never settled the far islands of the End where the blobs build their nests, however much levitite lay there. Their queen suffers no guests and makes no bargains. We left her islands to her, and perhaps that was the wisest thing we ever did.\"",
	]
	chapter.4407398F80F7B747.title: "&#B8C4FFUnder the Moon&r"
	chapter.4407398F80F7B747.subtitle: "Blood, harvest, blue and super moons: each has its own rules and its own spoils."
	quest.6A69EC405671CD11.title: "The Lunar Calendar"
	quest.6A69EC405671CD11.quest_desc: [
		"Sometimes an unusual moon rises at night; chat tells you when.",
		" ",
		"",
		" ",
		"§cBlood moon:§r three times the undead, spawning close by, no sleeping, villages get raided.",
		" ",
		"§6Harvest moon:§r crops yield more.",
		" ",
		"§9Blue moon:§r more experience, cheaper enchanting and anvil.",
		" ",
		"§aSuper moon:§r slimes spawn anywhere.",
		" ",
		"Blood, harvest and blue moons have \"super\" versions: the same, only stronger.",
		" ",
		"",
		" ",
		"The chronicler advises: meet a blood moon behind walls, a harvest moon in the field, a blue moon at the enchanting table and a super moon with a sword and empty chests for slime.",
	]
	quest.593D77D1B5095AFA.title: "Blood Moon Hunt"
	quest.593D77D1B5095AFA.quest_desc: [
		"Defeat 20 hostile mobs under a blood moon (over several moons if needed).",
		" ",
		"",
		" ",
		"The undead spawn right next to you that night, so stay together and near a wall.",
	]
	quest.75BBA6A9DDCC783F.title: "Live to See the Dawn"
	quest.75BBA6A9DDCC783F.quest_desc: [
		"Be in the Overworld when a blood moon rises and live until it sets without dying once.",
		" ",
		"",
		" ",
		"You cannot sleep that night: a bed will not help. Walls, light and friends will.",
	]
	quest.15E80221A0486886.title: "Harvest Night"
	quest.15E80221A0486886.quest_desc: [
		"Harvest 32 ripe crops under a harvest moon (over several moons if needed).",
		" ",
		"",
		" ",
		"A Create harvester does not count: pick them by hand, the moon likes the personal touch.",
	]
	quest.248601BE4FF21097.title: "Blue Moon Luck"
	quest.248601BE4FF21097.quest_desc: [
		"Gain 5 experience levels during one blue moon.",
		" ",
		"",
		" ",
		"There is more experience that night, and enchanting and the anvil cost less: time for your dream armour.",
	]
	quest.4F75796BE0847468.title: "Slime Rain"
	quest.4F75796BE0847468.quest_desc: [
		"Defeat 8 slimes during a super moon (over several moons if needed).",
		" ",
		"",
		" ",
		"That night they spawn anywhere. Slime means pistons, belts and sticky Create contraptions.",
	]
	quest.41327865CBDB7989.title: "Under Every Moon"
	quest.41327865CBDB7989.quest_desc: [
		"You have seen every moon of this world and survived each one.",
		" ",
		"",
		" ",
		"The chronicler writes: \"They were not afraid of the dark. Only of missing something interesting.\"",
	]
	chapter.6384AA12155B113A.title: "&#E63946Arsenal and Defence&r"
	chapter.6384AA12155B113A.subtitle: "Create Gunsmithing firearms and ammunition, Big Cannons and munitions, base defence and shields, across every era. Melee weapons and bows are in the Weapons chapter, armour in Armour Sets."
	quest.10B7D2BF5BA572F7.title: "The Arsenal"
	quest.10B7D2BF5BA572F7.quest_desc: [
		"Six independent branches: firearms, ammunition, cannons, munitions, base defence and shields. Each runs through the eras from left to right: brass, precision mechanism, steel, bosses. In a family quest any one item counts, and a click on any of them shows its recipe.",
		" ",
		"",
		" ",
		"How to make: a plain shield is 6 planks and an iron ingot on a crafting table.",
		" ",
		"",
		" ",
		"Chronicle: \"For a long time the First Guild did without weapons: we built, we did not fight. When we had to defend the workshops from our own apprentices, it was too late to forge swords. Prepare your defences early.\"",
	]
	quest.61F51669057A5A69.title: "Lead"
	quest.61F51669057A5A69.quest_desc: [
		"Create Gunsmithing: guns are built on a crafting table and mechanical crafters, ammunition by sequenced assembly. All of it needs lead.",
		" ",
		"",
		" ",
		"Where to get it: TFMG lead ore in the Overworld (Gunsmithing ore does not generate in this pack). Smelt the ore or crushed ore; nuggets come from an ingot on a crafting table.",
	]
	quest.5372210F85C8C1F8.title: "Flintlock"
	quest.5372210F85C8C1F8.quest_desc: [
		"How to make: andesite alloy, an iron sheet, flint and steel and a stripped log on a crafting table. A paper cartridge is a lead nugget, gunpowder and paper (or sequenced assembly: paper, gunpowder, nugget).",
		" ",
		"",
		" ",
		"One shot per reload. Paper shot (lead balls from nuggets on a stonecutter, gunpowder and paper) fires a spread of 12 pellets.",
	]
	task.75F78B212C180387.title: "Any item from the list"
	quest.2D103EFF73F65B56.title: "Musket and Blunderbuss"
	quest.2D103EFF73F65B56.quest_desc: [
		"Flintlock attachments go on with the \"Modify Attachments\" key (controls, NTGL Weapons section).",
		" ",
		"",
		" ",
		"How to make: the musket barrel is 2 iron sheets and 2 stripped logs; the blunderbuss barrel and the long blunderbuss barrel are iron sheets and a stripped log; the flintlock chambers are 8 iron sheets around a cogwheel.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	task.76928AFC347B7EF1.title: "Any item from the list"
	quest.55E240F4678C38C1.title: "Stock, Scope and Bayonet"
	quest.55E240F4678C38C1.quest_desc: [
		"Shared attachments. The stock fits the flintlock, revolver, shotgun and nailgun, the scope the flintlock, revolver and launcher, the bayonet the flintlock, the large bayonet the launcher.",
		" ",
		"",
		" ",
		"How to make: the stock is a brass sheet and stripped logs; the scope a spyglass, a brass sheet and black dye; the bayonet 2 iron sheets and a brass sheet, the large bayonet 4 iron sheets and a brass sheet.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	quest.77780F3504F257AB.title: "Revolver"
	quest.77780F3504F257AB.quest_desc: [
		"How to make: mechanical crafters with andesite alloy, steel sheets and an ingot, a cogwheel, a brass sheet and stripped logs. Steel comes only from the TFMG blast furnace.",
		" ",
		"",
		" ",
		"Six rounds in the cylinder: plain and piercing revolver rounds (ammunition branch).",
	]
	task.03971271BBA6D833.title: "Any item from the list"
	quest.73652F36B4E055A0.title: "Revolver Attachments"
	quest.73652F36B4E055A0.quest_desc: [
		"How to make: the long barrel is iron and brass sheets and stripped logs; the chamber belt brass nuggets and steel sheets on mechanical crafters; the auto fire frame andesite alloy, a cogwheel, a brass sheet, a precision mechanism and shafts on mechanical crafters.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	task.0E80BD6C4BC97CCB.title: "Any item from the list"
	quest.6E3070B895BB4A7F.title: "Shotgun"
	quest.6E3070B895BB4A7F.quest_desc: [
		"Two barrels; rounds: buckshot, flechettes (nails), steel flechettes and incendiary.",
		" ",
		"",
		" ",
		"How to make: the shotgun is andesite alloy, steel and brass sheets and stripped logs on mechanical crafters. Long barrels are steel and brass sheets with logs, spreading barrels steel and iron sheets, drums cogwheels with brass and steel sheets, the automatic loader brass sheets, precision mechanisms and andesite alloy (crafters).",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	task.6010172D1037E0EA.title: "Any item from the list"
	quest.1405461DC7088898.title: "Gatling"
	quest.1405461DC7088898.quest_desc: [
		"A hundred rounds per box. The steam engine is the \"engine\" attachment for the gatling, nailgun and blazegun.",
		" ",
		"",
		" ",
		"How to make: the gatling is steel sheets and an ingot, brass sheets, cogwheels, a precision mechanism and andesite alloy on mechanical crafters. The drum magazine is a large cogwheel, andesite alloy and brass sheets. The steam engine is a blast furnace, a Create steam engine and flywheel, brass sheets, a precision mechanism, a pipe and a tank.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	task.00AC4331E845E807.title: "Any item from the list"
	quest.0C4BB363D1D1CF68.title: "Nailgun"
	quest.0C4BB363D1D1CF68.quest_desc: [
		"A pneumatic gun: it fires nails, 40 per magazine. Steel nails are in the ammunition branch.",
		" ",
		"",
		" ",
		"How to make: mechanical crafters with andesite alloy, a toolbox, a fluid valve, iron and brass sheets, a precision mechanism, pipes, a copper backtank and stripped logs. Nails are 3 iron nuggets in a column (or a nugget cut and pressed). The splitter is iron sheets, a chute, a precision mechanism and pipes.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	quest.6437978C77D7DE73.title: "Blazegun"
	quest.6437978C77D7DE73.quest_desc: [
		"How to make: mechanical crafters with a blaze burner, a chute, brass sheets, pipes, a fluid tank, andesite alloy and stripped logs.",
		" ",
		"",
		" ",
		"Refuel: right-click the blazegun with fuel (coal and other burnables) or a blaze cake.",
	]
	task.6DD7B64DE465D41F.title: "Any item from the list"
	quest.5671B097B9F914F7.title: "Launcher"
	quest.5671B097B9F914F7.quest_desc: [
		"Four rockets in the tube. The auto launcher is the launcher's magazine attachment.",
		" ",
		"",
		" ",
		"How to make: the launcher is andesite alloy, chutes, steel and brass sheets, pipes and stripped logs on mechanical crafters. A rocket is sequenced assembly: a pipe, TNT, a brass sheet; the small rocket starts from an iron sheet with brass and TNT. The auto launcher is a toolbox, copper and brass sheets, pipes, a copper backtank, cogwheels and a precision mechanism.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	task.4A2267156ADD91EA.title: "Any item from the list"
	quest.759440345AB6D06E.title: "Ballistazooka"
	quest.759440345AB6D06E.quest_desc: [
		"A magazine attachment for the launcher: it throws spears instead of rockets.",
		" ",
		"",
		" ",
		"How to make: the ballistazooka is flywheels, iron and brass sheets, string and stripped logs on mechanical crafters. A spear is iron sheets and stripped logs on a crafting table.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	quest.72FDF6FBA89E2F82.title: "Frag Grenade"
	quest.72FDF6FBA89E2F82.quest_desc: [
		"How to make: a brass and an iron sheet, a copper nugget, gunpowder and a cogwheel on a crafting table.",
	]
	task.6E1FA2250BA20B03.title: "Any item from the list"
	quest.4CA873468808C681.title: "Pneumatic Hammer"
	quest.4CA873468808C681.quest_desc: [
		"A pneumatic melee weapon. A hammer or axe head goes on as an attachment; with the gun chamber it fires blank shotgun rounds.",
		" ",
		"",
		" ",
		"How to make: the hammer is andesite alloy, a brass block, a mechanical piston, a copper backtank and stripped logs on mechanical crafters. Heads: stone from stone, iron and diamond from a block and ingots, netherite from the diamond head on a smithing table. The chamber is steel, copper and brass sheets with andesite alloy.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	task.2D61F593DA723A85.title: "Any item from the list"
	quest.7918413E6BB6F54F.title: "The Harbinger's Guns"
	quest.7918413E6BB6F54F.quest_desc: [
		"Where to get it: the Harbinger drops a witherite block (a crafting table turns it into ingots), the Ender Golem drops the void core.",
		" ",
		"",
		" ",
		"How to make: the laser gatling is witherite ingots, iron, redstone and a redstone block; the wither assault shoulder weapon witherite, gunpowder and a redstone block; the void assault weapon the wither one plus a void core on the Mechanical Fusion Anvil (witherite, redstone blocks and an anvil).",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	task.66C8F501DF035764.title: "Any item from the list"
	quest.4D7B9F923518F36F.title: "Home-made Gunpowder"
	quest.4D7B9F923518F36F.quest_desc: [
		"Every round and charge takes gunpowder, more than creepers will supply.",
		" ",
		"",
		" ",
		"How to make: gunpowder is charcoal dust, sulfur and niter on a crafting table (or in the TFMG mixer). Dust comes from crushing charcoal, sulfur from crushing magma blocks, niter from a heated mixer: rotten flesh or guano and 250 mB of water.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	task.50D001798CCC8056.title: "Any item from the list"
	quest.1E0C3D38B3FD973A.title: "Cartridge Cases"
	quest.1E0C3D38B3FD973A.quest_desc: [
		"How to make: press forms are an iron ingot on a stonecutter. A blank is sequenced assembly from a brass sheet: a deployer applies the press form (it is kept), then gunpowder; the shotgun one also takes paper. One sheet gives 8 blanks.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	task.69E4EAA50CA7EFB2.title: "Any item from the list"
	quest.4E8C02DAE9D35040.title: "Live Rounds"
	quest.4E8C02DAE9D35040.quest_desc: [
		"How to make: sequenced assembly from a blank. Revolver: a lead nugget; gatling: a lead and a copper nugget; shotgun: lead balls, flechette: a nail, incendiary: blaze powder.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	task.412E9FFB02C43DB5.title: "Any item from the list"
	quest.2915627E580B0467.title: "Piercing Rounds"
	quest.2915627E580B0467.quest_desc: [
		"How to make: a steel nugget instead of lead, in the revolver round (with lead) and the gatling round (with copper); the steel flechette takes a steel nail; steel nails are 3 steel nuggets in a column or a nugget cut and pressed. Steel nuggets come from a steel ingot on a crafting table.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	quest.11FCCB9AB188671C.title: "First Cannon"
	quest.11FCCB9AB188671C.quest_desc: [
		"Create Big Cannons: a cannon is built from blocks (chamber, barrel, breech end) on a carriage or mount. A log cannon is weak, but it fires.",
		" ",
		"",
		" ",
		"How to make: the chamber is 4 logs around gunpowder; the end 3 logs, a button and gunpowder; the carriage planks, a shaft and a pair of wheels (a log in iron sheets).",
	]
	quest.3BFC9638790CFB7F.title: "Mount and Charges"
	quest.3BFC9638790CFB7F.quest_desc: [
		"Powder charges and shot are rammed in; the number of charges sets the range. The mount turns with rotation.",
		" ",
		"",
		" ",
		"How to make: the mount is an andesite casing, shafts, iron sheets and gunpowder; the ram rod a head (planks and a piston extension pole) on two sticks; a charge a bag (string and wool) and packed gunpowder (gunpowder in a compactor); solid shot iron ingots, nuggets and a slab.",
	]
	task.74C3A384A11950CB.title: "Any item from the list"
	quest.3A56ABA5279C1D80.title: "Wrought Iron Cannon and Mortar"
	quest.3A56ABA5279C1D80.quest_desc: [
		"Stronger than the log cannon and, like it, joins up when placed. The drop mortar end fires mortar shells dropped into the barrel.",
		" ",
		"",
		" ",
		"How to make: the chamber is 4 iron sheets around gunpowder; the end iron ingots, a sheet and gunpowder; the drop mortar end a wrought iron end and iron bars.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	quest.37E52492C6443C01.title: "Cannon Workshop"
	quest.37E52492C6443C01.quest_desc: [
		"The drill bores cast barrels (drill and lathe speeds must match), the builder fits the layers of steel barrels together, the loader with a ram head feeds munitions.",
		" ",
		"",
		" ",
		"How to make: each is an andesite casing with a piston extension pole: the drill adds iron and a pipe, the builder iron sheets and nuggets, the loader gunpowder.",
	]
	quest.7EA7A3F925D95AE8.title: "Casting"
	quest.7EA7A3F925D95AE8.quest_desc: [
		"Metal melts in a basin under a foundry lid over a blaze burner and is poured into a mould packed with casting sand. A filled cast takes time to set (bigger takes longer); break it to get an unbored block.",
		" ",
		"",
		" ",
		"How to make: the lid is 4 andesite alloy; sand is sand, dirt and clay; moulds are a log on a mechanical saw.",
	]
	quest.7BE14415BC16599B.title: "Cast Iron Cannon"
	quest.7BE14415BC16599B.quest_desc: [
		"TFMG cast iron is iron and coal in a heated compactor; it melts in the foundry basin. Bore the cast barrel and chamber with the drill, then add the missing breech parts by hand or with a deployer (the block lists them).",
		" ",
		"",
		" ",
		"Cast iron blocks do not join when placed: build the cannon in one piece or weld it. Broken without Silk Touch, a cannon turns into scrap.",
	]
	quest.529A00BF0C8D298D.title: "Cannon Welder"
	quest.529A00BF0C8D298D.quest_desc: [
		"Right-click two adjacent cannon blocks of the same material and type to weld them. Welding weakens some barrels, so casting and moving a whole cannon is better.",
		" ",
		"",
		" ",
		"How to make: a blaze burner, brass and iron sheets and a valve handle on a crafting table.",
	]
	task.5A73EC0830F83462.title: "Any item from the list"
	quest.75326C0F476326EC.title: "Bronze Cannon"
	quest.75326C0F476326EC.quest_desc: [
		"Bronze holds more powder than cast iron and is cast the same way.",
		" ",
		"",
		" ",
		"How to make: bronze ingots come from a heated mixer: 2 brass ingots and cinder flour, or copper, zinc and cinder flour (2 ingots). Cinder flour is crushed netherrack.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	task.35BAA68F6448DB02.title: "Any item from the list"
	quest.2CD0481462C678A7.title: "Autocannon"
	quest.2CD0481462C678A7.quest_desc: [
		"A rapid-fire gun with a magazine: defence against sky pirates and a ship weapon. Barrel, breech and recoil spring are cast in their own moulds (a log on a saw).",
		" ",
		"",
		" ",
		"How to make: the container is a brass ingot and iron sheets; a flak round an iron sheet, gunpowder and shot balls (an iron ingot in nuggets); an AP round cast iron and iron ingots; a machine gun round a case (cut from a sheet), gunpowder and a copper nugget.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	quest.327C192415E8CC66.title: "Steel Barrel"
	quest.327C192415E8CC66.quest_desc: [
		"Steel withstands far more charges than cast iron and bronze. The barrel is built from layers: each is cast and bored, the builder fits them together, and a fan blowing through lava turns the layers into a finished barrel.",
	]
	quest.3216571E90BBE848.title: "Nethersteel"
	quest.3216571E90BBE848.quest_desc: [
		"How to make: nethersteel comes from a superheated mixer: netherite scrap and a steel (or cast iron) ingot. The barrel is built from layers like the steel one.",
	]
	task.37E2AB9E11E22E71.title: "Any item from the list"
	quest.02EA33D7875AE63A.title: "Shot and Grapeshot"
	quest.02EA33D7875AE63A.quest_desc: [
		"Solid shot punches through walls, grapeshot hits crowds, the mortar stone flies furthest and explodes on impact.",
		" ",
		"",
		" ",
		"How to make: shot balls are an iron ingot in 8 nuggets; grapeshot shot balls, wool, string and a slab; a mortar stone stone and a slab.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	quest.4DC5ECBC76FBF9CD.title: "Munitions"
	quest.4DC5ECBC76FBF9CD.quest_desc: [
		"An HE shell with a fuze breaks structures, shrapnel hits crowds. Fuzes go into the shell.",
		" ",
		"",
		" ",
		"How to make: guncotton is paper, gunpowder, redstone and 200 mB of water in a mixer, then a compactor; the HE shell iron, a slab and packed guncotton on mechanical crafters; the impact fuze a button and redstone.",
	]
	task.2A5DCDCA90C03369.title: "Any item from the list"
	quest.717DAE49E9909408.title: "Fuzes"
	quest.717DAE49E9909408.quest_desc: [
		"How to make: timed is a clock, iron and redstone; proximity iron bars, quartz, iron and redstone; delayed impact a timed and an impact fuze; inertia a button, a recoil spring (a sheet cut on a saw and pressed) and redstone; wired copper and redstone.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	task.0048F8C71D073B67.title: "Any item from the list"
	quest.1159F550A1F3E589.title: "Special Shells"
	quest.1159F550A1F3E589.quest_desc: [
		"How to make: AP shot and shell are cast iron (TFMG), iron and a slab, the shell also guncotton; smoke hay and iron; the fluid shell iron and pipes (filled with a fluid); the drop mortar shell a powder charge, an iron sheet, a shaft and guncotton.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	task.08292A2AF8CF4186.title: "Any item from the list"
	quest.0B55CEA58AB85331.title: "Cartridges and Nitropowder"
	quest.0B55CEA58AB85331.quest_desc: [
		"A big cartridge is a compact charge filled with stronger powder; after a shot it can be refilled.",
		" ",
		"",
		" ",
		"How to make: a cartridge sheet is 4 brass sheets, then 5 pressings by sequenced assembly. Congealed nitro is blaze powder, magma cream and gunpowder in a mixer (or guncotton, slime, redstone and water); a furnace hardens it and a millstone grinds it into nitropowder.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	quest.20FC3401E61EA89B.title: "Mega Torch"
	quest.20FC3401E61EA89B.quest_desc: [
		"Stops hostile mobs spawning within 64 blocks.",
		" ",
		"",
		" ",
		"How to make: a mechanical mixer without heat: 3 torches, 2 diamonds, 2 gold blocks, 2 logs and 250 mB of lava.",
	]
	quest.69711FBF08F72FB9.title: "Guards"
	quest.69711FBF08F72FB9.quest_desc: [
		"Guard Villagers: sneak and right-click a villager with a sword or crossbow to make a guard. Clerics heal guards.",
	]
	quest.703292B04762F4AB.title: "Dread Lamp"
	quest.703292B04762F4AB.quest_desc: [
		"The reverse: blocks passive spawns within 64 blocks, for clean farms and warehouses.",
		" ",
		"",
		" ",
		"How to make: obsidian, glass panes, glowstone and black dye.",
	]
	quest.75D83EE5912EE169.title: "Feral Flare"
	quest.75D83EE5912EE169.quest_desc: [
		"Places invisible light sources within 16 blocks by itself: mines and cellars without torches.",
		" ",
		"",
		" ",
		"How to make: gold ingots, glowstone dust and glass.",
	]
	quest.1594ED87597CB23C.title: "XP Tome"
	quest.1594ED87597CB23C.quest_desc: [
		"Stores experience: keep your levels safe and share them with a friend.",
		" ",
		"",
		" ",
		"How to make: a book and 4 ender pearls.",
	]
	task.1CCB580E9874FEB9.title: "Any item from the list"
	quest.131C69AF71A5EF6E.title: "Radar Turret"
	quest.131C69AF71A5EF6E.quest_desc: [
		"Create Radar aims the cannon itself: the auto yaw controller goes under the mount, the auto pitch controller beside it, the fire controller emits a redstone signal once the mount is aligned. Link it all to the radar monitor with data links and pick the target on the monitor.",
		" ",
		"",
		" ",
		"How to make: auto yaw and pitch are a precision mechanism and a gearbox; the fire controller a brass casing, comparators, a precision mechanism and redstone; monitors electron tubes, a brass casing and a precision mechanism; the target filter paper, a precision mechanism and redstone.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	task.45520D2E38C635B9.title: "Any item from the list"
	quest.64BE3391B428A886.title: "Stone and Metal Shields"
	quest.64BE3391B428A886.quest_desc: [
		"New Shield Variants: tougher than the plain shield.",
		" ",
		"",
		" ",
		"How to make: the shape of a plain shield; the iron shield from iron ingots, stone from cobblestone and an iron ingot, gold from gold and an iron ingot.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	task.54407A8A5CFE18C7.title: "Any item from the list"
	quest.0E970AF69A9D5397.title: "Knightly Shields"
	quest.0E970AF69A9D5397.quest_desc: [
		"Epic Knights: four shield shapes in different materials.",
		" ",
		"",
		" ",
		"How to make: a wooden shield (heater, kite, round, elliptical) is planks and an iron ingot; a metal one the wooden shield of that shape with 4 ingots or stones around it.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	task.56565184CD6DA66F.title: "Any item from the list"
	quest.246BE58B314DF1CA.title: "Diamond Shields"
	quest.246BE58B314DF1CA.quest_desc: [
		"How to make: the New Shield Variants diamond shield is diamonds and an iron ingot; the Epic Knights shields a wooden shield and 4 diamonds.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	task.7ED558D33B6C3A8C.title: "Any item from the list"
	quest.4A3024A8A0A20293.title: "Steel Shields"
	quest.4A3024A8A0A20293.quest_desc: [
		"How to make: an Epic Knights wooden shield and 4 TFMG steel ingots.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	task.74B78FF637A7AC95.title: "Any item from the list"
	quest.4D2876ED23A162FE.title: "Netherite Shields"
	quest.4D2876ED23A162FE.quest_desc: [
		"How to make: the New Shield Variants netherite shield is netherite and iron ingots on a crafting table; the Epic Knights shields a diamond shield, a netherite ingot and the upgrade template on a smithing table.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	task.50832667D166B864.title: "Any item from the list"
	quest.2D10A077B461842B.title: "Special Shields"
	quest.2D10A077B461842B.quest_desc: [
		"The fire charge and TNT shields throw a fireball and TNT.",
		" ",
		"",
		" ",
		"How to make: a netherite ingot and a special part: a fire charge, TNT, a redstone block, a blaze rod, an ender pearl, a shulker shell (End cities) or a dragon head (End ships).",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	task.3DD96756E438F82B.title: "Any item from the list"
	quest.193C7623D7FF43C6.title: "Guardians' Shields"
	quest.193C7623D7FF43C6.quest_desc: [
		"How to make: the Bulwark of the Flame is ignitium (from Ignis), blaze rods, nether bricks and a shield; the Azure Sea Shield lacrima (from Scylla, Cataclysm sea creatures and the Acropolis treasure) and gold; the corrupted shield End enderman teeth (Enderman Overhaul), planks and iron.",
		" ",
		"",
		" ",
		"Where to get it: the Block Factory's Bosses enhanced shield and dragon guard shield cannot be crafted: they lie in dragon tower chests, the enhanced one also in the underworld arena vault.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	quest.3472B863BF92E3C0.title: "The Fortress"
	quest.3472B863BF92E3C0.quest_desc: [
		"Team goal: a base under a mega torch, with guards and at least one cast-iron cannon on the wall.",
	]
	image.33B7BCC1BD1C8DBB.title: "Firearms"
	image.01CEB0D673A6B78F.title: "Cannons"
	image.66051C4D60E02FDA.title: "Base Defence"
	image.3680975E2E88F189.title: "Shields"
	chapter.0C8BC331080BBBB1.title: "&#C9A227Armour Sets&r"
	chapter.0C8BC331080BBBB1.subtitle: "The pack's armour sets by branch: where to get every piece and what the set does. Every quest but the first is optional."
	quest.27A9A632D062727C.title: "The Wardrobe"
	quest.27A9A632D062727C.quest_desc: [
		"This chapter is a guide to the armour sets. A quest lists every piece of a set: clicking a piece opens its recipe in JEI, and the quest completes once each piece has been in your inventory.",
		" ",
		"",
		" ",
		"The branches do not depend on each other: §6metal§r, from copper through brass and diamond to netherite and the trophy armour built on it · §6Immersive Armors§r, wood, bone, slime, the robe, steampunk, heavy armour · §6Epic Knights§r, from padded armour and mail to steel plate · §6the Ice Maze§r, Aquamirae armour · §6monster trophies§r, armour from mini-boss loot. Inside a branch a set opens after the set it is made from or the tier before it, later sets also after their era.",
		" ",
		"",
		" ",
		"Every item's tooltip says \"Tier Tn · era\". A full set by tier: §7T0§r 7-10 armour · §fT1§r 12-15 · §6T2§r 16-18 armour and 4 toughness · §bT3§r 20 and 8 · §9T4§r 20 and 10 · §5T5§r 20 and 12 · §cT6§r 26-28 and 16. From T2 every piece also adds health: from +2 for a T2-T3 set up to +10 for T6.",
		" ",
		"",
		" ",
		"Diving gear, jetpacks and spacesuits are in the era chapters.",
	]
	task.333AE41AF344EE02.title: "Any piece of the set"
	quest.446771FA574107D5.title: "Copper Armour"
	quest.446771FA574107D5.quest_desc: [
		"How to make: copper ingots, laid out like iron armour (the chestplate takes 8).",
		" ",
		"Tier T0: 10 armour per set. The metal branch starts here: zinc, brass, diamond, netherite.",
		" ",
		"",
		" ",
		"§7One piece of the set completes the quest, the rest are optional (click a piece for its recipe).§r",
	]
	task.1F107C9521CC02F6.title: "Any piece of the set"
	quest.4CA3A49EEC85DBB3.title: "Zinc Armour"
	quest.4CA3A49EEC85DBB3.quest_desc: [
		"How to make: the same shapes in zinc ingots.",
		" ",
		"Tier T1: 12 armour, like chainmail.",
		" ",
		"",
		" ",
		"§7One piece of the set completes the quest, the rest are optional (click a piece for its recipe).§r",
	]
	task.07548928043A7CBA.title: "Any piece of the set"
	quest.5EA91EDFFD55CF09.title: "Brass Armour"
	quest.5EA91EDFFD55CF09.quest_desc: [
		"How to make: brass ingots, laid out like iron armour.",
		" ",
		"Where to get: brass is mixed in a mixer over a blaze burner (brass era).",
		" ",
		"Tier T2: 18 armour, 4 toughness, +2 health.",
		" ",
		"",
		" ",
		"§7One piece of the set completes the quest, the rest are optional (click a piece for its recipe).§r",
	]
	task.08517D7651D6DAFC.title: "Any piece of the set"
	quest.55449D6F4EB48018.title: "Diamond and Precision"
	quest.55449D6F4EB48018.quest_desc: [
		"How to make: diamonds and a precision mechanism in every piece (instead of one diamond).",
		" ",
		"Where to get: the precision mechanism is made by sequenced assembly (the Sequenced Assembly quest of the brass era).",
		" ",
		"Tier T3: 20 armour, 8 toughness, +2 health. Resonarium, abyssal and netherite armour are forged on diamond pieces.",
		" ",
		"",
		" ",
		"§7One piece of the set completes the quest, the rest are optional (click a piece for its recipe).§r",
	]
	task.78C88ECD30E15641.title: "Any piece of the set"
	quest.26F132859F0F0742.title: "Neptunium"
	quest.26F132859F0F0742.quest_desc: [
		"How to make: neptunium ingots and a precision mechanism in every piece, like diamond armour.",
		" ",
		"Where to get: the ingots lie in Neptune's Bounty, a rare box you fish up with a rod.",
		" ",
		"Tier T3: 20 armour, 8 toughness, +2 health. Underwater the helmet gives vision, the chestplate breathing, the leggings weightlessness, the boots speed.",
		" ",
		"",
		" ",
		"§7One piece of the set completes the quest, the rest are optional (click a piece for its recipe).§r",
	]
	task.3EDBCA004ADE93DA.title: "Any piece of the set"
	quest.500EC8607B466E1D.title: "Resonarium"
	quest.500EC8607B466E1D.quest_desc: [
		"How to make: smithing table: the resonarium template, a diamond piece and a resonarium plate (4 resonarium and 4 turtle or armadillo scutes).",
		" ",
		"Where to get: resonarium drops from sludges in the Otherside; the template lies in the chests at the top of the Otherside's ancient temple, and sometimes in ancient city, stronghold and trial chamber chests.",
		" ",
		"Tier T3: 20 armour, 8 toughness, +2 health.",
		" ",
		"",
		" ",
		"§7One piece of the set completes the quest, the rest are optional (click a piece for its recipe).§r",
	]
	task.0D080CFDE2A51A20.title: "Any piece of the set"
	quest.50B4906E206B9171.title: "Netherite Armour"
	quest.50B4906E206B9171.quest_desc: [
		"How to make: smithing table: a netherite upgrade template, a diamond piece and a netherite ingot. The ingot is 4 scrap, 2 gold and 2 TFMG steel in a superheated mixer.",
		" ",
		"Where to get: scrap comes from ancient debris deep in the Nether, the template from bastion chests.",
		" ",
		"Tier T5: 20 armour, 12 toughness, 0.4 knockback resistance, +6 health.",
		" ",
		"",
		" ",
		"§7One piece of the set completes the quest, the rest are optional (click a piece for its recipe).§r",
	]
	quest.05E666F85CC7AF48.title: "Moon Crystal"
	quest.05E666F85CC7AF48.quest_desc: [
		"How to make: 8 glow ink sacs around an amethyst shard (glow squids drop the sacs).",
		" ",
		"On a smithing table the crystal turns a netherite piece into a hero's armour, and the third item picks which: iron ingot for the Hero, feather for Lady Maria, snowball for the Silver Knight, bone for the Dark Lord. JEI shows all 30 sets.",
	]
	quest.4278CC7FD36D973A.title: "A Hero's Armour"
	quest.4278CC7FD36D973A.quest_desc: [
		"How to make: smithing table: a netherite piece, a Moon Crystal and the hero's item (JEI has all 30 Fantasy Armor sets). Any chestplate counts.",
		" ",
		"Tier T5 like netherite: 20 armour, 12 toughness, +6 health; the sets differ by their effects.",
	]
	task.5654D1DEEEF7D3E4.title: "Any piece of the set"
	quest.55024B3BC4964CE7.title: "Ignitium Armour"
	quest.55024B3BC4964CE7.quest_desc: [
		"How to make: smithing table: the ignitium template, a netherite piece and an ignitium ingot. The template: a netherite upgrade template, 4 blaze powder and 4 nether brick blocks.",
		" ",
		"Where to get: Ignis drops ignitium in the Burning Arena in the Nether (compass: Burning Arena).",
		" ",
		"Tier T6, the highest: 28 armour, 16 toughness, 0.8 knockback resistance, +10 health.",
		" ",
		"",
		" ",
		"§7One piece of the set completes the quest, the rest are optional (click a piece for its recipe).§r",
	]
	task.0BE13FCB1FB32690.title: "Any piece of the set"
	quest.08694E65871B3DFD.title: "Cursium Armour"
	quest.08694E65871B3DFD.quest_desc: [
		"How to make: smithing table: the cursium template, a netherite piece and a cursium ingot. The template: a netherite upgrade template, 2 black steel ingots and 6 gold ingots.",
		" ",
		"Where to get: Maledictus drops cursium in the Frosted Prison (compass: Frosted Prison); black steel drops from draugrs and lies in the prison chests.",
		" ",
		"Tier T6: 26 armour, 16 toughness, +8 health. The chestplate saves you from death once, then needs a long recharge.",
		" ",
		"",
		" ",
		"§7One piece of the set completes the quest, the rest are optional (click a piece for its recipe).§r",
	]
	task.7932BBD0FD2479CD.title: "Any piece of the set"
	quest.1EBD71F19CF7CA63.title: "Warden Armour"
	quest.1EBD71F19CF7CA63.quest_desc: [
		"How to make: smithing table: the warden template, a netherite piece and a reinforced echo shard (an echo shard, 4 warden carapaces and 4 phantom membranes).",
		" ",
		"Where to get: the template and carapaces lie in ancient city chests and in the Otherside's ancient temple; the Warden itself drops carapaces too.",
		" ",
		"Tier T6: 26 armour, 16 toughness, +8 health. The helmet blocks blindness and darkness, the leggings make you faster.",
		" ",
		"",
		" ",
		"§7One piece of the set completes the quest, the rest are optional (click a piece for its recipe).§r",
	]
	task.42D39A8659D370C5.title: "Any piece of the set"
	quest.76ABD4D0C9421375.title: "Annihilator Armour"
	quest.76ABD4D0C9421375.quest_desc: [
		"How to make: smithing table: the annihilator template, a netherite piece and a portal shard. The template: 4 enderitium ingots, 4 end stone and a bottle of annihilation.",
		" ",
		"Where to get: the Obliterator drops portal shards on the space station in the End; enderitium comes from ore in the End (9 gems make an ingot) and station chests, bottles from station chests.",
		" ",
		"Tier T6, the highest: 28 armour, 16 toughness, +10 health, almost no knockback.",
		" ",
		"",
		" ",
		"§7One piece of the set completes the quest, the rest are optional (click a piece for its recipe).§r",
	]
	task.3759F30698D790A1.title: "Any piece of the set"
	quest.3380C4BC0F0287C6.title: "Wooden Armour"
	quest.3380C4BC0F0287C6.quest_desc: [
		"How to make: logs, laid out like iron armour.",
		" ",
		"Tier T0: 7 armour, like leather. Every piece gives a chance to deflect arrows and softens explosions a little.",
		" ",
		"",
		" ",
		"§7One piece of the set completes the quest, the rest are optional (click a piece for its recipe).§r",
	]
	task.532DFE38A786D6C4.title: "Any piece of the set"
	quest.365BB99134E4CBDF.title: "Bone Armour"
	quest.365BB99134E4CBDF.quest_desc: [
		"How to make: bones, laid out like iron armour.",
		" ",
		"Tier T0: 7 armour, but every piece makes you walk a little faster. The bone pieces are the base of wither armour.",
		" ",
		"",
		" ",
		"§7One piece of the set completes the quest, the rest are optional (click a piece for its recipe).§r",
	]
	task.11B87C24DBE83F85.title: "Any piece of the set"
	quest.478CCBD01C5969A2.title: "Wither Armour"
	quest.478CCBD01C5969A2.quest_desc: [
		"How to make: a bone piece lined with nether bricks.",
		" ",
		"Tier T2: 16 armour, 4 toughness, +2 health, a slightly faster step. Whoever hits you gets withered.",
		" ",
		"",
		" ",
		"§7One piece of the set completes the quest, the rest are optional (click a piece for its recipe).§r",
	]
	task.301F3991E9176A2A.title: "Any piece of the set"
	quest.68D6835BB68D55C9.title: "Slime Armour"
	quest.68D6835BB68D55C9.quest_desc: [
		"How to make: slimeballs, laid out like iron armour.",
		" ",
		"Where to get: slimes drop them in swamps and slime chunks.",
		" ",
		"Tier T0: 10 armour. Every piece knocks back whoever hits you, softens explosions and reduces knockback.",
		" ",
		"",
		" ",
		"§7One piece of the set completes the quest, the rest are optional (click a piece for its recipe).§r",
	]
	task.1D07E6049C969400.title: "Any piece of the set"
	quest.61FA51811135FCBD.title: "Warrior's Armour"
	quest.61FA51811135FCBD.quest_desc: [
		"How to make: a leather piece of the same kind and iron ingots, plus a bone for the helmet and leather for the chestplate.",
		" ",
		"Tier T1: 15 armour. Berserk: the less health, the harder you hit; the pieces add axe damage.",
		" ",
		"",
		" ",
		"§7One piece of the set completes the quest, the rest are optional (click a piece for its recipe).§r",
	]
	task.0F7EF5AE46216678.title: "Any piece of the set"
	quest.167B967639030738.title: "Steampunk"
	quest.167B967639030738.quest_desc: [
		"How to make: brass ingots and pistons, plus a clock and a compass in the chestplate and glass and a redstone torch in the helmet.",
		" ",
		"Tier T2: 16 armour, 4 toughness, +2 health.",
		" ",
		"",
		" ",
		"§7One piece of the set completes the quest, the rest are optional (click a piece for its recipe).§r",
	]
	task.4323FFD9BAAAE51A.title: "Any piece of the set"
	quest.3533D9A9B549A644.title: "Heavy Armour"
	quest.3533D9A9B549A644.quest_desc: [
		"How to make: TFMG steel blocks and ingots.",
		" ",
		"Where to get: steel is made in the steel era (the Steel quest).",
		" ",
		"Tier T4: 20 armour, 12 toughness, +4 health; a full set cancels knockback completely, but you move slower.",
		" ",
		"",
		" ",
		"§7One piece of the set completes the quest, the rest are optional (click a piece for its recipe).§r",
	]
	task.544110E5628F9718.title: "Any piece of the set"
	quest.7724668EE148A963.title: "The Robe"
	quest.7724668EE148A963.quest_desc: [
		"How to make: wool and blaze powder in every piece.",
		" ",
		"Where to get: blazes in Nether fortresses drop the rods.",
		" ",
		"8 armour per set, but it resists fire and magic and sets whoever hits you on fire. The robe is the base of divine armour.",
		" ",
		"",
		" ",
		"§7One piece of the set completes the quest, the rest are optional (click a piece for its recipe).§r",
	]
	task.707302D084E1F63C.title: "Any piece of the set"
	quest.537BFD3C81045911.title: "Divine Armour"
	quest.537BFD3C81045911.quest_desc: [
		"How to make: a robe piece and gold ingots, plus a totem of undying in the chestplate and an emerald in the helmet.",
		" ",
		"Where to get: evokers drop totems in woodland mansions and during raids.",
		" ",
		"Tier T2: 18 armour, 4 toughness, +2 health. Every piece fully deflects one hit once a minute.",
		" ",
		"",
		" ",
		"§7One piece of the set completes the quest, the rest are optional (click a piece for its recipe).§r",
	]
	task.1FFEB160AF95B474.title: "Any piece of the set"
	quest.2145966031DE22C0.title: "Prismarine Armour"
	quest.2145966031DE22C0.quest_desc: [
		"How to make: prismarine shards and crystals, and a heart of the sea in the chestplate.",
		" ",
		"Where to get: guardians at ocean monuments drop prismarine, the heart of the sea lies in buried treasure (maps are in shipwrecks).",
		" ",
		"Tier T1: 15 armour. Spikes hurt enemies up close, you swim faster.",
		" ",
		"",
		" ",
		"§7One piece of the set completes the quest, the rest are optional (click a piece for its recipe).§r",
	]
	task.6B26E8A92871BE96.title: "Any piece of the set"
	quest.51ADF598BC7BF7BB.title: "Gambeson"
	quest.51ADF598BC7BF7BB.quest_desc: [
		"How to make: woolen fabric (3 white wool make 4 fabrics, 6 string make 2); the boots add leather and strips (2 leather make 6 strips).",
		" ",
		"Tier T0: 10 armour. The knight branch starts here.",
		" ",
		"",
		" ",
		"§7One piece of the set completes the quest, the rest are optional (click a piece for its recipe).§r",
	]
	task.247BE6E5C2198E06.title: "Any piece of the set"
	quest.26870972FB8692A0.title: "Chainmail"
	quest.26870972FB8692A0.quest_desc: [
		"How to make: the helmet, hauberk and leggings are iron chains (5, 8 and 7), the boots leather and strips.",
		" ",
		"Tier T1: 12 armour. The brigandine is a chestplate of leather and Create iron sheets, tier T0.",
		" ",
		"",
		" ",
		"§7One piece of the set completes the quest, the rest are optional (click a piece for its recipe).§r",
	]
