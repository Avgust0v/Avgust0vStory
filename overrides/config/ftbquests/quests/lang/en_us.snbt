	task.15E46185F367D1C7.title: "Any item from the list"
	quest.2EA0389E830F65D4.title: "Diamond Maces and Hammers"
	quest.2EA0389E830F65D4.quest_desc: [
		"How to make: like the iron ones, from diamonds. The Epic Knights flail takes a vanilla chain. Diamond ones later upgrade to netherite.",
		" ",
		"",
		" ",
		"Tier T3: damage 8-12, speed 0.7-1.4.",
