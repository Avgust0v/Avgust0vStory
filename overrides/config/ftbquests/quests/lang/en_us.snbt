{
	file.0000000000000001.title: "AvgustovStory"
	reward_table.7B015A218852F65B.title: "Village's Gift"
	reward_table.344791A38284FBF1.title: "Trading Gear"
	reward_table.75F4E52411B13725.title: "Traveler's Gear"
	reward_table.592561C799B6FAF1.title: "Hunter's Trophy"
	reward_table.779E14AEABE8BA1B.title: "Legend's Reward"
	reward_table.320FA7967966249B.title: "Mechanic's Kit"
	reward_table.284F1CA75065455B.title: "Brass Kit"
	reward_table.16B23A642123199E.title: "Electrician's Kit"
	reward_table.6833E15DE88C38A2.title: "Railwayman's Kit"
	reward_table.5E4FEC26A655A552.title: "Metallurgist's Kit"
	reward_table.4AC23E38FC006FEB.title: "Pilot's Kit"
	reward_table.37D5FFE4BE2B9876.title: "Gunner's Kit"
	reward_table.01314A45F21BE799.title: "Base Defence"
	chapter_group.0C5877243EA452C8.title: "&#F4A261&lThe Engineer's Path&r"
	chapter_group.79CFB7D5EF5A4EA6.title: "&#90BE6D&lCrafts and Life&r"
	chapter_group.6F40D0E1399F3965.title: "&#2A9D8F&lSettlements and Villagers&r"
	chapter_group.0B22509E29683950.title: "&#E63946&lAdventure and Bosses&r"
	chapter.318ED96E5B909505.title: "&#E9C46AHandbook&r"
	chapter.318ED96E5B909505.subtitle: "Everything this pack does differently from plain Minecraft. Read it on your first evening."
	quest.277DE12840B5758E.title: "How to Read This Book"
	quest.277DE12840B5758E.quest_desc: [
		"The Engineer's Path chapters follow the eras: each era unlocks new power, transport and logistics.",
		" ",
		"",
		" ",
		"The cell shape is the quest type: a big hexagon starts a chapter, a gear is a milestone, an octagon is a boss or a hunt, a pentagon is a place (a structure or a dimension), a rounded square is a note or a story page, a diamond is optional, a circle is an ordinary quest. The bigger the cell, the more important the quest. Side chapters (kitchen, beasts, arsenal, dungeons) open together with the main line.",
		" ",
		"",
		" ",
		"Click an item in a task to see its recipe in JEI.",
	]
	quest.6C64A75635356346.title: "Your Guild"
	quest.6C64A75635356346.quest_desc: [
		"The server plays in guilds: 2 to 4 guilds of up to 4 players. Create yours: /ftbteams party create <name>, then /ftbteams party invite <player>. Quest progress, chunk claims and team rewards are shared inside the guild. When a guild opens a letter from Master August, the whole server sees it in chat, and the first guild makes history.",
		" ",
		"",
		" ",
		"Team rewards (era milestones) are given once per team, normal ones to everyone.",
	]
	quest.4970C0D736D8E8EF.title: "Ponder"
	quest.4970C0D736D8E8EF.quest_desc: [
		"Hover over any Create block in your inventory or JEI and hold W to open an animated scene showing how it works. It is the best Create tutorial.",
		" ",
		"",
		" ",
		"R in JEI shows the recipe, U shows its uses.",
		" ",
		"",
		" ",
		"§6How it works:§r Hold W over any Create item (in your inventory or JEI) to open Ponder; hold Shift for a short summary. In JEI, R shows the recipe and U the uses; U on a machine (Millstone, Encased Fan, Mechanical Press) lists everything it makes. Engineer's Goggles on your head show RPM, stress and machine contents.",
		" ",
		"§6Why:§r nine \"broken\" machines out of ten are fixed in a minute: Ponder shows the right setup, goggles show what is missing.",
	]
	quest.511F2A5EA7E27314.title: "Pack Keybinds"
	quest.511F2A5EA7E27314.quest_desc: [
		"Z zoom, X dodge roll, B backpack, M map, N magnet, J jetpack (H hover), Y ship remote, ` Simulated rotate mode, R / V spells, Alt Create tool menu, U death history.",
		" ",
		"",
		" ",
		"Voice: Caps Lock to talk, ; voice chat menu, Alt+; groups, Alt+M mute.",
		" ",
		"",
		" ",
		"All keys can be changed in Options → Controls.",
	]
	quest.1312B8235E100152.title: "Voice Chat"
	quest.1312B8235E100152.quest_desc: [
		"Simple Voice Chat: voices carry 48 blocks and fade with distance. Press ; for a mic test, player volumes and groups: group members hear each other at any distance, handy for expeditions.",
	]
	quest.0BBC1EA872492C7B.title: "Thirst, Climate and Wounds"
	quest.0BBC1EA872492C7B.quest_desc: [
		"Legendary Survival Overhaul: next to hunger are thirst and temperature bars. Better purify raw water: smelt a bottle or canteen in a furnace. Heat and cold drain health down to one heart: dress for the weather (sewing table), warm up by a fire, seek shade and water in the heat. Damage hits body parts: bandages and medkits heal wounds. Wounds heal slowly on their own, sleep heals them only partly, and severe wounds bring debuffs: head - headache and nausea, arms - fatigue and weakness, chest - vulnerability, legs and feet - slowness. More in the Kitchen, Water and Climate chapter.",
	]
	quest.3AA1042BCCBF3AFA.title: "Death and Graves"
	quest.3AA1042BCCBF3AFA.quest_desc: [
		"When you die, your items stay in a grave where you fell — come back and open it. Others cannot open your grave. Death history with coordinates is on U.",
	]
	quest.4A9317BF669DD041.title: "Pings"
	quest.4A9317BF669DD041.quest_desc: [
		"Ping Wheel: hold the mouse wheel to put a mark on a block that your whole team sees. Handy in dungeons and while building.",
	]
	quest.5C05E25AE1149DB2.title: "A Lag-Free Server"
	quest.5C05E25AE1149DB2.quest_desc: [
		"The server is shared, so:",
		" ",
		"• do not leave items piling up on the ground or belts — use storage;",
		" ",
		"• switch unused lines off with a lever;",
		" ",
		"• one static Power Loader chunk loader per person; a guild keeps at most 50 chunks loaded, and loading stops for anyone who has not joined for 7 days;",
		" ",
		"• no more than ~3 trains per player, no cobblestone generators on collisions;",
		" ",
		"• a ship or machine is at most 16,000 blocks; build huge things in the open, not right against someone else's base.",
		" ",
		"",
		" ",
		"The world is backed up every 2 hours and the last 12 copies are kept.",
	]
	quest.5FB14D3A23A5E73F.title: "Your Skin"
	quest.5FB14D3A23A5E73F.quest_desc: [
		"The server works with any launcher. Set your skin with /skin set <licensed name or image URL>.",
	]
	quest.78DE637970AE59FD.title: "Hall of Fame"
	quest.78DE637970AE59FD.quest_desc: [
		"The server keeps four scoreboards: §eav_dishes§r (different dishes each player tried), §eav_bosses§r (guardians that fell near them), §eav_hours§r (hours played) and §eav_deaths§r (deaths).",
		" ",
		"",
		" ",
		"Put a Create Display Board at the station, connect a Display Link, pick the \"Scoreboard\" source and type the objective name. Let everyone see who the best cook and hunter on the server are.",
	]
	quest.018B0FD1CBC37B44.title: "Gear Tiers"
	quest.018B0FD1CBC37B44.quest_desc: [
		"Armour comes in tiers, each item's tooltip says \"Tier Tn · era\".",
		" ",
		"§7T0§r leather, wood, padded · §fT1§r iron, chainmail, cheap Epic Knights plate · §6T2§r brass, steampunk, 14th-century armour · §bT3§r diamond (now with a precision mechanism), abyssal, resonarium, neptunium · §9T4§r steel knight plate, heavy armour · §5T5§r netherite and Fantasy Armor · §cT6§r boss trophy armour (ignitium, cursium, annihilator, warden).",
		" ",
		"From T2 every piece also adds health: a full T5 set +6, a trophy set up to +10.",
		" ",
		"",
		" ",
		"Bosses come in tiers B1-B6 too. On the first meeting the chat shows the tier, the armour to bring and the health. Each extra player nearby gives the boss +35% health, keeping its current share. Guns and arrows deal at most a set damage per second to a boss per shooter, explosions at most a cap per hit.",
		" ",
		"",
		" ",
		"Netherite is made only in a superheated mixer: 4 scrap + 2 gold + 2 steel. Epic Knights gothic and kastenbrust plate upgrade to netherite on the smithing table keeping their enchantments, knight plate becomes Maximilian.",
	]
	quest.18A4027B6BFF9CC3.title: "Rotation and Stress"
	quest.18A4027B6BFF9CC3.quest_desc: [
		"Every source adds capacity in su (stress units): Water Wheel 256, Large Water Wheel 512, Hand Crank 256, a windmill 512 per RPM it turns, a steam engine up to 16,384.",
		" ",
		"Every machine takes its su per RPM: Millstone, Mechanical Mixer, saw, drill, Deployer, pump, pistons 4 each; Mechanical Press and Crushing Wheel 8; Encased Fan, Mechanical Arm, Mechanical Crafter 2; shafts, cogwheels and belts 0. Example: a press at 32 RPM is 256 su, exactly one water wheel.",
		" ",
		"If total stress exceeds capacity the network is Overstressed and all of it stops. Watch a Stressometer or wear Engineer's Goggles; add a source, slow heavy machines down or split them off with a Clutch.",
	]
	quest.1D58BCDA6C192C44.title: "Speed and Cogwheels"
	quest.1D58BCDA6C192C44.quest_desc: [
		"The source sets the network speed: Water Wheel 8 RPM, Large Water Wheel 4, Hand Crank 32, windmill 1-16, steam engine up to 64. A Large Cogwheel driving a small one doubles the speed, small driving large halves it; Shafts and Gearboxes keep it. The limit is 256 RPM. A Rotation Speed Controller drives the Large Cogwheel above it at any speed you set.",
		" ",
		"Speed makes machines work faster (a Millstone is equally slow up to 16 RPM, twice as fast at 32, sixteen times at 256), but stress grows by the same factor. A Mechanical Mixer needs at least 30 RPM. For an Encased Fan, RPM only adds range, not processing speed. Two branches at different speeds on one shaft break the block where they meet.",
	]
	quest.1256061A7CA0E382.title: "Getting Items In and Out"
	quest.1256061A7CA0E382.quest_desc: [
		"Items thrown on top (Q) are taken by: Mechanical Belt, Depot, Millstone, Crushing Wheels, an upward Mechanical Saw, Basin, Chute, Item Drain and a funnel placed to insert. NOT taken by: Item Vault and Fluid Tank (you cannot open them by hand either), Deployer and Mechanical Crafter (right-click their front), Spout (pipes only).",
		" ",
		"Right-click with an item puts it on a Depot, into a crafter or a deployer, but NOT into a Millstone. Right-click with an empty hand takes products out of a Millstone, off a Depot or a Belt.",
		" ",
		"Automation: funnels (Andesite Funnel moves 1 item, Brass a stack with a filter), Chutes (down by themselves, up with a Fan), Belts, the Mechanical Arm (5 blocks). Funnel to funnel between two chests does not work: use a Belt or a Chute.",
		" ",
		"Output: a Millstone keeps products inside (full slots stop it), Crushing Wheels drop them below, a Basin pours through its outlet onto a Belt, Depot or chest beside it one block lower.",
	]
	quest.0DBFC5019405734D.title: "Fan Processing"
	quest.0DBFC5019405734D.quest_desc: [
		"An Encased Fan blows through a catalyst block, and everything lying behind it in the stream, on the ground, a Belt or a Depot, gets processed:",
		" ",
		"• water: washing (crushed ore into nuggets, gravel into flint, flour into dough);",
		" ",
		"• lava or a fed Blaze Burner: smelting;",
		" ",
		"• fire, a campfire or an unfed burner: smoking (cook food only this way: smelting burns it);",
		" ",
		"• soul fire or a soul campfire: haunting.",
		" ",
		"RPM does not change the time: 7.5 s per 16 items in a stack; RPM only sets the range (3-20 blocks). Common mistakes: the catalyst is outside the stream; a whole stack on the ground takes long, so run items on a Belt. JEI shows the results: press U on the Encased Fan.",
	]
	quest.304AA2CFA6EAB288.title: "Ore: Crushing, Washing, Smelting"
	quest.304AA2CFA6EAB288.quest_desc: [
		"A Millstone does not grind ore: you need Crushing Wheels (era 2).",
		" ",
		"The route: raw ore → Crushing Wheels → crushed ore and Experience Nuggets (75 %) → fan washing through water → 9 nuggets plus a by-product (iron: redstone 75 %, copper: clay 50 %, gold: quartz 50 %, zinc: gunpowder 25 %) → a Mechanical Press over a Basin compacts 9 nuggets into an ingot. Or simply smelt the crushed ore: 1 ingot.",
		" ",
		"The gain: an ore block (silk touch) gives 1.75 crushed ore instead of 1, a raw ore block gives 9; plus experience and by-product metals. Until you have wheels, wash gravel (flint, iron nuggets) and red sand (gold nuggets).",
	]
	chapter.1C61CCEE8DC655F6.title: "&#C9A227Chronicle of the Predecessors&r"
	chapter.1C61CCEE8DC655F6.subtitle: "Who built machines on this land before us, and where they went. The chronicle pages are hidden in the world's structures and with its guardians."
	quest.64F9716A95B4C4F9.title: "Chronicle of the Predecessors"
	quest.64F9716A95B4C4F9.quest_subtitle: "How to find the pages"
	quest.64F9716A95B4C4F9.quest_desc: [
		"Each page of Ratibor's chronicle lies where the First Guild lived: in ruins, stations, foundries, on the sea floor and with the guardians. A page counts when you reach that place.",
		" ",
		"",
		" ",
		"Each page gives a treasure map with a red X to the next one (except the Nether page), and the Explorer's Compass reward finds any structure by name. Chests in those ruins also hold scraps from those who lived beside Ratibor. Pages open together with Master August's letters, as the guild itself grows.",
	]
	quest.4C9138ED290F5D61.title: "Page 1. We Came First"
	quest.4C9138ED290F5D61.quest_subtitle: "Master Ratibor's chronicle"
	quest.4C9138ED290F5D61.quest_desc: [
		"We came here when there was nothing but forest and wind. My father turned the first cog, from stone, for we did not yet know metal. We called ourselves a guild: each knew his own craft, together we knew everything.",
		" ",
		"",
		" ",
		"If you are reading this, we are gone. Do not grieve. Read on.",
		" ",
		"",
		" ",
		"— Ratibor, chronicler of the First Guild",
	]
	quest.136D243046ECF770.title: "Page 2. Wind and Water"
	quest.136D243046ECF770.quest_subtitle: "Master Ratibor's chronicle"
	quest.136D243046ECF770.quest_desc: [
		"Windmills stood on every hill, wheels on every stream. We ground flour, sawed timber and sang at work. It was the best of times. Machines served people, not the other way round.",
		" ",
		"",
		" ",
		"Remember this time, heir. It never comes back.",
		" ",
		"",
		" ",
		"— Ratibor, chronicler of the First Guild",
	]
	quest.1208C18957072236.title: "Page 3. Taming Fire"
	quest.1208C18957072236.quest_subtitle: "Master Ratibor's chronicle"
	quest.1208C18957072236.quest_desc: [
		"In the Nether fortresses we found blazes and learned to lock them in burners. Brass flowed like a river. We built faster and bigger.",
		" ",
		"",
		" ",
		"The smith Ignat wanted the strongest fire of all and grew Ignis, a knight of flame, to guard our forge. The knight guards it still. Even from us.",
		" ",
		"",
		" ",
		"— Ratibor, chronicler of the First Guild",
		" ",
		"",
		" ",
		"§cDo not look for Ignis's forge before you have steel: it is a tier B6 guardian.§r",
	]
	quest.6D0EBADDF753515D.title: "Page 4. The City Under the Waves"
	quest.6D0EBADDF753515D.quest_subtitle: "Master Ratibor's chronicle"
	quest.6D0EBADDF753515D.quest_desc: [
		"Our port stood on the southern shore: domes, gates, a lighthouse. We drained bays to build more. One night the sea came back and took the city.",
		" ",
		"",
		" ",
		"We told ourselves it was chance. That was the first lie.",
		" ",
		"",
		" ",
		"— Ratibor, chronicler of the First Guild",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Temple (underwater_village).",
	]
	quest.6C2B55B818AC4F67.title: "Page 5. The Stolen Sky"
	quest.6C2B55B818AC4F67.quest_subtitle: "Master Ratibor's chronicle"
	quest.6C2B55B818AC4F67.quest_desc: [
		"Our fleet was the guild's pride: steam airships flew all the way to the mountains. When the machines began to work on their own, the apprentices were left idle and stole them. Now they raid villages and call themselves by another name.",
		" ",
		"",
		" ",
		"If you meet them, do not blame them too much. We left them without work.",
		" ",
		"",
		" ",
		"— Ratibor, chronicler of the First Guild",
	]
	task.23E8D5103BF7FEBC.title: "Find a foundry or factory"
	quest.5080490B94FDC787.title: "Page 6. The Foundry"
	quest.5080490B94FDC787.quest_subtitle: "Master Ratibor's chronicle"
	quest.5080490B94FDC787.quest_desc: [
		"The foundries worked day and night. Stores counted themselves, packages flew along chains. Smoke hid the sun and nobody remembered the colour of the sky.",
		" ",
		"",
		" ",
		"An old miller said at the council: \"The land is tired.\" They laughed at him. I am still ashamed I said nothing.",
		" ",
		"",
		" ",
		"— Ratibor, chronicler of the First Guild",
		" ",
		"",
		" ",
		"§6Explorer's Compass (any of them):§r When Dungeons Arise: Foundry, Mechanical Nest; Create: Easy Structures: Factory 1, Factory 2.",
	]
	quest.07049344D99E519F.title: "Page 7. The Last Train"
	quest.07049344D99E519F.quest_subtitle: "Master Ratibor's chronicle"
	quest.07049344D99E519F.quest_desc: [
		"The Great Exhaustion came quietly: veins ran dry, rivers turned black, animals fled to the mountains. The council decided: if this land is spent, we will find another. Not here, but above the sky.",
		" ",
		"",
		" ",
		"The last train took the masters to the factory in the mountains where the rocket was built. I stayed to write down all that happened. Someone had to.",
		" ",
		"",
		" ",
		"— Ratibor, chronicler of the First Guild",
	]
	quest.4CE27C1BF38E94F4.title: "Page 8. The Rocket Factory"
	quest.4CE27C1BF38E94F4.quest_subtitle: "Master Ratibor's chronicle"
	quest.4CE27C1BF38E94F4.quest_desc: [
		"The mountain factory is guarded by the Harbinger, an iron sentinel we built from our best mechanisms. It lets no one in until it is sure they are worthy.",
		" ",
		"",
		" ",
		"Into its core I put a map of the sky: the way to where my brothers flew. If you defeated it, you are worthy.",
		" ",
		"",
		" ",
		"— Ratibor, chronicler of the First Guild",
	]
	quest.672FF7EFC7AFD2A5.title: "Page 9. The Guardian's Core"
	quest.672FF7EFC7AFD2A5.quest_subtitle: "Master Ratibor's chronicle"
	quest.672FF7EFC7AFD2A5.quest_desc: [
		"§6Tier B6§r · recommended armour T5+ (netherite and trophy sets)",
		" ",
		"",
		" ",
		"You hold the Harbinger's core. On its copper plate is a star map: the Earth, the orbit, the Moon, and beyond, Mars and Venus marked \"if the Moon is not enough\".",
		" ",
		"",
		" ",
		"They did not know whether it would be. We never found out.",
		" ",
		"",
		" ",
		"— Ratibor, chronicler of the First Guild",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Ancient Factory (L_Ender's Cataclysm 1.21.1).",
	]
	quest.16BD5124B9B1A7B0.title: "Page 10. The Oath of Fire"
	quest.16BD5124B9B1A7B0.quest_subtitle: "Master Ratibor's chronicle"
	quest.16BD5124B9B1A7B0.quest_desc: [
		"§6Tier B6§r · recommended armour T5+ (netherite and trophy sets)",
		" ",
		"§cHeat:§r a cooling lining on your armour and water",
		" ",
		"",
		" ",
		"Ignis has fallen, so Ignat's forge is free. The First Guild's oath is carved on the anvil: \"Build while the land gives. Take only as much as the land forgives.\"",
		" ",
		"",
		" ",
		"The second half of the oath was the first we forgot.",
		" ",
		"",
		" ",
		"— Ratibor, chronicler of the First Guild",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Burning Arena (L_Ender's Cataclysm 1.21.1).",
	]
	quest.69D2D4983CD65590.title: "Page 11. Above the Sky"
	quest.69D2D4983CD65590.quest_subtitle: "Master Ratibor's chronicle"
	quest.69D2D4983CD65590.quest_desc: [
		"From orbit the land looks small and fragile: blue, green, and brown where we burned it. My brothers looked at it from here for the last time.",
		" ",
		"",
		" ",
		"Heir, look at your land. Is it still green? Then you have already done more than we did.",
		" ",
		"",
		" ",
		"— Ratibor, chronicler of the First Guild",
	]
	quest.69D9D637AED315AB.title: "Page 12. The Lunar Workshop"
	quest.69D9D637AED315AB.quest_subtitle: "Master Ratibor's chronicle"
	quest.69D9D637AED315AB.quest_desc: [
		"This is the last page. The lunar workshop is empty: my brothers flew on, to Mars. I stayed; someone had to wait for the heirs and hand them the chronicle.",
		" ",
		"",
		" ",
		"If you are here, you have walked our road. Do not repeat our mistakes. Build wiser than us.",
		" ",
		"",
		" ",
		"The chronicle of the First Guild is finished. Begin your own.",
		" ",
		"",
		" ",
		"— Ratibor, chronicler of the First Guild",
	]
	quest.283EB5A9AD5C1061.title: "The Iron Knight"
	quest.283EB5A9AD5C1061.quest_subtitle: "A Predecessor guardian"
	quest.283EB5A9AD5C1061.quest_desc: [
		"§6Tier B2§r · recommended armour T1+ (iron)",
		" ",
		"",
		" ",
		"Our first automaton: armour with cogs and springs instead of a man. It could do one thing, chop. We were proud of it for a week, then could not stop it and walled it up underground.",
		" ",
		"",
		" ",
		"The lesson we did not learn: a mechanism without a purpose is worse than an empty workshop. Build a machine only when you know why.",
		" ",
		"",
		" ",
		"— Ratibor, chronicler of the First Guild",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Wrought Chamber (Mowzie's Mobs).",
	]
	quest.789ADDE7463B48C8.title: "The Netherite Monstrosity"
	quest.789ADDE7463B48C8.quest_subtitle: "A Predecessor guardian"
	quest.789ADDE7463B48C8.quest_desc: [
		"§6Tier B5§r · recommended armour T4+ (steel plate)",
		" ",
		"§cHeat:§r a cooling lining on your armour and water",
		" ",
		"",
		" ",
		"The smith Ignat built it to feed the Nether furnaces: a huge netherite golem that carried ore to the blaze burners by itself. When the ore ran out, it looked for it wherever it could: in walls, in bridges, in people.",
		" ",
		"",
		" ",
		"A burner's fire is a great helper. But you feed it, not a masterless machine.",
		" ",
		"",
		" ",
		"— Ratibor, chronicler of the First Guild",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Soul Black Smith (L_Ender's Cataclysm 1.21.1).",
	]
	quest.337D7CB8797BD211.title: "The Leviathan"
	quest.337D7CB8797BD211.quest_subtitle: "A Predecessor guardian"
	quest.337D7CB8797BD211.quest_desc: [
		"§6Tier B4§r · recommended armour T3+ (diamond-level)",
		" ",
		"",
		" ",
		"When we drained the bays for the port, the Leviathan rose from the deep. We thought it guarded the sea from us, and we were right. It still guards the sunken city and our submarines.",
		" ",
		"",
		" ",
		"Ballast, pressure glass, oxygen: we knew how to dive. We did not know when to stop.",
		" ",
		"",
		" ",
		"— Ratibor, chronicler of the First Guild",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Sunken City (L_Ender's Cataclysm 1.21.1).",
	]
	quest.35534A134624A5B2.title: "Scylla"
	quest.35534A134624A5B2.quest_subtitle: "A Predecessor guardian"
	quest.35534A134624A5B2.quest_desc: [
		"§6Tier B4§r · recommended armour T3+ (diamond-level)",
		" ",
		"",
		" ",
		"Scylla is the child of the storm over the sunken port. They say she was born from the lightning that struck our lighthouse while the sea took the city.",
		" ",
		"",
		" ",
		"— Ratibor, chronicler of the First Guild",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Acropolis (L_Ender's Cataclysm 1.21.1).",
	]
	quest.2E6AC0A4D2018FAC.title: "Maledictus"
	quest.2E6AC0A4D2018FAC.quest_subtitle: "A Predecessor guardian"
	quest.2E6AC0A4D2018FAC.quest_desc: [
		"§6Tier B6§r · recommended armour T5+ (netherite and trophy sets)",
		" ",
		"§bCold:§r a warm lining on your armour and hot food",
		" ",
		"",
		" ",
		"We sent the apprentices who stole the airships to the ice prison in the north. Maledictus was their warden. The prisoners escaped long ago and became illagers, yet the warden still guards the empty cells.",
		" ",
		"",
		" ",
		"We punished the hungry instead of feeding them.",
		" ",
		"",
		" ",
		"— Ratibor, chronicler of the First Guild",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Frosted Prison (L_Ender's Cataclysm 1.21.1).",
	]
	quest.1DBA801D2FF722F8.title: "The Invoker"
	quest.1DBA801D2FF722F8.quest_subtitle: "A Predecessor guardian"
	quest.1DBA801D2FF722F8.quest_desc: [
		"§6Tier B2§r · recommended armour T1+ (iron)",
		" ",
		"",
		" ",
		"My brother's best apprentice. He was the first to see that machines could be driven not by hand but by will, and the first to lead the apprentices into the forests. Now he leads the illagers and calls us \"the old masters\".",
		" ",
		"",
		" ",
		"If you defeat him, tell him: we are sorry.",
		" ",
		"",
		" ",
		"— Ratibor, chronicler of the First Guild",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Labyrinth (Illager Invasion).",
	]
	quest.582020A541AB5D80.title: "The Ancient Remnant"
	quest.582020A541AB5D80.quest_subtitle: "A Predecessor guardian"
	quest.582020A541AB5D80.quest_desc: [
		"§6Tier B4§r · recommended armour T3+ (diamond-level)",
		" ",
		"§cHeat:§r a cooling lining on your armour and water",
		" ",
		"",
		" ",
		"Our observatory stood in the desert. There the rocket's path was calculated: angles, speeds, fuel, all a navigation table does today. The Remnant guards the calculations from sand and thieves.",
		" ",
		"",
		" ",
		"The map it guards is only a draft. The final copy is in the Harbinger's core.",
		" ",
		"",
		" ",
		"— Ratibor, chronicler of the First Guild",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Cursed Pyramid (L_Ender's Cataclysm 1.21.1).",
	]
	quest.3AD3A6725655B6D0.title: "The Ender Guardian"
	quest.3AD3A6725655B6D0.quest_subtitle: "A Predecessor guardian"
	quest.3AD3A6725655B6D0.quest_desc: [
		"§6Tier B6§r · recommended armour T5+ (netherite and trophy sets)",
		" ",
		"",
		" ",
		"In the End we found levitite, a stone that refuses to lie on the ground. Flying cities and ship hulls were built from it. The Ender Guardian protects the last veins of levitite.",
		" ",
		"",
		" ",
		"Without levitite the rocket would never have left the ground. Treasure every crystal.",
		" ",
		"",
		" ",
		"— Ratibor, chronicler of the First Guild",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Ruined Citadel (L_Ender's Cataclysm 1.21.1).",
	]
	quest.329AE237179B6018.title: "The Guardians Rest"
	quest.329AE237179B6018.quest_subtitle: "All the Predecessors' guardians"
	quest.329AE237179B6018.quest_desc: [
		"Every guardian of the First Guild has fallen. Their duty is over: the masters will not return, and the heirs have proved worthy.",
		" ",
		"",
		" ",
		"The Predecessors' technology is yours now. Use it more wisely.",
	]
	quest.4FCBD34DB6C6BC3B.title: "The Guild's Library"
	quest.4FCBD34DB6C6BC3B.quest_desc: [
		"Each of Master August's letters arrives as a real book. Gather all ten, from the Prologue to To the Stars, and set them on lecterns in the town hall in chapter order, so those who come after us can read how we began.",
	]
	task.13CE0FBE3AFC8C28.title: "Scrap 1/13"
	task.1FA8A4CE1BD3A13F.title: "Scrap 2/13"
	task.7B988186FA72DE99.title: "Scrap 3/13"
	task.681395525C350C34.title: "Scrap 4/13"
	task.0FF3BD94023689C6.title: "Scrap 5/13"
	task.0E56E271033749A8.title: "Scrap 6/13"
	task.7F5F6B161D427115.title: "Scrap 7/13"
	task.489C0D343A3A0BA7.title: "Scrap 8/13"
	task.4467E086AAB3ECCB.title: "Scrap 9/13"
	task.289CB1696E82E153.title: "Scrap 10/13"
	task.2FEACA2CC1A88049.title: "Scrap 11/13"
	task.0A1BCD2B301CA720.title: "Scrap 12/13"
	task.33474C0DB7688232.title: "Scrap 13/13"
	quest.2EDB267AE42E9650.title: "Collector of Scraps"
	quest.2EDB267AE42E9650.quest_desc: [
		"Ratibor's chronicle is not all that is left of the First Guild. Chests in ruins hold tattered notes from those who lived beside him: the miller, the smith, the station keeper, the apprentices. With Lootr every player has their own chest, so everyone can search.",
		" ",
		"",
		" ",
		"Where to look: old ruins, windmills, Nether fortresses, the sunken city, raider ships and airships, the foundry, abandoned stations, mines and mine trains, the ruined castle, old graveyards, abandoned libraries, lighthouses, and the deepslate vaults of the Ancient Keep.",
		" ",
		"",
		" ",
		"The notes are not taken: keep them or shelve them in the town hall.",
	]
	quest.2DF99D88266E4FD7.title: "Stones of the Predecessors"
	quest.2DF99D88266E4FD7.quest_desc: [
		"Ancient Remnants: monoliths and monuments of a civilization not even Ratibor's chronicle remembers stand across the world. Their cores still hum. Find any of them; each one grants its own blessing.",
		" ",
		"",
		" ",
		"§6Explorer's Compass (any of them):§r Ancient Remnants: Cherry Monument, Coniferous Monument, Oakwood Monument, Hunter Monolith, Sentinel Monolith and 1 more.",
	]
	quest.4BFF5193874F0949.title: "The Monolith Codex"
	quest.4BFF5193874F0949.quest_desc: [
		"Research scraps cannot be crafted: they turn up in chests, most often at pillager outposts. Find a scrap and bind it into a Monolith Codex (a book, amethyst and deepslate on a crafting table): the codex tells what each stone grants and where to look for the rest.",
		" ",
		"",
		" ",
		"In the codex margin someone drew a cog cut from stone in charcoal and signed it \"M.\". Miron, Ratibor's father, saw these stones before anyone else: he carved his first cog after their markings. The First Guild did not start from nothing. Neither do we.",
	]
	task.68F92A6F2B18EC3B.title: "Scrap 10/13"
	quest.0B3E8C1A9FDC0C43.title: "The Miller Was Right"
	quest.0B3E8C1A9FDC0C43.quest_desc: [
		"The miller Dobrynya lies in an old graveyard: the one who first told the council \"the land is tired\" and was cast out for it. Find the note from his grave.",
	]
	quest.382EC0DD56E92FE4.title: "The Mill Turns Again"
	quest.382EC0DD56E92FE4.quest_desc: [
		"Build a windmill with a millstone on a hill, like Dobrynya's: wind instead of coal, flour instead of smoke. Tick the task when it turns.",
	]
	quest.77B8FB998CA1C226.title: "A Grove for Dobrynya"
	quest.77B8FB998CA1C226.quest_desc: [
		"\"Plant a tree beside him. He would want a tree, not a stone.\" Plant a grove of at least sixteen trees by the mill and tick the task. Ratibor kept silent at the council; you did not.",
	]
	quest.054F9E2CE961B8D8.title: "Guardians of Other Lands"
	quest.054F9E2CE961B8D8.quest_subtitle: "Master Ratibor's chronicle"
	quest.054F9E2CE961B8D8.quest_desc: [
		"We called this land ours because we came first. But beyond the river, the mountains and the sea, every land had its own master: a sun chief in the savanna, the Sculptor on the mountain, a mossy colossus in the jungle, a sentinel in the sands, the Kraken in the deep sea. None of us built them. They grew together with their land and slept as long as no one touched it.",
		" ",
		"",
		" ",
		"Our guardians watch over what we made. These watch over what we wanted to take. I keep a separate leaf of the chronicle for them and write down every one we woke.",
		" ",
		"",
		" ",
		"— Ratibor, chronicler of the First Guild",
		" ",
		"",
		" ",
		"§7This leaf opens after a victory over any guardian of another land (the Dungeons and Mini-Bosses and Bosses chapters). The chronicle lines about each of them are in their quest descriptions.§r",
	]
	quest.71C731CFE2F902A0.title: "No Masterless Land"
	quest.71C731CFE2F902A0.quest_subtitle: "Master Ratibor's chronicle"
	quest.71C731CFE2F902A0.quest_desc: [
		"When our veins ran dry, we went for ore into other lands: the Nether, the End, the sea floor, the snows and the sands. And everywhere someone was already waiting: every vein, every lava lake had its own guardian. There is no masterless land, heir. There is only land whose master has not been woken yet.",
		" ",
		"",
		" ",
		"At the council about the rocket I kept silent again. The council decided to look for a masterless land above the sky. I still do not know whether my brothers found one, or whether something sleeps there too.",
		" ",
		"",
		" ",
		"— Ratibor, chronicler of the First Guild",
	]
	chapter.768E07399E2C5D87.title: "&#A7C957Era 0. First Steps&r"
	chapter.768E07399E2C5D87.subtitle: "Settle in, find a village, make your first andesite alloy."
	quest.577642ADDF95E032.title: "Prologue. A New Land"
	quest.577642ADDF95E032.quest_subtitle: "A letter from Master August"
	quest.577642ADDF95E032.quest_desc: [
		"My friends!",
		" ",
		"",
		" ",
		"The ship has sailed and we have stayed. This land is rich but wild: no roads, no mills, none of our cogs.",
		" ",
		"",
		" ",
		"Now I will tell you what I kept quiet about all voyage. My grandfather spoke of the First Guild: masters who built machines long before us and one day vanished. He said they lived across the sea, on this very land. If you see an overgrown mill or a rusty cog in the grass, that is their trace. Bring me any records you find. I am starting the \"Chronicle of the Predecessors\".",
		" ",
		"",
		" ",
		"For now: a knife, a workbench, a roof. Find a village. And stay together: a guild is strong only while it is a guild.",
		" ",
		"",
		" ",
		"— Master August",
	]
	quest.4C63655423EE0349.title: "Welcome to AvgustovStory"
	quest.4C63655423EE0349.quest_subtitle: "A Create-centred pack"
	quest.4C63655423EE0349.quest_desc: [
		"Progress goes in eras: every new machine needs a product of the previous era. The Engineer's Path chapters walk you through it in order.",
		" ",
		"Use JEI for recipes: R shows a recipe, U shows uses. Hold W over any Create block to watch its Ponder tutorial.",
	]
	quest.477711A9460E18F2.title: "Crafting Table"
	quest.4CC5DAA24F887D91.title: "The First Night"
	quest.4CC5DAA24F887D91.quest_desc: [
		"Make a bed and sleep through the night. On the server half of the players is enough.",
	]
	quest.3A3959929D0FE561.title: "Flint Knife"
	quest.3A3959929D0FE561.quest_desc: [
		"The Farmer's Delight knife cuts food on a board and gets straw from grass.",
	]
	quest.35A5856EC8806193.title: "Cutting Board"
	quest.0881EAAFC76089B5.title: "Cooking Pot"
	quest.0881EAAFC76089B5.quest_desc: [
		"Stews and soups restore more hunger and give Nourishment. Put the pot over a heat source.",
	]
	quest.0F0C4C3DD4217887.title: "A Hot Meal"
	quest.2EC18C6208F09BD2.title: "Backpack"
	quest.2EC18C6208F09BD2.quest_desc: [
		"Opens with B. Upgrades (magnet, auto-smelting, filters) go straight into the backpack.",
	]
	quest.58EB00CC2026161D.title: "Iron"
	quest.34312F0ACEAA9988.title: "Copper"
	quest.34312F0ACEAA9988.quest_desc: [
		"You will need copper by the ton: pipes, tanks, casings, wires.",
	]
	quest.44A2090750D5E53E.title: "Zinc"
	quest.44A2090750D5E53E.quest_desc: [
		"Zinc ore has grey-green specks, mostly at Y 0–70. Later, zinc and copper make brass.",
	]
	quest.7F31BD8C5EC8CCB6.title: "Find a Village"
	quest.7F31BD8C5EC8CCB6.quest_desc: [
		"Villages are your first allies: trades, beds, chests. Every village has a Waystone.",
		" ",
		"",
		" ",
		"§6Explorer's Compass (any of them):§r ChoiceTheorem's Overhauled Village: Large/village Beach, Large/village Christmas, Large/village Desert, Large/village Desert Oasis, Large/village Dark Forest; Minecraft: Village Plains, Village Desert, Village Savanna, Village Snowy, Village Taiga and 61 more.",
	]
	quest.294D6C6083CE2ECE.title: "Waystone"
	quest.294D6C6083CE2ECE.quest_desc: [
		"Right-click a waystone to activate it; you can then teleport to it from any other one.",
	]
	quest.0F0542C5A3CC33D1.title: "Map and Claims"
	quest.0F0542C5A3CC33D1.quest_desc: [
		"M opens the FTB Chunks map. Claim chunks for your team there (protection from explosions and strangers) and set waypoints.",
	]
	quest.4BBD41D376ABCC53.title: "Travellers' Traces"
	quest.4BBD41D376ABCC53.quest_desc: [
		"Small structures are common: camps, guide posts, supply caches, Create-style windmills and water towers. Their chests may hold your first cogs and shafts.",
	]
	quest.1CC9DB28526AFC92.title: "Horse Power"
	quest.1CC9DB28526AFC92.quest_desc: [
		"Leash a horse to the horse crank and it walks in circles, turning a shaft. Your first power without water or wind.",
		" ",
		"",
		" ",
		"§6How it works:§r The Horse Crank sits on a path of suitable blocks (Ponder, key W, shows which are better); leash a horse to it and it walks in circles. Take rotation off with a cogwheel on the side or a shaft underneath, never from the top. Output depends on the animal and the path: check it with Engineer's Goggles.",
		" ",
		"§6Why:§r rotation where there is no river or wind, for example for your first Millstone making flour.",
	]
	quest.3C85E444B7B97A9C.title: "Andesite Alloy"
	quest.3C85E444B7B97A9C.quest_desc: [
		"Andesite + iron (or zinc) nuggets. This is the heart of Era 1: shafts, cogs, casings.",
		" ",
		"",
		" ",
		"§6How it works:§r In a crafting grid: 2 andesite and 2 iron (or zinc) nuggets in a 2x2 square, each kind on a diagonal, make 1 alloy. A Mechanical Mixer over a Basin (no heat) uses half as much: 1 andesite + 1 nugget = 1 alloy.",
		" ",
		"§6Why:§r Shafts, Cogwheels, Andesite Casing, Mechanical Belts: almost everything in era 1. Stock up on andesite, you will need a lot.",
	]
	quest.2BA45C1ABD28F58C.title: "Engineer's Goggles"
	quest.2BA45C1ABD28F58C.quest_desc: [
		"Show speed, stress and contents of machines you look at.",
		" ",
		"",
		" ",
		"§6How it works:§r Wear them and look at a block: sources show the capacity they add, machines show their stress, a Stressometer shows the whole network, tanks, Basins and Millstones show their contents.",
		" ",
		"§6Why:§r your main debugging tool. A machine is idle? Look at it with goggles: no rotation, too slow, or the network is overstressed.",
	]
	quest.2CEE645358B21744.title: "Wrench"
	quest.2CEE645358B21744.quest_desc: [
		"Rotates Create blocks; with Shift it picks them up quickly.",
		" ",
		"",
		" ",
		"§6How it works:§r Right-click a Create block to rotate it around the clicked face; sneak + right-click picks it up instantly. The wrench also flips a Mechanical Pump's arrow and a funnel, removes extra shafts from a belt and relocates assembled minecart and train contraptions.",
		" ",
		"§6Why:§r a misplaced block never needs breaking: machines are fixed in seconds.",
	]
	chapter.4FD73A25E2DD2973.title: "&#B5B5B5Era 1. Andesite&r"
	chapter.4FD73A25E2DD2973.subtitle: "Kinetics: wheels, millstones, presses, belts and the first moving machines."
	quest.66ED7F7448F796FE.title: "Chapter I. The First Cog"
	quest.66ED7F7448F796FE.quest_subtitle: "A letter from Master August"
	quest.66ED7F7448F796FE.quest_desc: [
		"Andesite alloy is grey and plain, yet everything else is born from it.",
		" ",
		"",
		" ",
		"Yesterday I found an old water wheel by a stream. The wood had rotted but the hub was whole, turned the way we turn ours. The Predecessors started just like us. The thought makes me both glad and uneasy: where are they now?",
		" ",
		"",
		" ",
		"Build your own wheel. Let the stream do the work and keep your hands for what matters.",
		" ",
		"",
		" ",
		"— Master August",
	]
	quest.6ECC7C838BBEE14E.title: "Shafts and Cogs"
	quest.6ECC7C838BBEE14E.quest_desc: [
		"Rotation travels through shafts and cogs; neighbouring cogs spin in opposite directions. Wear Engineer's Goggles to see the speed.",
		" ",
		"",
		" ",
		"§6How it works:§r A Shaft carries rotation in a straight line, a Cogwheel passes it to a neighbouring cogwheel, a Gearbox turns it round a corner. Neighbouring cogwheels spin in opposite directions; shafts lose no speed. Create's limit is 256 RPM. If two branches drive one shaft at different speeds or directions, the block where they meet breaks.",
		" ",
		"§6Why:§r these are Create's \"wires\": a machine only runs while rotation from a wheel, a windmill or a Hand Crank reaches it.",
	]
	quest.4F2B32D0E388BA97.title: "Hand Crank"
	quest.4F2B32D0E388BA97.quest_desc: [
		"Your first power is your own arm: enough to lift a gate or turn a press a few times.",
		" ",
		"",
		" ",
		"§6How it works:§r Hold right-click: the Hand Crank turns (sneak for the other direction) at 32 RPM and gives 256 su for as long as you hold it. Cranking costs hunger.",
		" ",
		"§6Why:§r testing a new machine before you have a wheel, and power for rare actions: raising a gate, moving a piston.",
	]
	quest.4F48098BE4C15E3B.title: "Water Wheel"
	quest.4F48098BE4C15E3B.quest_desc: [
		"Place the wheel where water flows or falls onto it. Several wheels on one shaft give more capacity (stress), not more speed.",
		" ",
		"",
		" ",
		"Ratibor's chronicle: \"The Predecessors' first wheel stood on this very stream. The water turned it for a hundred years and never asked for coal.\"",
		" ",
		"",
		" ",
		"§6How it works:§r Flowing water next to it (falling or running) turns the wheel: 8 RPM and 256 su per wheel. More sides in water add nothing and opposite currents cancel out; the spin direction follows the flow.",
		" ",
		"§6Why:§r cheap, everlasting power for the first workshop. 8 RPM is slow: speed it up with a Large Cogwheel driving a small one (x2 per step).",
	]
	quest.25BDB93253FA4E31.title: "Large Water Wheel"
	quest.25BDB93253FA4E31.quest_desc: [
		"Slower, but carries far more stress. A good heart for your first workshop.",
		" ",
		"",
		" ",
		"§6How it works:§r 4 RPM and 512 su: half the speed of a small wheel, twice the capacity. Water along one side is enough; more adds nothing.",
		" ",
		"§6Why:§r a backbone source for several machines; raise its speed with cogwheel steps.",
	]
	quest.0D33890A1ECCEE87.title: "Windmill"
	quest.0D33890A1ECCEE87.quest_desc: [
		"Sails attach to a windmill bearing and are assembled with a right-click. More sails means more capacity, and wind is everywhere.",
		" ",
		"",
		" ",
		"§6How it works:§r Glue a structure of at least 8 sail blocks (Windmill Sail, Sail Frame or any wool) to a Windmill Bearing and right-click the bearing. Every 8 sails give 1 RPM (16 RPM at most), and every RPM gives 512 su. Right-click again to stop it for editing.",
		" ",
		"§6Why:§r strong power without water: 32 sails give 4 RPM and 2048 su. Speed up the slow shaft with cogwheels.",
	]
	quest.4E2F08A493893CD4.title: "Shifting Gears"
	quest.4E2F08A493893CD4.quest_desc: [
		"Mesh a large cog with a small one and the speed doubles or halves. The main way to speed up a slow wheel.",
		" ",
		"",
		" ",
		"§6How it works:§r A Large Cogwheel meshes with a small one diagonally. Large driving small doubles the speed; small driving large halves it. Two large cogwheels connect at a right angle. Double the speed and you double the stress of every machine after it.",
		" ",
		"§6Why:§r raising a wheel's 8 RPM to 32-64 RPM for a Mechanical Mixer and faster processing, or slowing heavy machines down.",
	]
	quest.4EFDEBDB7A6D75CA.title: "Andesite Casing"
	quest.4EFDEBDB7A6D75CA.quest_desc: [
		"Andesite alloy on a stripped log. Almost every machine of this era is built on casings.",
		" ",
		"",
		" ",
		"§6How it works:§r Right-click a stripped log or stripped wood with Andesite Alloy. Clicking a Shaft or Cogwheel with casing encases it (tidy and safe).",
		" ",
		"§6Why:§r casing goes into the Gearbox, Mechanical Drill, Mechanical Press, Encased Fan, Depot and most other machines of the era.",
	]
	quest.1F3C2E85AC605CB9.title: "Measurements"
	quest.1F3C2E85AC605CB9.quest_desc: [
		"A stressometer read through goggles shows how much of the network capacity is used. Overstress stops the whole network at once.",
		" ",
		"",
		" ",
		"§6How it works:§r Put the Stressometer in line on a shaft: it shows how much of the network's capacity is used, and Engineer's Goggles show exact su. Source capacities add up; a machine takes its su x RPM (Millstone 4 su per RPM, Press 8). If stress exceeds capacity, the whole network stops (\"Overstressed\"), not just the last machine.",
		" ",
		"§6Why:§r check the remaining capacity before adding a machine. When overstressed, add a source, slow the heavy machines down or split them off with a Clutch.",
	]
	quest.15B86A6E44F88225.title: "Millstone"
	quest.15B86A6E44F88225.quest_desc: [
		"Grinds wheat into flour, gravel into flint, cobblestone into gravel, flowers into dyes. It does not take ore: ore goes to Crushing Wheels (era 2).",
		" ",
		"",
		" ",
		"§6How it works:§r Power it with a cogwheel on the side or a shaft from below. Throw items on top (Q) or feed them with a Chute or funnel: right-clicking with wheat in hand does NOT insert it. It holds one stack of one kind and grinds one item at a time: wheat takes 150 ticks (7.5 s) at 16 RPM or less, so a stack takes about 8 minutes; 32 RPM is twice as fast, 256 RPM sixteen times. Output stays inside: right-click with an empty hand, or a funnel on the side / Chute below. When the output slots are full, the millstone stops.",
		" ",
		"§6Why:§r Wheat Flour (dough, bread), flint from gravel, gravel from cobblestone, dyes from flowers, sugar from cane. Ore goes to Crushing Wheels only.",
	]
	quest.54F4C46D1A02AFDB.title: "Encased Fan"
	quest.54F4C46D1A02AFDB.quest_desc: [
		"The air stream pushes items and mobs. Through water it washes, through lava it smelts, through fire it smokes, through soul fire it haunts.",
		" ",
		"",
		" ",
		"§6How it works:§r A fan blows or sucks depending on its spin direction; its range grows with speed from 3 to 20 blocks (at 256 RPM). Put a catalyst block right in the stream: everything behind it on the ground, a Belt or a Depot gets processed. Processing speed does NOT depend on RPM: a stack of up to 16 takes 7.5 s, 64 items take four times longer.",
		" ",
		"§6Why:§r bulk processing without furnaces: washing, smelting, smoking, haunting. A fan under or over a Chute lifts items upwards.",
	]
	quest.389C3435AF290359.title: "Bulk Processing"
	quest.389C3435AF290359.quest_desc: [
		"Blow crushed ore through water: nuggets and rare by-products. Gravel gives flint and iron nuggets this way, red sand gives gold nuggets.",
		" ",
		"",
		" ",
		"§6How it works:§r Washing is water (source or flowing) inside the fan stream. Crushed Raw Iron gives 9 iron nuggets and redstone at 75 %, zinc gives 9 zinc nuggets; gravel gives flint (25 %) and an iron nugget (12.5 %). Until you have Crushing Wheels (era 2), wash gravel. Common mistakes: the water is not in the stream; a big stack on the ground: split it into 16s or run a Belt.",
		" ",
		"§6Why:§r nuggets and by-products from crushed ore (redstone, quartz, clay), dough from flour, and later the whole ore factory.",
	]
	quest.12A6FC78202DB4C7.title: "Mechanical Press"
	quest.12A6FC78202DB4C7.quest_desc: [
		"A press over a depot or belt turns ingots into sheets, the base of most Create recipes.",
		" ",
		"",
		" ",
		"§6How it works:§r Leave exactly one empty block between the press and the Depot, Belt or Basin; power it with a shaft from the side. Put items on a Depot with right-click; the press stops items on a Belt by itself. It is heavy: 8 su per RPM, 512 su at 64 RPM, so watch the Stressometer.",
		" ",
		"§6Why:§r iron, copper, golden and brass sheets for propellers, Electron Tubes and the Precision Mechanism; over a Basin it compacts (see Compacting).",
	]
	quest.4384678F160BB3BD.title: "Mechanical Mixer"
	quest.4384678F160BB3BD.quest_desc: [
		"A mixer over a basin combines ingredients. Heated recipes wait for a blaze burner.",
		" ",
		"",
		" ",
		"§6How it works:§r Basin on the floor (on a Blaze Burner if the recipe needs heat), one empty block, then the mixer. It needs at least 30 RPM: at a wheel's 8 or 16 RPM it does nothing! Throw ingredients into the Basin or feed them with a funnel, fluids by pipe. The result pours onto a Belt, Depot or chest placed beside the Basin one block lower; otherwise it stays in the Basin.",
		" ",
		"§6Why:§r Andesite Alloy at half the cost, dough, chocolate, and with heat, Brass and the other era 2 alloys.",
	]
	quest.7BEBD608D80FB369.title: "Compacting"
	quest.7BEBD608D80FB369.quest_desc: [
		"A press over a basin compacts many items into fewer, e.g. nuggets into ingots.",
		" ",
		"",
		" ",
		"§6How it works:§r The same Mechanical Press, but over a Basin (one empty block between). It runs filled 2x2 and 3x3 recipes: 9 nuggets into an ingot, 4 items into a block. If several recipes match, pick one with the filter on the press. Output works like the mixer's: onto a Belt, Depot or chest beside the Basin one block lower.",
		" ",
		"§6Why:§r nuggets from washing into ingots, resources into storage blocks, the Blaze Cake Base, later TFMG cast iron.",
	]
	quest.4416282B085423CF.title: "Belts"
	quest.4416282B085423CF.quest_desc: [
		"A belt links two shafts and carries items. Machines above the belt process everything passing by.",
		" ",
		"",
		" ",
		"§6How it works:§r Take a Mechanical Belt and right-click two shafts on one line: 2-20 blocks long, flat, diagonal or vertical. Power any shaft on the belt; items move faster at higher RPM, and the belt itself adds no stress. Items thrown on it ride along; take them off with an empty-hand right-click or a funnel at the end.",
		" ",
		"§6Why:§r the conveyor under Mechanical Presses, Fans, Spouts and Deployers: lines where items are processed on the move.",
	]
	quest.1098B5E64A0D1721.title: "Funnels"
	quest.1098B5E64A0D1721.quest_desc: [
		"Funnels pull items out of chests and put them back. Tunnels split the flow on a belt.",
		" ",
		"",
		" ",
		"§6How it works:§r Placed normally on a chest, an Andesite Funnel pulls items out; placed while sneaking, it puts them in; a Wrench flips it. Andesite Funnels move one item at a time, Brass Funnels up to a full stack and with a filter. Funnel to funnel between two chests does not work: put a Belt or a Chute in between.",
		" ",
		"§6Why:§r linking machines to chests: unloading the end of a belt, feeding a Millstone, taking products off a Depot. An Andesite Tunnel splits the flow on a belt.",
	]
	quest.5F94C8099C765EB1.title: "Chutes"
	quest.5F94C8099C765EB1.quest_desc: [
		"A Chute carries items down by itself, no rotation needed. Under a chest it pulls items out, above a chest or machine it puts them in; items thrown on top fall in too. An Encased Fan above or below a Chute lifts items up. A chute placed against the side of another becomes diagonal.",
		" ",
		"§6Why:§r feeding Millstones, Crushing Wheels and Basins from above, vertical storage and item lifts.",
	]
	quest.01265E4D3384E645.title: "Mechanical Saw"
	quest.01265E4D3384E645.quest_desc: [
		"An upward saw cuts items on a belt: logs into planks, stone into stairs.",
		" ",
		"",
		" ",
		"§6How it works:§r An upward-facing saw processes items on top of it: throw them on or run a Belt straight into it; it acts as a piece of conveyor, and output moves against its rotation. If an item has several results (stone to stairs, slabs), pick one with the filter, or the saw cycles through them. A sideways saw fells a whole tree if it cuts the bottom log.",
		" ",
		"§6Why:§r logs into stripped logs and planks, stonecutter recipes in bulk; later a tree farm together with a Deployer.",
	]
	quest.38351AA20081E7AE.title: "Mechanical Pump"
	quest.38351AA20081E7AE.quest_desc: [
		"A pump pushes fluid along pipes in the arrow direction. An infinite water source is two buckets in a 3×1 pit.",
		" ",
		"",
		" ",
		"§6How it works:§r The pump sits in a line of Fluid Pipes and moves fluid along its arrow; the spin direction does not matter, a Wrench turns the arrow. An open pipe end in water or lava draws it in; pipes connect to tanks, Basins and Spouts by themselves. Range is 16 blocks of pipe on each side; more RPM, faster flow.",
		" ",
		"§6Why:§r water for washing, mixers and steam boilers, lava for blaze cakes and Sturdy Sheets, filling a Spout.",
	]
	quest.3A38D7ABE34F76A9.title: "Spout"
	quest.3A38D7ABE34F76A9.quest_desc: [
		"Fills buckets and bottles and pours fluid onto items — used in sequenced assembly and in the kitchen.",
		" ",
		"",
		" ",
		"§6How it works:§r Place the Spout over a Depot or Belt with one empty block between, and fill it by pipe only: you cannot fill it by hand. An item on the Depot or Belt stops and gets filled: bottles, buckets and filling recipes (JEI: U on the fluid).",
		" ",
		"§6Why:§r sequenced assembly (Sturdy Sheets get lava), blaze cakes, chocolate and honey food, Builder's Tea.",
	]
	quest.3A9BEC7A42E89747.title: "Item Drain"
	quest.3A9BEC7A42E89747.quest_desc: [
		"The Item Drain is the Spout in reverse: right-click it with a bucket or bottle to pour the fluid in, and items that enter from the side on a Belt or funnel (or are thrown on top) roll across it and get emptied. Pull the fluid out by pipe with a Mechanical Pump.",
		" ",
		"§6Why:§r pouring buckets of water, lava or milk into pipes and tanks (in survival a bucket does not work on a tank) and sending empty containers back down the line.",
	]
	quest.3FFA51A73031CEC3.title: "Rose Quartz"
	quest.3FFA51A73031CEC3.quest_desc: [
		"Nether quartz plus redstone, then polished with sandpaper. Mason villagers and chests give quartz.",
		" ",
		"",
		" ",
		"§6How it works:§r Rose Quartz is nether quartz plus 8 redstone in a crafting grid. Polish it with Sand Paper: hold the quartz in your off hand and hold right-click with the paper (or look at quartz lying on the floor); later a Deployer holding sand paper does it over a Depot.",
		" ",
		"§6Why:§r Polished Rose Quartz + Iron Sheet = Electron Tube.",
	]
	quest.7DEF708B73A8F70F.title: "Electron Tube"
	quest.7DEF708B73A8F70F.quest_desc: [
		"Needed for smart blocks: deployers, crafters, redstone links.",
		" ",
		"",
		" ",
		"§6How it works:§r Polished Rose Quartz above an Iron Sheet in a crafting grid makes one tube. Make a dozen.",
		" ",
		"§6Why:§r Redstone Links, Deployers, Mechanical Crafters, Smart Fluid Pipes and the other smart blocks.",
	]
	quest.0D46A4828275B515.title: "Redstone Link"
	quest.0D46A4828275B515.quest_desc: [
		"A pair of links with the same frequency items sends a signal without wires.",
		" ",
		"",
		" ",
		"§6How it works:§r Place two links and put the same pair of frequency items into both (right-click the two slots on the block). Sneak + right-click (or a Wrench) switches a link to receiver mode. The signal travels wirelessly for 256 blocks.",
		" ",
		"§6Why:§r switching far-away lines from a lever at the door, linking a Threshold Switch to a machine across the base, control from a Linked Controller.",
	]
	quest.4150C56EE4F70F6C.title: "Copper Casing"
	quest.4150C56EE4F70F6C.quest_desc: [
		"Right-click a stripped log or stripped wood with a copper ingot.",
		" ",
		"§6Why:§r the Spout, Item Drain, Hose Pulley and Portable Fluid Interface: the whole fluid side of the era.",
	]
	quest.5ABB19465B46C3BE.title: "Diver"
	quest.5ABB19465B46C3BE.quest_desc: [
		"A copper backtank and a diving helmet let you stay underwater for a long time. The tank is filled with air from rotation.",
		" ",
		"",
		" ",
		"§6How it works:§r Place the Copper Backtank and give it rotation: it fills with air, faster at higher RPM. Worn on your back, it feeds the Copper Diving Helmet; Copper Diving Boots let you walk on the sea floor.",
		" ",
		"§6Why:§r underwater mining and building; later the same tank powers the Potato Cannon and the jetpack.",
	]
	quest.3A8C625128897260.title: "Empty Blaze Burner"
	quest.3A8C625128897260.quest_desc: [
		"The burner heats a basin; without it there is no brass. It only burns with a blaze caught inside, so the road leads to the Nether. Get the netherrack for it from ruined portals, there are plenty around the world.",
		" ",
		"",
		" ",
		"Chronicle: \"Our rise began with an empty burner and a caught blaze. So did our debt to fire, which we never repaid.\"",
		" ",
		"",
		" ",
		"§6How it works:§r Right-click a live blaze, or its spawner directly, with the Empty Blaze Burner to capture it. An empty burner can be lit with flint and steel, but only as decoration: it will not heat a Basin. The filled burner goes under a Basin or under a steam boiler tank.",
		" ",
		"§6Why:§r heat for Brass and the other heated recipes, smelting and smoking with a fan, and the steam engine of era 4.",
	]
	quest.58E29D718355BF98.title: "Liquid Experience"
	quest.58E29D718355BF98.quest_desc: [
		"Create Enchantment Industry: the mechanical grindstone turns experience nuggets into liquid XP and strips enchantments. XP is stored in tanks like any fluid.",
	]
	quest.083BA56F55976BB3.title: "Silo and Vessel"
	quest.083BA56F55976BB3.quest_desc: [
		"Create Connected: cheap multiblock item and fluid storage before brass.",
	]
	quest.4C68D34BFEDA95A1.title: "Six-way Gearbox"
	quest.14511258DD4ADD81.title: "Overstress Clutch"
	quest.14511258DD4ADD81.quest_desc: [
		"Disconnects a section when it is overstressed, so one machine cannot stop the whole factory.",
	]
	quest.0B9E71E9A52F3881.title: "Mechanical Extruder"
	quest.0B9E71E9A52F3881.quest_desc: [
		"A stone generator without contraptions: water, lava and a catalyst block beneath make cobble, and with the right catalyst ochrum, crimsite, asurine and other Create stones.",
	]
	quest.1AFD1969F4ABE98A.title: "Hydraulic Press"
	quest.1AFD1969F4ABE98A.quest_desc: [
		"Dreams & Desires: compacts fluids into stone — calcite, ochrum, crimsite from lava and milkshakes.",
	]
	quest.5962BBC27879708E.title: "Industrial Fan"
	quest.5962BBC27879708E.quest_desc: [
		"A high-power fan with catalyst sails: sanding, freezing and other new bulk processes.",
	]
	quest.0CAC05FCD0F52EA0.title: "Flanged Cogs and Chains"
	quest.0CAC05FCD0F52EA0.quest_desc: [
		"Bits 'n' Bobs: cogs can be linked by a chain across a distance, like a bicycle drive.",
	]
	quest.4287F5C47D4C3B98.title: "First Gun"
	quest.4287F5C47D4C3B98.quest_desc: [
		"Create Gunsmithing: the flintlock is made from andesite and iron sheets. More in the Arsenal chapter.",
	]
	quest.4079F25838407C2F.title: "Controlling Rotation"
	quest.4079F25838407C2F.quest_desc: [
		"A redstone signal on a clutch stops a shaft, on a gearshift it reverses it. The speedometer shows the speed. Any machine can now be switched by a lever or a sensor instead of breaking a cog.",
		" ",
		"",
		" ",
		"§6How it works:§r Clutches and Gearshifts go in line on a shaft. A redstone signal on a Clutch cuts the shaft (everything after it stops), on a Gearshift it reverses the rotation. The Speedometer shows RPM, and a comparator next to it gives a signal by speed.",
		" ",
		"§6Why:§r switching a workshop off with a lever, running pistons and pulleys back and forth, stopping a line from a sensor.",
	]
	quest.6CC52BB40B145712.title: "Create Chain Drive"
	quest.6CC52BB40B145712.quest_desc: [
		"Encased chain drives pass rotation sideways along a row of casings; the adjustable one doubles the speed on a signal.",
		" ",
		"",
		" ",
		"§6How it works:§r Encased Chain Drives pass rotation to each other along a row, and every shaft on the row turns the same way; the row may turn by 90 degrees. An Adjustable Chain Gearshift acts like a plain drive without a signal and doubles the speed of the other drives in the row when powered (an analog signal sets x1 to x2).",
		" ",
		"§6Why:§r sending rotation sideways to several machines without cogwheels, and switching a line's speed by signal.",
	]
	quest.52EDB7614DA3BAB2.title: "Clever Clutches"
	quest.52EDB7614DA3BAB2.quest_desc: [
		"Create Connected: the centrifugal clutch engages only at the set speed, the freewheel clutch turns one way only, the brake stops a network instantly.",
	]
	quest.632AEE7F419978EA.title: "Depot and Ejector"
	quest.632AEE7F419978EA.quest_desc: [
		"A depot is a one-tile belt: presses and deployers work on it. The ejector throws items (and players!) to a chosen spot, an easy way to link two workshops without a belt.",
		" ",
		"",
		" ",
		"§6How it works:§r A Depot holds one stack: right-click to place, throw items on, or feed it with funnels and belts; a Press, Spout or Deployer works above it (one empty block between). Aim a Weighted Ejector before placing it: sneak + right-click the landing spot (in a straight line, up to 32 blocks), then place it and power it. Whatever lands on it is launched; a redstone signal blocks it.",
		" ",
		"§6Why:§r a Depot is a one-item work station without a belt; the ejector throws items between workshops and across rivers, players too.",
	]
	quest.023FF6B1DA70A3B3.title: "Leap of Faith"
	quest.023FF6B1DA70A3B3.quest_desc: [
		"Get launched more than 30 blocks by an ejector. Tip: wear a helmet and land in water.",
	]
	quest.2C799B52B79B667C.title: "Tunnels and Filters"
	quest.2C799B52B79B667C.quest_desc: [
		"A tunnel over a belt splits the flow evenly to side belts. A filter in a funnel or arm lets only the right items through.",
		" ",
		"",
		" ",
		"§6How it works:§r Put an Andesite Tunnel on a Belt: if other belts or funnels are at its sides, it splits exactly one item off every passing stack to them, the rest rides on. List Filter: right-click it in hand to set the list, then right-click a filter slot on a funnel, tunnel, saw or deployer with it.",
		" ",
		"§6Why:§r spreading ore over furnaces, sorting loot into chests, separating products from raw material.",
	]
	quest.7F825C603FF381F6.title: "Create Redstone"
	quest.7F825C603FF381F6.quest_desc: [
		"Contacts fire when two contraptions meet, the analog lever outputs 0–15, latches and pulse blocks replace bulky circuits.",
		" ",
		"",
		" ",
		"§6How it works:§r Two Redstone Contacts facing each other give a signal, even if one rides on a moving contraption. Analog Lever: right-click raises the signal strength, sneak + right-click lowers it (0-15). A Pulse Repeater emits a short pulse after a delay of up to an hour (scroll on its panel). A Powered Latch turns on from a signal at the back and off from a signal at the side.",
		" ",
		"§6Why:§r stopping a piston or carriage at the end of its travel, exact signal strength, timers and latches without bulky circuits.",
	]
	quest.331A908A7569EB7C.title: "A Strong Breeze"
	quest.331A908A7569EB7C.quest_desc: [
		"Assemble a windmill of maximum strength — it takes a lot of sails. Compare the stressometer reading with water wheels.",
		" ",
		"",
		" ",
		"§6How it works:§r The limit is 16 RPM, which takes 128 sail blocks (wool counts too). Such a windmill gives 16 x 512 = 8192 su.",
		" ",
		"§6Why:§r one windmill runs a whole row of presses and mixers; compare it with water wheels on a Stressometer.",
	]
	quest.38FA369CC3B7EB77.title: "Hose Pulley"
	quest.38FA369CC3B7EB77.quest_desc: [
		"Lowers a hose into a lake to drain or fill it entirely. A lake (water or lava) of 10,000 blocks or more counts as infinite.",
		" ",
		"",
		" ",
		"§6How it works:§r The hose goes down while the pulley turns and winds back up when the rotation reverses. Connect a pipe with a Mechanical Pump to its other side: a pump pulling from the pulley drains the lake, a pump pushing into it fills it. Speed depends only on the pump and pipes.",
		" ",
		"§6Why:§r draining a lake for building, endless water for boilers and washing, lava for blaze cakes and Sturdy Sheets.",
	]
	quest.42B904A00EDF1DDD.title: "Tapping the Mantle"
	quest.42B904A00EDF1DDD.quest_desc: [
		"A big lava lake (10,000 blocks or more) counts as infinite. That is fuel for burners and extruders forever.",
	]
	quest.1B0289C7F9F33F57.title: "Haunted Bell"
	quest.1B0289C7F9F33F57.quest_desc: [
		"Haunt a bell with a soul-fire stream. Its toll shows where mobs will spawn at night, a lighting check for your base.",
		" ",
		"",
		" ",
		"§6How it works:§r You need a Peculiar Bell (recipe in JEI) and a fan stream through soul fire: fire on soul sand, a soul campfire, or a lit empty burner with a soul flame. A bell lying in the stream becomes Haunted.",
		" ",
		"§6Why:§r right-click with the bell to highlight spots where mobs can spawn: a lighting check for your base. Other haunting recipes are in JEI.",
	]
	quest.12D3D6A2419141C8.title: "Swappable Catalysts"
	quest.12D3D6A2419141C8.quest_desc: [
		"Create Connected: a catalyst sits in front of the fan instead of water or fire. No puddles or campfires, and you switch the mode by swapping one block.",
	]
	quest.7CEC8A7AB17E666B.title: "Gearbox"
	quest.7CEC8A7AB17E666B.quest_desc: [
		"A Gearbox passes rotation to all four sides around its axis: the straight output turns the opposite way, the side ones mirrored. It does not change speed. The Vertical Gearbox is the same block turned on its side; craft one into the other.",
		" ",
		"§6Why:§r turning a shaft round a corner or feeding 3-4 machines from one point without extra cogwheels.",
	]
	quest.0C01697C66F250F2.title: "Mechanical Drill"
	quest.0C01697C66F250F2.quest_desc: [
		"A drill breaks the block right in front of it while it spins, faster at higher RPM (4 su per RPM). Drops fall on the ground: catch them with a funnel or a Belt. The classic: a drill facing the spot where water meets lava gives endless cobblestone.",
		" ",
		"§6Why:§r cobblestone for the Millstone (gravel, then flint) and building; on a contraption, tunnels and quarries.",
	]
	quest.5991EF0C713904DB.title: "Pipes and Valve"
	quest.5991EF0C713904DB.quest_desc: [
		"Fluid Pipes connect by themselves; a Wrench turns a straight run into a pipe with a window (it stops linking to neighbouring pipes), and Copper Casing hides a pipe and locks its connections. A Fluid Valve sits in line: rotation one way opens it, the other way closes it. Fluid only moves when a Mechanical Pump drives it.",
		" ",
		"§6Why:§r bringing water to mixers and boilers and lava to a Spout; shutting a line with a valve without tearing it down.",
	]
	quest.7A6C07F193B2B8EB.title: "Fluid Tank"
	quest.7A6C07F193B2B8EB.quest_desc: [
		"Tanks placed together or stacked merge into one (up to 3x3 wide and 32 high); each block holds 8 buckets. In survival a bucket cannot fill or empty a tank: use pipes, an Item Drain, a Spout or a Basin. A comparator reads how full it is.",
		" ",
		"§6Why:§r a water and lava store for your lines, and in era 4 the boiler of a steam engine.",
	]
	quest.4B2AE3C4FD574B4C.title: "Flour and Dough"
	quest.4B2AE3C4FD574B4C.quest_desc: [
		"Wheat in a Millstone gives Wheat Flour (1, plus a chance of 2 more: 1.5 on average). Dough: flour and a water bucket in a crafting grid, flour in a fan stream through water, or a Mechanical Mixer with water. Dough in a furnace, smoker or campfire becomes bread.",
		" ",
		"§6Why:§r automatic bread for the whole guild and dough for the kitchen and sweets.",
	]
	quest.5C2D893952034C06.title: "Tree Farm"
	quest.5C2D893952034C06.quest_desc: [
		"Tree Fertilizer (flowers, coral and bone meal) grows a sapling into a tree at once, even in tight spaces. A Mechanical Saw facing the trunk sideways fells the whole tree when it cuts the bottom log.",
		" ",
		"§6Why:§r logs for casings and planks without an axe; with an era 2 Deployer planting saplings the farm becomes fully automatic.",
	]
	quest.51165BC26A85E13E.title: "Clipboard"
	quest.51165BC26A85E13E.quest_desc: [
		"Right-click to open a checklist, sneak + right-click to hang it on a wall. Most useful: right-click a machine with it to copy its settings (filters, modes) and left-click another to paste them. A written clipboard puts text on Display Boards and Nixie Tubes.",
		" ",
		"§6Why:§r setting up ten identical funnels in seconds, leaving notes for friends at a machine, labelling storage.",
	]
	quest.15B7943139D7496B.title: "Crafting Blueprint"
	quest.15B7943139D7496B.quest_desc: [
		"Hang the blueprint (painting + crafting table) on a wall; right-click an empty cell to open a menu and set a recipe. Right-click a configured cell to craft it from the ingredients in your inventory, sneak to craft up to a stack.",
		" ",
		"§6Why:§r crafting hundreds of shafts, cogwheels and belts for a new workshop quickly.",
	]
	quest.26A422EF2B054EE6.title: "Toolbox"
	quest.26A422EF2B054EE6.quest_desc: [
		"A toolbox holds lots of 8 different item types and keeps its contents when broken. Place it in the workshop: nearby players reach into it by holding the toolbox key (Alt by default) without walking over.",
		" ",
		"§6Why:§r your Wrench, goggles, glue and filters always at hand while building, with your inventory free.",
	]
	chapter.54375765B865CB39.title: "&#B5B5B5Era 1. Machines in Motion&r"
	chapter.54375765B865CB39.subtitle: "Pistons, bearings, pulleys, minecart contraptions and the schematicannon: everything that moves and builds by itself."
	quest.7EB3C3C4A1DFF233.title: "Super Glue"
	quest.7EB3C3C4A1DFF233.quest_desc: [
		"Glued blocks move together when a piston pushes or a bearing turns them. The base of every moving machine.",
		" ",
		"",
		" ",
		"§6How it works:§r Super Glue: right-click two corners to make a glued box; everything inside moves together. To remove a box, punch it with the glue in hand. Blocks hanging on others (torches, levers) usually need no glue.",
		" ",
		"§6Why:§r building structures for pistons, Mechanical Bearings, pulleys, train carriages and ships.",
	]
	quest.01C986BA577293FD.title: "Moving Machine"
	quest.01C986BA577293FD.quest_desc: [
		"Build a contraption with drills, saws or harvesters: a piston or bearing moves it while the tools work. This is how tunnel bores and tree farms are made.",
		" ",
		"",
		" ",
		"§6How it works:§r Glue a Mechanical Drill, Saw or Harvester to a structure and move it with a piston, Mechanical Bearing, Rope Pulley or Gantry Carriage: the tools work on the move. Loot goes into chests and barrels on the contraption itself, or drops if there are none. One contraption moves up to 2048 blocks.",
		" ",
		"§6Why:§r tunnel bores, quarries, tree and crop farms without manual work.",
	]
	quest.0FE63BEC8FE0FB9E.title: "Mechanical Farm"
	quest.0FE63BEC8FE0FB9E.quest_desc: [
		"A harvester on a moving machine reaps crops and leaves the roots. A plough tills the soil.",
		" ",
		"",
		" ",
		"§6How it works:§r A Mechanical Harvester only works on a moving contraption: it cuts ripe crops and replants them, leaving unripe ones alone. A Mechanical Plough breaks grass and other soft blocks on the move and tills dirt into farmland. Run them over the field with a piston or a minecart; the harvest goes into a chest on the contraption.",
		" ",
		"§6Why:§r an automatic farm for wheat (flour and bread), potatoes and cane without villagers.",
	]
	quest.534FF1B5D6814DCC.title: "Pistons and Bearings"
	quest.534FF1B5D6814DCC.quest_desc: [
		"A mechanical piston moves a glued structure in a line, a bearing spins it. This is the basis of gates, lifts, windmills and drills.",
		" ",
		"",
		" ",
		"§6How it works:§r A piston moves the structure glued to it; without Piston Extension Poles placed in line behind it, it cannot move at all, and their number is its range (up to 64). The rotation direction sets the travel direction (flip it with a Gearshift). A sticky piston pulls the structure back too. A Mechanical Bearing turns the structure in front of it while it receives rotation.",
		" ",
		"§6Why:§r gates, lifts, drawbridges, tunnel bores, carousels.",
	]
	quest.57355E960A7D739C.title: "Rope Pulley"
	quest.57355E960A7D739C.quest_desc: [
		"Lowers and raises a structure vertically: a mine lift or a drill that digs its own way down.",
		" ",
		"",
		" ",
		"§6How it works:§r The pulley lowers the structure glued under it while turning one way and raises it when the rotation reverses; the rope reaches 384 blocks. Higher RPM moves it faster; a Clutch and a Redstone Contact stop it at the right height.",
		" ",
		"§6Why:§r a mine lift, a drill that digs down layer by layer, a cargo hoist.",
	]
	quest.1C371232E7002E70.title: "Rope to Nowhere"
	quest.1C371232E7002E70.quest_desc: [
		"Extend a rope pulley more than 200 blocks. With the new world height that is a shaft from the sky to the bottom.",
	]
	quest.599D8A0525C64B63.title: "Gantry"
	quest.599D8A0525C64B63.quest_desc: [
		"A carriage rides a spinning shaft carrying a drill, deployer or another carriage. Block printers and quarries are built this way.",
		" ",
		"",
		" ",
		"§6How it works:§r Power a Gantry Shaft like a normal shaft, and a Gantry Carriage on it slides along; flip the rotation to reverse it. Glue a drill or a Deployer to the carriage; a carriage on a carriage adds a second axis.",
		" ",
		"§6Why:§r block printers, quarries that sweep row by row, precise manipulators.",
	]
	quest.7FD89700AC38E9C4.title: "Chassis and Sticker"
	quest.7FD89700AC38E9C4.quest_desc: [
		"Chassis grab the blocks around them without glue; a sticker grabs and releases on a signal — for docking contraptions.",
		" ",
		"",
		" ",
		"§6How it works:§r A chassis grabs blocks without glue: right-click a side with a slime ball to make it sticky. A Radial Chassis grabs every block of its layer within a radius (set with a Wrench, up to 16), a Linear Chassis a line of blocks in front of its sticky end. A Sticker attaches to or releases the block in front of it on a redstone signal.",
		" ",
		"§6Why:§r big drills and docking machines that leave or pick up part of themselves on a signal.",
	]
	quest.0C96E1CE909DE153.title: "Minecart Contraptions"
	quest.0C96E1CE909DE153.quest_desc: [
		"An assembler on rails turns a structure into a minecart: a harvester, drill or moving store long before trains. Couplings join two carts.",
		" ",
		"",
		" ",
		"§6How it works:§r Put a Cart Assembler in a rail line: a minecart passing over it while it is powered takes the glued structure along; without a signal it turns a cart contraption back into blocks. Use a Wrench on a cart contraption to pick it up and move it. A Minecart Coupling (right-click two carts) links carts together.",
		" ",
		"§6Why:§r mobile drills, harvesters and storage on plain rails, before trains.",
	]
	quest.32065E63E920021A.title: "Drive-by Exchange"
	quest.32065E63E920021A.quest_desc: [
		"Two interfaces, one on the contraption and one at the station, swap items as it passes. A harvester unloads itself this way.",
		" ",
		"",
		" ",
		"§6How it works:§r One interface on the contraption, another stationary one facing it with 1-2 empty blocks between. When they pass, they connect and the stationary one stands for every container on the contraption: a funnel or Chute on it unloads or loads them. The contraption waits while items move and leaves when they stop.",
		" ",
		"§6Why:§r a harvester unloads its crop at the barn by itself, a train loads ore by itself.",
	]
	quest.5BF049DE782F4C66.title: "Contraption Controls"
	quest.5BF049DE782F4C66.quest_desc: [
		"Turns drills, ploughs and saws on and off while the contraption moves, without disassembling it.",
		" ",
		"",
		" ",
		"§6How it works:§r Put Contraption Controls on the contraption: right-click them on the move to switch its tools on or off. The filter picks which ones (drills, saws, ploughs); if the controls are powered during assembly, they start switched off.",
		" ",
		"§6Why:§r driving a drill through your base without breaking anything, running a track layer only where needed.",
	]
	quest.51C301CBCAABE24C.title: "Fluids on the Move"
	quest.51C301CBCAABE24C.quest_desc: [
		"Like the item interface but for tanks: refuel tankers and vehicles as they pass.",
		" ",
		"",
		" ",
		"§6How it works:§r Works like the Portable Storage Interface, but for the contraption's tanks: a pair 1-2 blocks apart, with a pipe and a Mechanical Pump on the stationary one.",
		" ",
		"§6Why:§r refuelling trains and ships, hauling fluids from pumpjacks.",
	]
	quest.313D0A817054FF8A.title: "Schematics and Schematicannon"
	quest.313D0A817054FF8A.quest_desc: [
		"An empty schematic and Schematic and Quill save a build, the table writes it and the cannon builds it from a chest next to it. Share factories with friends: the file sits in the schematics folder.",
		" ",
		"",
		" ",
		"§6How it works:§r Mark two corners of a build with the Schematic and Quill and save it (the file goes to the schematics folder). The Schematic Table writes a file onto an Empty Schematic; put it into the Schematicannon and place the hologram. The cannon needs gunpowder as fuel and the blocks in a chest next to it; later a Stock Ticker can order the missing ones.",
		" ",
		"§6Why:§r copying good workshops, building big projects without laying blocks by hand, sharing factories with your guild.",
	]
	quest.4631C44D350E97EE.title: "Pattern Schematics"
	quest.4631C44D350E97EE.quest_desc: [
		"Saves a piece of a build as a repeating pattern that a schematicannon can lay for a kilometre (roads, track beds).",
	]
	quest.11963E3650F1D205.title: "Copycats"
	quest.11963E3650F1D205.quest_desc: [
		"Copycats+: zinc blocks that take the look of any block — slopes, steps, even working cogs and pipes.",
	]
	quest.451B49335CEE6F97.title: "Escalator"
	quest.6A32F8546E8A7A10.title: "Linear Chassis"
	quest.6A32F8546E8A7A10.quest_desc: [
		"Linear Chassis facing the same way move together. Make an open end sticky with a slime ball and it grabs a line of blocks in front of it; set the length with a Wrench (Ctrl for all of them). Attach blocks to the sides with Super Glue.",
		" ",
		"§6Why:§r a wide drill or harvester without piles of glue: a row of chassis with drills makes a tunnel shield.",
	]
	chapter.7CA4022CCA953A46.title: "&#E9C46AEra 2. Nether and Brass&r"
	chapter.7CA4022CCA953A46.subtitle: "Blaze burners, brass, sequenced assembly and smart automation."
	quest.21255BCC44ED797D.title: "Chapter II. Fire from Below"
	quest.21255BCC44ED797D.quest_subtitle: "A letter from Master August"
	quest.21255BCC44ED797D.quest_desc: [
		"Brass does not come from ore: copper and zinc need a heat no furnace gives. You need living fire, the blazes of the Nether.",
		" ",
		"",
		" ",
		"The chronicle says the Predecessors were the first to keep blazes in burners, and their greatness began there. So did their trouble: the strongest fire guardian, Ignis, they never tamed.",
		" ",
		"",
		" ",
		"Go to the Nether with armour, fire resistance and a friend. Catch a blaze and the workshop becomes a factory.",
		" ",
		"",
		" ",
		"— Master August",
	]
	quest.0212EF427C731405.title: "Into the Nether"
	quest.0212EF427C731405.quest_desc: [
		"Bring fire resistance and put a waystone by the portal: you will come back often.",
	]
	quest.38C48BE48BF9EED8.title: "Fortress and Blazes"
	quest.38C48BE48BF9EED8.quest_desc: [
		"Blazes live in Nether fortresses. YUNG's made them bigger and meaner, so go as a group.",
	]
	quest.6E0A417E075574BC.title: "Caught Blaze"
	quest.6E0A417E075574BC.quest_desc: [
		"Right-click a blaze with the empty burner. Feed it coal or logs, or better, let a mechanical arm do it.",
		" ",
		"",
		" ",
		"§6How it works:§r The burner only heats the Basin directly above it (and a steam boiler tank). Feed it any fuel with right-click (coal, logs, planks): the flame becomes heated; a Blaze Cake superheats it for a while. Without fuel the blaze only smoulders and heated recipes stop. In a fan stream a hungry burner smokes, a fed one smelts.",
		" ",
		"§6Why:§r Brass and every heated recipe, fan smelting without lava, the steam engine of era 4.",
	]
	quest.09D2A077FB7FD8DA.title: "Quartz"
	quest.2C8F1AF81F0DCA24.title: "Brass"
	quest.2C8F1AF81F0DCA24.quest_desc: [
		"Copper + zinc in a mixer over a basin with a lit burner. Brass opens the smart side of Create and the first ships.",
		" ",
		"",
		" ",
		"Chronicle: \"Brass gave us hands faster than human ones. Within a year we forgot how to use our own.\"",
		" ",
		"",
		" ",
		"§6How it works:§r A copper and a zinc ingot into a Basin on a lit Blaze Burner, a Mechanical Mixer one block above at 30+ RPM: 2 Brass Ingots come out. Common mistakes: an unfed burner, a mixer below 30 RPM, no outlet: put a Belt or Depot beside the Basin one block lower.",
		" ",
		"§6Why:§r Brass Casing, Mechanical Crafters, Brass Funnels and Tunnels, the Precision Mechanism: the whole smart side of Create.",
	]
	quest.2741FB41F86956F1.title: "Brass Casing"
	quest.2741FB41F86956F1.quest_desc: [
		"Right-click a stripped log or stripped wood with a Brass Ingot.",
		" ",
		"§6Why:§r Mechanical Crafters, the Mechanical Arm, Train Casing and the other brass machines.",
	]
	quest.09F002BF6428A02A.title: "Mechanical Crafter"
	quest.09F002BF6428A02A.quest_desc: [
		"Crafters form a grid and their arrows lead items to the last one. They make recipes bigger than 3×3: alternators, drills, jetpacks.",
		" ",
		"",
		" ",
		"§6How it works:§r Place crafters in a grid shaped like the recipe (as in JEI) and turn their arrows with a Wrench so all paths meet at one exit; the result goes into the chest, Depot or Belt there. Insert items by right-clicking the front or with funnels; cover empty recipe cells with a Crafter Slot Cover. If the recipe does not fill the whole grid, start it with a redstone pulse.",
		" ",
		"§6Why:§r recipes bigger than 3x3: Crushing Wheels, the Alternator, jetpacks, big addon parts.",
	]
	quest.017C54E1DE685462.title: "Deployer"
	quest.017C54E1DE685462.quest_desc: [
		"Does what a player with an item in hand does: places, uses, hits, cuts. The base of assembly lines.",
		" ",
		"",
		" ",
		"§6How it works:§r A Deployer acts on the spot two blocks in front of it (the block directly in front does not block it). Give it an item by right-clicking its front or with a funnel; a Wrench toggles right-click / left-click mode. Facing down over a Depot or Belt (one empty block between), it applies its item to what lies there: puts a cog on a part, polishes with sand paper.",
		" ",
		"§6Why:§r sequenced assembly (Precision Mechanisms, track), planting saplings on a tree farm, feeding Blaze Burners, automatic fighting and harvesting.",
	]
	quest.22DEBD5AC32E1906.title: "Sequenced Assembly"
	quest.22DEBD5AC32E1906.quest_desc: [
		"An item rides a belt under deployers, a press and a spout and becomes a finished part after enough loops. JEI shows the steps. Start a precision mechanism — you will need it in Era 4.",
		" ",
		"",
		" ",
		"Chronicle: \"My brother invented step-by-step assembly: the machine repeats the master's moves. Then the masters were not needed, and that was our fault, not the machine's.\"",
		" ",
		"",
		" ",
		"§6How it works:§r The part rides a Belt under the machines in the step order JEI shows and returns to the start until all loops are done. Precision Mechanism: a Golden Sheet, 5 loops past three Deployers (Cogwheel, Large Cogwheel, iron nugget); about 80 % succeed, the rest falls apart into parts (sheet, cogs, alloy). Loop the belt back or return parts with a Mechanical Arm.",
		" ",
		"§6Why:§r Precision Mechanisms (arms, trains, era 4 ships), Sturdy Sheets, track: everything complex in Create is made this way.",
	]
	quest.4DD982119AD237B9.title: "Smart Logistics"
	quest.4DD982119AD237B9.quest_desc: [
		"Brass funnels and tunnels filter and split the flow evenly: sorting without chests.",
		" ",
		"",
		" ",
		"§6How it works:§r A Brass Funnel moves up to a full stack at once (scroll its panel for the amount) and passes only what its filter allows. A Brass Tunnel has a filter on every side and distribution modes (split, round robin, prefer nearest); tunnels on parallel belts act as one group. A Smart Chute is a Chute with a filter and a batch size; redstone stops it.",
		" ",
		"§6Why:§r sorting ore and loot into chests, even distribution to furnaces and crafters, exact ingredient feeding.",
	]
	quest.7EB137A15A34CA8A.title: "Crushing Wheels"
	quest.7EB137A15A34CA8A.quest_desc: [
		"Faster than a millstone with more by-products: the heart of an ore factory.",
		" ",
		"",
		" ",
		"§6How it works:§r Place the two wheels one empty block apart on parallel axes and spin them towards each other so the top pulls inwards. Throw items on top or feed a Chute: the wheels take a whole stack at once and the output falls out below: put a Belt, Chute or chest there. Each wheel costs 8 su per RPM, so a pair at 128 RPM takes 2048 su. They also do every Millstone recipe.",
		" ",
		"§6Why:§r crushing ore (an ore block gives 1.75 crushed ore, a raw ore block 9) with experience and by-product metals, Cinder Flour, Powdered Obsidian, sand from gravel.",
	]
	quest.3AADC189D9D3C63C.title: "Blaze Cake"
	quest.3AADC189D9D3C63C.quest_desc: [
		"Superheats a burner, needed for the best alloys and diamonds from graphite.",
		" ",
		"",
		" ",
		"§6How it works:§r Netherrack in Crushing Wheels gives Cinder Flour; egg + sugar + flour under a Mechanical Press over a Basin give a Blaze Cake Base; a Spout pours 250 mB of lava on it: Blaze Cake. Right-click a burner with the cake to superheat it for a while.",
		" ",
		"§6Why:§r superheated recipes in JEI and twice the heat for a steam boiler (2 heat levels instead of 1).",
	]
	quest.02B2AF48CD21AAC5.title: "Stoker"
	quest.02B2AF48CD21AAC5.quest_desc: [
		"A mechanical arm keeps the burner fed (the arm arrives with the precision mechanism).",
	]
	quest.0BCBB280684C68BA.title: "Physics Assembler"
	quest.0BCBB280684C68BA.quest_desc: [
		"Turns a build into a physics object: a car, a boat, a balloon or a ship. See the Sky chapter next.",
	]
	quest.3C50FBC27A835777.title: "Steering Wheel"
	quest.40503799A0A423E9.title: "Hot-Air Balloon"
	quest.40503799A0A423E9.quest_desc: [
		"The burner heats air in an envelope: a simple aircraft without propellers.",
		" ",
		"",
		" ",
		"The reward for the balloon is in The Sky: Ships and Jetpacks (the Hot-Air Balloon quest).",
	]
	quest.76D4E2534E658833.title: "Hypertubes"
	quest.76D4E2534E658833.quest_desc: [
		"Pneumatic tubes for players: step into the entrance and fly to the exit. Fast transport inside a base.",
	]
	quest.3E5DB1CBC2E87723.title: "Molten Metal"
	quest.3E5DB1CBC2E87723.quest_desc: [
		"Create: Metalwork: a heated mixer melts ore and ingots, and a press over a basin casts them back. Molten metal flows through pipes into moulds.",
	]
	quest.53BE8C9A41875B8F.title: "Blaze Enchanter"
	quest.53BE8C9A41875B8F.quest_desc: [
		"A blaze burner fed with liquid XP enchants items on a belt — chosen enchantments, no randomness.",
	]
	quest.5373F9D80574BB87.title: "Blaze Forger"
	quest.5373F9D80574BB87.quest_desc: [
		"An automatic anvil: merges enchantments and moves them through templates.",
	]
	quest.4BA257241455E208.title: "Printer"
	quest.4BA257241455E208.quest_desc: [
		"Copies books and enchanted books for XP and renames items. Later it re-addresses packages.",
	]
	quest.2E77D291260458A8.title: "Enchanted Machines"
	quest.2E77D291260458A8.quest_desc: [
		"Create Enchantable Machinery: drills, saws, harvesters and crushers take enchantments — Fortune on a drill gives more ore, Silk Touch whole blocks.",
	]
	quest.63072E52E756743B.title: "Brass Gearbox"
	quest.630644A731842D3C.title: "Blasting Catalyst"
	quest.630644A731842D3C.quest_desc: [
		"The fan smelts items without an open lava pool next to your base.",
	]
	quest.4F4340E840565303.title: "Seething"
	quest.4F4340E840565303.quest_desc: [
		"Dreams & Desires: a stream through a superheated burner, a new process that turns coal into diamond shards.",
	]
	quest.31FA8CAD5BBCABD7.title: "Smart Hopper"
	quest.56DCFE856A54DE1B.title: "Refined Radiance"
	quest.56DCFE856A54DE1B.quest_desc: [
		"Create More Features: a glowing material from glowstone and powdered obsidian, for the best tools and casings.",
	]
	quest.767F7D02C450CD1F.title: "Chunk Loader"
	quest.767F7D02C450CD1F.quest_desc: [
		"Create Power Loader: the empty loader captures a ghast, then keeps its chunk loaded while it spins. Factories keep running while you are away.",
		" ",
		"",
		" ",
		"§6How it works:§r Right-click a ghast with the empty andesite chunk loader to capture it. Place the loader and give it rotation: while it spins, the chunk stays loaded; when rotation stops, the chunk unloads.",
		" ",
		"§6Why:§r your factory keeps running while you are away. Server rule: one static loader per player (see A Lag-Free Server).",
	]
	quest.424855176498ACCE.title: "Goggle Helmet"
	quest.424855176498ACCE.quest_desc: [
		"Create Goggles: goggles go into any helmet and the backtank into a chestplate. No more choosing between armour and goggles.",
	]
	quest.4B5250A8B6E15D61.title: "Keycards"
	quest.4B5250A8B6E15D61.quest_desc: [
		"Create: Things and Misc: a card press and reader make base doors that open only for your card.",
	]
	quest.03A88E9E1A38677A.title: "Pipe Organs"
	quest.03A88E9E1A38677A.quest_desc: [
		"Sound of Steam: a real pipe organ blown by steam systems, played by keyboard or punched roll.",
	]
	quest.4EE3BBA648021077.title: "Displays"
	quest.4EE3BBA648021077.quest_desc: [
		"A display link reads a machine, storage or station and shows it on nixie tubes, display boards or signs. Show your stock at the entrance.",
		" ",
		"",
		" ",
		"§6How it works:§r First right-click the display board or nixie tube with the Display Link, then place the link on the source block (storage, station, Stressometer) and choose what to send in its menu. Display Boards need rotation; a Nixie Tube without a link shows redstone strength, or text from a written Clipboard.",
		" ",
		"§6Why:§r stock levels at the entrance, train times at the station, network stress on the engineer's desk.",
	]
	quest.78693900B9C38AD7.title: "Storage Sensors"
	quest.78693900B9C38AD7.quest_desc: [
		"The smart observer sees what is on a belt or in a chest. The threshold switch starts a line when storage runs low and stops it when full.",
		" ",
		"",
		" ",
		"§6How it works:§r A Smart Observer with a filter emits a signal when a matching item passes in front of it or sits in the chest it watches. A Threshold Switch goes on a chest or vault with two thresholds: the signal turns on at one fill level and off at the other.",
		" ",
		"§6Why:§r stopping a line when storage is full and restarting it when it runs low, counting output, signal-based sorting.",
	]
	quest.7A09D27E6554F0C5.title: "Sequenced Gearshift"
	quest.7A09D27E6554F0C5.quest_desc: [
		"Runs a program: turn 90°, wait, return. For doors, gates and anything that needs an exact stroke.",
		" ",
		"",
		" ",
		"§6How it works:§r Right-click to open its list of steps: turn by an angle, move a piston by N blocks, wait. A redstone signal runs the program once and then it waits for the next signal; a comparator reads the current step.",
		" ",
		"§6Why:§r gates and bridges that open by an exact distance, turntables, machines with a fixed cycle.",
	]
	quest.0977AF04472AFBA2.title: "Elevator"
	quest.0977AF04472AFBA2.quest_desc: [
		"An elevator pulley with floor contacts: the cab stops at the chosen floor, and floors can be named on a display.",
		" ",
		"",
		" ",
		"§6How it works:§r Build a cabin under the Elevator Pulley and glue a Redstone Contact to it; on every floor place a stationary Redstone Contact in the same column facing the cabin. On assembly (rotation supplied, right-click the pulley) every contact in that column turns into an Elevator Contact by itself: they are not crafted separately. Right-click a contact to name its floor; a pulse on a contact calls the cabin, and inside, Contraption Controls pick the floor (scroll and click).",
		" ",
		"§6Why:§r a lift for the mine and the workshop floors; a contact emits a signal while the cabin is at its floor, so use it to open doors.",
	]
	quest.56F14CBA45AC0668.title: "Clock Tower"
	quest.56F14CBA45AC0668.quest_desc: [
		"The clockwork bearing shows the game time with hands made of any blocks. Put a clock on your town hall.",
		" ",
		"",
		" ",
		"§6How it works:§r Glue a hand to the Clockwork Bearing and give it rotation: it shows the hour. A second structure in front of the hour hand (not glued to it) becomes the minute hand. Right-click the bearing to start or stop it.",
		" ",
		"§6Why:§r clocks on the town hall and the station, structures that turn with the time of day.",
	]
	quest.5767BA611E3D30F3.title: "Crushing It"
	quest.5767BA611E3D30F3.quest_desc: [
		"Run a pair of crushing wheels at maximum speed — that takes serious power.",
		" ",
		"",
		" ",
		"§6How it works:§r The limit is 256 RPM: the pair then takes 2 x 8 x 256 = 4096 su. Raise the speed with cogwheels or a Rotation Speed Controller and check the reserve on a Stressometer.",
		" ",
		"§6Why:§r higher RPM crushes a stack faster, so the ore factory keeps up with your drills.",
	]
	quest.31BB2F85D7AB43B9.title: "Linked Controller"
	quest.31BB2F85D7AB43B9.quest_desc: [
		"A controller whose buttons are bound to redstone link frequencies: gates, lifts and machines from your hands.",
	]
	quest.1391112CEE65751D.title: "Pulse Program"
	quest.1391112CEE65751D.quest_desc: [
		"Create Connected: a pulse generator running a program from a control chip — timers and loops without miles of redstone.",
	]
	quest.109072BD9CF9DE42.title: "Kinetic Bridge"
	quest.109072BD9CF9DE42.quest_desc: [
		"Passes rotation across a gap without a shaft between the ends, isolating the stress.",
	]
	quest.00A078CC1DBAECFC.title: "Self-Driving Cart"
	quest.00A078CC1DBAECFC.quest_desc: [
		"A minecart contraption whose deployer places rails ahead of itself. It lays the way to a distant mine on its own.",
	]
	quest.6A049651F814E691.title: "Super Experience"
	quest.6A049651F814E691.quest_desc: [
		"Lightning on an experience block makes super experience, fuel for enchantments above the usual cap.",
	]
	quest.3B059234A12FE49D.title: "Light Instead of Wires"
	quest.3B059234A12FE49D.quest_desc: [
		"Create Optical: an optical source shines a beam, a sensor catches it and gives a signal, and mirrors and lenses turn the beam. That carries a signal across the base without wires. The parts are made by sequenced assembly.",
	]
	quest.0BA4D815EEA1E98C.title: "Attribute Filter"
	quest.0BA4D815EEA1E98C.quest_desc: [
		"Right-click to set it up: instead of a list of items it checks properties such as crushable, smeltable, food, added by a mod and more. Put it in a filter slot of a Brass Funnel, Tunnel, Smart Chute or into Stock Ticker categories.",
		" ",
		"§6Why:§r sending all ore to the crusher and everything else to storage with one filter; sorting drill loot.",
	]
	quest.63EC383E8BD2C6D7.title: "Smart Fluid Pipe"
	quest.63EC383E8BD2C6D7.quest_desc: [
		"At a source it picks which fluid to draw; further down a pipe it only lets that fluid through. Set the fluid by right-clicking its filter slot with a bucket or bottle of it.",
		" ",
		"§6Why:§r drawing only water from a shared tank, keeping lava and water apart in one network, not mixing milk and honey in the kitchen.",
	]
	quest.61DF4C272AEE3043.title: "Builder's Tea"
	quest.61DF4C272AEE3043.quest_desc: [
		"A heated Mechanical Mixer: leaves + 250 mB water + 250 mB milk give 500 mB of tea. Milk goes into an Item Drain by the bucket and by pipe into the Basin. A Spout pours 250 mB of tea into each glass bottle.",
		" ",
		"§6Why:§r Create fluids in practice (Item Drain, pipe, Basin, Spout), and the tea itself is a motivating, filling drink for building and mining.",
	]
	quest.4BE048499EDE2483.title: "Create Timers"
	quest.4BE048499EDE2483.quest_desc: [
		"A Pulse Timer emits short pulses at the interval you scroll in; a signal at its input pauses it. A Pulse Extender stretches a short signal to the set time (up to an hour). A Powered Toggle Latch is a lever that flips on every pulse at its back.",
		" ",
		"§6Why:§r an ejector or press every N seconds, one Mechanical Arm cycle at a time, lights and doors on a timer, one on/off button for a line.",
	]
	quest.19AEE9552BB3EE24.title: "Lava Diver"
	quest.19AEE9552BB3EE24.quest_desc: [
		"Copper helmet, boots and backtank are upgraded with a netherite ingot at a smithing table (needs a netherite upgrade template). The full set (Netherite Diving Helmet, Netherite Backtank, netherite leggings and Netherite Diving Boots) protects from fire and lava while the tank has air, and you see better in lava.",
		" ",
		"§6Why:§r walking through Nether lava lakes, mining ancient debris, repairing lava pumps and boilers.",
	]
	quest.2C45B3F8E422CA06.title: "The Brass Age"
	quest.2C45B3F8E422CA06.quest_desc: [
		"Crafters, sequenced assembly and smart logistics: everything you need for a real factory.",
	]
	chapter.109EA7C80E9B6026.title: "&#8AB17DLand and Sea&r"
	chapter.109EA7C80E9B6026.subtitle: "Cars, boats, submarines and rides on Create Aeronautics physics, from brass on."
	quest.78B5B9A254BDDA39.title: "Chapter III. Beyond the Horizon"
	quest.78B5B9A254BDDA39.quest_subtitle: "A letter from Master August"
	quest.78B5B9A254BDDA39.quest_desc: [
		"The physics assembler is a strange machine: what it builds comes alive. Wheels roll, sails catch the wind, a hull floats.",
		" ",
		"",
		" ",
		"To the guild's sailors: domes and gates have been seen underwater off the southern shores. The Predecessors seem to have had a port, and the sea took it. Build a submarine and go down. Carefully: the deep does not forgive.",
		" ",
		"",
		" ",
		"— Master August",
	]
	quest.11BE6D3308CF9E83.title: "Applied Kinematics"
	quest.11BE6D3308CF9E83.quest_desc: [
		"Glue a build, add a physics assembler and power it: the build becomes a physics body that falls, floats and rolls.",
	]
	quest.574AE09AC6303A92.title: "Wheels"
	quest.574AE09AC6303A92.quest_desc: [
		"Offroad: a tire goes on a wheel mount with suspension. Large and monstrous tires handle rough ground.",
	]
	quest.738D3A3801D55CBF.title: "Engine"
	quest.738D3A3801D55CBF.quest_desc: [
		"The portable engine burns fuel on board and spins the wheels.",
	]
	quest.49DC399AE57E1357.title: "First Car"
	quest.49DC399AE57E1357.quest_desc: [
		"Four wheels, an engine and a steering wheel. Team goal: drive to a neighbouring base.",
	]
	quest.659D384023611DEA.title: "Swivels and Winches"
	quest.659D384023611DEA.quest_desc: [
		"A swivel bearing hitches a trailer, a winch lifts loads and tows.",
	]
	quest.7B8F6AEC2CF0A28F.title: "Tunnel Borer"
	quest.7B8F6AEC2CF0A28F.quest_desc: [
		"A vehicle with a cutting head chews tunnels through rock as it drives.",
	]
	quest.5158C310BE2968DA.title: "Roller Coaster"
	quest.5158C310BE2968DA.quest_desc: [
		"Coaster tracks bend freely in space: loops, spirals, chain lifts. A fun park for your friends.",
	]
	quest.79891D13DD13ACE2.title: "Sailboat"
	quest.79891D13DD13ACE2.quest_desc: [
		"Floaters keep the hull afloat, sails catch the wind (a wind vane shows its direction), the rudder steers.",
	]
	quest.5DDA8FB499631B8A.title: "Motorboat"
	quest.3F506BEC14B3ECCB.title: "Under Sail"
	quest.3F506BEC14B3ECCB.quest_desc: [
		"Team goal: cross an ocean on your own vessel.",
	]
	quest.73AB85589161C4AC.title: "Ballast"
	quest.73AB85589161C4AC.quest_desc: [
		"Create Submarine: the pump floods ballast tanks to dive and empties them to surface.",
	]
	quest.01576B7B752B1CBA.title: "Pressurised Glass"
	quest.01576B7B752B1CBA.quest_desc: [
		"Normal glass cracks in the deep. Iron pressurised glass holds the pressure.",
	]
	quest.62B8CBE037206B2F.title: "Air Supply"
	quest.62B8CBE037206B2F.quest_desc: [
		"The electrolyzer makes oxygen from water, the diffuser spreads it through the sub.",
	]
	quest.5BB391B6A0CC4458.title: "Submarine"
	quest.5BB391B6A0CC4458.quest_desc: [
		"The onboard computer controls the dive, the water thruster pushes. Team goal: dive below Y=0 and come back, then tick the checkmark.",
		" ",
		"",
		" ",
		"Chronicle: \"In a submarine like this we searched for the sunken port. The Leviathan let us no further than the gates.\"",
	]
	quest.608B7BF241B2C981.title: "Deep Water"
	quest.608B7BF241B2C981.quest_desc: [
		"The barometer shows your depth and the decompression chamber lets you come back from deep dives unharmed. With them a submarine reaches the ocean floor.",
	]
	quest.4F077325BF0A09F8.title: "Sonar"
	quest.68B0159760A23598.title: "Mechanical Conduit"
	quest.68B0159760A23598.quest_desc: [
		"Create: Aquatic Ambitions: ocean processing and a mechanical conduit for an underwater base.",
	]
	quest.07CEDD7E5C651FCC.title: "Honey Glue"
	quest.07CEDD7E5C651FCC.quest_desc: [
		"Honey glue marks a group of blocks for a physics assembly more precisely than super glue.",
	]
	quest.3376DF953AFA7D17.title: "Ropes"
	quest.3376DF953AFA7D17.quest_desc: [
		"A rope ties two contraptions together: a tow, trailer, anchor or hanging cradle.",
	]
	quest.45ADC5C830926264.title: "Handle"
	quest.45ADC5C830926264.quest_desc: [
		"Hold on to a handle while moving so passengers do not fall off the deck.",
	]
	quest.75170D286D644F65.title: "Nameplate"
	quest.75170D286D644F65.quest_desc: [
		"Name your vehicle: the name shows in navigation and on radars.",
	]
	quest.4B3B6E6BF88B5C0D.title: "Contraption Diagram"
	quest.4B3B6E6BF88B5C0D.quest_desc: [
		"The diagram shows mass, centre of mass and thrust before launch.",
	]
	quest.3F3B7CD53FE312E4.title: "Redstone Magnet"
	quest.3F3B7CD53FE312E4.quest_desc: [
		"A magnet pulls contraptions together on a signal, for docking and coupling.",
	]
	quest.256ACAE55CD48615.title: "The Port Gates"
	quest.256ACAE55CD48615.quest_desc: [
		"Team goal: take your submarine down to the gates of the sunken port; the arches and domes of Underwater Village stand in every ocean. Tick the checkmark when the boat rests by the gates.",
		" ",
		"",
		" ",
		"Ratibor wrote that the Leviathan let their submarine no further than the gates. The gates are in front of you. Beyond them lies the port temple (page 4 of the Chronicle of the Predecessors), and deeper still, the Leviathan itself. Go further than they could.",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Small Gate (underwater_village).",
	]
	quest.70FFFD81AE0CCB62.title: "Captain"
	quest.70FFFD81AE0CCB62.quest_desc: [
		"A car, a ship and a submarine: land and sea are yours.",
	]
	chapter.68EF7D52A167703E.title: "&#48CAE4The Sky: Ships and Jetpacks&r"
	chapter.68EF7D52A167703E.subtitle: "Balloons and propellers from brass, gyroscopes alongside trains, levitite and jetpacks after the End."
	quest.465941E135A689AB.title: "Chapter IV. The Guild's Sky"
	quest.465941E135A689AB.quest_subtitle: "A letter from Master August"
	quest.465941E135A689AB.quest_desc: [
		"As a boy I thought clouds were for birds. I was wrong: they are for those not afraid of propellers.",
		" ",
		"",
		" ",
		"But we are not the first in the sky. A steam airship under a black flag was seen over the forests, with illagers shooting from it. It is a Predecessor ship; I knew it from a drawing in the chronicle. The raiders fly on stolen goods.",
		" ",
		"",
		" ",
		"Start with a balloon. Then a propeller, a rudder, a navigation table. And may our fleet one day pass over their airship.",
		" ",
		"",
		" ",
		"— Master August",
	]
	quest.12268CDCD669EB14.title: "Hot-Air Balloon"
	quest.12268CDCD669EB14.quest_desc: [
		"An envelope above a burner: hot air lifts the build. The simplest aircraft.",
	]
	quest.6176B327FB6967D1.title: "Head in the Clouds"
	quest.37775BFF17F4282E.title: "Propeller Bearing"
	quest.37775BFF17F4282E.quest_desc: [
		"A propeller bearing with blades gives thrust. It goes on a ship with a physics assembler and a steering wheel.",
	]
	quest.6FD4BA8DC7693A80.title: "First Ship"
	quest.6FD4BA8DC7693A80.quest_desc: [
		"Team goal: fly a propeller ship to a neighbouring base. Without a gyroscope it sways, so keep it small.",
		" ",
		"",
		" ",
		"Chronicle: \"Our first ship rose over this very valley. Half a century later illager raiders flew ships like it.\"",
	]
	quest.7AFB83E96F18CBFF.title: "Solid Fuel Thruster"
	quest.7AFB83E96F18CBFF.quest_desc: [
		"Create Propulsion: the simplest jet thrust, plus wings (temper them in a furnace).",
	]
	quest.3EA463AB4D805A63.title: "Cockpit"
	quest.3EA463AB4D805A63.quest_desc: [
		"Aeroworks: a yoke, a throttle quadrant and pedals send signals to control surfaces and engines.",
	]
	quest.074BFA88F1A824A2.title: "Gyroscope"
	quest.18BA14FB6E0B6508.title: "Gyroscopic Propeller"
	quest.18BA14FB6E0B6508.quest_desc: [
		"Keeps the ship level. Needs a precision mechanism, so it opens together with trains.",
	]
	quest.40890E25CD724252.title: "Smart Propellers"
	quest.6DA4847976A3E673.title: "Fluid Thruster"
	quest.6DA4847976A3E673.quest_desc: [
		"Runs on turpentine: crushed spruce plus water in a mixer.",
	]
	quest.7A094033F3F0C72C.title: "Navigation Table"
	quest.2746FB3D256D6FBA.title: "Docking"
	quest.2746FB3D256D6FBA.quest_desc: [
		"Docking connectors join two ships in flight: transfer people and cargo without landing.",
	]
	quest.7ADE11575F89DF99.title: "Air Fleet"
	quest.7ADE11575F89DF99.quest_desc: [
		"Team goal: a stabilised ship with a navigation table that holds course and altitude.",
	]
	quest.7C493CEC1B4BA1D0.title: "Cargo Route"
	quest.7C493CEC1B4BA1D0.quest_desc: [
		"The transponder records a route between airship stations, and the ship carries cargo on its own like a scheduled train.",
	]
	quest.2A5102659915C685.title: "Ship Claim"
	quest.2A5102659915C685.quest_desc: [
		"Protects the ship like an FTB Chunks claim, so nobody can take it apart mid-air.",
	]
	quest.4EF6A4D7C599283F.title: "Harpoon"
	quest.13C84087EA17B3D2.title: "Floating Islands"
	quest.13C84087EA17B3D2.quest_desc: [
		"Islands hang above the clouds, with houses, towers, ponds and even a volcano. Ratibor's chronicle remembers the First Guild lifting whole streets into the sky on levitite. Find at least one island: a ship reaches what your feet cannot.",
		" ",
		"",
		" ",
		"§6Explorer's Compass (any of them):§r mss: Arena, Birch River, Calcite House, Castle Ruin, Castle Tower and 30 more.",
	]
	quest.0AF94DACD04C9CCB.title: "The Sky Arena"
	quest.0AF94DACD04C9CCB.quest_desc: [
		"The biggest island is an arena with trial spawners and a vault. Team goal: clear it with your whole guild and open the vault, then tick the checkmark.",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Arena (mss).",
	]
	quest.5D5AA5F7B0B988AA.title: "Radar"
	quest.5D5AA5F7B0B988AA.quest_desc: [
		"Create Radars tracks ships, mobs and players. The monitor arrives with the precision mechanism.",
	]
	quest.24A454126BA127C2.title: "Steam Jetpack"
	quest.24A454126BA127C2.quest_desc: [
		"Create Stuff 'n Additions: personal flight on a steam engine, well before the End.",
	]
	quest.1FA6327560BA8AB0.title: "The End"
	quest.1FA6327560BA8AB0.quest_desc: [
		"Use Eyes of Ender to find the stronghold. YUNG's reworked both strongholds and the dragon island.",
	]
	quest.767D6B425028B816.title: "Levitite"
	quest.767D6B425028B816.quest_desc: [
		"End stone powder + zinc + water, then heat: crystals that float with no power. Floating islands and bases.",
		" ",
		"",
		" ",
		"Chronicle: \"Levitite held up our flying cities. The Ender Guardian watches over its veins.\"",
	]
	quest.513AF4CC98998836.title: "Elytra"
	quest.2716D5A640A1855F.title: "Jetpack"
	quest.2716D5A640A1855F.quest_desc: [
		"Runs on backtank air. J toggles it, H toggles hover.",
	]
	quest.1E75DB116875FB8F.title: "Ion Thruster"
	quest.1E75DB116875FB8F.quest_desc: [
		"Electric thrust without fuel. Needs a TFMG steel mechanism.",
	]
	quest.3525A19D86C1269B.title: "Edge of the Sky"
	quest.5C0879E16AFDC9DC.title: "Aviator Goggles"
	quest.2AAC4A5B00DAC48F.title: "Altitude Sensor"
	quest.2AAC4A5B00DAC48F.quest_desc: [
		"Outputs a signal by altitude: an autopilot holds its level and ballast drops on its own.",
	]
	quest.34F6AE5BB042C238.title: "Velocity Sensor"
	quest.1D820AD45C5AE9F4.title: "Gimbal Sensor"
	quest.1D820AD45C5AE9F4.quest_desc: [
		"A signal by roll and pitch — the core of a home-made autopilot that levels the ship.",
	]
	quest.03F033F779418501.title: "Laser"
	quest.03F033F779418501.quest_desc: [
		"A laser pointer and sensor: a rangefinder for landing and a tripwire for the hangar.",
	]
	quest.7AB8168AADB10F5D.title: "Far From Home"
	quest.7AB8168AADB10F5D.quest_desc: [
		"Set a navigation table target more than 5000 blocks away, your first long expedition.",
	]
	quest.2AF434B686B16FF1.title: "Mounted Cannon"
	quest.2AF434B686B16FF1.quest_desc: [
		"A potato cannon on deck, the first defence of your ship.",
	]
	quest.6D0D143877C63ECF.title: "Ghostbuster"
	quest.6D0D143877C63ECF.quest_desc: [
		"Shoot down a phantom with a mounted cannon.",
	]
	quest.7A59ABAE862C8C01.title: "Vector Thrust"
	quest.7A59ABAE862C8C01.quest_desc: [
		"An engine with a swivelling nozzle: the ship manoeuvres without rudders.",
	]
	quest.5E0BD74945082AA2.title: "Pearlescent Levitite"
	quest.53E47ED6DA088D05.title: "Masters of the Sky"
	quest.53E47ED6DA088D05.quest_desc: [
		"A fleet, cargo routes and jetpacks. The best gear will need boss trophies.",
	]
	chapter.7FC2CF8BF6F9688D.title: "&#2A9D8FEra 3. Factory and Current&r"
	chapter.7FC2CF8BF6F9688D.subtitle: "Create 6 storage, packages and the first electricity."
	quest.37C7E988DD06B6B3.title: "Chapter V. A City of Machines"
	quest.37C7E988DD06B6B3.quest_subtitle: "A letter from Master August"
	quest.37C7E988DD06B6B3.quest_desc: [
		"Brass is mastered and the trouble now is disorder. Chests overflow, belts tangle, everyone hauls their own.",
		" ",
		"",
		" ",
		"The Predecessors went through this too. Their foundries stood so close that smoke hid the sun, and their stores counted themselves. Ratibor writes that this was when they first forgot to ask whether the land could bear it.",
		" ",
		"",
		" ",
		"Build the store, the post and the wires. But plant gardens next to them and keep animals. We will not repeat their mistake.",
		" ",
		"",
		" ",
		"— Master August",
	]
	quest.5EB3BA9F3F56F287.title: "Item Vault"
	quest.5EB3BA9F3F56F287.quest_desc: [
		"Vaults merge into one big storage. Funnels, arms and packagers connect to them.",
		" ",
		"",
		" ",
		"§6How it works:§r Vaults placed together merge into one (base up to 3x3, length up to three times the width). You cannot open it by hand: items go in and out through funnels, a Mechanical Arm, an Item Hatch or a packager.",
		" ",
		"§6Why:§r one huge shared store for a line and the base of the packager and Stock Ticker network.",
	]
	quest.47001A59A0B89240.title: "Packager"
	quest.47001A59A0B89240.quest_desc: [
		"Packs items into addressed packages that travel by belt, chain and train.",
		" ",
		"",
		" ",
		"§6How it works:§r Attach the packager to a chest or vault: on a redstone signal it packs the contents into a Cardboard Package and pushes it out. A package fed back in is unpacked into its storage if everything fits.",
		" ",
		"§6Why:§r shipping orders by Chain Conveyor, train and Frogport; with a Stock Link, storage the whole network can use.",
	]
	quest.7D00AA26CB9675C7.title: "Package Frogport"
	quest.7D00AA26CB9675C7.quest_desc: [
		"Right-click a Chain Conveyor with the Frogport, place it nearby and set its address in its menu. It puts other packages onto the chain and takes packages with its own address off it into the chest or packager below. Right-click it with a Clipboard to note the address.",
		" ",
		"§6Why:§r mail between workshops without belts: order at the store and the package rides to the right workshop.",
	]
	quest.3F3291A1E5618CAF.title: "Chain Conveyor"
	quest.3F3291A1E5618CAF.quest_desc: [
		"Put Chain Conveyors on shafts and link two of them by right-clicking with a chain (up to 32 blocks, up to 4 links each). They pass rotation to each other and carry packages; hold a Wrench and right-click to ride the chain yourself.",
		" ",
		"§6Why:§r a package road between Frogports across the whole base.",
	]
	quest.4A376E246EDCEF5F.title: "Stock Keeping"
	quest.4A376E246EDCEF5F.quest_desc: [
		"The stock ticker lists the whole network and orders what you need straight to you.",
		" ",
		"",
		" ",
		"§6How it works:§r A Stock Link on a packager adds that storage to the network. Bind a Stock Ticker by right-clicking the link before placing it; orders go through a stock keeper, any mob or Blaze Burner seated in front of the ticker (right-click it). The order is packed and sent to the address you set.",
		" ",
		"§6Why:§r one window into every store on the base; the base of made-to-order factories and table-cloth shops.",
	]
	quest.2A794F41BE8008BD.title: "Factory Gauge"
	quest.2A794F41BE8008BD.quest_desc: [
		"Keeps a stock level: when a product runs low it orders the ingredients and starts production.",
		" ",
		"",
		" ",
		"§6How it works:§r Placed on a packager, the gauge watches its chest and restocks it from the network up to a target (hold right-click to set it). Placed on its own, it watches the whole network: connect ingredient gauges and a workshop address, and when stock runs low it sends raw materials there.",
		" ",
		"§6Why:§r a made-to-order factory: the network keeps a set stock of sheets, mechanisms and food by itself.",
	]
	quest.16935440BED7C1E7.title: "Fluid Packages"
	quest.16935440BED7C1E7.quest_desc: [
		"Factory Logistics packs fluids into jars that travel like normal packages.",
	]
	quest.4559634BDE43CF11.title: "First Automated Line"
	quest.4559634BDE43CF11.quest_desc: [
		"Team goal: a line that turns raw material into a stored product with no hands. Sheets, cogs or bread will do.",
		" ",
		"",
		" ",
		"Chronicle: \"Our first line that ran without people stood in the riverside foundry. We celebrated for a week. The river turned black within a year.\"",
	]
	quest.04395D536ED14639.title: "Rolling Mill"
	quest.04395D536ED14639.quest_desc: [
		"The start of Crafts & Additions: rolls ingots into rods and wire.",
	]
	quest.4C51493BC599030A.title: "Wires"
	quest.3E53F78D09A3DDFA.title: "Capacitor"
	quest.633ACAF83A600B2C.title: "Alternator"
	quest.633ACAF83A600B2C.quest_desc: [
		"Turns rotation into energy (FE). Needs a mechanical crafter.",
		" ",
		"",
		" ",
		"§6How it works:§r Turn the Alternator with a shaft and it produces FE: more RPM, more energy, but it is a heavy load, so give it a strong source. Take the power off with a Connector in Pull mode.",
		" ",
		"§6Why:§r electricity for Electric Motors far from rivers, the Tesla Coil and New Age energisers.",
	]
	quest.2F21427C8D01F550.title: "Electric Motor"
	quest.2F21427C8D01F550.quest_desc: [
		"The reverse: energy into rotation. Energy travels along wires for kilometres.",
		" ",
		"",
		" ",
		"§6How it works:§r The Electric Motor takes FE through a Connector in Push mode and turns a shaft by itself; scroll on it to set the speed (up to 256 RPM), and energy use grows with speed.",
		" ",
		"§6Why:§r power travels by wire for kilometres, so a motor runs machines where there is no source of their own.",
	]
	quest.2D4BC9494DB51701.title: "The Grid"
	quest.2D4BC9494DB51701.quest_desc: [
		"Right-click two connectors with a Copper Spool to run a wire between them. A Wrench switches a connector's mode: Pull on a generator, Push on a consumer, None for a plain pylon.",
		" ",
		"§6Why:§r a power grid between bases instead of kilometres of shafts.",
	]
	quest.559AD3DF79BDBBE3.title: "Accumulator"
	quest.3B4349BED16DF8C8.title: "Tesla Coil"
	quest.3B4349BED16DF8C8.quest_desc: [
		"Charges items and zaps nearby mobs.",
	]
	quest.0E5275852E2AAD12.title: "Energiser"
	quest.0E5275852E2AAD12.quest_desc: [
		"New Age: charges items with energy. Charged iron becomes magnetite. In AvgustovStory it needs a C&A capacitor.",
	]
	quest.6354043329D0CFB6.title: "Magnetite"
	quest.2DACD5528C14659D.title: "Generator Coils"
	quest.2DACD5528C14659D.quest_desc: [
		"Magnets spinning next to coils make a lot of energy: the New Age generator outclasses the C&A alternator.",
	]
	quest.5A9546D215D8FE04.title: "New Age Motor"
	quest.51CED7BB65034E92.title: "Vibrant Vaults"
	quest.51CED7BB65034E92.quest_desc: [
		"Create: Vibrant Vaults: vertical and coloured vaults and packagers; colour becomes an address and logistics stays readable.",
	]
	quest.4FACCDC9C1AEF784.title: "Shipping Containers"
	quest.29284A3CCAFA6EDD.title: "Experience Hatch"
	quest.29284A3CCAFA6EDD.quest_desc: [
		"Deposit your experience into the team tank and draw it back when needed.",
	]
	quest.563E3090B12CA398.title: "Table Cloth Shop"
	quest.563E3090B12CA398.quest_desc: [
		"A table cloth with a stock ticker turns storage into a shop: friends pick goods, pay, and the package arrives on its own. Put shops at stations.",
	]
	quest.7AD0179052D2AFA7.title: "Re-Packager"
	quest.7AD0179052D2AFA7.quest_desc: [
		"Joins the parts of a large order into one package, needed for crafters fed by orders.",
	]
	quest.129EDEAB9BEC1992.title: "Robo Bees"
	quest.129EDEAB9BEC1992.quest_desc: [
		"Create Mobile Packages: drone bees take packages from the port and fly them straight to a player, wherever they are.",
	]
	quest.317DA199C0120077.title: "Portable Stock Ticker"
	quest.317DA199C0120077.quest_desc: [
		"Order from storage anywhere in the world; a bee delivers it.",
	]
	quest.6C7148B5AEC81857.title: "Overcharging"
	quest.6C7148B5AEC81857.quest_desc: [
		"An energiser charges metal with power. Overcharged iron and gold are the next New Age tier.",
	]
	quest.1ECD18322D14D8E0.title: "Advanced Energiser"
	quest.2833E05F1D197C34.title: "Advanced Motor"
	quest.2833E05F1D197C34.quest_desc: [
		"The next motor tier: more speed and torque from the same grid.",
	]
	quest.21C9E35BB4C820FD.title: "Stronger Magnets"
	quest.21C9E35BB4C820FD.quest_desc: [
		"Redstone and layered magnets make New Age generators produce more.",
	]
	quest.5E3188FB1682D359.title: "Solar Heating"
	quest.5E3188FB1682D359.quest_desc: [
		"Solar plates heat pipes, and the heat runs a blaze burner without fuel during the day.",
	]
	quest.0F0FAFE8F6C8A5CD.title: "Biomass"
	quest.0F0FAFE8F6C8A5CD.quest_desc: [
		"Crafts & Additions: farm waste becomes pellets, fuel for burners from nothing.",
	]
	quest.21EFFCEDB0160E7F.title: "Item Hatch"
	quest.21EFFCEDB0160E7F.quest_desc: [
		"Place the hatch on a Vault or chest. Right-clicking it puts in the item in your hand, sneak + right-click everything except your hotbar.",
		" ",
		"§6Why:§r a Vault cannot be opened by hand, so the hatch is its drop-off window: back from the mine, unload with one click.",
	]
	quest.3CD6487F15C4CA9C.title: "Redstone Requester"
	quest.3CD6487F15C4CA9C.quest_desc: [
		"Right-click a Stock Link with it before placing to join that network. Right-click the placed requester to set the order (what, how many, which address); every redstone pulse sends that order out of storage.",
		" ",
		"§6Why:§r a button for \"bring 64 coal to the boilers\", raw material fed by a sensor without walking to the ticker.",
	]
	quest.6BA5E146AFCD8360.title: "Package Filter"
	quest.6BA5E146AFCD8360.quest_desc: [
		"Right-click to write an address. In the filter slot of a funnel, Brass Tunnel or Smart Chute it only lets packages with that address through.",
		" ",
		"§6Why:§r routing packages to workshops on plain belts, without Frogports.",
	]
	quest.7F492D888B9BF134.title: "Industrial Town"
	quest.7F492D888B9BF134.quest_desc: [
		"A tracked warehouse, a power grid and automation. Next: steam, rails and an economy.",
	]
	chapter.7CF6F3B9F0311268.title: "&#F4A261Era 4. Steam and Rails&r"
	chapter.7CF6F3B9F0311268.subtitle: "Precision mechanisms, steam engines, trains and money."
	quest.7C9CA89A3742B492.title: "Chapter VI. The Railway"
	quest.7C9CA89A3742B492.quest_subtitle: "A letter from Master August"
	quest.7C9CA89A3742B492.quest_desc: [
		"Steam and rails are my favourite invention, and I answer that without thinking.",
		" ",
		"",
		" ",
		"A Predecessor station was found in the forest: a platform, a board, rusty switches. The tracks lead one way, to an old factory in the mountains. Ratibor writes of \"the last train\". Who rode it, and where?",
		" ",
		"",
		" ",
		"A precision mechanism, a boiler at full power, the first station. Then a main line across the continent. Let every base of ours be linked to every other.",
		" ",
		"",
		" ",
		"— Master August",
	]
	quest.49C8E1C2CB9DF78F.title: "Precision Mechanism"
	quest.49C8E1C2CB9DF78F.quest_desc: [
		"Sequenced assembly: a golden sheet passes deployers adding cogwheels, large cogwheels and iron nuggets. The key to the whole era.",
		" ",
		"",
		" ",
		"Chronicle: \"The precision mechanism is the heart of the guardians. The Harbinger is built from the same mechanisms.\"",
		" ",
		"",
		" ",
		"§6How it works:§r The line: a Press makes a Golden Sheet, a looped Belt carries it under three Deployers (Cogwheel, Large Cogwheel, iron nugget), 5 loops. About 80 % succeed, the rest falls apart into parts (sheet, cogs, alloy) you can reuse.",
		" ",
		"§6Why:§r the Mechanical Arm, Train Controls, the Extendo Grip and Wand of Symmetry, stabilised ships.",
	]
	quest.322E48A162593536.title: "Mechanical Arm"
	quest.322E48A162593536.quest_desc: [
		"The mechanical arm takes items from one block and puts them into another: belts, depots, basins, furnaces, crafters. Made from a precision mechanism, brass casing and a brass sheet.",
		" ",
		"",
		" ",
		"§6How it works:§r While the arm is still in your hand (before placing!), right-click the target blocks: one click makes an input (blue), another an output (yellow), left-click removes a selection. Then place it within 5 blocks of them and power it. With several outputs, scroll its panel for the mode (round robin, prefer first); redstone stops it, and a short negative pulse gives exactly one cycle.",
		" ",
		"§6Why:§r compact lines without belts, returning parts in sequenced assembly, feeding burners, loading mechanical crafters.",
	]
	quest.64D1E811B244D8F0.title: "Steam Engine"
	quest.64D1E811B244D8F0.quest_desc: [
		"A water tank over blaze burners. A bigger tank with more burners raises the boiler level and power.",
		" ",
		"",
		" ",
		"§6How it works:§r A boiler is Fluid Tanks (at least 4) with Blaze Burners under them and water from a Mechanical Pump. Place the Steam Engine on the side of a tank and right-click it with a Shaft to make the output shaft. The boiler level is the lowest of three: heat (a fed burner 1, with a cake 2), size (4 tank blocks per level) and water (10 mB per tick per level). Each level runs one engine at full power: 64 RPM and 16,384 su.",
		" ",
		"§6Why:§r your first really big power: one boiler runs the whole factory, maxed crushers and the track works.",
	]
	quest.50DBEB12E4862F54.title: "Big Boiler"
	quest.50DBEB12E4862F54.quest_desc: [
		"A steam engine pulls only as much as its boiler gives. The boiler is fluid tanks of water over blaze burners: the more tanks and burners, the more engines it drives. Engineer's goggles show its level.",
		" ",
		"",
		" ",
		"§6How it works:§r Look at a tank with Engineer's Goggles: three bars, Size, Water and Heat; the boiler level follows the shortest one. Short on water: add a pump or speed it up; short on heat: more burners under the tank. An unfed burner (or fire, magma) only gives a weak passive mode.",
		" ",
		"§6Why:§r matching the boiler to the number of engines; engines beyond the level run weaker.",
	]
	quest.037B455A917C82D8.title: "Sturdy Sheet"
	quest.037B455A917C82D8.quest_desc: [
		"A sturdy sheet comes from sequenced assembly: obsidian powder from crushing wheels is pressed into a blank, filled with lava and pressed again. Railway casing is made from it.",
		" ",
		"",
		" ",
		"§6How it works:§r Obsidian in Crushing Wheels gives Powdered Obsidian (and the obsidian back at 75 %). Then the sequenced assembly line JEI shows: a Spout with lava and a Mechanical Press over a Belt.",
		" ",
		"§6Why:§r Train Casing, and from it stations, Train Controls and bogeys.",
	]
	quest.5F22BB0D8AF2D897.title: "Railway Casing"
	quest.5F22BB0D8AF2D897.quest_desc: [
		"Railway casing is brass casing with a sturdy sheet applied. Stations, train controls, doors and couplers are made from it.",
		" ",
		"",
		" ",
		"§6How it works:§r Right-click Brass Casing with a Sturdy Sheet (or let a Deployer do it). Right-clicking a track with Train Casing places a bogey; click again to change its style.",
		" ",
		"§6Why:§r bogeys, the Train Station, Train Controls, carriage doors.",
	]
	quest.358D0659205DAC79.title: "Tracks"
	quest.358D0659205DAC79.quest_desc: [
		"Tracks come from sequenced assembly of sleepers with iron and zinc nuggets. A main line eats hundreds of them, so automate it.",
		" ",
		"",
		" ",
		"§6How it works:§r Right-click an existing track with track, then the destination: the line lays itself with turns and slopes; hold sprint for the longest bend. Blocks in your off hand are paved under the track automatically.",
		" ",
		"§6Why:§r main lines between bases, mines and stores.",
	]
	quest.380479E50B4CB991.title: "Station"
	quest.380479E50B4CB991.quest_desc: [
		"A station (railway casing and a compass) goes right on the track. Trains are assembled and disassembled there, and schedules use it as a stop.",
		" ",
		"",
		" ",
		"§6How it works:§r Right-click a track with the Station, then place it nearby. Switch it to assembly mode in its menu: put bogeys on the track (right-click a rail with Train Casing), build the carriages, glue them, place Train Controls and press Assemble. Trains can only be disassembled at a station.",
		" ",
		"§6Why:§r route stops, building and fixing trains; right-click the station with a map to mark it.",
	]
	quest.69DC4856CBFC0A90.title: "Train Controls"
	quest.69DC4856CBFC0A90.quest_desc: [
		"Train controls turn a glued build on bogeys into a train; without them it will not move. Recipe: a lever, railway casing and a precision mechanism.",
		" ",
		"",
		" ",
		"§6How it works:§r A train will not assemble without Train Controls; a second set facing backwards lets it run both ways. Right-click the controls and the train follows your movement keys. Fuel (coal, logs) in a chest or barrel on the train makes it faster; fuel in a Vault is not used.",
		" ",
		"§6Why:§r manual driving and a seat for the schedule driver.",
	]
	quest.7C036BD110CE6DC8.title: "Super Glue"
	quest.7C036BD110CE6DC8.quest_desc: [
		"Super glue marks an area, and every block inside moves together as one carriage.",
		" ",
		"",
		" ",
		"§6How it works:§r Each carriage is its own glued box over its own bogeys (one or two per carriage); do not glue carriages to each other.",
		" ",
		"§6Why:§r a multi-carriage train that takes curves.",
	]
	quest.411E9AB77390070D.title: "Schedule"
	quest.411E9AB77390070D.quest_desc: [
		"Hand the schedule to a conductor (a villager or a blaze) and the train runs on its own.",
		" ",
		"",
		" ",
		"§6How it works:§r Right-click with the Train Schedule in hand to open the editor: add stations and conditions (wait N seconds, until loaded or unloaded). Then right-click the driver with it: any mob or Blaze Burner seated in front of the Train Controls. You can take the schedule back at any time.",
		" ",
		"§6Why:§r the train runs itself: ore from the mine, cargo between bases, a passenger line.",
	]
	quest.6CEC049A0BB60DFF.title: "First Train"
	quest.6CEC049A0BB60DFF.quest_desc: [
		"Team goal: a scheduled train between two bases, or a mine and a warehouse.",
		" ",
		"",
		" ",
		"Chronicle: \"Our trains linked every Predecessor city. The last one took the masters to the rocket factory, and the rails fell silent forever.\"",
	]
	quest.135D2D76A1165B42.title: "Train Doors"
	quest.135D2D76A1165B42.quest_desc: [
		"Doors for carriages: a wooden door and railway casing.",
	]
	quest.43E8152C9C58FC59.title: "Navigator"
	quest.43E8152C9C58FC59.quest_desc: [
		"Railways Navigator plans journeys with transfers across the network and shows arrival boards.",
	]
	quest.5F026A4053487696.title: "Display Board"
	quest.5F026A4053487696.quest_desc: [
		"The Create Railways Navigator advanced display goes on a train as a destination sign or on a platform, and shows more than a regular display board.",
	]
	quest.27E39C39CB646949.title: "Bank"
	quest.27E39C39CB646949.quest_desc: [
		"Numismatics: every player gets an account. Coins are minted from metals, trade happens at vendors.",
	]
	quest.33E4A92F201544B0.title: "Vendor"
	quest.33E4A92F201544B0.quest_desc: [
		"Everyone in the team is best at something: sell your goods to friends through vendors at stations.",
	]
	quest.03BA26063AFC1037.title: "Cast Iron Cannon"
	quest.03BA26063AFC1037.quest_desc: [
		"Create Big Cannons: cannons are built from blocks and fire shot. Good for defending your base from raids.",
		" ",
		"",
		" ",
		"Create Big Cannons in detail, with the rewards, are in the Arsenal and Defence chapter.",
	]
	quest.04F05A9D86419715.title: "Track Switch"
	quest.04F05A9D86419715.quest_desc: [
		"Steam 'n' Rails: a switch is flipped by a lever or redstone — junctions, depots and passing loops.",
	]
	quest.24CEEA04CD08EC2B.title: "Signals"
	quest.24CEEA04CD08EC2B.quest_desc: [
		"Signals split tracks into blocks with one train per block. Without them two trains on one line will crash sooner or later.",
		" ",
		"",
		" ",
		"§6How it works:§r Right-click a track with the Train Signal, then place it nearby. Signals split the line into blocks: a scheduled train will not enter an occupied block and never passes a signal against its direction; for two-way traffic add a second one facing the other way.",
		" ",
		"§6Why:§r several trains on one line without crashes, passing loops and depots.",
	]
	quest.1B9143F82446A079.title: "Arrival Board"
	quest.1B9143F82446A079.quest_desc: [
		"A display link shows the time until the next train on a display board.",
	]
	quest.45877A48C15C0BA6.title: "Track Coupler"
	quest.45877A48C15C0BA6.quest_desc: [
		"The Steam 'n' Rails train coupler sits on the track and couples or uncouples trains along their route.",
	]
	quest.2185C3F1F0490CC1.title: "Conductor"
	quest.2185C3F1F0490CC1.quest_desc: [
		"A cap on an andesite casing becomes a conductor robot that drives trains and pulls levers on schedule.",
	]
	quest.3225AC4F65A3B8E5.title: "Gauges and Monorail"
	quest.3225AC4F65A3B8E5.quest_desc: [
		"Steam 'n' Rails: wide gauge for heavy trains and a monorail on girders for tight spots and good looks.",
	]
	quest.0C7817597691E087.title: "Fuel Tank"
	quest.0C7817597691E087.quest_desc: [
		"Liquid-fuel trains: later, diesel becomes the main fuel of your lines.",
	]
	quest.05CF54651EECE600.title: "Long Train"
	quest.05CF54651EECE600.quest_desc: [
		"Build a train with at least six carriages.",
	]
	quest.1D7583A7568D88A9.title: "Mainline"
	quest.1D7583A7568D88A9.quest_desc: [
		"Ride more than 5000 blocks in one trip — a mainline linking every team base.",
	]
	quest.7C79A52036532CCA.title: "Portal Line"
	quest.7C79A52036532CCA.quest_desc: [
		"Trains pass through Nether portals: 1 block in the Nether is 8 in the Overworld — the fastest way to far bases.",
	]
	quest.64B723F464DF7138.title: "Carriage Doors"
	quest.64B723F464DF7138.quest_desc: [
		"Train Utilities: sliding doors modelled on real trains, plus platform blocks.",
	]
	quest.790CA574E95D369F.title: "Kinetic Battery"
	quest.790CA574E95D369F.quest_desc: [
		"Stores rotation and releases it later, for machines that work in bursts.",
	]
	quest.43262ED3EBEB1E23.title: "Brass Chunk Loader"
	quest.43262ED3EBEB1E23.quest_desc: [
		"Loads up to 5×5 chunks and works on trains and ships, so carriages never get stuck at the edge of loaded land.",
	]
	quest.78E467044E1863CF.title: "Gamepad Control"
	quest.78E467044E1863CF.quest_desc: [
		"Drive redstone links from a gamepad or keyboard with smooth analogue signals — for cranes, ships and trains.",
	]
	quest.2979DE43D31AA237.title: "Golden Mixer"
	quest.2979DE43D31AA237.quest_desc: [
		"The Dreams & Desires golden mixer is a mixer with a golden whisk; JEI shows what it does beyond the regular one.",
	]
	quest.53C4296266FA3507.title: "Full Steam"
	quest.53C4296266FA3507.quest_desc: [
		"A max-level boiler: a big tank, many blaze burners, plenty of water. Power for a whole factory.",
		" ",
		"",
		" ",
		"Chronicle: \"At full steam our boilers ate forest faster than it grew. Build windmills and wheels; let steam help, not rule.\"",
		" ",
		"",
		" ",
		"§6How it works:§r Level 18 needs 18 heat (for example 9 burners on blaze cake), 72 tank blocks and 180 mB of water per tick; then 18 engines give 18 x 16,384 su.",
		" ",
		"§6Why:§r power for a whole industrial district from one boiler.",
	]
	quest.012D55AC890E4EE2.title: "Rotation Speed Controller"
	quest.012D55AC890E4EE2.quest_desc: [
		"Sets an exact network speed regardless of the source. Without it big factories overstress or waste power.",
		" ",
		"",
		" ",
		"§6How it works:§r Place the controller on the input shaft and a Large Cogwheel directly on top: it drives the cogwheel at the speed you scroll in (up to 256 RPM, reverse too). It adds no capacity: more RPM, more stress.",
		" ",
		"§6Why:§r exact speeds for mixers and lines; slowing down quickly when overstressed without rebuilding gears.",
	]
	quest.57DB21C390DE2EE5.title: "Engineer's Tools"
	quest.57DB21C390DE2EE5.quest_desc: [
		"The wand of symmetry mirrors your building and the extendo grip reaches further, for tall builds and bridges.",
	]
	quest.4AEBFB0A1E381054.title: "Potato Cannon"
	quest.4AEBFB0A1E381054.quest_desc: [
		"Fires any food from your backtank. Defeat a mob with it; different crops behave differently.",
	]
	quest.0A629A3336C4AD75.title: "Steam Whistle"
	quest.0A629A3336C4AD75.quest_desc: [
		"A whistle on the boiler signals the shift change. Several of different pitch make an organ.",
	]
	quest.0F468DB664E7F4B6.title: "Choo Choo!"
	quest.0F468DB664E7F4B6.quest_desc: [
		"Mount a steam whistle on your train and sound it while driving.",
	]
	quest.777E5AC12A2FA1E1.title: "Track Crew"
	quest.777E5AC12A2FA1E1.quest_desc: [
		"A mechanical roller on a train paves the bed under the track; a track observer sees a passing train for switches and barriers.",
	]
	quest.54ACDA619631C266.title: "Buffer Stop"
	quest.54ACDA619631C266.quest_desc: [
		"The Misc and Things train buffer goes at the end of a dead end so the train stays on the rails.",
	]
	quest.0D1630844C98F34A.title: "Track Factory"
	quest.0D1630844C98F34A.quest_desc: [
		"Make more than 1000 tracks with one press. A main line between bases takes thousands, so the factory pays off.",
	]
	quest.1028EC86159CF8AD.title: "Cosy Carriage"
	quest.1028EC86159CF8AD.quest_desc: [
		"Create: Interiors: chairs and sofas you can sit on in a moving train or ship.",
	]
	quest.40C6269F041F6C55.title: "Postbox"
	quest.40C6269F041F6C55.quest_desc: [
		"Right-click a Train Station with the Postbox, place it nearby and set its address. Packages for other addresses put into it are picked up by any train stopping at the station, and packages for this address are dropped off into it; it works in unloaded chunks too.",
		" ",
		"§6Why:§r mail by rail: an order from storage travels to a distant base by itself.",
	]
	quest.27205B9F3903CFBA.title: "The Age of Steam"
	quest.27205B9F3903CFBA.quest_desc: [
		"Steam, rails and money. Next comes steel, and only the TFMG blast furnace makes it.",
	]
	chapter.2D70F24899807E05.title: "&#6C757DEra 5. Steel and Oil&r"
	chapter.2D70F24899807E05.subtitle: "Blast furnaces, oil fields, plastic and endless ore veins."
	quest.5927541A6852BA3D.title: "Chapter VII. Steel"
	quest.5927541A6852BA3D.quest_subtitle: "A letter from Master August"
	quest.5927541A6852BA3D.quest_desc: [
		"Cast iron is brittle and we need strength. Steel is made only in a blast furnace: huge, hot and hungry. And oil waits underground: fuel, plastic, circuit boards.",
		" ",
		"",
		" ",
		"This is exactly where the Predecessors broke. The chronicle speaks of the \"Great Exhaustion\": they pumped the land dry, rivers turned black, animals left, and their apprentices, out of work, took the old tools and became illager raiders.",
		" ",
		"",
		" ",
		"Smelt steel and pump oil, but count every barrel. We have only one land.",
		" ",
		"",
		" ",
		"— Master August",
	]
	quest.6596D173AF641EF6.title: "Cast Iron"
	quest.6596D173AF641EF6.quest_desc: [
		"Iron with coal under a press over a basin. Cast iron is the frame of all TFMG heavy industry.",
	]
	quest.1149957716CF42A8.title: "Fireproof Brick"
	quest.1149957716CF42A8.quest_desc: [
		"Fireproof bricks are fired in a furnace from fireclay balls (JEI shows where the fireclay comes from). The blast furnace walls are built from them.",
	]
	quest.51D890EF63FFA68A.title: "Coke Oven"
	quest.51D890EF63FFA68A.quest_desc: [
		"The coke oven (cast iron and industrial iron) bakes coal into coke. Ponder shows how to build it from several blocks.",
	]
	quest.2518FD5E3D0F8C76.title: "Coal Coke"
	quest.2518FD5E3D0F8C76.quest_desc: [
		"Coke burns hotter than coal and fuels the blast furnace. Stock up: the furnace is always hungry.",
	]
	quest.551BD18276D7EA22.title: "Blast Furnace"
	quest.551BD18276D7EA22.quest_desc: [
		"Fireproof brick walls, iron ore and coke fed from the top. See Ponder and JEI for sizes.",
	]
	quest.5DAF564C963FD05E.title: "Steel"
	quest.5DAF564C963FD05E.quest_desc: [
		"The only way to make steel from scratch in AvgustovStory. Big Cannons and Gunsmithing steel convert 1:1 in a crafting grid.",
		" ",
		"",
		" ",
		"Chronicle: \"Steel was our pride and our ruin. For it we levelled the mountains that held back the rivers.\"",
		" ",
		"",
		" ",
		"§6Steel opens the late tiers:§r netherite (superheated mixer, the Netherite quest), Epic Knights knight plate and heavy armour T4, steel weapons.",
	]
	quest.60975C4024C61525.title: "Heavy Plate"
	quest.60975C4024C61525.quest_desc: [
		"Heavy plate is steel rolled by sequenced assembly. It goes into the steel mechanism, distillation and heavy machines.",
	]
	quest.5C442A1AADB0D00A.title: "Steel Mechanism"
	quest.5C442A1AADB0D00A.quest_desc: [
		"The steel mechanism is the key of the era: heavy plate, steel cogs, nickel and lead plates, screws and a screwdriver in sequenced assembly. Without it there is no pumpjack, no drilling machine and no ion thruster.",
	]
	quest.65AB2D5985F2AF66.title: "Steel Casing"
	quest.65AB2D5985F2AF66.quest_desc: [
		"Steel casing is steel applied to hardened planks: the base of TFMG machines.",
	]
	quest.0517763710403F2C.title: "Oil Scanner"
	quest.0517763710403F2C.quest_desc: [
		"Oil sits in specific chunks. The scanner shows how rich a chunk is.",
	]
	quest.6301E49FA9901CE0.title: "Pumpjack"
	quest.6301E49FA9901CE0.quest_desc: [
		"Chronicle: \"The oil flowed until it ran out. Count the barrels, heir; we did not.\"",
	]
	quest.6C7F36997FFC58F0.title: "Diesel Generators Pumpjack"
	quest.6C7F36997FFC58F0.quest_desc: [
		"The second oil system. In AvgustovStory its bearing also needs a steel mechanism.",
	]
	quest.079ADB71CC3BAE2D.title: "Distillation"
	quest.079ADB71CC3BAE2D.quest_desc: [
		"The distillation controller builds a tower that splits crude oil into fractions: gasoline, diesel, kerosene, naphtha and more. Ponder shows how to build the tower.",
	]
	quest.7B3B79C13DB227E1.title: "Fuel"
	quest.7B3B79C13DB227E1.quest_desc: [
		"Gasoline and diesel come off the distillation tower. They fuel Diesel Generators engines and TFMG machines.",
	]
	quest.1F6F566757C93AE5.title: "Diesel Engine"
	quest.1F6F566757C93AE5.quest_desc: [
		"Its pistons are now made of steel, but the engine packs a lot of rotation into a small block.",
	]
	quest.7D3924CA3CBB831F.title: "Plastic"
	quest.7D3924CA3CBB831F.quest_desc: [
		"Plastic sheets are cast from molten plastic; JEI shows the chain from distillation products. Circuit boards need plastic.",
	]
	quest.4664BA7269053B79.title: "Circuit Board"
	quest.4664BA7269053B79.quest_desc: [
		"Needed for TFMG engines and for the rocket controls.",
	]
	quest.485F971FBE660B5F.title: "Aluminum"
	quest.485F971FBE660B5F.quest_desc: [
		"Aluminium is made in a chemical vat from bauxite dust. Aluminium sheets are needed for the rocket in the last era.",
	]
	quest.754A2BEB65158F3D.title: "TFMG Power"
	quest.754A2BEB65158F3D.quest_desc: [
		"The TFMG generator turns rotation into electricity, and the accumulator stores it (lead, sulfuric acid, an aluminium casing).",
	]
	quest.2271B5353B3A159A.title: "Drilling Machine"
	quest.2271B5353B3A159A.quest_desc: [
		"Endless ore from an underground vein. Find veins with the vein finder; each has its own yield.",
	]
	quest.3F375ABC97FD6C91.title: "Vein Finder"
	quest.3F375ABC97FD6C91.quest_desc: [
		"The vein finder shows whether a chunk holds an endless vein for the drilling machine. Recipe: amethyst, an Eye of Ender and redstone ore.",
	]
	quest.03C72A5485CBDF0D.title: "Steel Barrel"
	quest.03C72A5485CBDF0D.quest_desc: [
		"The built-up steel barrel of Create Big Cannons. The details and the reward are in Arsenal and Defence (the Steel Barrel quest).",
	]
	quest.079D6921AC491BEF.title: "Flare Stack"
	quest.079D6921AC491BEF.quest_desc: [
		"Burns off surplus gases so the column never stops on a full tank.",
	]
	quest.565B2C898DE979ED.title: "Industrial Mixer"
	quest.565B2C898DE979ED.quest_desc: [
		"The TFMG industrial mixer is a large mixer for chemistry recipes; JEI shows which ones it takes.",
	]
	quest.6F33439F4138ACC0.title: "Chemical Vat"
	quest.6F33439F4138ACC0.quest_desc: [
		"A vat with electrodes runs TFMG electrolysis and chemical reactions.",
	]
	quest.423783841511FDFC.title: "Asphalt"
	quest.423783841511FDFC.quest_desc: [
		"Bitumen from distillation makes asphalt roads that are faster to run and drive on.",
	]
	quest.009032BD517A601E.title: "Large Diesel Engine"
	quest.009032BD517A601E.quest_desc: [
		"Large diesels chain on one shaft and a turbocharger adds power.",
	]
	quest.6F572FD85FEEC494.title: "Huge Diesel Engine"
	quest.6F572FD85FEEC494.quest_desc: [
		"The huge diesel engine is the strongest engine in Diesel Generators. Feed it fuel from the distillation tower.",
	]
	quest.2CFB6682A875F57E.title: "Ethanol"
	quest.2CFB6682A875F57E.quest_desc: [
		"Fermenting crops in a lidded basin makes ethanol, a renewable fuel without oil.",
	]
	quest.2730B1177D89E2AC.title: "Canister"
	quest.2730B1177D89E2AC.quest_desc: [
		"A canister holds fuel and refuels machines on the road.",
	]
	quest.320B4FF55989C1C1.title: "The Industrial Age"
	quest.320B4FF55989C1C1.quest_desc: [
		"Steel, oil and endless ore. Next: the sky and the End.",
	]
	chapter.5F6BD320417E29B3.title: "&#E63946Era 6. Boss Trophies&r"
	chapter.5F6BD320417E29B3.subtitle: "Cataclysm trophies and netherite gear. Cannons are in the Arsenal chapter."
	quest.066C0076956AAE88.title: "Chapter VIII. The Predecessors' Guardians"
	quest.066C0076956AAE88.quest_subtitle: "A letter from Master August"
	quest.066C0076956AAE88.quest_desc: [
		"Before leaving, the Predecessors set guardians over what mattered most: the fire knight Ignis at the Nether forge, the iron Harbinger at the rocket factory in the mountains. The guardians still serve masters who are gone and let no one pass.",
		" ",
		"",
		" ",
		"In their hearts are metals no furnace can smelt. And Ratibor says the Harbinger's core holds a map of the sky.",
		" ",
		"",
		" ",
		"Do not go alone. This is a job for the whole guild.",
		" ",
		"",
		" ",
		"— Master August",
	]
	quest.130148D3B8439F46.title: "The Hunt Begins"
	quest.130148D3B8439F46.quest_desc: [
		"Detailed boss quests are in the Bosses chapter. This one only covers the trophies your machines need.",
		" ",
		"",
		" ",
		"Prepare like a raid: enchanted diamond-tier armour or better, fire resistance and healing potions, a totem, filling food and the whole team nearby. Find lairs with the Explorer's Compass.",
	]
	quest.09B61BBAF2CBA24F.title: "Ignis"
	quest.09B61BBAF2CBA24F.quest_desc: [
		"§6Tier B6§r · recommended armour T5+ (netherite and trophy sets)",
		" ",
		"§cHeat:§r a cooling lining on your armour and water",
		" ",
		"",
		" ",
		"The fire knight of the Burning Arena in the Nether. Hits with fire and a shield; fire resistance is a must, and block the lava around the arena first. A team of 2–4 is recommended.",
		" ",
		"",
		" ",
		"The guardian of the Predecessors' forge: see the Chronicle of the Predecessors, page 10.",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Burning Arena (L_Ender's Cataclysm 1.21.1).",
	]
	quest.55CA5B20172A1007.title: "Ignitium"
	quest.55CA5B20172A1007.quest_desc: [
		"Needed for the netherite jetpack.",
	]
	quest.1F31CC93666C13D9.title: "The Harbinger"
	quest.1F31CC93666C13D9.quest_desc: [
		"§6Tier B6§r · recommended armour T5+ (netherite and trophy sets)",
		" ",
		"",
		" ",
		"The mechanical guardian of the Ancient Factory, very much in the spirit of Create. Fires lasers and missiles: use cover and keep moving. A team of 2–4 is recommended.",
		" ",
		"",
		" ",
		"The guardian of the Predecessors' rocket factory, with a star map in its core: see the Chronicle, page 9.",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Ancient Factory (L_Ender's Cataclysm 1.21.1).",
	]
	quest.7D8C648876D1BE98.title: "Witherite"
	quest.7D8C648876D1BE98.quest_desc: [
		"Needed for the Ore Excavation netherite drill.",
	]
	quest.4233AE2347FB1210.title: "Netherite Jetpack"
	quest.4233AE2347FB1210.quest_desc: [
		"The netherite jetpack is made on mechanical crafters: elytra, a netherite backtank, ignitium and brass. In this pack ignitium replaced the precision mechanism, so it takes a victory over Ignis.",
	]
	quest.55D9A380247187A0.title: "Netherite Drill"
	quest.55D9A380247187A0.quest_desc: [
		"The netherite drill for the drilling machine: a diamond drill, a netherite upgrade template and witherite on a smithing table. In this pack the Harbinger's witherite replaced the netherite ingot.",
	]
	quest.30CB301B541829CE.title: "Veterans"
	quest.30CB301B541829CE.quest_desc: [
		"The best gear is won. One frontier is left: space.",
	]
	chapter.6F1204A5E9394F2D.title: "&#9D4EDDEra 7. Space&r"
	chapter.6F1204A5E9394F2D.subtitle: "A rocket, spacesuits, the Moon and Mars. The finale."
	quest.141E0EDDF78B547B.title: "Chapter IX. To the Stars"
	quest.141E0EDDF78B547B.quest_subtitle: "A letter from Master August"
	quest.141E0EDDF78B547B.quest_desc: [
		"This is my last letter, friends.",
		" ",
		"",
		" ",
		"Now I know where the last train went. The Predecessors built a rocket and left to look for a land they had not yet exhausted. The map from the Harbinger's core leads to the Moon: their last workshop is there.",
		" ",
		"",
		" ",
		"Once there was not a single cog here. Now we have trains, ships, factories and steel, and a living land around us. We walked their road and did not break. A rocket needs everything we know. Gather the whole guild and fly to where their chronicle ends.",
		" ",
		"",
		" ",
		"— Master August",
	]
	quest.1C133A562A6AA6C2.title: "Rocket Engineer Table"
	quest.1C133A562A6AA6C2.quest_desc: [
		"Creating Space: engines are designed on blueprints, the rocket is built from blocks like a contraption.",
	]
	quest.031BAEFE8C990837.title: "Space Metals"
	quest.031BAEFE8C990837.quest_desc: [
		"Nickel comes from TFMG ore in the Overworld, aluminium comes from TFMG bauxite. There is no cobalt on Earth: it is only on the Moon.",
	]
	quest.02CF9D42370FBB20.title: "Lunar Cobalt"
	quest.02CF9D42370FBB20.quest_desc: [
		"Cobalt from lunar ore plus aluminium sheets make a proper rocket casing for the next flights, to Mars and Venus.",
	]
	quest.395D9CBF7783687A.title: "Engine Blueprint"
	quest.395D9CBF7783687A.quest_desc: [
		"Enter the engine properties you want on the rocket engineer table and it gives you a blueprint. The engine and its parts are made from the blueprint.",
	]
	quest.52623177A13DE13C.title: "Rocket Engine"
	quest.52623177A13DE13C.quest_desc: [
		"The small rocket engine is made from a blueprint off the rocket engineer table; JEI shows its parts. The heavier the rocket, the more thrust it needs.",
	]
	quest.76C9E9D3439B1365.title: "Thorium"
	quest.76C9E9D3439B1365.quest_desc: [
		"New Age thorium: thorium ore generates in the world, and a mixer can make it from stone, clay and water.",
	]
	quest.180F23FB6EF5DD37.title: "Overcharged Diamond"
	quest.180F23FB6EF5DD37.quest_desc: [
		"A diamond in an advanced energiser. Needed for the rocket controls.",
	]
	quest.3D2BAE855354FD05.title: "Rocket Controls"
	quest.3D2BAE855354FD05.quest_desc: [
		"Needs a New Age overcharged diamond and a TFMG circuit board: every branch at once.",
		" ",
		"",
		" ",
		"Chronicle: \"The controls of our rocket took a year to build. Each master added a part in turn, a keepsake of home.\"",
	]
	quest.41A045F9CA841BBB.title: "Nuclear Fuel"
	quest.41A045F9CA841BBB.quest_desc: [
		"Nuclear fuel comes from sequenced assembly: radioactive thorium (thorium through crushing wheels) on an iron plate.",
	]
	quest.3E323B4F45F1A01B.title: "Reactor"
	quest.3E323B4F45F1A01B.quest_desc: [
		"The New Age reactor: casing, glass, a fuel acceptor, heat vents and rods on TFMG heavy plate. Overheating turns the core into corium, a melt that burns through the floor. Keep spare cooling and build it away from your base.",
	]
	quest.129EFC7C2F4F85A2.title: "Air Liquefier"
	quest.129EFC7C2F4F85A2.quest_desc: [
		"The Creating Space air liquefier pulls gases out of the air and liquefies them. That is how you get liquid oxygen for the spacesuit and the rocket.",
	]
	quest.3E87A2803D715CDC.title: "Liquid Oxygen"
	quest.3E87A2803D715CDC.quest_desc: [
		"The liquefier turns air into liquid oxygen, stored in a cryogenic tank that fuels the rocket and spacesuit tanks.",
	]
	quest.318692E388708E7C.title: "Spacesuit"
	quest.318692E388708E7C.quest_desc: [
		"The spacesuit is sewn from spacesuit fabric (copper sheet, gold and red wool in sequenced assembly). Fill the oxygen backtank with liquid oxygen through a pipe from below.",
	]
	quest.09E687E6EA4026B2.title: "Orbit"
	quest.09E687E6EA4026B2.quest_desc: [
		"Fly the rocket into Earth orbit. Page 11 of the Chronicle of the Predecessors pays the reward for the first orbit.",
	]
	quest.575ACA00F378EEF2.title: "The Moon"
	quest.575ACA00F378EEF2.quest_desc: [
		"Team goal: land the whole team and bring samples home for the guild: sixteen blocks of moon regolith (the Moon's top layer drops it). Bring an oxygen sealer to build a base with air. The landing itself is marked by page 12 of the Chronicle of the Predecessors.",
	]
	quest.79E7A700C61E5553.title: "Moon Base"
	quest.79E7A700C61E5553.quest_desc: [
		"The oxygen sealer fills a closed room with oxygen, so you can breathe in your moon base without the backtank. The walls must have no gaps.",
	]
	quest.0A39EA459E6367D7.title: "Mars"
	quest.0A39EA459E6367D7.quest_desc: [
		"Ratibor wrote that his brothers flew on from the Moon to Mars. To follow them you need a stronger engine and more fuel.",
	]
	quest.227A42268CAD3B97.title: "Venus"
	quest.227A42268CAD3B97.quest_desc: [
		"On the star map from the Harbinger's core Venus is marked \"if the Moon is not enough\". Hot and poisonous: prepare as for the Nether.",
	]
	quest.460A44F163F7847C.title: "Epilogue. The Guild's Story"
	quest.460A44F163F7847C.quest_subtitle: "The end of one story, the start of another"
	quest.460A44F163F7847C.quest_desc: [
		"You stand in the Predecessors' lunar workshop. On the bench lie the last page of the chronicle and an empty book. Ratibor was waiting for whoever came next.",
		" ",
		"",
		" ",
		"Below is your land: roads, rails, factory smoke, city lights and green fields. You built more than the Predecessors and did not ruin what feeds you.",
		" ",
		"",
		" ",
		"Write the names of everyone in the guild into the empty book and put it by the station. This is your story: AvgustovStory. Mars and Venus await the next chapter.",
	]
	chapter.151B1C8AD1616459.title: "&#E76F51Kitchen, Water and Climate&r"
	chapter.151B1C8AD1616459.subtitle: "Clean water, hearty food, clothes for the weather, your own beer and wine, all run by Create machines."
	quest.1D6532AEE86B0746.title: "Clean Water"
	quest.1D6532AEE86B0746.quest_desc: [
		"Legendary Survival Overhaul: next to hunger is a thirst bar. Raw river water quenches less and may make you sick. Smelt a water bottle in a furnace to get clean water. A Create fan over lava does the same in bulk.",
		" ",
		"",
		" ",
		"Chronicle: \"When foundries stood on every river, the water turned black. We learned to boil it and drink it bitter. Drink it clean, and do not let the rivers turn black again.\"",
	]
	quest.738192A57BF3792F.title: "Canteen"
	quest.738192A57BF3792F.quest_desc: [
		"A canteen holds several sips. Fill it with water and heat it in a furnace to purify it. For long trips there is a large canteen.",
		" ",
		"",
		" ",
		"Chronicle: \"In the last years everyone carried a canteen: we no longer trusted the springs.\"",
	]
	quest.1D44838FBC181F8B.title: "Water Purifier"
	quest.1D44838FBC181F8B.quest_desc: [
		"The water purifier is a head amulet (Curios slot): while worn, thirst does not drain. It takes copper and brass sheets, a charcoal filter, a precision mechanism and a canteen, so it is a precision-era goal. Until then: canteen and boiled water.",
		" ",
		"",
		" ",
		"Chronicle: \"We put purifiers by every kitchen when they belonged by every foundry. Keeping water clean is cheaper than cleaning it.\"",
	]
	quest.20D884662DD3CD9D.title: "Heat and Cold"
	quest.20D884662DD3CD9D.quest_desc: [
		"Body temperature depends on the biome, altitude, weather, time of day and what is nearby: fire and lava warm you, water, ice and snow cool you. A thermometer shows how hot or cold you are. Without protection, heat and cold drain your health down to one heart.",
	]
	quest.42AC7B82D3FA8BD8.title: "Sewing Table"
	quest.42AC7B82D3FA8BD8.quest_desc: [
		"At the sewing table you stitch a lining into armor: a warm one for the snow, a cooling one for deserts and the Nether. Any armor becomes clothing for the weather.",
	]
	quest.3B17E29D075C8592.title: "Warm Lining"
	quest.7295133678F66227.title: "Cooling Lining"
	quest.67F084DF55A23737.title: "Heater"
	quest.67F084DF55A23737.quest_desc: [
		"Warms the air around it, making a snowy base livable.",
	]
	quest.60DF1F21EF685F68.title: "Cooler"
	quest.60DF1F21EF685F68.quest_desc: [
		"Cools the air around it, for bases in the desert and the Nether.",
	]
	quest.707A59E3AFA43B90.title: "First Aid"
	quest.707A59E3AFA43B90.quest_desc: [
		"Damage now hits body parts. A hurt head blurs your sight, hurt arms hit and dig worse, hurt legs slow you down. A bandage or plaster heals one part, a medkit heals more, and morphine dulls the pain for a while.",
	]
	quest.119DFDC1CB78E80E.title: "Medkit"
	quest.3823B45A254AEA58.title: "Knife and Board"
	quest.3823B45A254AEA58.quest_desc: [
		"Era 0 already paid for the knife and the board (Flint Knife, Cutting Board). Here they open the kitchen.",
	]
	quest.5ACE0163F6203D78.title: "Stove and Pot"
	quest.5ACE0163F6203D78.quest_desc: [
		"Farmer's Delight: pot meals are more filling and give Nourishment. Soups also quench thirst.",
	]
	quest.04CC9CD124C29EB8.title: "Soup for the Whole Guild"
	quest.04CC9CD124C29EB8.quest_desc: [
		"Vegetable soup and chicken soup cook in the pot on the stove. Every new dish counts for Gourmet: the more different dishes, the more hearts.",
	]
	quest.4B1EB9D3DD6BBD10.title: "Feast"
	quest.4B1EB9D3DD6BBD10.quest_desc: [
		"A block dish for the whole team: place it on a table and everyone takes a serving.",
	]
	quest.5A97D002957E6FFF.title: "Rich Soil"
	quest.2743BFBEE92E78B2.title: "Mechanical Kitchen"
	quest.2743BFBEE92E78B2.quest_desc: [
		"Create Central Kitchen: a saw cuts like a cutting board, a deployer with a knife works the board, a blaze burner heats the pot, an arm loads it.",
	]
	quest.491D07C0F0616BB7.title: "Slicer"
	quest.7B65D4E85B4213DC.title: "Keg"
	quest.7B65D4E85B4213DC.quest_desc: [
		"Brewin' and Chewin': ingredients ferment in a keg and are poured into tankards. Create pipes can feed the keg directly.",
	]
	quest.5CD5C6B32E16CEFE.title: "Beer"
	quest.5CD5C6B32E16CEFE.quest_desc: [
		"Beer quenches thirst, but strong drinks make you Tipsy — not before a fight.",
	]
	quest.4C3E4519E263C2F1.title: "Mead"
	quest.7CCA1FA01EE40E72.title: "Ferments"
	quest.7CCA1FA01EE40E72.quest_desc: [
		"Jerky is the best travel food.",
	]
	quest.20EB8AD3B1B3707C.title: "Cheese"
	quest.20EB8AD3B1B3707C.quest_desc: [
		"A cheese wheel matures lying on the floor. Patience.",
	]
	quest.43D611D20E2A63F0.title: "Pizza"
	quest.074D90F0E7FFECC4.title: "Steel-Toe Stout"
	quest.0A5FF3EEE9393BB3.title: "Grapes"
	quest.3C91B79D602AEF36.title: "Wine Cellar"
	quest.3C91B79D602AEF36.quest_desc: [
		"Create Winery: a press crushes grapes into pomace, and the must ages in a wine cellar.",
	]
	quest.2C853FA06D9AD647.title: "Wine"
	quest.236A0C858978A01B.title: "Champagne"
	quest.462956A8435D5420.title: "Chocolate Factory"
	quest.462956A8435D5420.quest_desc: [
		"Create Confectionery: cocoa is crushed and chocolate is mixed with heat. Hot chocolate quenches thirst.",
	]
	quest.25CB3685B95D775D.title: "Nuts"
	quest.25CB3685B95D775D.quest_desc: [
		"Garnished: nuts from nut trees are cracked by a millstone and garnished by a spout.",
	]
	quest.52CC2FF27EE6FB4E.title: "Garnished Meal"
	quest.6960F9B7D764872A.title: "Fryer"
	quest.6960F9B7D764872A.quest_desc: [
		"Create: Bitterballen: sunflower oil and a mechanical fryer over a blaze burner.",
	]
	quest.63CE185815E31B92.title: "Fries"
	quest.734C904D2FC6116B.title: "Automated Kitchen"
	quest.734C904D2FC6116B.quest_desc: [
		"Team goal: a kitchen that cooks, cuts and fries on Factory Gauge orders — food and drink for the whole team, hands-free.",
	]
	quest.53E2DB669A21A45C.title: "Your Own Tavern"
	quest.53E2DB669A21A45C.quest_desc: [
		"A tavern with beer, wine and pizza, and a Numismatics vendor at the bar: let friends pay for dinner.",
	]
	quest.4AD2AE6CFE0EB0AC.title: "End Cuisine"
	quest.2324D73EB868E07D.title: "Card Table"
	quest.2324D73EB868E07D.quest_desc: [
		"Charta and Charta: Casino: card games in the world itself — blackjack, Texas hold'em, durak, crazy eights. Up to 8 players at one table, each on their own chair.",
		" ",
		"",
		" ",
		"Chips are virtual. To play for coins, agree on a buy-in and pick a banker.",
	]
	quest.16E35FB952F43AAC.title: "Your Own Casino"
	quest.16E35FB952F43AAC.quest_desc: [
		"A dealer table and game chairs: turn the tavern into a game hall. Add pool and chess next to it.",
	]
	quest.5FFD08E7197D783B.title: "Pool and Chess"
	quest.5FFD08E7197D783B.quest_desc: [
		"Pool and Billiards: craft the table and cue from the recipe book. Snooker, 8-ball, 9-ball, two players or against a bot.",
		" ",
		"",
		" ",
		"MineChess: craft a chessboard for real two-player chess.",
	]
	quest.03349234A9A2020D.title: "Candy and Gingerbread"
	quest.57BA29CDF42B744D.title: "Campfire Marshmallows"
	quest.47E9A2864FBB20A9.title: "Chocolate Collection"
	quest.4B5298305B92257F.title: "Balanced Diet"
	quest.4B5298305B92257F.quest_desc: [
		"One spout makes chocolate berries, a honeyed apple and a sweet roll.",
	]
	quest.07A441807671B4FA.title: "Gourmet"
	quest.07A441807671B4FA.quest_desc: [
		"Every new dish gives gourmet points by how hard it is to make: ★ 1 point for a furnace, campfire or 1-2 ingredients; ★★ 2 for the cutting board or 3-4 ingredients; ★★★ 3 for the cooking pot, Create machines, kegs, the winery and feasts. A dish is food that restores at least two hunger shanks.",
		" ",
		"",
		" ",
		"Everyone starts with 8 hearts. 10, 15, 35, 50, 75, 100, 135, 165, 210, 250, 310 and 360 points each add a heart, up to 20. Stages bring kitchen ranks, from Kitchen Boy to Kitchen Legend, and coins. A Crystal Heart (9 fragments from mineshaft, buried treasure, jungle temple and bastion chests) gives one more heart on right click.",
		" ",
		"",
		" ",
		"Shared table: a serving taken from a feast counts for everyone in your guild within 16 blocks.",
		" ",
		"",
		" ",
		"A death takes one heart, never below the starting 8. To win it back, collect as many points of different dishes as your last stage cost (dishes you know count too), or use a Crystal Heart.",
		" ",
		"",
		" ",
		"Diet: your last 10 meals and drinks count. There are five groups: meat, fish and eggs; vegetables and fruit; bread and grain; sweets; drinks. 3 groups give Haste for 10 minutes, 4 also Strength, all 5 also Resistance. 10 meals in a row from one group are \"monotonous\": Weakness. The same dish 8 times in a row is \"boring\": a short Hunger.",
		" ",
		"",
		" ",
		"§e/hearts§r shows hearts and points. §e/gourmet§r gives the gourmet journal: your diet and the dishes you have not tried yet.",
		" ",
		"",
		" ",
		"Every land has its own cuisine: ocean structure chests hold fish dishes, cold ones hot soups, deserts and jungles fruit and sweets, the Nether and the End their own dishes, dungeons cheese, wine and Crystal Heart fragments. The first win over each boss gives fragments, over a big one a whole Crystal Heart.",
	]
	chapter.0FE0B49642FB6CD5.title: "&#90BE6DFarms and Lines&r"
	chapter.0FE0B49642FB6CD5.subtitle: "A good engineer does not chop trees — he builds what chops them."
	quest.57DC511E55D14451.title: "Farms and Lines"
	quest.57DC511E55D14451.quest_desc: [
		"Ratibor: \"By hand we mine for one evening. By machine — for a lifetime.\" This chapter lists the farms that take the chores out of this pack: water, fuel, stone, ore, experience, steel and rocket fuel. How to build each is in the description and in the Ponder hints (hold W over a machine).",
	]
	quest.0C1AB0F17EF01CD9.title: "Clean Water Station"
	quest.0C1AB0F17EF01CD9.quest_desc: [
		"How: a mechanical pump feeds water into a mixer over a blaze burner, a deployer or hopper feeds glass bottles — the mixer boils water right into bottles (250 mB each). Without a burner: a cauldron on a campfire, bottles by hand.",
		" ",
		"Why: thirst is a daily chore. Clean water gives no thirst, and juices made from it also cool you down.",
	]
	quest.61DCBDD899D09163.title: "Lumber Mill"
	quest.61DCBDD899D09163.quest_desc: [
		"How: a mechanical saw fells the whole tree, a deployer plants the sapling, logs ride a belt into a furnace or a fire fan. Spruce or birch are easiest (straight trunk).",
		" ",
		"Why: charcoal fuels burners, the boiling campfires and furnaces; planks and sticks go into everything.",
	]
	quest.18BB7FC4F9D7A905.title: "Stone from Nothing"
	quest.18BB7FC4F9D7A905.quest_desc: [
		"How: the mechanical extruder between water and lava pushes out stone; with the right sample block next to it you get andesite, granite or diorite. Add rotation and you have an endless quarry.",
		" ",
		"Why: andesite alloy, stone blocks, gravel and sand for the next farms.",
	]
	quest.4474FCA42743231A.title: "Sand and Clay"
	quest.4474FCA42743231A.quest_desc: [
		"How: crushing wheels turn cobblestone into gravel and gravel into sand; a fan through water washes gravel (flint, iron nuggets) and sand (clay).",
		" ",
		"Why: glass, concrete, bricks, flint — and iron from washing before your mine is ready.",
	]
	quest.37C5F2BD8916DC49.title: "Autopilot Field"
	quest.37C5F2BD8916DC49.quest_desc: [
		"How: a harvester on a piston or a train passes over the field and reaps it, leaving the plants to regrow; a plough tills new land. Sugar cane and bamboo work the same way.",
		" ",
		"Why: bread, animal feed, sugar — and lots of dishes for gourmet points.",
	]
	quest.4DDFCA5EB06FDA77.title: "Kelp Boiler Room"
	quest.4DDFCA5EB06FDA77.quest_desc: [
		"How: kelp grows in a water column, a harvester or saw cuts it, a fire fan dries it, a press or crafter packs blocks.",
		" ",
		"Why: a dried kelp block is cheap renewable fuel for burners and furnaces.",
	]
	quest.639523AD0B236BF2.title: "Chicken Roost"
	quest.639523AD0B236BF2.quest_desc: [
		"How: a Create Integrated Farming roost — hens lay and moult inside the block, a hopper or belt collects eggs and feathers.",
		" ",
		"Why: feathers for arrows, eggs and chicken for the kitchen, without a fence full of hens.",
	]
	quest.5681907E1EC1DAAA.title: "Ore from Stone"
	quest.5681907E1EC1DAAA.quest_desc: [
		"How: an extruder (the brass one is faster) pushes out asurine, veridium, ochrum and crimsite when a sample block sits next to it; crushing wheels make crushed ore, washing and smelting give zinc, copper, gold and iron.",
		" ",
		"Why: brass without mining — the key resource of the era.",
	]
	quest.103BE13758B916A0.title: "Piped Experience"
	quest.103BE13758B916A0.quest_desc: [
		"How: mobs killed by a deployer with a sword or by crushing wheels drop experience; Create Enchantment Industry collects it as fluid and nuggets. Keep the mob farm away from mega torches.",
		" ",
		"Why: experience pays for enchanting and for the teleports, which cost XP here.",
	]
	quest.1CEB7ADE4A053DF7.title: "Blaze Rods"
	quest.1CEB7ADE4A053DF7.quest_desc: [
		"Where: blazes in Nether fortresses; fence the spawner and let a deployer fight. Gunpowder and rods also come from a mixer with blaze powder (Create Ultimate Factory, see JEI).",
		" ",
		"Why: blaze burners, potions, ender eyes and powder charges — before tier B3 bosses you always want a stock.",
	]
	quest.5539ED7AAC4C0048.title: "Coke Oven"
	quest.5539ED7AAC4C0048.quest_desc: [
		"How: the TFMG coke oven bakes coal into coke. Coal comes from mining, from haunting charcoal with a soul-fire fan, or from washing.",
		" ",
		"Why: the blast furnace needs coke for steel — no coke, no steel era.",
	]
	quest.584FC0929BD87BA9.title: "Endless Lava"
	quest.584FC0929BD87BA9.quest_desc: [
		"How: a hose pulley in a Nether lava sea — a pool of over 10 000 blocks counts as infinite and never runs dry. Pipes and pumps bring it home or into a train tank.",
		" ",
		"Why: fuel, casting and stone extruders.",
	]
	quest.7A379864171045A0.title: "Oil and Diesel"
	quest.7A379864171045A0.quest_desc: [
		"How: a TFMG pumpjack over an oil deposit (more of them in badlands), a distillation tower splits crude into gasoline, diesel, kerosene and gas.",
		" ",
		"Why: engines, generators and plastic of the steel era.",
	]
	quest.29DEC34A72369A8E.title: "Rocket Fuel"
	quest.29DEC34A72369A8E.quest_desc: [
		"How: a mechanical electrolyzer splits water into hydrogen and oxygen, an air liquefier gives liquid oxygen, and it all collects in cryogenic tanks. Fuel does not travel in buckets: pipes and tanks only.",
		" ",
		"Why: without fuel a rocket is a monument.",
	]
	quest.037F7593A8C97FE0.title: "Moon Quarry"
	quest.037F7593A8C97FE0.quest_desc: [
		"How: on the Moon the same extruder or a drill on a bearing; the valuable Moon ores go through crushing and washing like at home.",
		" ",
		"Why: building stone for the Moon base on the spot — shipping stone from Earth by rocket is expensive.",
	]
	quest.23F84575BE33D32D.title: "Questionable Farms"
	quest.23F84575BE33D32D.quest_desc: [
		"Ratibor frowns at the words \"iron golem farm\", \"raid farm\" and \"trading hall\". You can build them, but iron, totems and Mending stop being rewards, and the guild shop misses its customers. The chronicle will remember.",
		" ",
		"Tip: if you build them, wait until the steel era, when the game is about other things.",
	]
	chapter.388F77CD4F772EF4.title: "&#90BE6DBeasts, Fishing and Farms&r"
	chapter.388F77CD4F772EF4.subtitle: "Wildlife, Aquaculture fishing, crop storage and automatic farms."
	quest.648CA8E4002792F8.title: "Naturalist"
	quest.648CA8E4002792F8.quest_desc: [
		"The world has dozens of new animals: deer, bears, snakes, fireflies. The net catches butterflies and fireflies.",
		" ",
		"",
		" ",
		"Chronicle: \"Before the Great Exhaustion the animals left for the mountains, and we were the last to notice. Write down who lives around you. If the list ever grows shorter, stop.\"",
	]
	quest.46BB8658D89E5BEA.title: "The Hunt"
	quest.5E07AFF348EDFEA5.title: "Fireflies"
	quest.107929A294983AF4.title: "A Pet"
	quest.107929A294983AF4.quest_desc: [
		"Critters & Companions: tame a ferret, a red panda or a jumping spider. Friends & Foes: a glare points out dark spots.",
	]
	quest.61F5087944156F29.title: "Koi"
	quest.372CAC49BD881CCB.title: "Silk and Hook"
	quest.372CAC49BD881CCB.quest_desc: [
		"Jumping spider silk makes a grappling hook, the climber's best tool.",
	]
	quest.47D53965F4099D7E.title: "Copper Golem"
	quest.47D53965F4099D7E.quest_desc: [
		"A copper block, a pumpkin and a lightning rod make a little helper that presses copper buttons.",
	]
	quest.6035F63716FF33C1.title: "Illager Totems"
	quest.6035F63716FF33C1.quest_desc: [
		"The Iceologer and Illusioner hide in cabins; their totems save you in new ways.",
	]
	quest.170EB030A9F86563.title: "Biome Endermen"
	quest.6A93004FFBD6C81F.title: "Maple Syrup"
	quest.7EE2EA2995FDE8B4.title: "Fishing"
	quest.7EE2EA2995FDE8B4.quest_desc: [
		"Aquaculture: worms from a worm farm are bait; hooks and lines are set in a tackle box. Every biome has its own fish.",
	]
	quest.097E890E050C296D.title: "Tackle"
	quest.53427463D093ECE7.title: "Trophy Fish"
	quest.53427463D093ECE7.quest_desc: [
		"Tuna lives in the ocean, arapaima in the jungle.",
	]
	quest.6D222AD1354FA4F1.title: "Sunken Treasure"
	quest.47C6BB6818338F4F.title: "Seafood"
	quest.061A25FE70E5C239.title: "Drawers"
	quest.061A25FE70E5C239.quest_desc: [
		"Storage Drawers: each drawer holds lots of one item; the compacting drawer converts nuggets to ingots and blocks.",
	]
	quest.1D1B7F599AF0A561.title: "Harvest Storage"
	quest.1D1B7F599AF0A561.quest_desc: [
		"Controllers link drawers and barrels into one network: a Create funnel feeds the controller and it sorts everything.",
	]
	quest.1F76C6E74D4BC47E.title: "Sprinklers"
	quest.1F76C6E74D4BC47E.quest_desc: [
		"Slice & Dice: sprinklers water and fertilise crops so they grow faster.",
	]
	quest.4DF2762B75E31C53.title: "Automatic Farm"
	quest.4DF2762B75E31C53.quest_desc: [
		"Team goal: a watered field, a mechanical harvester reaping, belts carrying the crop to storage — hands-free.",
	]
	quest.220CBAA0AAF68C08.title: "The Zoo"
	quest.220CBAA0AAF68C08.quest_desc: [
		"Team goal: enclosures with at least five different animal species from different mods.",
	]
	quest.43715C376C3EA5D7.title: "Apiary"
	quest.43715C376C3EA5D7.quest_desc: [
		"A pump pulls honey from a hive straight into a tank, for spouts and the kitchen.",
	]
	quest.6761C7B4E826A261.title: "Roosts"
	quest.6761C7B4E826A261.quest_desc: [
		"Create Integrated Farming: a chicken in a roost lays eggs and drops feathers into a funnel, a henhouse without loose mobs.",
	]
	quest.42112A28B6C69D90.title: "Fishing Net"
	quest.42112A28B6C69D90.quest_desc: [
		"A net on a moving contraption, a boat or a train over water, fishes as it goes. There is a lava net for the Nether too.",
	]
	quest.3A4ED3F79573E9E2.title: "Aquarium"
	quest.62A5E5D0A5F4D4F0.title: "Skies Full of Birds"
	quest.62A5E5D0A5F4D4F0.quest_desc: [
		"Fowl Play: birds now really fly in flocks: gulls on the coast, crows and pigeons by the fields, geese by rivers, hawks over forests. A scarecrow keeps crows off your crops.",
	]
	quest.2C3008D3F1456B86.title: "Fancy Breeds"
	quest.2C3008D3F1456B86.quest_desc: [
		"Earth Mobs: fancy chickens, horned sheep, teacup pigs, jumbo and hyper rabbits. A fancy feather and a ram horn prove you found them.",
	]
	quest.0E96D6C35503C980.title: "Coastal Life"
	quest.0E96D6C35503C980.quest_desc: [
		"Spawn: rocky shores and seagrass meadows hold clams, sea cows, octopuses, sunfish and seals. The angler fish glows in the deep; catch it in a bucket.",
	]
	quest.52EF94D584C246DC.title: "Ant Farm"
	quest.52EF94D584C246DC.quest_desc: [
		"Ants from anthills gather whatever lies around. An ant farm keeps a colony at home.",
	]
	quest.265801186363658A.title: "Thrasher"
	quest.265801186363658A.quest_desc: [
		"Upgrade Aquatic: thrashers hunt in cold oceans; they sense vibration and shock their prey. Pike live in rivers.",
	]
	quest.017A9AC58435BBB1.title: "Lava Fishing"
	quest.017A9AC58435BBB1.quest_desc: [
		"Nether Depths Upgrade: obsidianfish, lava pufferfish and searing cod swim in Nether lava lakes. A normal rod would burn there.",
	]
	quest.57F76869F4929731.title: "The Owl's Nest"
	quest.57F76869F4929731.quest_desc: [
		"Ender Zoology: owls hunt spiders and lay eggs. Dire wolves roam snowy forests; do not go there alone.",
	]
	quest.2A49C2B7547DB685.title: "The Ribbit Market"
	quest.2A49C2B7547DB685.quest_desc: [
		"Ribbits: frog merchants live in swamp villages: fishermen, gardeners, sorcerers. They trade for amber.",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Ribbit Village (Ribbits).",
	]
	quest.2686668689286D25.title: "The Manor Prisoner"
	quest.2686668689286D25.quest_desc: [
		"Eternal Nether: the piglin manor keeps a piglin prisoner. Free him; the piglin hunters will not forgive it.",
		" ",
		"",
		" ",
		"§6Explorer's Compass:§r Piglin Manor (Eternal Nether).",
	]
	chapter.5C651509E771767F.title: "&#2A9D8FVillagers and Trade&r"
	chapter.5C651509E771767F.subtitle: "Trading, coins, village guards and villagers working Create machines."
	quest.2658DC25D6B3DA7D.title: "Find a Village"
	quest.2658DC25D6B3DA7D.quest_desc: [
		"Villages provide trading, food and workers. They're overhauled in this pack (ChoiceTheorem's Overhauled Village) and much bigger.",
		" ",
		"",
		" ",
		"Chronicle: \"The villages stood here long before us. We traded with them while we were generous, then began to take. Our apprentices, left without work, turned illager and raided these same villages. Trade fairly and protect them.\"",
		" ",
		"",
		" ",
		"The reward for the first village is in Era 0 (Find a Village). Here the village opens the chapter.",
		" ",
		"",
		" ",
		"§6Explorer's Compass (any of them):§r ChoiceTheorem's Overhauled Village: Large/village Beach, Large/village Christmas, Large/village Desert, Large/village Desert Oasis, Large/village Dark Forest; Minecraft: Village Plains, Village Desert, Village Savanna, Village Snowy, Village Taiga and 61 more.",
	]
	quest.689955EBFEFBEE47.title: "Emeralds"
	quest.689955EBFEFBEE47.quest_desc: [
		"The villager currency.",
	]
	quest.580BCAE9E6CE216C.title: "Professions"
	quest.580BCAE9E6CE216C.quest_desc: [
		"Just Enough Professions shows in JEI which workstation gives which profession.",
	]
	quest.11B1C884F639507E.title: "Cure a Zombie Villager"
	quest.11B1C884F639507E.quest_desc: [
		"Throw a splash potion of weakness at a zombie villager and feed it a golden apple. A cured villager gives permanent discounts.",
	]
	quest.183F2694AA369842.title: "Trading Depot"
	quest.183F2694AA369842.quest_desc: [
		"A Create addon: the depot trades with the villager in front of it, fed and emptied by Create logistics.",
	]
	quest.3722F79F88DAAC1E.title: "Working Hands"
	quest.3722F79F88DAAC1E.quest_desc: [
		"Create Villager Labor puts villagers to work at Create machines. Sneak + right-click a villager with the binder, then sneak + right-click a work seat to seat them.",
	]
	quest.79555F0FF44A37BA.title: "Press Seat"
	quest.79555F0FF44A37BA.quest_desc: [
		"A seated villager works the press for you.",
	]
	quest.212E828BE86D1EE0.title: "Mixer Seat"
	quest.212E828BE86D1EE0.quest_desc: [
		"The villager handles mixing recipes.",
	]
	quest.781937B74390881F.title: "Millstone Seat"
	quest.781937B74390881F.quest_desc: [
		"The villager grinds grain and ore at the millstone.",
	]
	quest.05926B4D3859C7F8.title: "Saw Seat"
	quest.05926B4D3859C7F8.quest_desc: [
		"The villager cuts logs and stone.",
	]
	quest.53E5411E4A9D48F0.title: "Work Gloves"
	quest.53E5411E4A9D48F0.quest_desc: [
		"A mixer seat upgrade: the villager can process heated recipes.",
	]
	quest.0BD872A6E132BA98.title: "Permanent Worker"
	quest.0BD872A6E132BA98.quest_desc: [
		"Use it on a seat to spawn a permanent villager worker. No more catching and leading villagers.",
	]
	quest.2859F5709F676199.title: "Brass Workshop"
	quest.2859F5709F676199.quest_desc: [
		"Seats come in andesite, copper and brass, just like Create parts. Build a brass workshop.",
	]
	quest.2FB3669343F67A3E.title: "Village Guards"
	quest.2FB3669343F67A3E.quest_desc: [
		"Guard Villagers adds guards that protect villagers and friendly players. You can equip them.",
	]
	quest.0191994FE0A2F870.title: "Hero of the Village"
	quest.0191994FE0A2F870.quest_desc: [
		"Defeat a pillager raid. The Ravager is the main target, and Evokers drop the Totem of Undying.",
	]
	quest.2ED598306999F658.title: "Goblin Traders"
	quest.2ED598306999F658.quest_desc: [
		"Goblins sometimes appear underground, and Vein Goblins in the Nether. They sell rare goods.",
	]
	quest.2CD88606C1AE94EC.title: "Villager Hat"
	quest.2CD88606C1AE94EC.quest_desc: [
		"An artifact from chests. While you wear it, villagers sell for less.",
	]
	quest.782F00D1CBFEEC77.title: "Bank Account"
	quest.782F00D1CBFEEC77.quest_desc: [
		"Create: Numismatics gives the server its own coins: spur (1), bevel (8), sprocket (16), cog (64), crown (512) and sun (4096). Deposit and withdraw them at a Bank Terminal. Quests in this branch pay in coins.",
		" ",
		"",
		" ",
		"The reward for the bank terminal is in Era 4 (the Bank quest).",
	]
	quest.19FF6DD1272E94B3.title: "Your Own Shop"
	quest.19FF6DD1272E94B3.quest_desc: [
		"A Vendor sells your goods to other players for coins. Sneak + right-click to configure it.",
		" ",
		"",
		" ",
		"The reward for the vendor is in Era 4 (the Vendor quest).",
	]
	quest.22559023B528869C.title: "Pay to Pass"
	quest.22559023B528869C.quest_desc: [
		"A Depositor takes payment and emits a redstone pulse: paid doors, lifts, train tickets.",
	]
	quest.0A3EA0673EEC8504.title: "Shared Treasury"
	quest.0A3EA0673EEC8504.quest_desc: [
		"The Banking Guide turns a Blaze Burner into a Blaze Banker: an account shared by several players, like a team treasury.",
	]
	quest.3D99FF00DB2F6952.title: "Marketplace"
	quest.3D99FF00DB2F6952.quest_desc: [
		"Open a market row and sell your friends what your factories make.",
	]
	quest.78389CE2CC3C1B88.title: "Trade Empire"
	quest.78389CE2CC3C1B88.quest_desc: [
		"Your economy is running. Time to found your own colony!",
	]
	chapter.496D413A0F49A695.title: "&#E9C46AContract Exchange&r"
	chapter.496D413A0F49A695.subtitle: "Repeatable orders: hand in a batch of goods and get coins. A reason to automate every line."
	quest.75B148B996AF893A.title: "How the Exchange Works"
	quest.75B148B996AF893A.quest_desc: [
		"Every contract repeats: press Submit, the goods are taken from your inventory, Numismatics coins arrive at once and the contract reopens.",
		" ",
		"",
		" ",
		"Prices make hand-gathering barely worth it and an automated line well worth it. Spend coins in friends' shops and keep them in the bank.",
	]
