	quest.1F068CE1876D1439.quest_desc: [
		"Garnished.",
		" ",
		"How to make: 2 iron or zinc ingots, 2 sticks and string. Faster than a normal axe (damage 9, speed 0.9).",
		" ",
		"",
		" ",
		"Tier T1: damage 8-8.5, speed 1.2-1.3.",
