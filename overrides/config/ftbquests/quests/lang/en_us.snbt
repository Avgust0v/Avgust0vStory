	task.3F287CD139941517.title: "Any piece of the set"
	quest.0D77D52DE41CE293.title: "Lamellar"
	quest.0D77D52DE41CE293.quest_desc: [
		"How to make: the chestplate is 8 lamellar rows, the boots 2 rows, leather and strips; a row is 6 iron nuggets and 3 strips. The face helmet is a shishak and 5 iron nuggets. No leggings.",
		" ",
		"Tier T1: 8 armour for the three pieces.",
		" ",
		"",
		" ",
		"§7One piece of the set completes the quest, the rest are optional (click a piece for its recipe).§r",
