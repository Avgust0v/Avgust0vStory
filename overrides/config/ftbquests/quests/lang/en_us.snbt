	quest.1C1FD63726CFA75D.title: "Netherite Polearms"
	quest.1C1FD63726CFA75D.quest_desc: [
		"How to make: smithing table: a netherite upgrade template, a diamond weapon of the same kind and a netherite ingot.",
		" ",
		"",
		" ",
		"Tier T5: damage 5-24.7, speed 0.65-1.7. Epic Knights polearms have 15-18 strength.",
