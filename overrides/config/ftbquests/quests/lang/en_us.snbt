	quest.61C0C9AAA2E4FF1F.title: "War Hammers"
	quest.61C0C9AAA2E4FF1F.quest_desc: [
		"How to make: the Basic Weapons hammer is 5 iron ingots and 2 sticks, the Epic Knights heavy war hammer 4 ingots, a stick and a hilt. The heaviest hit among iron weapons, but slow, and Epic Knights hammers pierce armour.",
		" ",
		"",
		" ",
		"Tier T1: damage 9, speed 0.7-0.95.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	quest.499A79BFFE0C453F.title: "Mossy Hammer"
	quest.499A79BFFE0C453F.quest_desc: [
		"Legendary Monsters.",
		" ",
		"How to make: a nature crystal, a moss block, 4 chiseled stone bricks and a stick.",
		" ",
		"Where to get: the nature crystal drops from the Overgrown Colossus in the Mossy Temple.",
		" ",
		"",
		" ",
		"Tier T1: damage 9, speed 0.8. Right-clicking a block hits everything within 4 blocks for 10 damage and poisons it. It also mines like a pickaxe.",
	]
	task.6AFD4A9675A94A0F.title: "Any item from the list"
	quest.1F26DCA3814FEE3A.title: "Clubs and Maces"
	quest.1F26DCA3814FEE3A.quest_desc: [
		"How to make: the Basic Weapons club is 2 iron ingots and a stick. Epic Knights: the mace and the morning star are 3 ingots, a stick and a hilt, the flail also takes a chain (a vanilla one works here). Almost an iron axe, and your axe stays whole for chopping.",
		" ",
		"",
		" ",
		"Tier T1: damage 8-10.4, speed 0.9-1.15.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
	]
	task.1049EB5B536C39C7.title: "Any item from the list"
