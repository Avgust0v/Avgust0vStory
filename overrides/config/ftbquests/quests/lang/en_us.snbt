	task.2ABCADD6A4B75327.title: "Any item from the list"
	quest.320D44AED8AAB828.title: "Netherite Maces and Hammers"
	quest.320D44AED8AAB828.quest_desc: [
		"How to make: smithing table: a netherite upgrade template, a diamond item of the same kind and a netherite ingot (netherite comes from a superheated mixer: scrap, gold and steel).",
		" ",
		"",
		" ",
		"Tier T5: damage 9-21.8, speed 0.7-1.4. Epic Knights maces and hammers have 15-17 strength.",
		" ",
		"",
		" ",
		"§7Any one item from the list completes the quest, the rest are optional (click for the recipe).§r",
