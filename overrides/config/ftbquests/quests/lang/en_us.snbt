	quest.4E7D9ACBC56C484A.quest_desc: [
		"How to make: the chestplate is 2 iron ingots and 6 chains, the leggings 2 ingots and 5 chains, the boots ingots, leather and strips, the kettle hat ingots, Create iron sheets and chains.",
		" ",
		"Tier T1: 15 armour, like iron.",
		" ",
		"",
		" ",
		"§7One piece of the set completes the quest, the rest are optional (click a piece for its recipe).§r",
